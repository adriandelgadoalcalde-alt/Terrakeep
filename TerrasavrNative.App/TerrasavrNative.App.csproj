<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TerrasavrNative.Core\TerrasavrNative.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <ApplicationIcon>Assets\branding\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Metadatos visibles en Propiedades del .exe / Administrador de tareas de Windows -
         sin esto, .NET usa el nombre del ensamblado en crudo (TerrasavrNative.App). -->
    <AssemblyTitle>Terrakeep</AssemblyTitle>
    <Product>Terrakeep</Product>
    <Description>Editor de personajes de Terraria (vanilla + Calamity Mod)</Description>
    <Company></Company>
    <!-- Real, sincronizada a mano con la version mas reciente de Assets/changelog.json - antes
         no se fijaba y caia al 1.0.0.0 por defecto de .NET, sin significar nada real. -->
    <Version>1.2.0</Version>
    <FileVersion>1.2.0.0</FileVersion>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
  </PropertyGroup>

</Project>
