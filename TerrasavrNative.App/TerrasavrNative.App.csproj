<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TerrasavrNative.Core\TerrasavrNative.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <ApplicationIcon>Assets\branding\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Nombre real del binario compilado (Terrakeep.exe/.dll) - independiente del nombre del
         proyecto/namespace C# (TerrasavrNative.App, sin tocar, cambiarlo afecta a carpetas y
         referencias de proyecto en todo el solution). Antes el .exe se llamaba
         TerrasavrNative.App.exe pese a que Product/AssemblyTitle ya decian "Terrakeep" - visible
         si el usuario abria la carpeta de instalacion o el Administrador de tareas (pestaña
         Detalles, columna "Nombre de archivo"). Pedido explicito del usuario (5-sep-2026): "de
         cara al usuario no puede ver nada... del otro nombre". -->
    <AssemblyName>Terrakeep</AssemblyName>
    <!-- Metadatos visibles en Propiedades del .exe / Administrador de tareas de Windows -
         sin esto, .NET usa el nombre del ensamblado en crudo (TerrasavrNative.App). -->
    <AssemblyTitle>Terrakeep</AssemblyTitle>
    <Product>Terrakeep</Product>
    <Description>Editor de personajes de Terraria (vanilla + Calamity Mod)</Description>
    <!-- Auditoria final de Opus (5-sep-2026, antes de publicar): el comentario de
         AboutViewModel.AuthorName ya daba por hecho que el nombre del autor vivia tambien aqui
         (<Authors>), pero NO estaba puesto - Company iba vacio y no habia ni Authors ni
         Copyright, asi que las Propiedades del Terrakeep.exe en Windows (pestaña Detalles) no
         decian de quien es el programa. Es justo el sitio donde mirar cuando alguien
         redistribuye un binario, asi que importa de verdad de cara a publicarlo. El nombre va
         LITERAL: "IncrediBad", con I y B mayusculas (misma regla que en AboutViewModel). -->
    <Authors>IncrediBad</Authors>
    <Company>IncrediBad</Company>
    <Copyright>Copyright © 2026 IncrediBad</Copyright>
    <!-- Real, sincronizada a mano con la version mas reciente de Assets/changelog.json - antes
         no se fijaba y caia al 1.0.0.0 por defecto de .NET, sin significar nada real. -->
    <Version>2.1.0</Version>
    <FileVersion>2.1.0.0</FileVersion>
    <AssemblyVersion>2.1.0.0</AssemblyVersion>
  </PropertyGroup>

</Project>
