<Window x:Class="TerrasavrNative.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TerrasavrNative.App"
        xmlns:vm="clr-namespace:TerrasavrNative.App.ViewModels"
        xmlns:data="clr-namespace:TerrasavrNative.Core.Data;assembly=TerrasavrNative.Core"
        mc:Ignorable="d"
        Title="Terrakeep" Height="760" Width="1180"
        Background="{StaticResource BgPrimaryBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Tarjeta de un slot de item (Inventario/Banco/...) -->
        <DataTemplate DataType="{x:Type vm:ItemSlotViewModel}">
            <!-- Arrastrar y soltar (pedido explicito 1-sep-2026): un slot ya puesto se puede
                 arrastrar sobre otro para intercambiarlos, y aqui tambien se pueden soltar
                 tarjetas arrastradas desde la Libreria - ver los manejadores reales en
                 MainWindow.xaml.cs (OnItemSlotMouseDown/Move/Drop). -->
            <Border ToolTip="{Binding StatsTooltip}" AllowDrop="True"
                    PreviewMouseLeftButtonDown="OnItemSlotMouseDown" MouseMove="OnItemSlotMouseMove"
                    Drop="OnItemSlotDrop">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ItemSlotCard}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter Property="Opacity" Value="0.35" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCalamity}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource CalamityBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                            <!-- Slot seleccionado para el panel "Editar" compartido - pedido explicito
                                 1-sep-2026 (equivalente real de resaltar el slot activo de app.TabEdit). -->
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                                <Setter Property="Effect" Value="{StaticResource AccentGlow}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="&#9733;" Command="{Binding ApplyBestPrefixCommand}"
                                ToolTip="Aplicar el mejor prefijo real"
                                Padding="2,0" FontSize="11" Foreground="{StaticResource AccentBrush}"
                                Background="Transparent"
                                Visibility="{Binding HasBestPrefixSuggestion, Converter={StaticResource BoolToVis}}" />
                        <Button Content="&#10005;" Command="{Binding ClearCommand}"
                                ToolTip="Vaciar este slot" Style="{StaticResource CircleCloseButton}"
                                Width="18" Height="18" FontSize="10"
                                Visibility="{Binding IsNotEmpty, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <Button DockPanel.Dock="Bottom" Command="{Binding ChooseFromLibraryCommand}"
                            HorizontalAlignment="Left" Padding="4,1" FontSize="10" Margin="0,2,0,0"
                            Background="Transparent" Foreground="{StaticResource AccentBrush}"
                            BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Content" Value="Cambiar" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                        <Setter Property="Content" Value="Elegir..." />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <Image Source="{Binding IconPath}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                        <StackPanel>
                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyText}"
                                       FontSize="11" TextWrapping="Wrap" MaxHeight="26" />
                            <TextBlock Text="{Binding PrefixDisplay, Mode=OneWay}" Style="{StaticResource CaptionText}" FontSize="9.5" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                        Visibility="{Binding IsNotEmpty, Converter={StaticResource BoolToVis}}">
                                <TextBox Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}"
                                         Width="34" Margin="0" Padding="2,0" FontSize="10.5"
                                         Background="{StaticResource BgPrimaryBrush}"
                                         Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- Panel "Editar" compartido - equivalente real de app.TabEdit: sigue al slot
             SELECCIONADO (ItemEditViewModel.Slot), no a uno fijo, para poder vivir fuera del
             TabControl de contenedores y "acompañar" a Inventario/Banco/Caja fuerte/Fragua/
             Boveda/Loadouts por igual (pedido explicito 1-sep-2026). -->
        <DataTemplate x:Key="ItemEditTemplate" DataType="{x:Type vm:ItemEditViewModel}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Editar" Style="{StaticResource SectionText}" Margin="0,0,0,10" />

                <TextBlock DockPanel.Dock="Top" Text="{Binding NoPrefixMessage}" Style="{StaticResource CaptionText}"
                           TextWrapping="Wrap" Margin="0,0,0,10"
                           Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}" />

                <StackPanel DockPanel.Dock="Top" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Image Source="{Binding Slot.IconPath}" Width="32" Height="32" Stretch="Uniform" Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Visibility="{Binding Slot.IconPath, Converter={StaticResource NullToVis}}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Slot.DisplayName}" Style="{StaticResource BodyText}" TextWrapping="Wrap" MaxWidth="220" />
                            <TextBlock Style="{StaticResource CaptionText}">
                                <Run Text="{Binding Slot.ContainerName, Mode=OneWay}" />
                                <Run Text=" · slot " />
                                <Run Text="{Binding Slot.SlotIndex, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Índice (id)" Style="{StaticResource CaptionText}" Margin="0,0,0,3" />
                    <TextBox Text="{Binding Slot.ItemId, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,8"
                             Background="{StaticResource BgElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />

                    <TextBlock Text="Cantidad" Style="{StaticResource CaptionText}" Margin="0,0,0,3" />
                    <TextBox Text="{Binding Slot.Count, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,8"
                             Background="{StaticResource BgElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />

                    <TextBlock Text="Prefijo (id)" Style="{StaticResource CaptionText}" Margin="0,0,0,3" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBox Text="{Binding Slot.PrefixId, UpdateSourceTrigger=PropertyChanged}" Width="50" Padding="6,4"
                                 Background="{StaticResource BgElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                        <Button Content="★" Command="{Binding ApplyBestPrefixCommand}" ToolTip="Aplicar el mejor prefijo real"
                                Padding="6,2" Margin="6,0,0,0" FontSize="12" Foreground="{StaticResource AccentBrush}"
                                Background="Transparent"
                                Visibility="{Binding Slot.HasBestPrefixSuggestion, Converter={StaticResource BoolToVis}}" />
                        <Button Content="Quitar" Command="{Binding ClearPrefixCommand}" ToolTip="Quitar el prefijo actual"
                                Padding="6,2" Margin="6,0,0,0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                Background="Transparent" />
                    </StackPanel>
                    <TextBlock Text="{Binding Slot.PrefixDisplay}" Style="{StaticResource CaptionText}" Margin="0,0,0,6"
                               Visibility="{Binding Slot.PrefixDisplay, Converter={StaticResource EmptyToCollapsed}}" />

                    <TextBlock Text="{Binding CategoriesLabel}" Style="{StaticResource CaptionText}" Foreground="{StaticResource AccentBrush}"
                               Margin="0,4,0,10" Visibility="{Binding CanHavePrefix, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- Selector de prefijo real de 3 niveles (equivalente exacto de los botones
                     btMeta/btGroups/btPrefix reales de app.TabEdit, ya filtrados por lo que es
                     legal de verdad para este objeto - ver PrefixGroupCatalog/PrefixRulesCatalog). -->
                <StackPanel Visibility="{Binding CanHavePrefix, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Metas}" Margin="0,0,0,6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PrefixMetaButtonViewModel}">
                                <Button Content="{Binding Label}" Style="{StaticResource PrefixMetaButton}"
                                        Command="{Binding DataContext.ItemEdit.SelectMetaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Groups}" Margin="0,0,0,6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PrefixGroupButtonViewModel}">
                                <Button Content="{Binding Label}" Style="{StaticResource PrefixGroupButton}"
                                        Command="{Binding DataContext.ItemEdit.SelectGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Prefixes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PrefixCatalogEntryViewModel}">
                                    <Button Content="{Binding DisplayName}"
                                            Command="{Binding DataContext.ItemEdit.ApplyPrefixCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" Padding="7,4" Margin="0,0,5,5" FontSize="11"
                                            Background="{StaticResource BgElevatedBrush}" BorderThickness="0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCalamity}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource CalamityBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AccentMutedBrush}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <!-- Nodo del arbol de categorias de la Libreria (recursivo - se referencia a si mismo
             por StaticResource, patron real de WPF para arboles sin usar TreeView). Un clic
             selecciona/deselecciona la carpeta como filtro Y despliega/pliega sus subcarpetas
             a la vez (LibraryViewModel.SelectCategoryCommand). -->
        <DataTemplate x:Key="CategoryNodeTemplate" DataType="{x:Type vm:CategoryNodeViewModel}">
            <StackPanel>
                <Button Command="{Binding DataContext.Library.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" HorizontalContentAlignment="Left" Padding="4,3" Margin="0,0,0,1"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource BgHoverBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentMutedBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding IconPath}" Width="16" Height="16" Margin="0,0,6,0" Stretch="Uniform"
                               VerticalAlignment="Center"
                               Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                        <TextBlock Text="{Binding Name}" FontSize="11.5" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}" FontSize="10"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Button>
                <ItemsControl ItemsSource="{Binding Children}" Margin="16,0,0,0"
                              ItemTemplate="{DynamicResource CategoryNodeTemplate}"
                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ContainerTabTemplate" DataType="{x:Type vm:ContainerViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Slots}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </DataTemplate>

        <!-- Un objeto/arma/accesorio recomendado dentro de una build, ya con icono real -->
        <DataTemplate DataType="{x:Type vm:BuildItemRowViewModel}">
            <Border Background="{StaticResource BgElevatedBrush}" CornerRadius="5" Margin="0,0,6,6" Padding="8,5"
                    ToolTip="{Binding StatsTooltip}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderThickness" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCalamity}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource CalamityBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <Image Source="{Binding IconPath}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,7,0"
                           Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                    <StackPanel>
                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyText}" />
                        <TextBlock Text="{Binding PrefixText}" Style="{StaticResource CaptionText}"
                                   Visibility="{Binding PrefixText, Converter={StaticResource NullToVis}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Una clase dentro de una etapa (melee/ranged/mage/summoner/rogue) -->
        <DataTemplate x:Key="BuildClassTemplate" DataType="{x:Type vm:BuildClassGearViewModel}">
            <StackPanel Margin="0,0,24,16" MinWidth="220">
                <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="Auto-equipar" FontSize="11" Padding="7,2"
                            Background="{StaticResource AccentBrush}" Foreground="{StaticResource BgPrimaryBrush}"
                            BorderThickness="0"
                            Command="{Binding DataContext.AutoEquipCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding Source}"
                            IsEnabled="{Binding DataContext.IsCharacterLoaded, RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="Coloca esta armadura/accesorios/armas en el personaje cargado" />
                    <TextBlock Text="{Binding ClassName}" Style="{StaticResource SectionText}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="Armadura" Style="{StaticResource CaptionText}" Margin="0,4,0,2" />
                <ItemsControl ItemsSource="{Binding Armor}" />
                <TextBlock Text="Armas" Style="{StaticResource CaptionText}" Margin="0,6,0,2" />
                <ItemsControl ItemsSource="{Binding Weapons}" />
                <TextBlock Text="Accesorios" Style="{StaticResource CaptionText}" Margin="0,6,0,2" />
                <ItemsControl ItemsSource="{Binding Accessories}" />
            </StackPanel>
        </DataTemplate>

        <!-- Una etapa completa (Pre-Hardmode/Hardmode temprano/Endgame) -->
        <DataTemplate DataType="{x:Type vm:BuildStageViewModel}">
            <StackPanel Margin="0,0,0,28">
                <TextBlock Text="{Binding Label}" Style="{StaticResource TitleText}" Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding Classes}" ItemTemplate="{StaticResource BuildClassTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!-- Una entrada de "Novedades" -->
        <DataTemplate DataType="{x:Type data:WhatsNewEntry}">
            <Border Background="{StaticResource BgSecondaryBrush}" CornerRadius="8" Margin="0,0,0,14" Padding="16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Version}" Style="{StaticResource TitleText}" />
                        <TextBlock Text="{Binding DisplayDate}" Style="{StaticResource CaptionText}"
                                   Margin="10,0,0,0" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TextBlock Text="{Binding DisplayNote}" Style="{StaticResource CaptionText}"
                               Margin="0,4,0,8" TextWrapping="Wrap"
                               Visibility="{Binding DisplayNote, Converter={StaticResource EmptyToCollapsed}}" />
                    <ItemsControl ItemsSource="{Binding Changes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type data:WhatsNewChange}">
                                <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,2">
                                    <Run Text="- " Foreground="{StaticResource AccentBrush}" />
                                    <Run Text="{Binding DisplayText, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Objetos nuevos" Style="{StaticResource SectionText}" Margin="0,10,0,4"
                               Visibility="{Binding Items.Count, Converter={StaticResource CountToVis}}" />
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type data:WhatsNewItem}">
                                <Border Background="{StaticResource BgElevatedBrush}" CornerRadius="4" Margin="0,0,6,6" Padding="7,3">
                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource CaptionText}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Changelog del propio EDITOR (Terrakeep, pestaña "Acerca de") - distinto de
             WhatsNewEntry, que es el changelog del juego/Calamity. -->
        <DataTemplate DataType="{x:Type data:ChangelogEntry}">
            <Border Background="{StaticResource BgSecondaryBrush}" CornerRadius="8" Margin="0,0,0,14" Padding="16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Version}" Style="{StaticResource TitleText}" FontSize="18" />
                        <TextBlock Text="{Binding Date}" Style="{StaticResource CaptionText}"
                                   Margin="10,0,0,0" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionText}"
                               Margin="0,4,0,8" TextWrapping="Wrap" />

                    <TextBlock Text="Añadido" Style="{StaticResource SectionText}" FontSize="12" Margin="0,4,0,2"
                               Visibility="{Binding Added.Count, Converter={StaticResource CountToVis}}" />
                    <ItemsControl ItemsSource="{Binding Added}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,2">
                                    <Run Text="+ " Foreground="{StaticResource TealBrush}" />
                                    <Run Text="{Binding Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Arreglado" Style="{StaticResource SectionText}" FontSize="12" Margin="0,8,0,2"
                               Visibility="{Binding Fixed.Count, Converter={StaticResource CountToVis}}" />
                    <ItemsControl ItemsSource="{Binding Fixed}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,2">
                                    <Run Text="- " Foreground="{StaticResource PinkBrush}" />
                                    <Run Text="{Binding Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <TabControl Style="{StaticResource NavTabControl}" SelectedIndex="{Binding SelectedTabIndex}">
        <!-- ===================== INICIO ===================== -->
        <TabItem Header="Inicio">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="14">
                <StackPanel MaxWidth="880" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                        <Image Source="pack://siteoforigin:,,,/Assets/branding/logo-128.png" Width="56" Height="56" />
                        <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Text="{Binding About.AppName}" Style="{StaticResource TitleText}" FontSize="26" />
                            <TextBlock Text="{Binding About.Tagline}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" LineHeight="20" Margin="0,10,0,24" MaxWidth="700">
                        <Run Text="Editor de personajes de Terraria - vanilla y Calamity Mod (tModLoader) a la vez, con el mismo archivo. Edicion nativa: sin Electron, sin Chromium embebido, arranque instantaneo. Carga un " />
                        <Run Text=".plr" FontStyle="Italic" />
                        <Run Text=" (con su " />
                        <Run Text=".tplr" FontStyle="Italic" />
                        <Run Text=" si lo tiene) y edita inventario, equipo por loadout, buffs, investigacion, mascotas/monturas, apariencia y mas - los objetos de Calamity se detectan y editan igual que los vanilla, marcados en " />
                        <Run Text="rojo" Foreground="{StaticResource CalamityBrush}" FontWeight="SemiBold" />
                        <Run Text=" para distinguirlos." />
                    </TextBlock>

                    <Button Style="{StaticResource NavCardButton}" HorizontalAlignment="Left" Margin="0,0,0,26"
                            Command="{Binding GoToTabCommand}" CommandParameter="Personaje">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="4" Background="{StaticResource AccentBrush}" CornerRadius="2" Margin="0,0,16,0" />
                            <StackPanel>
                                <TextBlock Text="Empezar: cargar un personaje" Style="{StaticResource SectionText}" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="Abre un archivo .plr real y edita todo su contenido, incluido Calamity si el .tplr esta al lado."
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="520" Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="Que mas puedes hacer" Style="{StaticResource SectionText}" Margin="0,0,0,12" />
                    <ItemsControl>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <Button Style="{StaticResource NavCardButton}" Width="270" Height="108" Margin="0,0,14,14"
                                Command="{Binding GoToTabCommand}" CommandParameter="Libreria">
                            <StackPanel>
                                <TextBlock Text="Libreria" Style="{StaticResource SectionText}" />
                                <TextBlock Text="Busca entre miles de objetos vanilla y de Calamity por nombre y colocalos directamente en cualquier slot."
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavCardButton}" Width="270" Height="108" Margin="0,0,14,14"
                                Command="{Binding GoToTabCommand}" CommandParameter="Builds">
                            <StackPanel>
                                <TextBlock Text="Builds" Style="{StaticResource SectionText}" />
                                <TextBlock Text="Equipo recomendado por clase y etapa del juego (vanilla y Calamity), con auto-equipar de un click."
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavCardButton}" Width="270" Height="108" Margin="0,0,14,14"
                                Tag="Pink" Command="{Binding GoToTabCommand}" CommandParameter="Exploracion">
                            <StackPanel>
                                <TextBlock Text="Exploracion" Style="{StaticResource SectionText}" />
                                <TextBlock Text="Carga un mundo .wld y navega su mapa completo: pan, zoom y NPCs de pueblo con su posicion."
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavCardButton}" Width="270" Height="108" Margin="0,0,14,14"
                                Tag="Teal" Command="{Binding GoToTabCommand}" CommandParameter="Novedades">
                            <StackPanel>
                                <TextBlock Text="Novedades" Style="{StaticResource SectionText}" />
                                <TextBlock Text="Que ha cambiado en cada version del JUEGO y de Calamity Mod - objetos nuevos, arreglos, etc."
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavCardButton}" Width="270" Height="108" Margin="0,0,14,14"
                                Tag="Orange" Command="{Binding GoToTabCommand}" CommandParameter="AcercaDe">
                            <StackPanel>
                                <TextBlock Text="¡Sobre esta versión!" Style="{StaticResource SectionText}" />
                                <TextBlock Text="Que ha cambiado en el propio Terrakeep, version instalada y creditos."
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            </StackPanel>
                        </Button>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ===================== PERSONAJE ===================== -->
        <TabItem Header="Personaje">
            <DockPanel Margin="14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="Cargar personaje (.plr)..." Tag="Accent" Click="OnLoadClick" />
                    <Button Content="Guardar" Tag="Orange" Margin="10,0,0,0" Command="{Binding SaveCommand}" />
                    <TextBlock Text="{Binding CharacterName, StringFormat='Personaje: {0}'}"
                               Style="{StaticResource SectionText}" VerticalAlignment="Center" Margin="20,0,0,0"
                               Visibility="{Binding IsCharacterLoaded, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}"
                           Margin="0,10,0,0" TextWrapping="Wrap" />

                <TabControl Style="{StaticResource InnerTabControl}" SelectedIndex="{Binding PersonajeInnerTabIndex}">
                    <TabItem Header="Objetos">
                        <!-- Layout real de Terrasavr (pedido explicito 1-sep-2026): el inventario/equipo
                             arriba, la Libreria (arbol + buscador) siempre visible debajo, a la derecha
                             del arbol - nunca una pestaña aparte a la que hay que ir, para que arrastrar
                             una tarjeta de la Libreria hasta un slot visible sea posible de verdad. -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="270" />
                            </Grid.RowDefinitions>

                            <!-- Contenedores a la izquierda + panel "Editar" a la derecha (equivalente real
                                 de app.TabInventory.initSide: sideCtr con las pestañas Edit/Library reales -
                                 aqui Library ya vive fijo abajo, ver Grid.Row=1, y Editar sigue al slot
                                 SELECCIONADO sea cual sea el contenedor activo). -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="300" />
                                </Grid.ColumnDefinitions>

                                <TabControl Grid.Column="0" Style="{StaticResource InnerTabControl}" ItemsSource="{Binding Containers}" Margin="0,0,10,0">
                                    <TabControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ContainerViewModel}">
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </TabControl.ItemTemplate>
                                    <TabControl.ContentTemplate>
                                        <StaticResource ResourceKey="ContainerTabTemplate" />
                                    </TabControl.ContentTemplate>
                                </TabControl>

                                <Border Grid.Column="1" Style="{StaticResource SidePanelCard}">
                                    <ContentControl Content="{Binding ItemEdit}" ContentTemplate="{StaticResource ItemEditTemplate}" />
                                </Border>
                            </Grid>

                            <!-- Libreria: arbol de carpetas real (vanilla + Calamity, ver
                                 LibraryViewModel.BuildCategoryTree) + buscador, SIEMPRE visible aqui abajo. -->
                            <Border Grid.Row="1" Background="{StaticResource BgSecondaryBrush}" CornerRadius="8" Padding="8">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Background="{StaticResource AccentBrush}" CornerRadius="6" Padding="8,5" Margin="0,0,0,6"
                                            Visibility="{Binding Library.IsPicking, Converter={StaticResource BoolToVis}}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Cancelar" Command="{Binding Library.CancelPickCommand}"
                                                    Background="Transparent" BorderThickness="0" Foreground="{StaticResource BgPrimaryBrush}" Padding="6,2" />
                                            <TextBlock Text="Elige (o arrastra) un objeto para colocarlo en el slot seleccionado..."
                                                       Foreground="{StaticResource BgPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="11.5" />
                                        </DockPanel>
                                    </Border>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{StaticResource BgPrimaryBrush}" CornerRadius="6"
                                                Padding="5" Margin="0,0,8,0">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Top" Content="Ver todo" HorizontalAlignment="Left"
                                                        Padding="5,2" FontSize="10" Margin="0,0,0,4"
                                                        Command="{Binding Library.ClearCategoryCommand}" />
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding Library.RootCategories}"
                                                                  ItemTemplate="{StaticResource CategoryNodeTemplate}" />
                                                </ScrollViewer>
                                            </DockPanel>
                                        </Border>

                                        <DockPanel Grid.Column="1">
                                            <TextBox DockPanel.Dock="Top" Text="{Binding Library.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="7,5" Background="{StaticResource BgElevatedBrush}"
                                                     Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0"
                                                     MaxWidth="360" HorizontalAlignment="Left" FontSize="12" Margin="0,0,0,4" />
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding Library.ResultsSummary}" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding Library.Results}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:LibraryItemViewModel}">
                                                            <!-- Arrastrar una tarjeta hasta un slot visible arriba lo coloca alli
                                                                 (o pulsar "Colocar" si el picker esta activo) - pedido explicito
                                                                 1-sep-2026. -->
                                                            <Border Width="80" Height="86" Margin="3" Padding="4" CornerRadius="6"
                                                                    Background="{StaticResource BgElevatedBrush}" BorderThickness="1"
                                                                    ToolTip="{Binding StatsTooltip}" Cursor="Hand"
                                                                    PreviewMouseLeftButtonDown="OnLibraryCardMouseDown" MouseMove="OnLibraryCardMouseMove">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush0}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCalamity}" Value="True">
                                                                                <Setter Property="BorderBrush" Value="{StaticResource CalamityBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <DockPanel>
                                                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding DisplayName}"
                                                                               Style="{StaticResource CaptionText}" FontSize="9" TextWrapping="Wrap"
                                                                               TextAlignment="Center" MaxHeight="22" Margin="0,2,0,0" />
                                                                    <Button DockPanel.Dock="Bottom" Content="Colocar" FontSize="8.5" Padding="0,1"
                                                                            Background="{StaticResource AccentBrush}" BorderThickness="0"
                                                                            Foreground="{StaticResource BgPrimaryBrush}"
                                                                            Command="{Binding DataContext.Library.PlaceInTargetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"
                                                                            Visibility="{Binding DataContext.Library.IsPicking, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                                                                    <Image Source="{Binding IconPath}" Stretch="Uniform" MaxHeight="32"
                                                                           Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                                                                    <TextBlock DockPanel.Dock="Top" Text="?" Style="{StaticResource BodyText}"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                                               Visibility="{Binding IconPath, Converter={StaticResource NullToCollapsed}}" />
                                                                </DockPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </DockPanel>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Buffs">
                        <DockPanel Margin="0,10,0,0">
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <Button Content="Añadir buff..." Tag="Accent" Command="{Binding Buffs.BeginAddCommand}"
                                        HorizontalAlignment="Left" Margin="0,0,0,10" />

                                <Border Background="{StaticResource AccentBrush}" CornerRadius="6" Padding="10,7"
                                        Visibility="{Binding Buffs.IsPicking, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <Button DockPanel.Dock="Right" Content="Cancelar" Command="{Binding Buffs.CancelAddCommand}"
                                                    Background="Transparent" BorderThickness="0" Foreground="{StaticResource BgPrimaryBrush}" />
                                            <TextBlock Text="Buscar buff para añadir (vanilla + Calamity)"
                                                       Foreground="{StaticResource BgPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBox Text="{Binding Buffs.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="8,6" Background="{StaticResource BgPrimaryBrush}"
                                                 Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0"
                                                 MaxWidth="380" HorizontalAlignment="Left" FontSize="13" />
                                        <TextBlock Text="{Binding Buffs.ResultsSummary}" Foreground="{StaticResource BgPrimaryBrush}"
                                                   FontSize="11" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>

                                <ScrollViewer Margin="0,10,0,0" MaxHeight="240" VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding Buffs.IsPicking, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl ItemsSource="{Binding Buffs.Results}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:BuffCatalogEntryViewModel}">
                                                <Button Command="{Binding DataContext.Buffs.PickBuffCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" Margin="0,0,6,6" Padding="0" Background="Transparent" BorderThickness="0">
                                                    <Border Width="96" Height="96" Padding="6" CornerRadius="6"
                                                            Background="{StaticResource BgElevatedBrush}" BorderThickness="1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush0}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCalamity}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{StaticResource CalamityBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding DisplayName}"
                                                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                                                       TextAlignment="Center" MaxHeight="30" Margin="0,4,0,0" />
                                                            <Image Source="{Binding IconPath}" Stretch="Uniform" MaxHeight="40"
                                                                   Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                                                        </DockPanel>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Buffs.Active}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:BuffRowViewModel}">
                                            <Border Background="{StaticResource BgElevatedBrush}" CornerRadius="5" Margin="0,0,6,6" Padding="9,6">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCalamity}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{StaticResource CalamityBrush}" />
                                                                <Setter Property="BorderThickness" Value="1" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Top" Content="&#10005;" Command="{Binding RemoveCommand}"
                                                            ToolTip="Quitar este buff" HorizontalAlignment="Right"
                                                            Style="{StaticResource CircleCloseButton}" Width="18" Height="18" FontSize="10" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Source="{Binding IconPath}" Width="28" Height="28" Stretch="Uniform" Margin="0,0,8,0"
                                                               Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" MaxWidth="130" TextWrapping="Wrap" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                <TextBox Text="{Binding DurationSeconds, UpdateSourceTrigger=PropertyChanged}"
                                                                         Width="50" Padding="3,1" FontSize="12"
                                                                         Background="{StaticResource BgPrimaryBrush}"
                                                                         Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                                                                <TextBlock Text=" s" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Investigacion">
                        <DockPanel Margin="0,10,0,0">
                            <Button DockPanel.Dock="Top" Content="Investigar todo" Tag="Accent"
                                    Command="{Binding ResearchAllCommand}" HorizontalAlignment="Left" Margin="0,0,0,10" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Research}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ResearchRowViewModel}">
                                            <Border Background="{StaticResource BgElevatedBrush}" CornerRadius="4" Margin="0,0,6,6" Padding="6,4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCalamity}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{StaticResource CalamityBrush}" />
                                                                <Setter Property="BorderThickness" Value="1" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="{Binding IconPath}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,6,0"
                                                           Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Apariencia">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                            <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                                <TextBlock Text="Preview real de cuerpo completo (sprites reales del juego) - sin armadura/vestuario equipado, item en mano ni animacion, solo la pose de reposo. No aplica el efecto visual del tinte de pelo (shader especial que este preview no reproduce), solo su color de pelo base."
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,10" />

                                <Border Background="{StaticResource BgElevatedBrush}" CornerRadius="8" Padding="16"
                                        HorizontalAlignment="Left" Margin="0,0,0,18">
                                    <Image Source="{Binding Appearance.PreviewImage}" Width="240" Height="336"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Uniform" />
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="Genero" Style="{StaticResource SectionText}" Margin="0,0,0,4" />
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton GroupName="Gender" Content="Chico" IsChecked="{Binding Appearance.IsMale}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,12,0" />
                                            <RadioButton GroupName="Gender" Content="Chica" IsChecked="{Binding Appearance.IsFemale}" Foreground="{StaticResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="Peinado" Style="{StaticResource SectionText}" Margin="0,0,0,4" />
                                        <Button Command="{Binding Appearance.OpenHairPickerCommand}" Padding="8,6" HorizontalContentAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Appearance.HairStyle, StringFormat='Estilo #{0}'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="&#9998;" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Tinte de pelo" Style="{StaticResource SectionText}" Margin="0,0,0,4" />
                                        <Button Command="{Binding Appearance.OpenHairDyePickerCommand}" Padding="8,6" HorizontalContentAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Appearance.HairDyeDisplayName}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="&#9998;" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Selector visual de tinte de pelo - pedido explicito 1-sep-2026 (sprites en vez
                                     de escribir un id a mano) - mismo patron de overlay que el peinado de arriba. -->
                                <Border Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,18"
                                        Visibility="{Binding Appearance.IsHairDyePickerOpen, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <Button DockPanel.Dock="Right" Content="Cerrar" Command="{Binding Appearance.CloseHairDyePickerCommand}" Padding="8,3" />
                                            <TextBlock Text="Elige un tinte de pelo" Style="{StaticResource SectionText}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Appearance.HairDyeOptions}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:HairDyeOptionViewModel}">
                                                        <Button Command="{Binding DataContext.Appearance.SelectHairDyeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding Index}" Margin="2" Padding="6"
                                                                Background="{StaticResource BgElevatedBrush}" BorderThickness="0"
                                                                ToolTip="{Binding DisplayName}">
                                                            <StackPanel Width="54">
                                                                <Image Source="{Binding IconPath}" Width="28" Height="28" Stretch="Uniform"
                                                                       HorizontalAlignment="Center"
                                                                       Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                                                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource CaptionText}"
                                                                           FontSize="9" TextWrapping="Wrap" TextAlignment="Center" Margin="0,3,0,0" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>

                                <!-- Selector visual de peinado - pedido explicito 1-sep-2026 (sprites en vez de
                                     ids a mano). Mismo patron de overlay que ya usan el picker de prefijo y de
                                     buffs (Border de acento superpuesto, no un Popup real). -->
                                <Border Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,18"
                                        Visibility="{Binding Appearance.IsHairPickerOpen, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <Button DockPanel.Dock="Right" Content="Cerrar" Command="{Binding Appearance.CloseHairPickerCommand}" Padding="8,3" />
                                            <TextBlock Text="Elige un peinado" Style="{StaticResource SectionText}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Appearance.HairOptions}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:HairOptionViewModel}">
                                                        <Button Command="{Binding DataContext.Appearance.SelectHairCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding Id}" Margin="2" Padding="4"
                                                                Background="{StaticResource BgElevatedBrush}" BorderThickness="0"
                                                                ToolTip="{Binding Id}">
                                                            <Image Source="{Binding Thumbnail}" Width="30" Height="42"
                                                                   RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Uniform" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>

                                <ItemsControl ItemsSource="{Binding Appearance.Swatches}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ColorSwatchViewModel}">
                                            <Border Background="{StaticResource BgElevatedBrush}" CornerRadius="6" Margin="0,0,10,10" Padding="10">
                                                <StackPanel Width="150">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <Border Width="20" Height="20" CornerRadius="3" Background="{Binding Preview}"
                                                                BorderBrush="{StaticResource BorderBrush0}" BorderThickness="1" Margin="0,0,7,0" />
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <Slider Minimum="0" Maximum="255" Value="{Binding R}" Foreground="#E05555" Margin="0,2" />
                                                    <Slider Minimum="0" Maximum="255" Value="{Binding G}" Foreground="#55C065" Margin="0,2" />
                                                    <Slider Minimum="0" Maximum="255" Value="{Binding B}" Foreground="#5580E0" Margin="0,2" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Estadisticas" Style="{StaticResource SectionText}" Margin="0,20,0,8" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="Dificultad" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding Appearance.DifficultyLabels}" SelectedIndex="{Binding Appearance.Difficulty}"
                                                  Width="120" Padding="6,4" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="Vida (actual / max.)" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Text="{Binding Appearance.HealthNow, UpdateSourceTrigger=PropertyChanged}" Width="60" Padding="6,4"
                                                     Background="{StaticResource BgElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                                            <TextBlock Text="/" VerticalAlignment="Center" Margin="4,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBox Text="{Binding Appearance.HealthMax, UpdateSourceTrigger=PropertyChanged}" Width="60" Padding="6,4"
                                                     Background="{StaticResource BgElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Mana (actual / max.)" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Text="{Binding Appearance.ManaNow, UpdateSourceTrigger=PropertyChanged}" Width="60" Padding="6,4"
                                                     Background="{StaticResource BgElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                                            <TextBlock Text="/" VerticalAlignment="Center" Margin="4,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBox Text="{Binding Appearance.ManaMax, UpdateSourceTrigger=PropertyChanged}" Width="60" Padding="6,4"
                                                     Background="{StaticResource BgElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="Misiones de pesca completadas" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Appearance.FishingQuestsCompleted, UpdateSourceTrigger=PropertyChanged}" Width="70" Padding="6,4"
                                                 Background="{StaticResource BgElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="Puntuacion de golf" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Appearance.GolferScore, UpdateSourceTrigger=PropertyChanged}" Width="70" Padding="6,4"
                                                 Background="{StaticResource BgElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Horas jugadas" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Appearance.PlayHours, UpdateSourceTrigger=PropertyChanged, StringFormat=N1}" Width="70" Padding="6,4"
                                                 Background="{StaticResource BgElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Spawn Points">
                        <DockPanel Margin="0,10,0,0">
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="Puntos de aparicion guardados por mundo. &quot;Id&quot; es un identificador interno del mundo, no un texto legible - no suele hacer falta tocarlo."
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <Button Content="Añadir spawn point" Tag="Accent" Command="{Binding Servers.AddEntryCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Servers.Entries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ServerEntryRowViewModel}">
                                            <Border Background="{StaticResource BgElevatedBrush}" CornerRadius="6" Margin="0,0,0,8" Padding="12,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel Width="220" Margin="0,0,14,0">
                                                        <TextBlock Text="Nombre" Style="{StaticResource CaptionText}" Margin="0,0,0,3" />
                                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"
                                                                 Background="{StaticResource BgPrimaryBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                                                    </StackPanel>
                                                    <StackPanel Width="80" Margin="0,0,14,0">
                                                        <TextBlock Text="Spawn X" Style="{StaticResource CaptionText}" Margin="0,0,0,3" />
                                                        <TextBox Text="{Binding SpawnX, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"
                                                                 Background="{StaticResource BgPrimaryBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                                                    </StackPanel>
                                                    <StackPanel Width="80" Margin="0,0,14,0">
                                                        <TextBlock Text="Spawn Y" Style="{StaticResource CaptionText}" Margin="0,0,0,3" />
                                                        <TextBox Text="{Binding SpawnY, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"
                                                                 Background="{StaticResource BgPrimaryBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                                                    </StackPanel>
                                                    <StackPanel Width="100" Margin="0,0,14,0">
                                                        <TextBlock Text="Id" Style="{StaticResource CaptionText}" Margin="0,0,0,3" />
                                                        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"
                                                                 Background="{StaticResource BgPrimaryBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                                                    </StackPanel>
                                                    <Button Content="Quitar" VerticalAlignment="Bottom" Padding="8,5"
                                                            Command="{Binding DataContext.Servers.RemoveEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Desbloqueos">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                            <StackPanel MaxWidth="440">
                                <TextBlock Text="Desbloqueos y activaciones permanentes del personaje."
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <CheckBox Content="Accesorio extra (modo experto/maestro)" IsChecked="{Binding Flags.ExtraAccessory}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <CheckBox Content="Cambio de antorcha de bioma desbloqueado" IsChecked="{Binding Flags.UnlockedBiomeTorches}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <CheckBox Content="Cambio de antorcha de bioma activado" IsChecked="{Binding Flags.UsingBiomeTorches}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <CheckBox Content="Alcance de mesa de trabajo aumentado (Pan del Artesano)" IsChecked="{Binding Flags.ArtisanBread}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <CheckBox Content="Regeneracion de vida aumentada (Cristal Vital)" IsChecked="{Binding Flags.VitalCrystal}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <CheckBox Content="Defensa aumentada (Fruta de Egida)" IsChecked="{Binding Flags.AegisFruit}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <CheckBox Content="Regeneracion de mana aumentada (Cristal Arcano)" IsChecked="{Binding Flags.ArcaneCrystal}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <CheckBox Content="Suerte aumentada (Perla de Galaxia)" IsChecked="{Binding Flags.GalaxyPearl}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <CheckBox Content="Poder de pesca aumentado (Gusano de Gominola)" IsChecked="{Binding Flags.GummyWorm}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <CheckBox Content="Velocidad de mineria y colocacion aumentada (Ambrosia)" IsChecked="{Binding Flags.Ambrosia}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <CheckBox Content="Evento de la Segunda Defensa de las Dimensiones completado (puede usar invocaciones)" IsChecked="{Binding Flags.FinishedDD2Event}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <CheckBox Content="Carrito potenciado desbloqueado" IsChecked="{Binding Flags.UnlockedSuperMinecart}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <CheckBox Content="Carrito potenciado activado" IsChecked="{Binding Flags.UsingSuperMinecart}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Version">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                            <StackPanel MaxWidth="500">
                                <Border Background="{StaticResource CalamityBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,14">
                                    <TextBlock Foreground="White" TextWrapping="Wrap" FontSize="12"
                                               Text="Cuidado: cambiar la version cambia que campos lee/escribe el guardado. Un valor que no encaje con el contenido real del personaje puede producir un archivo que ni esta app ni el juego sepan releer bien." />
                                </Border>
                                <TextBlock Text="Numero de version en crudo" Style="{StaticResource SectionText}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding VersionEditor.RawVersion, UpdateSourceTrigger=PropertyChanged}"
                                         Width="90" Padding="6,4" HorizontalAlignment="Left" Margin="0,0,0,16"
                                         Background="{StaticResource BgElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />

                                <ItemsControl ItemsSource="{Binding VersionEditor.Groups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:VersionGroup}">
                                            <StackPanel Margin="0,0,0,14">
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource CaptionText}" Margin="0,0,0,6" />
                                                <ItemsControl ItemsSource="{Binding Options}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:VersionOption}">
                                                            <Button Content="{Binding Label}" Margin="0,0,6,6" Padding="8,4"
                                                                    Command="{Binding DataContext.VersionEditor.SetVersionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding Number}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </TabItem>

        <!-- ===================== BUILDS ===================== -->
        <TabItem Header="Builds">
            <TabControl Style="{StaticResource InnerTabControl}" Margin="14">
                <TabItem Header="Vanilla">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Builds.VanillaStages}" Margin="4,10,0,0" />
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Calamity Mod">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Builds.CalamityStages}" Margin="4,10,0,0" />
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </TabItem>

        <!-- ===================== NOVEDADES ===================== -->
        <TabItem Header="Novedades">
            <ScrollViewer Margin="14" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,14">
                        <Run Text="Esto es el registro de cambios del " />
                        <Run Text="JUEGO" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        <Run Text=" (Terraria y Calamity Mod) - objetos nuevos, arreglos, etc. Para ver qué ha cambiado en el propio Terrakeep, ve a " />
                        <Run Text="«¡Sobre esta versión!»" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        <Run Text="." />
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding WhatsNew.Entries}" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ===================== EXPLORACION ===================== -->
        <TabItem Header="Exploracion">
            <DockPanel Margin="14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Cargar mundo (.wld)..." Tag="Accent" Click="OnLoadWorldClick" />
                    <TextBlock Text="{Binding Exploration.WorldTitle, StringFormat='Mundo: {0}'}"
                               Style="{StaticResource SectionText}" VerticalAlignment="Center" Margin="20,0,0,0"
                               Visibility="{Binding Exploration.IsWorldLoaded, Converter={StaticResource BoolToVis}}" />
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding Exploration.IsWorldLoaded, Converter={StaticResource BoolToVis}}">
                        <Button Content="&#8722;" Command="{Binding Exploration.ZoomOutCommand}" Padding="10,2" />
                        <TextBlock Text="{Binding Exploration.Zoom, StringFormat={}{0:P0}}" Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center" Width="50" TextAlignment="Center" />
                        <Button Content="+" Command="{Binding Exploration.ZoomInCommand}" Padding="10,2" Margin="4,0,0,0" />
                        <Button Content="Restablecer" Command="{Binding Exploration.ZoomResetCommand}" Padding="8,2" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Exploration.StatusMessage}"
                           Style="{StaticResource CaptionText}" Margin="0,10,0,0" TextWrapping="Wrap" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource BgSecondaryBrush}" CornerRadius="8" Margin="0,0,10,0">
                        <DockPanel>
                            <Border DockPanel.Dock="Bottom" Background="{StaticResource BgElevatedBrush}"
                                    CornerRadius="0,0,8,8" Padding="10,6"
                                    Visibility="{Binding Exploration.HoverInfo, Converter={StaticResource EmptyToCollapsed}}">
                                <TextBlock Text="{Binding Exploration.HoverInfo}" Style="{StaticResource CaptionText}" />
                            </Border>
                            <!-- Arrastrar para desplazar (pan) + rueda para zoom, sin necesitar Ctrl - los
                                 gestores reales viven en el code-behind (MainWindow.xaml.cs) porque
                                 necesitan tocar los offsets del ScrollViewer, que la ViewModel no conoce.
                                 Cursor="Hand" (no "SizeAll", las 4 flechas que el usuario rechazo
                                 explicitamente 1-sep-2026) - WPF no trae un cursor de "mano de agarre"
                                 nativo como el pan de TEdit/Photoshop, esto es lo mas cercano sin
                                 fabricar un .cur propio. -->
                            <Grid>
                                <ScrollViewer x:Name="WorldMapScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                              PreviewMouseWheel="OnWorldMapPreviewMouseWheel"
                                              PreviewMouseLeftButtonDown="OnWorldMapMouseDown"
                                              PreviewMouseMove="OnWorldMapMouseMove"
                                              PreviewMouseLeftButtonUp="OnWorldMapMouseUp"
                                              MouseLeave="OnWorldMapMouseLeave"
                                              Cursor="Hand">
                                    <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <Grid.LayoutTransform>
                                            <ScaleTransform ScaleX="{Binding Exploration.Zoom}" ScaleY="{Binding Exploration.Zoom}" />
                                        </Grid.LayoutTransform>
                                        <Image x:Name="WorldMapImage" Source="{Binding Exploration.WorldImage}" Stretch="None"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                               HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
                                        <ItemsControl ItemsSource="{Binding Exploration.Npcs}" IsHitTestVisible="True">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><Canvas IsItemsHost="True" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding TileX}" />
                                                    <Setter Property="Canvas.Top" Value="{Binding TileY}" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:WorldNpcRowViewModel}">
                                                    <Ellipse Width="11" Height="11" Margin="-5.5,-5.5,0,0"
                                                             Fill="Magenta" Stroke="White" StrokeThickness="1.5"
                                                             ToolTip="{Binding Name}" Cursor="Hand" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </ScrollViewer>

                                <!-- Tooltip flotante que sigue al cursor sobre el mapa (estilo TEdit),
                                     ADEMAS del texto fijo de abajo (pedido explicito 1-sep-2026: "tambien
                                     tiene que decirlo cuando pasas el raton por encima", sin quitar el de
                                     abajo). Canvas superpuesto en vez de Popup real - un Popup es un HWND
                                     aparte y parpadea al mover el raton rapido; el Canvas se recorta solo
                                     al area visible del mapa. Reposicionado a mano en
                                     OnWorldMapMouseMove (MainWindow.xaml.cs), que es quien ya conoce la
                                     posicion real del cursor sobre el mapa. -->
                                <Canvas x:Name="MapTooltipCanvas" IsHitTestVisible="False">
                                    <Border x:Name="MapTooltipBorder" Background="{StaticResource BgElevatedBrush}"
                                            CornerRadius="4" Padding="8,4" Effect="{StaticResource CardShadow}"
                                            Visibility="{Binding Exploration.HoverInfo, Converter={StaticResource EmptyToCollapsed}}">
                                        <TextBlock Text="{Binding Exploration.HoverInfo}" Style="{StaticResource CaptionText}" />
                                    </Border>
                                </Canvas>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <DockPanel Grid.Column="1">
                        <TextBlock DockPanel.Dock="Top" Text="NPCs de pueblo" Style="{StaticResource SectionText}" Margin="0,0,0,8" />
                        <TextBox DockPanel.Dock="Top" Text="{Binding Exploration.NpcSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="7,5" Background="{StaticResource BgElevatedBrush}"
                                 Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0"
                                 FontSize="12" Margin="0,0,0,10" />

                        <Expander DockPanel.Dock="Bottom" Header="NPCs que faltan" Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,10,0,0" IsExpanded="True"
                                  Visibility="{Binding Exploration.MissingNpcs.Count, Converter={StaticResource CountToVis}}">
                            <ItemsControl ItemsSource="{Binding Exploration.MissingNpcs}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:MissingNpcRowViewModel}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <Image Source="{Binding IconPath}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,5,0"
                                                   Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource CaptionText}"
                                                       Foreground="{StaticResource CalamityBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Exploration.Npcs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:WorldNpcRowViewModel}">
                                        <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,5"
                                                HorizontalContentAlignment="Stretch" Cursor="Hand"
                                                ToolTip="Ir a su posicion en el mapa"
                                                Command="{Binding DataContext.Exploration.GoToNpcCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Border Background="{StaticResource BgElevatedBrush}" CornerRadius="5" Padding="8,5">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="{Binding IconPath}" Width="28" Height="28" Stretch="Uniform" Margin="0,0,8,0"
                                                           Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" />
                                                        <TextBlock Text="{Binding Position}" Style="{StaticResource CaptionText}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </TabItem>

        <!-- ===================== ACERCA DE ===================== -->
        <TabItem Header="Acerca de">
            <ScrollViewer Margin="14" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,20">
                        <Image Source="pack://siteoforigin:,,,/Assets/branding/logo-128.png" Width="72" Height="72" />
                        <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Text="{Binding About.AppName}" Style="{StaticResource TitleText}" FontSize="28" />
                            <TextBlock Text="{Binding About.Tagline}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0">
                                <Run Text="Version " /><Run Text="{Binding About.Version, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding About.CreditsText}" Style="{StaticResource BodyText}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,24" />

                    <TextBlock Text="¡Sobre esta versión!" Style="{StaticResource TitleText}" FontSize="20" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,14">
                        <Run Text="Esto es el registro de cambios del propio " />
                        <Run Text="EDITOR" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        <Run Text=" (Terrakeep) - qué se ha añadido y arreglado, versión a versión. Para el registro del juego/Calamity, ve a «Novedades»." />
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Changelog.Entries}" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
