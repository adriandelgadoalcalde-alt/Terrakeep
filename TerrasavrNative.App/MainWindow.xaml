<Window x:Class="TerrasavrNative.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TerrasavrNative.App"
        xmlns:vm="clr-namespace:TerrasavrNative.App.ViewModels"
        xmlns:data="clr-namespace:TerrasavrNative.Core.Data;assembly=TerrasavrNative.Core"
        xmlns:controls="clr-namespace:TerrasavrNative.App.Controls"
        xmlns:conv="clr-namespace:TerrasavrNative.App.Converters"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="860" Width="1180" MinWidth="1080" MinHeight="700"
        Background="{StaticResource BgPrimaryBrush}" Closing="OnWindowClosing" KeyDown="OnWindowKeyDown"
        AllowDrop="True" Drop="OnWindowDrop">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- H5-10 (quinta auditoria de Opus): fraccion 0..1 real a ancho en pixeles, para las
             barras de vida/mana de la cabecera. -->
        <conv:FractionToWidthConverter x:Key="FractionToWidth" />

        <!-- Panel "Editar" compartido - equivalente real de app.TabEdit: sigue al slot
             SELECCIONADO (ItemEditViewModel.Slot), no a uno fijo, para poder vivir fuera del
             TabControl de contenedores y "acompañar" a Inventario/Banco/Caja fuerte/Fragua/
             Boveda/Loadouts por igual (pedido explicito 1-sep-2026). -->
        <DataTemplate x:Key="ItemEditTemplate" DataType="{x:Type vm:ItemEditViewModel}">
            <!-- L-d (segunda auditoria de Opus, Fable): "sin ScrollViewer de seguridad - un
                 objeto con muchos prefijos legales (varios Metas/Groups reales a la vez, ej.
                 un arma Picaro real de Calamity) puede desbordar la altura real del panel en
                 una ventana baja, y el contenido de mas arriba (Índice/Cantidad/Prefijo a mano)
                 quedaria inalcanzable - DockPanel no recorta ni scrollea solo (mismo aviso real
                 ya documentado en el proyecto para Panel). Mismo criterio ya establecido en el
                 resto de la app ("ScrollViewer de seguridad" - MountsContainer, Almacenes...). -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding Loc[action_edit], Mode=OneWay}" Style="{StaticResource SectionText}" Margin="0,0,0,10" />

                <TextBlock DockPanel.Dock="Top" Text="{Binding NoPrefixMessage}" Style="{StaticResource CaptionText}"
                           TextWrapping="Wrap" Margin="0,0,0,10"
                           Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}" />

                <!-- Auditoria de Opus, Bloque 5 (T-5): leyenda real de los 3 codigos de color de
                     un slot (fondo verde/punto rojo/borde morado) - antes habia que
                     descubrirlos por prueba y error. Solo aqui, en el hueco real que deja "sin
                     seleccion" (StaticResource nunca compite con el contenido de edicion real). -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10"
                            Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}">
                    <TextBlock Text="{Binding Loc[legend_title], Mode=OneWay}" Style="{StaticResource CaptionText}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Border Width="14" Height="14" CornerRadius="3" Background="{StaticResource EquippedGreenBrush}" Opacity="0.5" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Loc[legend_equipped], Mode=OneWay}" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Ellipse Width="10" Height="10" Fill="{StaticResource CalamityBrush}" Margin="2,0,6,0" />
                        <TextBlock Text="{Binding Loc[legend_calamity_item], Mode=OneWay}" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="14" Height="14" CornerRadius="3" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Loc[legend_selected_slot], Mode=OneWay}" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <DockPanel Margin="0,0,0,10">
                        <!-- La tarjeta compacta (Inventario/Almacenes, pregunta a Opus sobre el
                             diseño 2-sep-2026) ya no tiene sitio para un boton "✕" propio -
                             este panel, que acompaña a cualquier slot seleccionado sea cual sea
                             el contenedor, es donde vive ahora tambien para esos casos (la
                             tarjeta rica conserva el suyo ademas, por comodidad). -->
                        <Button DockPanel.Dock="Right" Content="{Binding Loc[action_empty_slot], Mode=OneWay}" Command="{Binding Slot.ClearCommand}"
                                ToolTip="{Binding Loc[tt_empty_this_slot], Mode=OneWay}" Tag="Ghost" Padding="6,3" FontSize="10.5" VerticalAlignment="Center" />
                        <!-- H5-06 (quinta auditoria de Opus): mismo interruptor que el menu
                             contextual del slot, aqui tambien - el Content cambia de verdad
                             (★ lleno/vacio) para que el propio boton diga su estado sin tener
                             que leer un tooltip. -->
                        <Button DockPanel.Dock="Right" Command="{Binding Slot.ToggleFavoriteCommand}"
                                ToolTip="{Binding Loc[tt_toggle_favorite], Mode=OneWay}" Tag="Ghost" Padding="6,3" Margin="0,0,6,0"
                                FontSize="12" VerticalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="&#9734;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Slot.IsFavorited}" Value="True">
                                            <Setter Property="Content" Value="&#9733;" />
                                            <Setter Property="Foreground" Value="{StaticResource MasterGoldBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Image Source="{Binding Slot.IconPath}" Width="32" Height="32" Stretch="Uniform" Margin="0,0,8,0"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               VerticalAlignment="Center"
                               Visibility="{Binding Slot.IconPath, Converter={StaticResource NullToVis}}" />
                        <StackPanel VerticalAlignment="Center">
                            <!-- Auditoria de Opus, D-3: color real de rareza (null = color de
                                 texto normal, ver VanillaRarityColorCatalog). -->
                            <TextBlock Text="{Binding Slot.DisplayName}" Style="{StaticResource BodyText}" TextWrapping="Wrap" MaxWidth="220"
                                       Foreground="{Binding Slot.RarityBrush, TargetNullValue={StaticResource TextPrimaryBrush}}" />
                            <TextBlock Style="{StaticResource CaptionText}">
                                <Run Text="{Binding Slot.ContainerName, Mode=OneWay}" />
                                <Run Text="{Binding Loc[label_dot_slot], Mode=OneWay}" />
                                <Run Text="{Binding Slot.SlotIndex, Mode=OneWay}" />
                            </TextBlock>
                            <!-- Auditoria de Opus, E-3: "un usuario que no conoce el juego no
                                 sabe que el slot 3 es 'Accesorio 1'" - respaldado por el
                                 original real (locClass Helmet/Shirt/Pants/Accessory $1). -->
                            <TextBlock Text="{Binding Slot.SlotRoleLabel}" Style="{StaticResource CaptionText}"
                                       FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"
                                       Visibility="{Binding Slot.SlotRoleLabel, Converter={StaticResource NullToVis}}" />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="{Binding Loc[label_index_id], Mode=OneWay}" Style="{StaticResource CaptionText}" Margin="0,0,0,3" />
                    <!-- Auditoria de Opus (octava pasada, T-17) - BUG REAL encontrado y
                         arreglado: con PropertyChanged, escribir "100" pasaba de verdad por
                         Id=1 y Id=10 antes de llegar a 100 - CADA digito colocaba un objeto
                         real (OnItemIdChanged llama a PlaceItem de inmediato), asi que escribir
                         un id de 3 cifras colocaba 2 objetos equivocados antes del correcto.
                         Sin UpdateSourceTrigger explicito, el TextBox usa su valor real por
                         defecto (LostFocus) - confirma al salir del campo; OnCommitTextOnEnter
                         (code-behind) fuerza el mismo commit real al pulsar Intro, sin tener
                         que hacer clic fuera. -->
                    <TextBox Text="{Binding Slot.ItemId}" Padding="6,4" Margin="0,0,0,8" KeyDown="OnCommitTextOnEnter"
                             Background="{StaticResource BgElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                    <!-- Restriccion de slot (consulta a Opus, sexta pasada): el unico camino
                         de los tres (Libreria filtrada/arrastrar y soltar/Indice a mano) donde
                         el silencio confunde de verdad - aqui SI hace falta una linea real,
                         nada modal. Collapsed no reserva espacio, no cambia el espaciado
                         normal cuando no hay mensaje. -->
                    <TextBlock Text="{Binding Slot.RejectionMessage}" Style="{StaticResource CaptionText}"
                               Foreground="{StaticResource CalamityBrush}" TextWrapping="Wrap" Margin="0,-4,0,8"
                               Visibility="{Binding Slot.RejectionMessage, Converter={StaticResource NullToVis}}" />

                    <TextBlock Text="{Binding Loc[label_quantity], Mode=OneWay}" Style="{StaticResource CaptionText}" Margin="0,0,0,3" />
                    <TextBox Text="{Binding Slot.Count, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,8"
                             Background="{StaticResource BgElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />

                    <TextBlock Text="{Binding Loc[label_prefix_id], Mode=OneWay}" Style="{StaticResource CaptionText}" Margin="0,0,0,3" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <!-- Mismo arreglo real que "Índice" de arriba (T-17) - PrefixId tambien
                             ejecuta una accion inmediata (SetPrefix) en cada cambio. -->
                        <TextBox Text="{Binding Slot.PrefixId}" Width="50" Padding="6,4" KeyDown="OnCommitTextOnEnter"
                                 Background="{StaticResource BgElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                        <!-- Pregunta a Opus sobre el diseño (2-sep-2026, quinta pasada): el
                             Background="Transparent" puesto a mano aqui era letra muerta - la
                             plantilla real de Button (Theme.xaml) ignora esa propiedad, solo
                             reacciona a Tag. ★ = accion principal (Accent); Quitar = deshacer
                             (Ghost, ya sustituye ese Background/Foreground a mano). -->
                        <Button Content="★" Command="{Binding ApplyBestPrefixCommand}" ToolTip="{Binding Loc[tt_apply_best_prefix], Mode=OneWay}"
                                Tag="Accent" Padding="6,2" Margin="6,0,0,0" FontSize="12"
                                Visibility="{Binding Slot.HasBestPrefixSuggestion, Converter={StaticResource BoolToVis}}" />
                        <Button Content="{Binding Loc[action_remove], Mode=OneWay}" Command="{Binding ClearPrefixCommand}" ToolTip="{Binding Loc[tt_remove_current_prefix], Mode=OneWay}"
                                Tag="Ghost" Padding="6,2" Margin="6,0,0,0" FontSize="11" />
                    </StackPanel>
                    <TextBlock Text="{Binding Slot.PrefixDisplay}" Style="{StaticResource CaptionText}" Margin="0,0,0,6"
                               Visibility="{Binding Slot.PrefixDisplay, Converter={StaticResource EmptyToCollapsed}}" />

                    <TextBlock Text="{Binding CategoriesLabel}" Style="{StaticResource CaptionText}" Foreground="{StaticResource AccentBrush}"
                               Margin="0,4,0,10" Visibility="{Binding CanHavePrefix, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- Selector de prefijo real de 3 niveles (equivalente exacto de los botones
                     btMeta/btGroups/btPrefix reales de app.TabEdit, ya filtrados por lo que es
                     legal de verdad para este objeto - ver PrefixGroupCatalog/PrefixRulesCatalog). -->
                <StackPanel Visibility="{Binding CanHavePrefix, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Metas}" Margin="0,0,0,6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PrefixMetaButtonViewModel}">
                                <Button Content="{Binding Label}" Style="{StaticResource PrefixMetaButton}"
                                        Command="{Binding DataContext.ItemEdit.SelectMetaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Groups}" Margin="0,0,0,6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PrefixGroupButtonViewModel}">
                                <Button Content="{Binding Label}" Style="{StaticResource PrefixGroupButton}"
                                        Command="{Binding DataContext.ItemEdit.SelectGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Prefixes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PrefixCatalogEntryViewModel}">
                                    <!-- Auditoria de Opus, D-6: antes una lista de 20 nombres
                                         opacos - el efecto real ya se sabe calcular
                                         (PrefixEffectCatalog), solo faltaba mostrarlo aqui. -->
                                    <Button Content="{Binding DisplayName}" ToolTip="{Binding EffectDescription}"
                                            Command="{Binding DataContext.ItemEdit.ApplyPrefixCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" Padding="7,4" Margin="0,0,5,5" FontSize="11"
                                            Background="{StaticResource BgElevatedBrush}" BorderThickness="0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCalamity}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource CalamityBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AccentMutedBrush}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </DockPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- Nodo del arbol de categorias de la Libreria (recursivo - se referencia a si mismo
             por StaticResource, patron real de WPF para arboles sin usar TreeView). Un clic
             selecciona/deselecciona la carpeta como filtro Y despliega/pliega sus subcarpetas
             a la vez (LibraryViewModel.SelectCategoryCommand). -->
        <!-- Auditoria de Opus, Bloque 6 (T-18): antes 3 copias identicas de esta plantilla
             (Libreria/Investigacion/Buffs), solo distintas en A QUE SelectCategoryCommand
             apuntaba cada boton - cada nodo lleva ahora su propio comando real
             (CategoryNodeViewModel.SelectCommand, asignado una vez por cada ViewModel dueño
             justo tras construir su arbol), asi que una UNICA plantilla real sirve a los 3
             arboles (Libreria, Investigacion y Buffs, cada uno con su propia instancia de
             arbol e igual de correcto). -->
        <DataTemplate x:Key="CategoryNodeTemplate" DataType="{x:Type vm:CategoryNodeViewModel}">
            <StackPanel>
                <!-- Auditoria de redimensionado, R-06/H-06: HorizontalAlignment="Stretch" para que
                     el Button ocupe todo el ancho real disponible de la columna (herencia hasta
                     el DockPanel de dentro, ver mas abajo) - sin esto el DockPanel interior mide
                     su propio ancho natural y el TextBlock nunca sabe cuanto sitio tiene de
                     verdad. -->
                <Button Command="{Binding SelectCommand}"
                        CommandParameter="{Binding}" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"
                        Padding="4,3" Margin="0,0,0,1"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource BgHoverBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentMutedBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <!-- Auditoria de redimensionado, R-06/H-06: DockPanel en vez de StackPanel
                         Horizontal. El MaxWidth="165" de abajo (arreglo real de 2-sep-2026, "hay
                         nombres cortados") solo funcionaba para el PRIMER nivel del arbol - cada
                         nivel de profundidad añade su propio Margin="16,0,0,0" (ver el
                         ItemsControl recursivo mas abajo), asi que a partir del 2º nivel 165 ya
                         no cabia en el hueco real (columna fija de 210px menos sangria menos
                         icono) y el nombre se recortaba, hasta el 100% en el 3er nivel. Un
                         DockPanel SI da al ultimo hijo el ancho restante REAL (a diferencia de un
                         StackPanel horizontal, que mide con infinito), asi que TextWrapping
                         funciona solo, a cualquier profundidad y cualquier ancho de columna - sin
                         ninguna constante que mantener. -->
                    <DockPanel>
                        <Image DockPanel.Dock="Left" Source="{Binding IconPath}" Width="16" Height="16" Margin="0,0,6,0" Stretch="Uniform"
                               VerticalAlignment="Center"
                               Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                        <!-- Sin sufijo de recuento aparte (pedido explicito 2-sep-2026, "calca
                             exactamente"): los nombres reales YA llevan su propio "(N)" cuando
                             el propio Terrasavr lo pone (carpetas calculadas por predicado,
                             ej. "Melee damage (316)") - añadir otro aqui duplicaria el numero.
                             Las carpetas con lista literal de ids (ej. "Copper & Tin") tampoco
                             llevan recuento en el Terrasavr real, asi que no se inventa uno. -->
                        <TextBlock Text="{Binding Name}" FontSize="11.5" VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </DockPanel>
                </Button>
                <ItemsControl ItemsSource="{Binding Children}" Margin="16,0,0,0"
                              ItemTemplate="{DynamicResource CategoryNodeTemplate}"
                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DataTemplate>

        <!-- Tarjeta compacta de slot (todos los contenedores reales) - pregunta a Opus sobre
             el diseño 2-sep-2026. Reutiliza los MISMOS handlers de drag&drop que la tarjeta
             rica (leen sender.DataContext, no dependen de la forma de la tarjeta) y el mismo
             ItemSlotCommand/triggers reales (equipado en verde, Calamity en rojo, seleccionado
             con el glow de acento). Sin Width/Height explicitos - los da SlotGridPanel al
             hacer Arrange. -->
        <DataTemplate x:Key="SlotCompactTemplate" DataType="{x:Type vm:ItemSlotViewModel}">
            <!-- H5-14 (quinta auditoria de Opus): "ningun slot se puede alcanzar con tabulador
                 ni flechas - un Border no es enfocable en WPF". Focusable real (el
                 FocusVisualStyle del tema, T-H/F2, lo pinta gratis en cuanto lo recibe) +
                 KeyDown propio (Supr vacia, Intro abre "Elegir...", F alterna favorito, Ctrl+C/
                 Ctrl+V copian/pegan el objeto entero - ver OnItemSlotKeyDown). -->
            <Border AllowDrop="True" Focusable="True" ToolTipService.IsEnabled="{Binding ShowTooltip}"
                    PreviewMouseLeftButtonDown="OnItemSlotMouseDown" MouseMove="OnItemSlotMouseMove"
                    DragOver="OnItemSlotDragOver" Drop="OnItemSlotDrop" KeyDown="OnItemSlotKeyDown">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding ChooseFromLibraryCommand}" />
                </Border.InputBindings>
                <Border.ToolTip>
                    <ToolTip DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <StackPanel MaxWidth="240">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" TextWrapping="Wrap"
                                       Foreground="{Binding RarityBrush, TargetNullValue={StaticResource TextPrimaryBrush}}"
                                       Visibility="{Binding IsNotEmpty, Converter={StaticResource BoolToVis}}" />
                            <!-- Auditoria de Opus, E-3 -->
                            <TextBlock Text="{Binding SlotRoleLabel}" Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource AccentBrush}"
                                       Visibility="{Binding SlotRoleLabel, Converter={StaticResource NullToVis}}" />
                            <TextBlock Style="{StaticResource CaptionText}"
                                       Visibility="{Binding PrefixDisplay, Converter={StaticResource EmptyToCollapsed}}">
                                <Run Text="{Binding Loc[label_prefix], Mode=OneWay}" />
                                <Run Text="{Binding PrefixDisplay, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock Text="{Binding StatsTooltip}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                       Visibility="{Binding StatsTooltip, Converter={StaticResource NullToVis}}" />
                            <!-- 6º/7º hueco de accesorio real (consulta a Opus, sexta pasada:
                                 "la etiqueta de color sola es un codigo que el usuario tiene
                                 que aprender; el tooltip lo resuelve gratis") - se ve tambien
                                 con el slot vacio, ver ShowTooltip. -->
                            <TextBlock Text="{Binding Loc[slot_extra_expert], Mode=OneWay}" Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource PinkBrush}" TextWrapping="Wrap"
                                       Visibility="{Binding IsExpertAccessorySlot, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding Loc[slot_extra_master], Mode=OneWay}" Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource MasterGoldBrush}" TextWrapping="Wrap"
                                       Visibility="{Binding IsMasterAccessorySlot, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </ToolTip>
                </Border.ToolTip>
                <!-- El menu contextual TAMPOCO hereda el DataContext solo (es un Popup fuera del
                     arbol visual, igual que el ToolTip de arriba) - mismo remedio real. -->
                <!-- Pregunta a Opus sobre el diseño (2-sep-2026, quinta pasada: "el menú de
                     clic derecho... sale un recuadro rectangular super pequeño que no sirve de
                     nada"). Antes "Vaciar slot" desaparecia por completo si el slot ya estaba
                     vacio (Visibility) - un slot vacio con un unico item real ("Aplicar mejor
                     prefijo", tambien oculto ahi) podia acabar con el menu con 0 filas
                     visibles. IsEnabled en vez de Visibility: la fila SIEMPRE esta, solo se
                     apaga cuando no aplica - comunica el porque en vez de cambiar de forma. -->
                <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="{Binding Loc[action_choose_item], Mode=OneWay}" Command="{Binding ChooseFromLibraryCommand}" />
                        <MenuItem Header="{Binding Loc[action_apply_best_prefix], Mode=OneWay}" Command="{Binding ApplyBestPrefixCommand}"
                                  Visibility="{Binding HasBestPrefixSuggestion, Converter={StaticResource BoolToVis}}" />
                        <!-- H5-06 (quinta auditoria de Opus): el dato ya viajaba de punta a
                             punta (PlrBodySerializer) sin ningun camino para tocarlo desde la
                             App - IsCheckable refleja el estado real, IsEnabled=IsNotEmpty
                             porque un slot vacio no tiene nada que favoritar. -->
                        <MenuItem Header="{Binding Loc[label_favorite], Mode=OneWay}" Command="{Binding ToggleFavoriteCommand}"
                                  IsCheckable="True" IsChecked="{Binding IsFavorited, Mode=OneWay}"
                                  IsEnabled="{Binding IsNotEmpty}" />
                        <MenuItem Header="{Binding Loc[action_empty_slot], Mode=OneWay}" Command="{Binding ClearCommand}" IsEnabled="{Binding IsNotEmpty}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ItemSlotCardCompact}">
                        <Style.Triggers>
                            <!-- El fondo de "hueco vacio" ya lo pone el estilo BASE
                                 (ItemSlotCardCompact en Theme.xaml, pregunta a Opus sobre el
                                 diseño 2-sep-2026 - segunda consulta). Antes había aquí
                                 un DataTrigger de Opacity 0.35 que lavaba ese color contra el
                                 fondo del panel (los triggers del estilo derivado se evalúan
                                 DESPUÉS que los del base) - quitado a propósito, la opacidad ya
                                 no debe tocar el fondo del slot vacío. -->
                            <!-- Auditoria de Opus (octava pasada, T-4/E-1) - BUG REAL encontrado
                                 y arreglado: aqui vivian TAMBIEN los triggers de "es de
                                 Calamity" (borde rojo) y "esta equipado" (borde verde), y en
                                 WPF el ULTIMO trigger activo declarado gana - un objeto de
                                 Calamity equipado (el caso real mas comun, EquipmentGroupViewModel
                                 construye SIEMPRE isEquipped:true) se pintaba SIEMPRE verde,
                                 nunca rojo. Se perdia la señal central "esto es de Calamity" en
                                 la propia pantalla de Equipamiento. Arreglo real (no un parche
                                 de orden): el borde pasa a significar UNA sola cosa
                                 (seleccionado, unico trigger que queda aqui) - "equipado" se
                                 mueve al FONDO (mancha verde suave, ver el Border de relleno de
                                 mas abajo) y "Calamity" a un punto real en la esquina (ver el
                                 Ellipse de mas abajo) - los 3 estados se leen SIEMPRE a la vez,
                                 ninguno tapa a otro. -->
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                                <Setter Property="Effect" Value="{StaticResource AccentGlow}" />
                            </DataTrigger>
                            <!-- H5-05 (quinta auditoria de Opus): "¿Dónde lo tengo?" - mismo
                                 patron real ya validado por X-c para los NPCs del mapa (resaltar
                                 los que coinciden en vez de ocultar los que no, opacidad real,
                                 nunca Visibility). Canal propio (Opacity del Border entero, no
                                 compite con seleccionado/equipado/Calamity - mismo criterio real
                                 de T-4/E-1 de arriba). -->
                            <DataTrigger Binding="{Binding IsSearchMatch}" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <!-- Canal real de "equipado" (antes competia por el borde con Calamity/
                         seleccionado, ver el comentario de arriba) - mancha de fondo suave,
                         nunca tapa nada, se lee a la vez que el resto. -->
                    <Border Background="{StaticResource EquippedGreenBrush}" Opacity="0.16" CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsEquipped}" Value="True" />
                                            <Condition Binding="{Binding IsEmpty}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <!-- Auditoria de Opus, Bloque 3 (T-14): "el usuario no tiene ninguna
                         confirmacion visual de que su edicion se aplico" - flash real de un
                         instante, IsHitTestVisible=False (nunca roba el clic/arrastre real del
                         slot) y en su propio canal independiente (Opacity de este Border
                         suyo, no comparte trigger con seleccionado/equipado/Calamity - mismo
                         criterio anti-conflicto del comentario de arriba, T-4/E-1). Disparado
                         SOLO en una edicion real de usuario, ver ItemSlotViewModel.JustEdited/
                         MainViewModel.HookSlotEditing. -->
                    <Border Background="{StaticResource AccentBrush}" CornerRadius="4" Opacity="0" IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding JustEdited}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="0.45" Duration="0:0:0.22" AutoReverse="True" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <!-- Icono fantasma real (extraido del propio juego, ver
                         SlotGhostIconResolver.cs/scripts/extraer-iconos-fantasma-slot.js) -
                         solo visible con el slot vacio, igual que en Terraria real
                         (Color.White*0.35f alli; aqui retintado a TextSecondaryBrush en el
                         propio PNG, ver el script de extraccion). -->
                    <Image Source="{Binding GhostIconPath}" Stretch="Uniform" Margin="6" Opacity="0.35"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                    <Image Source="{Binding IconPath}" Stretch="Uniform" Margin="4"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                    <!-- Canal real de "es de Calamity" - punto en la esquina, siempre visible,
                         nunca tapado por el borde de seleccion ni por la mancha de equipado. -->
                    <Ellipse Width="8" Height="8" Fill="{StaticResource CalamityBrush}"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                             Visibility="{Binding IsCalamity, Converter={StaticResource BoolToVis}}"
                             ToolTip="{Binding Loc[label_calamity_item], Mode=OneWay}" />
                    <TextBlock Text="{Binding Count}" FontSize="9.5" Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,1"
                               Visibility="{Binding ShowCount, Converter={StaticResource BoolToVis}}">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" Direction="0" ShadowDepth="0" BlurRadius="3" Opacity="0.9" />
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="&#9733;" FontSize="9" Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,0,0,0"
                               Visibility="{Binding HasBestPrefixSuggestion, Converter={StaticResource BoolToVis}}" />
                    <!-- H5-06 (quinta auditoria de Opus): "Favorito" se guardaba/leia de punta
                         a punta pero no se veia en ningun sitio - esquina inferior izquierda,
                         el UNICO canal todavia libre (superior-derecha=Calamity, inferior-
                         derecha=Cantidad, superior-izquierda=sugerencia de prefijo, borde=
                         seleccionado, fondo=equipado - mismo criterio anti-conflicto de T-4/E-1,
                         cada señal en su propio sitio, ninguna tapa a otra). -->
                    <TextBlock Text="&#9733;" FontSize="9" Foreground="{StaticResource MasterGoldBrush}"
                               HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="1,0,0,1"
                               ToolTip="{Binding Loc[label_favorite], Mode=OneWay}"
                               Visibility="{Binding IsFavorited, Converter={StaticResource BoolToVis}}" />
                    <!-- 6º/7º hueco de accesorio real (consulta a Opus, sexta pasada): una
                         franja vertical en el borde interior izquierdo en vez del contorno (el
                         contorno ya carga 3 significados mutuamente excluyentes - Calamity/
                         Equipado/Seleccionado - y esto es identidad PERMANENTE del hueco, debe
                         leerse a la vez que esos tres, no competir con ellos). Rosa para el 6º
                         (Experto, Corazón de Demonio), oro para el 7º (Modo Maestro) - paleta
                         propia de Terrakeep, no el arcoíris/pulso real del juego (ver el
                         comentario de EquipmentGroupViewModel para el porque). -->
                    <Rectangle Width="3" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="2"
                               Fill="{StaticResource PinkBrush}"
                               Visibility="{Binding IsExpertAccessorySlot, Converter={StaticResource BoolToVis}}" />
                    <Rectangle Width="3" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="2"
                               Fill="{StaticResource MasterGoldBrush}"
                               Visibility="{Binding IsMasterAccessorySlot, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Rejilla compacta de UN contenedor entero - pregunta a Opus sobre el diseño
             2-sep-2026, unificada tras el feedback del usuario ("equipamiento no tiene el mismo
             formato que inventario y el resto de las 9 pestañas"): usada ahora por los 9
             contenedores reales (Equipamiento/Inventario/Almacenes/Monturas/Monedas), no solo
             los de >10 slots. SlotGridPanel (TerrasavrNative.App/Controls) calcula un tamaño de
             celda real entre 44 y 96px que crece/encoge con la ventana; si no cabria ni a 44px,
             aparece scroll (nunca se sacrifica la legibilidad). Columns viene de
             ContainerViewModel.Columns (10 por defecto, 5 para los contenedores de Equipamiento
             - ver EquipmentGroupViewModel.AddSlotSet) para que cada uno mantenga su forma real
             en vez de una unica fila larga. AvailableHeight se enlaza al ActualHeight del propio
             ScrollViewer via RelativeSource AncestorType (recorrido real del arbol visual - un
             ElementName aqui seria fragil, ver SlotGridPanel.cs). -->
        <DataTemplate x:Key="ContainerCompactTemplate" DataType="{x:Type vm:ContainerViewModel}">
            <DockPanel>
                <!-- H4-05 (cuarta auditoria de Opus, Fable): "Vaciar contenedor" no tenia
                     confirmacion NI vuelta atras - banner temporal real (ContainerViewModel.
                     CanUndoClear/UndoClearCommand), visible unos segundos tras vaciar. Editado
                     UNA sola vez aqui (plantilla compartida por los 4 contenedores reales) en
                     vez de en cada cabecera copiada - no repite la duplicacion que H4-10 ya
                     señala en esas 4 cabeceras. -->
                <Border DockPanel.Dock="Top" Background="{StaticResource BgElevatedBrush}" CornerRadius="6" Padding="8,5" Margin="0,0,0,6"
                        Visibility="{Binding CanUndoClear, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{Binding Loc[action_undo], Mode=OneWay}" Command="{Binding UndoClearCommand}"
                                Tag="Accent" Padding="8,3" FontSize="10.5" />
                        <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource LocFormat}">
                                    <Binding Path="Loc[status_cleared_items]" Mode="OneWay" />
                                    <Binding Path="LastClearedCount" Mode="OneWay" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DockPanel>
                </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Slots}" ItemTemplate="{StaticResource SlotCompactTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- ReferenceWidth (pregunta a Opus sobre el diseño, quinta pasada -
                                 fusion de Equipamiento con laterales): sin ancestro
                                 SlotRowHost real (el caso de siempre, Inventario/Almacenes/
                                 Equipamiento en solitario) este binding no encuentra nada y
                                 ReferenceWidth se queda en su default 0 = desactivado,
                                 comportamiento identico a como estaba. Solo tiene efecto real
                                 dentro de la fila fusionada de Equipamiento. -->
            <controls:SlotGridPanel Columns="{Binding Columns}" MinCell="{Binding MinCell}" MaxCell="{Binding MaxCell}" Gap="4"
                                                     ReferenceColumns="10"
                                                     ReferenceWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=controls:SlotRowHost}}"
                                                     AvailableHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
            </DockPanel>
        </DataTemplate>

        <!-- Un objeto/arma/accesorio recomendado dentro de una build, ya con icono real -->
        <DataTemplate DataType="{x:Type vm:BuildItemRowViewModel}">
            <Grid Margin="0,0,6,6">
                <Border Background="{StaticResource BgElevatedBrush}" CornerRadius="5" Padding="8,5"
                        ToolTip="{Binding StatsTooltip}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderThickness" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCalamity}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource CalamityBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding IconPath}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,7,0"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                        <StackPanel MaxWidth="167">
                            <!-- Bd-e (segunda auditoria de Opus, Fable): "columnas irregulares" -
                                 con la columna ahora de ancho fijo (ver BuildClassTemplate), el
                                 texto necesita poder partirse en dos lineas en vez de desbordar
                                 el ancho de la tarjeta con un nombre largo.
                                 Auditoria de redimensionado, R-03/H-03: el TextWrapping de arriba
                                 NUNCA actuaba de verdad - un StackPanel Horizontal (padre, linea
                                 566) mide a sus hijos con ancho INFINITO, asi que el TextBlock
                                 pedia su ancho natural completo y la tarjeta (BuildClassTemplate,
                                 Width=220) se limitaba a recortar la diferencia en silencio.
                                 MISMO bug exacto que CategoryNodeTemplate ya documenta mas abajo
                                 (buscar "TextWrapping no bastaba solo"), sin aplicar aqui hasta
                                 ahora. 167 = 220 (tarjeta) - 6 (Margin de la fila, linea 552) - 16
                                 (Padding del Border, 553) - 24 (icono, 567) - 7 (su margen) -
                                 medido exacto contra el recorte real, ver
                                 ESPEC-auditoria-redimensionado.md#4.3. -->
                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding PrefixText}" Style="{StaticResource CaptionText}"
                                       Visibility="{Binding PrefixText, Converter={StaticResource NullToVis}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- Bd-d (segunda auditoria de Opus, Fable): "marcar lo que ya se posee" - misma
                     mancha de color verde real que ya usa "equipado" en Objetos
                     (EquippedGreenBrush), aqui como insignia en la esquina en vez de fondo
                     entero (el fondo ya lo usa el borde rojo de Calamity). -->
                <Border Width="14" Height="14" CornerRadius="7" Background="{StaticResource EquippedGreenBrush}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0"
                        Visibility="{Binding IsOwned, Converter={StaticResource BoolToVis}}"
                        ToolTip="{Binding Loc[tt_already_have_item], Mode=OneWay}">
                    <TextBlock Text="✓" FontSize="9" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Una clase dentro de una etapa (melee/ranged/mage/summoner/rogue) -->
        <DataTemplate x:Key="BuildClassTemplate" DataType="{x:Type vm:BuildClassGearViewModel}">
            <!-- Bd-e (segunda auditoria de Opus, Fable): "columnas irregulares" - antes solo
                 MinWidth (el ancho real crecia con el nombre mas largo de CADA clase, asi que
                 al envolver a una segunda fila las columnas no quedaban alineadas entre si).
                 Ancho fijo aqui + WrapPanel.ItemWidth a juego (ver el ItemsControl de abajo) -
                 mismo hueco que antes el Margin de 24, ahora repartido por el propio WrapPanel. -->
            <StackPanel Margin="0,0,0,16" Width="220" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                <DockPanel Margin="0,0,0,6">
                    <!-- Bug real encontrado 2-sep-2026 ("el boton apenas se diferencia con el
                         fondo"): Background/Foreground puestos a mano aqui NO HACEN NADA - la
                         plantilla real de Button (Theme.xaml) ignora la propiedad Background
                         del control (usa un SolidColorBrush con nombre fijo) y solo reacciona
                         a Tag="Accent"/"Teal"/"Pink"/"Orange", igual que el resto de botones
                         de color solido de la app (Cargar/Guardar/...). -->
                    <Button DockPanel.Dock="Right" Content="{Binding Loc[action_auto_equip], Mode=OneWay}" FontSize="11" Padding="7,2"
                            Tag="Accent"
                            Command="{Binding DataContext.AutoEquipCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding Source}"
                            IsEnabled="{Binding DataContext.IsCharacterLoaded, RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="{Binding Loc[tt_auto_equip], Mode=OneWay}" />
                    <TextBlock Text="{Binding ClassName}" Style="{StaticResource SectionText}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="{Binding Loc[label_armor], Mode=OneWay}" Style="{StaticResource CaptionText}" Margin="0,4,0,2" />
                <ItemsControl ItemsSource="{Binding Armor}" />
                <TextBlock Text="{Binding Loc[label_weapons], Mode=OneWay}" Style="{StaticResource CaptionText}" Margin="0,6,0,2" />
                <ItemsControl ItemsSource="{Binding Weapons}" />
                <TextBlock Text="{Binding Loc[label_accessories], Mode=OneWay}" Style="{StaticResource CaptionText}" Margin="0,6,0,2" />
                <ItemsControl ItemsSource="{Binding Accessories}" />
            </StackPanel>
        </DataTemplate>

        <!-- Una etapa completa (Pre-Hardmode/Hardmode temprano/Endgame) -->
        <DataTemplate DataType="{x:Type vm:BuildStageViewModel}">
            <StackPanel Margin="0,0,0,28" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Label}" Style="{StaticResource TitleText}" Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding Classes}" ItemTemplate="{StaticResource BuildClassTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel ItemWidth="248" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!-- Una entrada de "Novedades" - H5-09: margen derecho real (antes 0), para que el hueco
             entre columnas del UniformGrid (DetailCardColumns=2 en Amplio) no las deje pegadas. -->
        <DataTemplate DataType="{x:Type vm:WhatsNewEntryViewModel}">
            <Border Background="{StaticResource BgSecondaryBrush}" CornerRadius="8" Margin="0,0,10,14" Padding="16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Version, Mode=OneWay}" Style="{StaticResource TitleText}" />
                        <TextBlock Text="{Binding DisplayDate, Mode=OneWay}" Style="{StaticResource CaptionText}"
                                   Margin="10,0,0,0" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TextBlock Text="{Binding DisplayNote, Mode=OneWay}" Style="{StaticResource CaptionText}"
                               Margin="0,4,0,8" TextWrapping="Wrap"
                               Visibility="{Binding DisplayNote, Mode=OneWay, Converter={StaticResource EmptyToCollapsed}}" />
                    <ItemsControl ItemsSource="{Binding Changes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WhatsNewChangeViewModel}">
                                <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,2">
                                    <Run Text="- " Foreground="{StaticResource AccentBrush}" />
                                    <Run Text="{Binding Text, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Pedido explicito del usuario (2-sep-2026): "bugfixes" ya venia en el
                         propio JSON pero System.Text.Json lo ignoraba en silencio - ahora se
                         muestra igual que Changes, con su propia cabecera. -->
                    <TextBlock Text="{Binding Loc[label_fixes], Mode=OneWay}" Style="{StaticResource SectionText}" Margin="0,10,0,4"
                               Visibility="{Binding Bugfixes.Count, Converter={StaticResource CountToVis}}" />
                    <ItemsControl ItemsSource="{Binding Bugfixes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WhatsNewChangeViewModel}">
                                <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,2">
                                    <Run Text="- " Foreground="{StaticResource AccentBrush}" />
                                    <Run Text="{Binding Text, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding Loc[label_new_items], Mode=OneWay}" Style="{StaticResource SectionText}" Margin="0,10,0,4"
                               Visibility="{Binding Items.Count, Converter={StaticResource CountToVis}}" />
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <!-- N-d (segunda auditoria de Opus, Fable): "toda la app enseña
                                 sprites; aqui no, y el resolvedor de iconos ya esta a mano". -->
                            <DataTemplate DataType="{x:Type vm:WhatsNewItemViewModel}">
                                <Border Background="{StaticResource BgElevatedBrush}" CornerRadius="4" Margin="0,0,6,6" Padding="7,3">
                                    <!-- C-17 (informe de pulido final, cierra la otra mitad de N1):
                                         "como en calamity mod y tmodloader" - misma plantilla real
                                         que la tarjeta de la Libreria (StatsTooltip resuelto con la
                                         MISMA llamada exacta, ItemStatsFormatter.Format), sin las
                                         lineas de clic/doble clic (aqui no aplican, esto no coloca
                                         nada en ningun slot). Sin StatsTooltip, WPF no muestra
                                         ningun ToolTip (valor null) - ni sprite ni nombre repetido. -->
                                    <Border.ToolTip>
                                        <ToolTip DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <StackPanel MaxWidth="240">
                                                <TextBlock Text="{Binding DisplayName, Mode=OneWay}" FontWeight="Bold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding StatsTooltip}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                                           Visibility="{Binding StatsTooltip, Converter={StaticResource NullToVis}}" />
                                            </StackPanel>
                                        </ToolTip>
                                    </Border.ToolTip>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding IconPath}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,5,0"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                               Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                                        <TextBlock Text="{Binding DisplayName, Mode=OneWay}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Changelog del propio EDITOR (Terrakeep, pestaña "Acerca de") - distinto de
             WhatsNewEntry, que es el changelog del juego/Calamity. H5-09: mismo margen derecho
             real que WhatsNewEntryViewModel, mismo motivo (UniformGrid de 2 columnas). -->
        <DataTemplate DataType="{x:Type vm:ChangelogEntryViewModel}">
            <Border Background="{StaticResource BgSecondaryBrush}" CornerRadius="8" Margin="0,0,10,14" Padding="16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Version, Mode=OneWay}" Style="{StaticResource TitleText}" FontSize="18" />
                        <TextBlock Text="{Binding Date, Mode=OneWay}" Style="{StaticResource CaptionText}"
                                   Margin="10,0,0,0" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TextBlock Text="{Binding Summary, Mode=OneWay}" Style="{StaticResource CaptionText}"
                               Margin="0,4,0,8" TextWrapping="Wrap" />

                    <TextBlock Text="{Binding Loc[label_added], Mode=OneWay}" Style="{StaticResource SectionText}" FontSize="12" Margin="0,4,0,2"
                               Visibility="{Binding Added.Count, Converter={StaticResource CountToVis}}" />
                    <ItemsControl ItemsSource="{Binding Added}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,2">
                                    <Run Text="+ " Foreground="{StaticResource TealBrush}" />
                                    <Run Text="{Binding Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding Loc[label_fixed], Mode=OneWay}" Style="{StaticResource SectionText}" FontSize="12" Margin="0,8,0,2"
                               Visibility="{Binding Fixed.Count, Converter={StaticResource CountToVis}}" />
                    <ItemsControl ItemsSource="{Binding Fixed}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,2">
                                    <Run Text="- " Foreground="{StaticResource PinkBrush}" />
                                    <Run Text="{Binding Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Rework de Buffs (pregunta a Opus sobre el diseño 2-sep-2026, cuarta pasada: "la
             misma rejilla cantidad de slots y contorno y todo que inventario"). Tarjeta
             compacta de un slot de buff - calco de SlotCompactTemplate, sin Count/estrella de
             prefijo (un buff no tiene cantidad ni prefijo). -->
        <DataTemplate x:Key="BuffSlotCompactTemplate" DataType="{x:Type vm:BuffSlotViewModel}">
            <!-- H4-04 (cuarta auditoria de Opus, Fable): faltaba el DragOver real que su gemelo
                 de objetos ya tiene (OnItemSlotDragOver) - arrastrar un buff YA colocado en otro
                 slot se rechazaba en silencio total al soltar, sin ningun aviso mientras se
                 arrastraba. -->
            <!-- H5-14 (quinta auditoria de Opus): mismo mecanismo real que SlotCompactTemplate -
                 Focusable + KeyDown (Supr/Intro/Ctrl+C/Ctrl+V - sin "F" de favorito, un buff no
                 tiene ese concepto). -->
            <Border AllowDrop="True" Focusable="True" ToolTipService.IsEnabled="{Binding IsNotEmpty}"
                    PreviewMouseLeftButtonDown="OnBuffSlotMouseDown" MouseMove="OnBuffSlotMouseMove"
                    DragOver="OnBuffSlotDragOver" Drop="OnBuffSlotDrop" KeyDown="OnBuffSlotKeyDown">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding ChooseFromLibraryCommand}" />
                </Border.InputBindings>
                <Border.ToolTip>
                    <ToolTip DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <StackPanel MaxWidth="240">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" TextWrapping="Wrap" />
                            <!-- H6-12 (sexta auditoria de Opus): rotulo real "Debuff" en el tooltip,
                                 no solo el punto morado del icono - visible tambien para quien no
                                 recuerde el significado del color. -->
                            <TextBlock Text="{Binding Loc[label_debuff], Mode=OneWay}" Foreground="{StaticResource DebuffBrush}" FontWeight="Bold"
                                       Visibility="{Binding IsDebuff, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                       Visibility="{Binding Description, Converter={StaticResource NullToVis}}" />
                        </StackPanel>
                    </ToolTip>
                </Border.ToolTip>
                <!-- Pregunta a Opus sobre el diseño (2-sep-2026, quinta pasada: "mejor sería
                     que tuviera igual que en las armas añadir buff o quitar buff si lo hay") -
                     mismo par de acciones reales que ya tiene la tarjeta de objetos
                     (ChooseFromLibraryCommand ya existe, lo usa el doble clic de arriba) +
                     IsEnabled en vez de Visibility, mismo criterio que el menu de objetos. -->
                <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="{Binding Loc[action_choose_buff], Mode=OneWay}" Command="{Binding ChooseFromLibraryCommand}" />
                        <MenuItem Header="{Binding Loc[action_empty_slot], Mode=OneWay}" Command="{Binding ClearCommand}" IsEnabled="{Binding IsNotEmpty}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <!-- Auditoria de Opus, Bloque 5 (T-4): BUG REAL encontrado y arreglado - mismo
                     anti-patron ya diagnosticado y arreglado en SlotCompactTemplate (E-1,
                     octava pasada): "es de Calamity" y "esta seleccionado" competian por
                     BorderBrush, y en WPF el ULTIMO trigger activo declarado gana. Un buff de
                     Calamity seleccionado para editarlo (camino real y comun, ver
                     MainViewModel.SelectBuffSlot) perdia el borde rojo justo mientras se estaba
                     editando - se perdia la señal "esto es de Calamity" en el momento en que
                     mas falta hace. Mismo arreglo real: el borde pasa a significar UNA sola
                     cosa (seleccionado), "Calamity" se mueve a un punto real en la esquina
                     (Ellipse de mas abajo) - ambos estados se leen siempre a la vez. -->
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ItemSlotCardCompact}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                                <Setter Property="Effect" Value="{StaticResource AccentGlow}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Image Source="{Binding IconPath}" Stretch="Uniform" Margin="4"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                    <Ellipse Width="8" Height="8" Fill="{StaticResource CalamityBrush}"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                             Visibility="{Binding IsCalamity, Converter={StaticResource BoolToVis}}"
                             ToolTip="{Binding Loc[label_calamity_buff], Mode=OneWay}" />
                    <!-- H6-12 (sexta auditoria de Opus, "no hay forma de distinguir buff de
                         debuff"): esquina OPUESTA al punto de Calamity de arriba (un buff de
                         Calamity puede ser debuff a la vez - los dos puntos deben poder verse
                         juntos sin pisarse). -->
                    <Ellipse Width="8" Height="8" Fill="{StaticResource DebuffBrush}"
                             HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="2,0,0,2"
                             Visibility="{Binding IsDebuff, Converter={StaticResource BoolToVis}}"
                             ToolTip="{Binding Loc[label_debuff], Mode=OneWay}" />
                    <!-- Bu-a (segunda auditoria de Opus, Fable): "T-14 se porto a objetos y no a
                         buffs, aunque los comentarios declaran a los dos paneles como gemelos" -
                         calco literal del flash real de SlotCompactTemplate (T-14), mismo canal
                         independiente (Opacity propio, IsHitTestVisible=False). -->
                    <Border Background="{StaticResource AccentBrush}" CornerRadius="4" Opacity="0" IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding JustEdited}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="0.45" Duration="0:0:0.22" AutoReverse="True" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Rejilla compacta de los 44/22/10 slots de buff reales - calco de
             ContainerCompactTemplate, misma SlotGridPanel/ReferenceColumns=10 (mismo tamaño de
             icono que el resto de rejillas de la app). -->
        <DataTemplate x:Key="BuffContainerCompactTemplate" DataType="{x:Type vm:BuffContainerViewModel}">
            <DockPanel>
                <!-- H4-05/H4-06 (cuarta auditoria de Opus, Fable): mismo banner real de Deshacer
                     ya cerrado en ContainerCompactTemplate, ver ahi el porque. -->
                <Border DockPanel.Dock="Top" Background="{StaticResource BgElevatedBrush}" CornerRadius="6" Padding="8,5" Margin="0,0,0,6"
                        Visibility="{Binding CanUndoClear, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{Binding Loc[action_undo], Mode=OneWay}" Command="{Binding UndoClearCommand}"
                                Tag="Accent" Padding="8,3" FontSize="10.5" />
                        <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource LocFormat}">
                                    <Binding Path="Loc[status_cleared_buffs]" Mode="OneWay" />
                                    <Binding Path="LastClearedCount" Mode="OneWay" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DockPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Slots}" ItemTemplate="{StaticResource BuffSlotCompactTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:SlotGridPanel Columns="{Binding Columns}" MinCell="40" MaxCell="90" Gap="4"
                                                         ReferenceColumns="10"
                                                         AvailableHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </DataTemplate>

        <!-- Panel "Editar buff seleccionado" - calco reducido de ItemEditTemplate. -->
        <DataTemplate x:Key="BuffEditTemplate" DataType="{x:Type vm:BuffEditViewModel}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding Loc[action_edit_buff], Mode=OneWay}" Style="{StaticResource SectionText}" Margin="0,0,0,10" />

                <TextBlock DockPanel.Dock="Top" Text="{Binding NoSelectionMessage}" Style="{StaticResource CaptionText}"
                           TextWrapping="Wrap" Margin="0,0,0,10"
                           Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}" />

                <!-- Auditoria de Opus, Bloque 5 (T-5): mismo criterio que ItemEditTemplate -
                     leyenda real, solo en el hueco de "sin seleccion" (aqui sin "equipado",
                     los buffs no tienen ese estado). -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10"
                            Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}">
                    <TextBlock Text="{Binding Loc[legend_title], Mode=OneWay}" Style="{StaticResource CaptionText}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Ellipse Width="10" Height="10" Fill="{StaticResource CalamityBrush}" Margin="2,0,6,0" />
                        <TextBlock Text="{Binding Loc[legend_calamity_buff], Mode=OneWay}" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="14" Height="14" CornerRadius="3" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Loc[legend_selected_slot], Mode=OneWay}" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="{Binding Loc[action_empty_slot], Mode=OneWay}" Command="{Binding ClearSlotCommand}"
                                ToolTip="{Binding Loc[tt_empty_this_slot], Mode=OneWay}" Tag="Ghost" Padding="6,3" FontSize="10.5" VerticalAlignment="Center" />
                        <Image Source="{Binding Slot.IconPath}" Width="32" Height="32" Stretch="Uniform" Margin="0,0,8,0"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               VerticalAlignment="Center"
                               Visibility="{Binding Slot.IconPath, Converter={StaticResource NullToVis}}" />
                        <TextBlock Text="{Binding Slot.DisplayName}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                   MaxWidth="200" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- Bu-b (segunda auditoria de Opus, Fable): mismo patron real ya usado en
                         ItemEditTemplate - RejectionMessage, sin nada modal. -->
                    <TextBlock Text="{Binding Slot.RejectionMessage}" Style="{StaticResource CaptionText}"
                               Foreground="{StaticResource CalamityBrush}" TextWrapping="Wrap" Margin="0,-4,0,8"
                               Visibility="{Binding Slot.RejectionMessage, Converter={StaticResource NullToVis}}" />

                    <TextBlock Text="{Binding Slot.Description}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                               Margin="0,0,0,10" Visibility="{Binding Slot.Description, Converter={StaticResource NullToVis}}" />

                    <TextBlock Text="{Binding Loc[label_duration_seconds], Mode=OneWay}" Style="{StaticResource CaptionText}" Margin="0,0,0,3" />
                    <TextBox Text="{Binding Slot.DurationSeconds, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,10"
                             Background="{StaticResource BgElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />

                    <!-- 3 botones reales (pregunta a Opus sobre el diseño 2-sep-2026, cuarta
                         pasada): Minima = dato real extraido del buffTime de la pocion base (o
                         la moda real como aproximacion honesta, ver MinTooltip); Media = 2x
                         Minima (unico precedente real de escalera, Pocion de la suerte);
                         Maxima = S.getMaxTime() real del propio Terrasavr. -->
                    <!-- Jerarquia real (pregunta a Opus sobre el diseño, quinta pasada): los 3
                         son valores del MISMO control, no 3 acciones de peso distinto - Maxima
                         (la que el 95% quiere) en Accent, Minima/Media en AccentSoft. -->
                    <UniformGrid Columns="3" Rows="1">
                        <Button Content="{Binding MinLabel}" Command="{Binding ApplyMinCommand}" ToolTip="{Binding MinTooltip}"
                                Tag="AccentSoft" FontSize="10.5" Padding="4,6" Margin="0,0,4,0" />
                        <Button Content="{Binding MediaLabel}" Command="{Binding ApplyMediaCommand}"
                                ToolTip="{Binding Loc[tt_duration_min_2x], Mode=OneWay}"
                                Tag="AccentSoft" FontSize="10.5" Padding="4,6" Margin="0,0,4,0" />
                        <Button Content="{Binding MaxLabel}" Command="{Binding ApplyMaxCommand}"
                                ToolTip="{Binding Loc[tt_duration_max], Mode=OneWay}"
                                Tag="Accent" FontSize="10.5" Padding="4,6" />
                    </UniformGrid>
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <!-- Tarjeta de un objeto del catalogo completo en la Libreria (quinta pasada, pregunta a
             Opus sobre el diseño: "la libreria sigue sin tener las rejillas como en
             inventario"). Sustituye la tarjeta fija 80x86 con caption de nombre - obligatorio
             quitar Width/Height fijos porque SlotGridPanel.ArrangeOverride hace
             Arrange(new Rect(x,y,_cell,_cell)), un tamaño fijo se saldria de una celda pequeña
             y se solaparia con la vecina. El nombre se quita de la tarjeta (vivia recortado en
             silencio sin puntos suspensivos en categorias con muchos resultados) y se compone
             solo en el tooltip, que ya lo hacia - mismo patron ya validado en
             BuffLibraryCardTemplate. Arrastre igual que siempre (OnLibraryCardMouseDown/Move,
             no dependen de la forma de la tarjeta). -->
        <DataTemplate x:Key="LibraryCardTemplate" DataType="{x:Type vm:LibraryItemViewModel}">
            <!-- H5-12 (quinta auditoria de Opus): "un clic en una tarjeta de la Libreria no hace
                 absolutamente nada... la unica via real es arrastrar". MouseLeftButtonUp real
                 (OnLibraryCardClick, MainWindow.xaml.cs) - clic simple coloca en el slot
                 seleccionado en Editar, doble clic al primer hueco libre del Inventario. -->
            <Border Padding="0" CornerRadius="6" Background="{StaticResource BgElevatedBrush}" BorderThickness="1" Cursor="Hand"
                    PreviewMouseLeftButtonDown="OnLibraryCardMouseDown" MouseMove="OnLibraryCardMouseMove" MouseLeftButtonUp="OnLibraryCardClick">
                <Border.ToolTip>
                    <ToolTip DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <StackPanel MaxWidth="240">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" TextWrapping="Wrap"
                                       Foreground="{Binding RarityBrush, TargetNullValue={StaticResource TextPrimaryBrush}}" />
                            <TextBlock Text="{Binding StatsTooltip}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                       Visibility="{Binding StatsTooltip, Converter={StaticResource NullToVis}}" />
                            <!-- H5-12: "si no hay ninguno seleccionado, la tarjeta lo dice al pasar
                                 el raton" - pedido explicito del informe. -->
                            <TextBlock Text="{Binding Loc[tt_library_click_place], Mode=OneWay}"
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,0"
                                       Visibility="{Binding DataContext.ItemEdit.Slot, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVis}}" />
                            <TextBlock Text="{Binding Loc[tt_library_no_slot_selected], Mode=OneWay}"
                                       Style="{StaticResource CaptionText}" Foreground="{StaticResource OrangeBrush}" TextWrapping="Wrap" Margin="0,5,0,0"
                                       Visibility="{Binding DataContext.ItemEdit.Slot, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToCollapsed}}" />
                            <!-- C-11 (informe de pulido final, cierra L4): "arrastrar es el UNICO
                                 gesto que existia hasta H5-12, y no lo anuncia nada" - tercera linea
                                 real, siempre visible (el arrastre funciona haya o no hueco elegido
                                 en Editar), cierra la queja tal como el usuario la vivio. -->
                            <TextBlock Text="{Binding Loc[tt_or_drag_card], Mode=OneWay}"
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </ToolTip>
                </Border.ToolTip>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush0}" />
                        <Style.Triggers>
                            <!-- Auditoria de Opus (octava pasada, L-6) - BUG REAL encontrado y
                                 arreglado: el hover ponia TAMBIEN el borde en acento, declarado
                                 ANTES que el DataTrigger de Calamity - sobre una tarjeta de
                                 Calamity, el borde de hover nunca se veia (gana el rojo,
                                 declarado despues). El hover ya se lee de sobra solo con el
                                 fondo (mismo criterio que BuffLibraryCardTemplate, que nunca
                                 tuvo este bug); el borde queda libre para significar solo
                                 "es de Calamity", visible siempre. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BgHoverBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCalamity}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource CalamityBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Image Source="{Binding IconPath}" Stretch="Uniform" Margin="4"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                    <!-- Auditoria de Opus, T-10: suelo real de legibilidad - 8px era mas pequeño
                         que cualquier otro texto real de la app (el resto usa 9px o mas para
                         palabras reales), aqui subido a 9. -->
                    <Button Content="{Binding Loc[action_place], Mode=OneWay}" Tag="Accent" FontSize="9" Padding="0,1" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                            Command="{Binding DataContext.Library.PlaceInTargetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Visibility="{Binding DataContext.Library.IsPicking, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Tarjeta de un buff del catalogo completo en la Libreria de buffs (Fase 2, pregunta
             a Opus sobre el diseño 2-sep-2026: "resultados en rejilla, misma tarjeta que la de
             arriba") - mismo lenguaje visual que BuffSlotCompactTemplate (icono cuadrado,
             borde rojo si es Calamity), sin estados de vacio/seleccion (una entrada de
             catalogo no tiene ninguno de los dos) y con el boton "Colocar" solo cuando hay un
             slot esperando (BuffLibrary.IsPicking). -->
        <DataTemplate x:Key="BuffLibraryCardTemplate" DataType="{x:Type vm:BuffCatalogEntryViewModel}">
            <!-- C-11 (informe de pulido final, cierra L4): "pasa lo mismo con la pestaña buff" -
                 un clic aqui no hacia NADA, unica via real era arrastrar (igual que H5-12 en su
                 dia para la Libreria de objetos) - mismo gemelo real: MouseLeftButtonUp con clic
                 simple/doble clic (OnBuffLibraryCardClick, MainWindow.xaml.cs). -->
            <Border Padding="0" CornerRadius="6" Background="{StaticResource BgElevatedBrush}" BorderThickness="1" Cursor="Hand"
                    PreviewMouseLeftButtonDown="OnBuffLibraryCardMouseDown" MouseMove="OnBuffLibraryCardMouseMove" MouseLeftButtonUp="OnBuffLibraryCardClick">
                <Border.ToolTip>
                    <ToolTip DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <StackPanel MaxWidth="240">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" TextWrapping="Wrap" />
                            <!-- H6-12 (sexta auditoria de Opus): mismo rotulo real que
                                 BuffSlotCompactTemplate. -->
                            <TextBlock Text="{Binding Loc[label_debuff], Mode=OneWay}" Foreground="{StaticResource DebuffBrush}" FontWeight="Bold"
                                       Visibility="{Binding IsDebuff, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                       Visibility="{Binding Description, Converter={StaticResource NullToVis}}" />
                            <TextBlock Text="{Binding Loc[tt_buff_library_click_place], Mode=OneWay}"
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,0"
                                       Visibility="{Binding DataContext.BuffEdit.Slot, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVis}}" />
                            <TextBlock Text="{Binding Loc[tt_buff_library_no_slot_selected], Mode=OneWay}"
                                       Style="{StaticResource CaptionText}" Foreground="{StaticResource OrangeBrush}" TextWrapping="Wrap" Margin="0,5,0,0"
                                       Visibility="{Binding DataContext.BuffEdit.Slot, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToCollapsed}}" />
                            <TextBlock Text="{Binding Loc[tt_or_drag_card], Mode=OneWay}"
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </ToolTip>
                </Border.ToolTip>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush0}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BgHoverBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCalamity}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource CalamityBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Image Source="{Binding IconPath}" Stretch="Uniform" Margin="4"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                    <!-- H6-12: mismo punto morado que la rejilla de Buffs (BuffSlotCompactTemplate)
                         - el borde ya esta ocupado por "es de Calamity" aqui, asi que "es debuff"
                         necesita su propia señal. Esquina SUPERIOR-izquierda (no inferior): el
                         boton "Colocar" real ocupa todo el borde inferior cuando esta visible. -->
                    <Ellipse Width="8" Height="8" Fill="{StaticResource DebuffBrush}"
                             HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,2,0,0"
                             Visibility="{Binding IsDebuff, Converter={StaticResource BoolToVis}}"
                             ToolTip="{Binding Loc[label_debuff], Mode=OneWay}" />
                    <!-- Auditoria de Opus, T-10: suelo real de legibilidad - 8px era mas pequeño
                         que cualquier otro texto real de la app (el resto usa 9px o mas para
                         palabras reales), aqui subido a 9. -->
                    <Button Content="{Binding Loc[action_place], Mode=OneWay}" Tag="Accent" FontSize="9" Padding="0,1" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                            Command="{Binding DataContext.BuffLibrary.PlaceInTargetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Visibility="{Binding DataContext.BuffLibrary.IsPicking, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Auditoria de Opus, I-1: tarjeta real de un personaje encontrado de un plumazo en el
             lanzador de Inicio - doll de cuerpo completo real (PlayerPreviewRenderer, mismos
             datos que ya guarda el propio .plr), dificultad, insignia de Calamity si tiene
             .tplr al lado, y fecha real de ultima modificacion - un click carga y salta a
             Personaje (MainViewModel, Home.CharacterChosen). -->
        <DataTemplate x:Key="CharacterCardTemplate" DataType="{x:Type vm:CharacterListEntryViewModel}">
            <Border Padding="12" CornerRadius="8" Background="{StaticResource BgElevatedBrush}" BorderThickness="1"
                    Width="240" Margin="0,0,14,14" Cursor="Hand"
                    Effect="{StaticResource CardShadow}"
                    Tag="{Binding DataContext.Home, RelativeSource={RelativeSource AncestorType=Window}}">
                <!-- C-13 (informe de pulido final, cierra H2): mismo "levanta al pasar" real de
                     NavCardButton (Theme.xaml, TranslateTransform Y 0->-3 en 150ms) - a
                     proposito SIN el ColorAnimation del borde a acento que si tiene NavCardButton,
                     porque aqui el borde YA significa "personaje cargado" (IsCurrent, mas abajo) -
                     animarlo tambien al pasar el raton reproduciria el bug real L-6 (color de
                     estado y color de hover peleando por el mismo Setter). -->
                <Border.RenderTransform>
                    <TranslateTransform Y="0" />
                </Border.RenderTransform>
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.Home.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                </Border.InputBindings>
                <!-- I-b (segunda auditoria de Opus, Fable): "Sin ninguna accion secundaria en la
                     tarjeta - faltan las 3 obvias y baratas". Menu contextual real (clic derecho).
                     Un ContextMenu real es un popup APARTE del arbol visual de la ventana -
                     RelativeSource AncestorType=Window (el truco de arriba) no llega hasta aqui
                     dentro, por eso HomeViewModel viaja en el propio Tag del Border (inerte, sitio
                     real donde dejarlo) y PlacementTarget.Tag lo recupera desde el menu. -->
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{Binding Loc[action_open_folder], Mode=OneWay}"
                                  Command="{Binding PlacementTarget.Tag.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="{Binding Loc[action_duplicate_character], Mode=OneWay}"
                                  Command="{Binding PlacementTarget.Tag.DuplicateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="{Binding Loc[action_restore_backup], Mode=OneWay}"
                                  Command="{Binding PlacementTarget.Tag.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  ToolTip="{Binding Loc[tt_restore_last_backup], Mode=OneWay}" />
                        <!-- H5-04 (quinta auditoria de Opus): "un panel 'Historial de guardados'...
                             con fecha, tamaño y un boton por punto - para restaurar cualquiera,
                             no solo el ultimo". Submenu real, poblado bajo demanda al abrirlo
                             (OnBackupHistorySubmenuOpened) - un item "placeholder" es
                             obligatorio para que WPF dibuje la flecha de despliegue y dispare
                             SubmenuOpened; se sustituye entero por la lista real. -->
                        <MenuItem Header="{Binding Loc[action_save_history], Mode=OneWay}" SubmenuOpened="OnBackupHistorySubmenuOpened">
                            <MenuItem Header="{Binding Loc[label_loading_ellipsis], Mode=OneWay}" IsEnabled="False" />
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush0}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BgHoverBrush}" />
                                <Setter Property="Effect" Value="{StaticResource CardShadowHover}" />
                                <!-- Sin Storyboard.TargetName a proposito - MC4011 real ya
                                     encontrado en este mismo proyecto (Theme.xaml, comentario de
                                     NavCardButton): TargetName solo vale dentro de
                                     ControlTemplate.Triggers, este es un Style.Triggers normal
                                     sobre el propio Border. Sin TargetName, el Storyboard anima el
                                     elemento con el propio Style (este Border) - la ruta con tipo
                                     calificado llega hasta el TranslateTransform inline de
                                     RenderTransform sin necesidad de nombrarlo. -->
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-3" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <!-- I-a: "No se distingue que personaje esta cargado - las tarjetas se
                                 ven identicas al volver a Inicio". -->
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="{Binding Preview}" Width="52" Height="72.8" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <DockPanel>
                            <TextBlock Text="✓" DockPanel.Dock="Right" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" Margin="4,0,0,0"
                                       ToolTip="{Binding Loc[tt_current_character], Mode=OneWay}"
                                       Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding Name}" Style="{StaticResource SectionText}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <!-- Auditoria de redimensionado, R-05/H-05: con 3 insignias nuevas
                             (tModLoader/Calamity/Vanilla, 4-sep-2026) mas la de dificultad, la
                             fila entera desbordaba el Width=240 de la tarjeta (linea de arriba) y
                             el StackPanel horizontal recortaba la ultima en silencio - hasta 39 de
                             40px, medido. WrapPanel deja que pase a una segunda linea cuando hace
                             falta, sin perder ninguna. -->
                        <!-- C-12 (auditoria de pulido final): las 4 insignias solo llevaban margen
                             horizontal - a un ancho de tarjeta que fuerza el WrapPanel de arriba
                             (R-05/H-05) a una segunda linea, la fila de abajo quedaba pegada a la
                             de arriba sin ningun hueco vertical. Margen inferior en las 4. -->
                        <WrapPanel Margin="0,4,0,0">
                            <Border Background="{StaticResource BgHoverBrush}" CornerRadius="3" Padding="5,1" Margin="0,0,5,4">
                                <TextBlock Text="{Binding DifficultyLabel}" Style="{StaticResource CaptionText}" FontSize="10" />
                            </Border>

                            <!-- Encargo del usuario 4-sep-2026: hasta hoy solo habia UNA insignia, roja, que decia
                                 "Calamity" y en realidad solo significaba "tiene un .tplr al lado" (=cualquier mod).
                                 Ahora son tres hechos separados, en orden de importancia de izquierda a derecha:
                                 tModLoader (lo principal) -> Calamity (lo especifico, ADEMAS de la anterior, no en su
                                 lugar) -> Vanilla (la ausencia de las dos). Ver ESPEC-sprites-botones-badges.md#C. -->

                            <!-- "Vanilla": la mas callada de las tres a proposito (es la AUSENCIA de mods, no un rasgo
                                 que reclame atencion). Solo contorno, mismo lenguaje visual que los selectores nuevos de
                                 Exploracion - sin inventar ningun color nuevo del tema. -->
                            <Border Background="Transparent" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                    CornerRadius="3" Padding="5,1" Margin="0,0,5,4"
                                    ToolTip="{Binding Loc[tt_no_mods_no_tplr], Mode=OneWay}"
                                    Visibility="{Binding IsVanilla, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Vanilla" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>

                            <!-- "tModLoader": la pareja AccentMuted/AccentHover, que en este tema ya significa "de la
                                 familia del acento pero secundario" (Tag="AccentSoft", PrefixGroupButton). Va ANTES que
                                 la de Calamity porque es el hecho principal, y su ToolTip lleva la lista real de mods
                                 (usedMods del propio .tplr) cuando el fichero la trae. -->
                            <Border Background="{StaticResource AccentMutedBrush}" CornerRadius="3" Padding="5,1" Margin="0,0,5,4"
                                    ToolTip="{Binding UsedModsTooltip, TargetNullValue='Personaje de tModLoader: tiene un archivo .tplr con datos de mods'}"
                                    Visibility="{Binding IsTModLoader, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="tModLoader" FontSize="10" Foreground="{StaticResource AccentHoverBrush}" FontWeight="SemiBold" />
                            </Border>

                            <!-- "Calamity": el rojo de siempre (CalamityBrush), pero ahora solo cuando hay contenido
                                 REAL de Calamity dentro del .tplr, no por el mero hecho de que el .tplr exista. -->
                            <Border Background="{StaticResource CalamityBrush}" CornerRadius="3" Padding="5,1" Margin="0,0,5,4"
                                    ToolTip="{Binding Loc[tt_has_calamity_content], Mode=OneWay}"
                                    Visibility="{Binding IsCalamity, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Calamity" FontSize="10" Foreground="White" FontWeight="SemiBold" />
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding LastModifiedText}" Style="{StaticResource CaptionText}" FontSize="10" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- H5-11 (quinta auditoria de Opus): "el lanzador de mundos desaparece para siempre en
             cuanto cargas uno... para pasar al siguiente hay que volver al dialogo de
             Explorador". Pildora compacta (reemplaza a la antigua WorldCardTemplate, una
             tarjeta grande que solo vivia dentro del estado vacio) para vivir de forma
             PERMANENTE en la barra superior de Exploracion (no solo en el estado vacio) - mismo
             IsCurrent/borde de acento real que ya usa Inicio (I-a) para marcar el personaje
             cargado, y el mismo menu contextual real ("Abrir carpeta", ausente hasta ahora por
             alcance - el informe lo pide explicitamente ahora que la lista es permanente). -->
        <DataTemplate x:Key="WorldPillTemplate" DataType="{x:Type vm:WorldListEntryViewModel}">
            <Border Padding="8,5" CornerRadius="6" Background="{StaticResource BgElevatedBrush}" BorderThickness="1"
                    Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonUp="OnWorldCardClick"
                    Tag="{Binding DataContext.Exploration, RelativeSource={RelativeSource AncestorType=Window}}">
                <Border.ToolTip>
                    <MultiBinding Converter="{StaticResource LocFormat}">
                        <Binding Path="Loc[tt_world_last_modified]" Mode="OneWay" />
                        <Binding Path="LastModifiedText" Mode="OneWay" />
                    </MultiBinding>
                </Border.ToolTip>
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{Binding Loc[action_open_folder], Mode=OneWay}"
                                  Command="{Binding PlacementTarget.Tag.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush0}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BgHoverBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#10003;" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" Margin="0,0,5,0"
                               VerticalAlignment="Center" ToolTip="{Binding Loc[tt_current_world], Mode=OneWay}"
                               Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding Title}" Style="{StaticResource CaptionText}" FontSize="11.5" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="160" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Punto 4 (advisor Opus, "una nueva barra lateral" - ver ESPEC-ui-exploracion.md#14.4
             punto 4): fila de inventario generica, compartida por Cofres/Minerales/Objetos.
             CheckBox (multiseleccion, "Buscar seleccionados") + Button real (RowClickButton -
             NUNCA Border+MouseBinding, ver el arreglo real de "¿Donde lo tengo?" en bitacora.md,
             el mismo gotcha de captura de raton de WPF) que busca SOLO esa fila con un clic. -->
        <DataTemplate x:Key="InventoryRowTemplate" DataType="{x:Type vm:WorldInventoryRowViewModel}">
            <Grid Margin="0,0,0,4" Visibility="{Binding IsMatch, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- C-19 (informe de pulido final, detalle menor): esta plantilla es compartida
                     por Cofres/Minerales/Objetos, pero "Buscar seleccionados" solo existe de
                     verdad en Cofres y Objetos - en Minerales el tick dispara "Marcar en el
                     mapa" (C-04), sin ningun boton "Buscar seleccionados" real ahi. Texto neutro,
                     cierto en las 3 categorias, en vez de citar un boton que en una de ellas no
                     existe. -->
                <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,6,0"
                          ToolTip="{Binding Loc[tt_check_for_bulk_action], Mode=OneWay}" />
                <Button Grid.Column="1" HorizontalContentAlignment="Stretch"
                        Command="{Binding DataContext.Exploration.SearchInventoryRowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}">
                    <!-- La fila de "Cofre de un mod" (la unica con Id negativo, ver
                         WorldInventoryRowViewModel.IsModdedChest) lleva el tooltip que EXPLICA por
                         que no tiene nombre propio - el resto sigue con el generico de siempre.
                         Style con BasedOn en vez de un atributo ToolTip suelto para que las dos
                         opciones sigan siendo {Binding Loc[...]} y cambien de idioma en caliente. -->
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource RowClickButton}">
                            <Setter Property="ToolTip" Value="{Binding Loc[tt_search_on_map], Mode=OneWay}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsModdedChest}" Value="True">
                                    <Setter Property="ToolTip" Value="{Binding Loc[explore_chest_modded_tooltip], Mode=OneWay}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <!-- P-7 (auditoria Opus vs TEdit): "TEdit muestra el id siempre en gris a la
                         derecha - Terrakeep ya permite buscar y filtrar por id pero no enseña
                         ninguno, el usuario no puede saber que numero escribir". DockPanel en vez
                         del StackPanel Horizontal de siempre - mismo motivo real ya documentado en
                         R-06 (CategoryNodeTemplate): un StackPanel Horizontal mide a sus hijos con
                         ancho INFINITO sin importar su propio ancho disponible, asi que el id a la
                         derecha no quedaria garantizado visible con un nombre largo. DockPanel.
                         Dock="Right" reserva su hueco de verdad; el nombre (ultimo hijo, sin Dock)
                         se lleva el resto y SI se recorta con TextTrimming, ahora garantizado. -->
                    <DockPanel LastChildFill="True">
                        <!-- Encargo del usuario 4-sep-2026 ("quiero todos los sprites de todos los objetos del
                             mundo en el buscador de exploracion... un cofre dorado de agua etc") - caja de tamaño
                             FIJO (26x26) con dos capas excluyentes, para que todas las filas alineen su texto en la
                             misma columna aunque los sprites reales midan de 16x16 a 96x64:
                               - Sprite real, si lo hay (TileIconResolver/WallIconResolver/VanillaIconResolver).
                                 StretchDirection="DownOnly" es a proposito: un sprite de 16x16 se pinta a 1:1
                                 (nitido, sin el escalado x1.625 irregular que da un NearestNeighbor a 26px) y solo
                                 los grandes de verdad se encogen para caber.
                               - El cuadradito de color de siempre (paleta real del MAPA, TEdit) como respaldo cuando
                                 no hay sprite: tiles/paredes de mods, ids mas nuevos que el catalogo, NetId de
                                 objeto modeado. Nunca se pierde informacion, solo mejora cuando se puede.
                             Ver ESPEC-sprites-botones-badges.md#A.10. -->
                        <Grid DockPanel.Dock="Left" Width="26" Height="26" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Image Source="{Binding IconPath}" Stretch="Uniform" StretchDirection="DownOnly"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                            <Border Width="14" Height="14" CornerRadius="2"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    BorderBrush="{StaticResource BorderBrush0}" BorderThickness="1"
                                    Visibility="{Binding IconPath, Converter={StaticResource NullToCollapsed}}">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding SwatchColor}" />
                                </Border.Background>
                            </Border>
                        </Grid>
                        <!-- Bug real reportado por el usuario (6-sep-2026, captura de Cofres): "se
                             sigue perdiendo contenido, mira todo el espacio que hay vacio para
                             mostrar los nombres de los cofres... que se revise eso para TODAS las
                             pestañas de Exploracion".
                             Como estaba: nombre y recuento APILADOS a la izquierda (StackPanel
                             vertical) y solo el id a la derecha. El recuento real ("184", "45") es
                             de 2-4 caracteres y se comia una linea entera de ancho, mientras que
                             desde el final del nombre hasta el id quedaba una franja vacia de mas
                             de la mitad de la columna - y el nombre, con TextTrimming, se cortaba
                             con puntos suspensivos aunque ese hueco estuviera ahi al lado sin usar.
                             Ahora: recuento e id APILADOS a la DERECHA (justo el hueco que sobraba,
                             y son los dos datos numericos, que se leen mejor alineados), y el
                             nombre se lleva TODO el resto con TextWrapping en vez de recortarse -
                             si de verdad no cabe, crece a una segunda linea, que es exactamente el
                             alto que antes ocupaba el recuento. Mismo criterio en las 5 categorias.
                             El MaxWidth del bloque derecho es la garantia real de que el nombre
                             conserva su sitio: el CountLabel de Minerales ("86.200 tiles · 6.738
                             vetas") es largo, y sin tope se llevaria media fila. -->
                        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" MaxWidth="96" Margin="8,0,0,0">
                            <TextBlock Text="{Binding CountLabel}" Style="{StaticResource BodyText}"
                                       TextAlignment="Right" TextWrapping="Wrap" />
                            <!-- El id se esconde en la fila de "Cofre de un mod": ahi el Id es el
                                 type del tile, o sea -1 ("casilla vacia"), y enseñar "[-1]" seria
                                 volver a poner delante justo el numero sin sentido que el usuario
                                 reporto. El resto de filas lo siguen llevando (P-7: TEdit muestra
                                 el id siempre, y el buscador acepta buscar por id). -->
                            <TextBlock Text="{Binding Id, StringFormat='[{0}]'}" Style="{StaticResource CaptionText}"
                                       TextAlignment="Right"
                                       Visibility="{Binding IsModdedChest, Converter={StaticResource InverseBoolToVis}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Button>
            </Grid>
        </DataTemplate>

        <!-- C-06 (informe de pulido final, ESPEC-pulido-final-libreria-inicio-apariencia.md#9.6,
             cierra E8): "Cofre a cofre" - una fila por cofre real, desplegable. Pulsar la fila
             (sprite+nombre+coordenadas) navega a esa posicion del mapa Y despliega/repliega su
             contenido a la vez (GoToChestCommand); pulsar un objeto de dentro no navega (ya se
             esta mirando ese cofre). -->
        <DataTemplate x:Key="ChestRowTemplate" DataType="{x:Type vm:ChestRowViewModel}">
            <!-- Bug real reportado por el usuario (6-sep-2026): "el cuadradito de resaltado que
                 marca 'aqui esta seleccionado esto' no aparece en el modo Cofre a cofre". Este
                 Border no tenia BorderThickness NI trigger de seleccion - el indicador teal que SI
                 se ve en las demas categorias vive en la plantilla de WorldSearchResults (mas
                 abajo, DataTrigger sobre IsCurrent), y esta vista usa otra clase de fila
                 (ChestRowViewModel) que ni siquiera tenia IsCurrent. Mismo grosor (1.5) y mismo
                 pincel (TealBrush) que alli, para que el gesto se lea igual en toda la pestaña. El
                 BorderThickness es 1.5 en los DOS estados y solo cambia de color: subirlo al
                 seleccionar movería la fila entera (mismo criterio ya fijado en CategorySelector). -->
            <Border Background="{StaticResource BgElevatedBrush}" CornerRadius="6" Margin="0,0,0,6"
                    BorderThickness="1.5"
                    Visibility="{Binding IsMatch, Converter={StaticResource BoolToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource TealBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Button HorizontalContentAlignment="Stretch" Padding="8"
                            Command="{Binding DataContext.Exploration.GoToChestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}">
                        <!-- Mismo criterio que InventoryRowTemplate: el cofre sobre una casilla de
                             mod lleva el tooltip que lo explica, el resto el generico. -->
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RowClickButton}">
                                <Setter Property="ToolTip" Value="{Binding Loc[tt_goto_map_toggle_contents], Mode=OneWay}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsModdedChest}" Value="True">
                                        <Setter Property="ToolTip" Value="{Binding Loc[explore_chest_modded_tooltip], Mode=OneWay}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <DockPanel LastChildFill="True">
                            <Grid DockPanel.Dock="Left" Width="26" Height="26" Margin="0,0,7,0" VerticalAlignment="Center">
                                <Image Source="{Binding IconPath}" Stretch="Uniform" StretchDirection="DownOnly"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                            </Grid>
                            <!-- Mismo reparto que las otras 4 categorias (ver el comentario largo de
                                 InventoryRowTemplate): datos numericos apilados a la derecha - aqui,
                                 cuantos objetos lleva dentro y las coordenadas, que es lo que se
                                 compara de fila a fila - y el nombre con TODO el ancho restante y
                                 TextWrapping en vez de recortarse con puntos suspensivos. -->
                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" MaxWidth="96" Margin="8,0,0,0">
                                <TextBlock Text="{Binding ItemCountLabel, Mode=OneWay}"
                                           Style="{StaticResource CaptionText}" Foreground="{StaticResource TextSecondaryBrush}"
                                           TextAlignment="Right" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource CaptionText}" TextAlignment="Right">
                                    <Run Text="(" /><Run Text="{Binding TileX, Mode=OneWay}" /><Run Text=", " /><Run Text="{Binding TileY, Mode=OneWay}" /><Run Text=")" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding VariantName}" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                                <!-- WldChest.Name - el nombre propio del cofre, si el jugador se lo puso -
                                     antes no se mostraba en NINGUN sitio de la app (C-19). -->
                                <TextBlock Text="{Binding ChestName}" Style="{StaticResource CaptionText}" FontStyle="Italic"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding ChestName, Converter={StaticResource NullToVis}}" />
                            </StackPanel>
                        </DockPanel>
                    </Button>
                    <ItemsControl ItemsSource="{Binding Items}" Margin="33,4,0,8"
                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChestContentItemViewModel}">
                                <DockPanel Margin="0,0,0,3" LastChildFill="True">
                                    <Image DockPanel.Dock="Left" Source="{Binding IconPath}" Width="18" Height="18" Margin="0,0,6,0"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Uniform" StretchDirection="DownOnly"
                                           Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Stack, StringFormat='x{0}'}"
                                               Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" VerticalAlignment="Center">
                                        <Run Text="{Binding PrefixName, Mode=OneWay}" FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- F-5 (auditoria de Opus vs TEdit, E-04): las listas largas (hasta 1000 resultados,
             hasta 260 filas de inventario) eran un ItemsControl desnudo dentro de un
             ScrollViewer externo - WPF realiza TODOS sus contenedores de golpe en el primer
             layout, y ademas un ScrollViewer externo DESACTIVA la virtualizacion del panel
             interno aunque lo tuviera (mismo aviso literal que TEdit deja en su equivalente,
             TileWallPickerControl.xaml:55, "no external ScrollViewer - ListBox handles its
             own"). Estilo de contenedor sin ninguna decoracion propia (sin fondo/borde de
             seleccion): la fila YA trae su propio Border/Button, este contenedor solo debe
             desaparecer visualmente - Focusable=False porque el Boton interno de cada fila ya
             es el objetivo real del foco y del clic. -->
        <Style x:Key="VirtualRowContainer" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Auditoria de Opus, N-1: "el personaje cargado, si tiene cambios sin guardar, y las
             propias acciones de Cargar/Guardar solo se veian dentro de la pestaña Personaje" -
             viola P2 (todo a mano, nada se esconde): cambiar a Builds/Exploracion/etc perdia de
             vista con QUE personaje se estaba trabajando, y guardar exigia volver a Personaje
             primero. Barra real, visible en CUALQUIER pestaña - mismo doll de
             PlayerPreviewRenderer que ya usa Apariencia (real, no un icono generico), nombre,
             dificultad, insignia de Calamity (mismo criterio que en todos los demas sitios,
             HasCalamityData) y el punto de "sin guardar" ya real de WindowTitle/IsDirty. -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource BorderBrush0}"
                BorderThickness="0,0,0,1" Padding="16,8">
            <!-- H5-10 (quinta auditoria de Opus): "la cabecera global, lo unico visible en las 6
                 pestañas, esta hueca por dentro - todo el centro vacio". Grid de 3 columnas en vez
                 del DockPanel real anterior (identidad+botones nada mas) - la columna central
                 ahora es una franja real de constantes vitales, el dato que mas se consulta y que
                 hoy exige 3 saltos de pestaña (Apariencia para vida/mana, Equipamiento para
                 defensa, hacer la cuenta a mano para el dinero). -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- C-14 (auditoria de pulido final, cierra H3): 20px es el escalon real "grupos
                     distintos" de la escala del proyecto - sin este margen, a cualquier ancho
                     donde la franja central se estrecha, los botones de la derecha quedaban
                     pegados al ultimo dato vital (dinero/horas), leyendose como el mismo grupo. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <!-- T-H/F1 (segunda auditoria de Opus, Fable): "N-3 esta bien hecho pero no se
                         anuncia en ningun sitio (sin ToolTip en la cabecera)... un atajo que nadie
                         descubre no mejora la practicidad" - los 4 atajos reales (OnWindowKeyDown)
                         ya existian, solo faltaba decirlo donde el usuario los va a usar. -->
                    <!-- P-4 (auditoria de Opus vs TEdit, cierra B-02/B-03): 4 grupos reales
                         (archivo-entrada / busqueda / historial / archivo-salida), separados por
                         una linea de 1px - mismo recurso que el <Separator/> de TEdit entre
                         grupos de menu, trasladado a una barra horizontal. "Cargar personaje"
                         baja de Accent a boton normal en cuanto hay personaje cargado
                         (FalseToTag) - ya no compite con "Guardar", el otro relleno de la fila. -->
                    <Button Content="{Binding Loc[action_load_character], Mode=OneWay}" Tag="{Binding IsCharacterLoaded, Converter={x:Static conv:FalseToTagConverter.Instance}, ConverterParameter=Accent}"
                            Click="OnLoadClick" ToolTip="Ctrl+O" />
                    <Border Width="1" Background="{StaticResource BorderBrush0}" Margin="12,4" />
                    <!-- H5-05 (quinta auditoria de Opus): "no se puede buscar entre los ~350
                         slots que el personaje ya tiene - ¿Donde tengo el Ala de murcielago?
                         solo se responde a ojo". Boton real en la cabecera global (visible en
                         CUALQUIER pestaña, como Guardar) - x:Name para que el Popup de abajo
                         pueda anclarse a el. -->
                    <!-- F-16 (auditoria de Opus vs TEdit, B-04): antes se OCULTABA del todo sin
                         personaje (Visibility), un tercer comportamiento distinto al resto de la
                         fila (siempre visible / deshabilitado / oculto) - ahora se DESHABILITA via
                         CanExecute (mismo patron que Guardar/etc.), con ToolTipService.
                         ShowOnDisabled para que el motivo se vea igual que en las 5 pildoras de
                         Exploracion, y la barra no cambia de forma al cargar un personaje.
                         P-4 (auditoria Opus vs TEdit, cierra B-03): el emoji 🔍 era el UNICO de
                         toda la fila (no obedece Foreground ni el estado deshabilitado, depende de
                         la fuente de emoji instalada) - texto puro, como sus vecinos. Renombrado
                         "Buscar en el personaje": "¿Dónde lo tengo?" no decia DONDE busca, y desde
                         que existe tambien el buscador de mundo (Exploracion) la ambiguedad es
                         real. -->
                    <Button x:Name="WhereIsItButton" Content="{Binding Loc[action_where_is_it], Mode=OneWay}"
                            Command="{Binding ToggleWhereIsItCommand}" ToolTipService.ShowOnDisabled="True">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="ToolTip" Value="Busca un objeto por nombre o #id entre TODOS los slots reales de tu personaje (Inventario, Almacenes, Equipamiento de los 4 loadouts...) (Ctrl+Shift+F)" />
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="ToolTip" Value="Carga un personaje primero" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border Width="1" Background="{StaticResource BorderBrush0}" Margin="12,4" />
                    <!-- H5-01 (quinta auditoria de Opus): "casi toda edicion del personaje es
                         irreversible" - historial real de deshacer/rehacer (UndoStack), no solo
                         a nivel de fichero como "Deshacer último guardado" de al lado. El
                         tooltip lleva el rotulo real de la SIGUIENTE entrada (que se va a
                         deshacer/rehacer si se pulsa), no solo "hay algo" - P5, feedback vivo.
                         P-4 (auditoria Opus vs TEdit, cierra B-03): Padding="8,8" en vez de "8,3" -
                         mismo alto vertical (8) que el estilo base (14,8), solo mas estrechos en
                         horizontal; antes quedaban 10px mas bajos que sus vecinos. -->
                    <Button Content="↶" FontSize="15" Padding="8,8" Command="{Binding UndoEditCommand}"
                            >
                        <Button.ToolTip>
                            <MultiBinding Converter="{StaticResource LocFormat}" ConverterParameter="fallback">
                                <Binding Path="Loc[tt_undo_with_label]" Mode="OneWay" />
                                <Binding Path="Loc[tt_undo_plain]" Mode="OneWay" />
                                <Binding Path="UndoStack.NextUndoLabel" Mode="OneWay" />
                            </MultiBinding>
                        </Button.ToolTip>
                    </Button>
                    <Button Content="↷" FontSize="15" Padding="8,8" Margin="4,0,0,0" Command="{Binding RedoEditCommand}"
                            >
                        <Button.ToolTip>
                            <MultiBinding Converter="{StaticResource LocFormat}" ConverterParameter="fallback">
                                <Binding Path="Loc[tt_redo_with_label]" Mode="OneWay" />
                                <Binding Path="Loc[tt_redo_plain]" Mode="OneWay" />
                                <Binding Path="UndoStack.NextRedoLabel" Mode="OneWay" />
                            </MultiBinding>
                        </Button.ToolTip>
                    </Button>
                    <!-- T-C (segunda auditoria de Opus, Fable): el .bak real que Guardar ya deja
                         (CharacterFileService.WriteAtomic) ahora tiene una forma real de usarse
                         desde la propia UI, sin ir a buscarlo a mano al Explorador de archivos. -->
                    <Button Content="{Binding Loc[action_undo_last_save], Mode=OneWay}" Margin="10,0,0,0" Command="{Binding UndoLastSaveCommand}"
                            ToolTip="{Binding Loc[tt_undo_last_save], Mode=OneWay}" />
                    <Border Width="1" Background="{StaticResource BorderBrush0}" Margin="12,4" />
                    <Button Content="{Binding Loc[action_save], Mode=OneWay}" Tag="Orange" Command="{Binding SaveCommand}" ToolTip="Ctrl+S" />
                </StackPanel>
                <!-- C-14 (auditoria de pulido final, cierra H3): mismo escalon de 20px que la
                     columna 2 - separa la identidad del personaje de la franja de vitales, "se
                     junta con Softcore" a cualquier ancho, incluida pantalla completa. -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0"
                            Visibility="{Binding IsCharacterLoaded, Converter={StaticResource BoolToVis}}">
                    <Image Source="{Binding Appearance.PreviewImage}" Width="28" Height="39.2" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <!-- H-1 (segunda auditoria de Opus, Fable): "PlrCharacter.Name se lee y
                                 se escribe sin problema... y muestra el nombre como texto muerto" -
                                 TextBox real con el estilo "filled" ya usado en el resto de la app
                                 (BgElevatedBrush, sin borde) + OnCommitTextOnEnter (ya existe, T-17
                                 resolvio el gotcha de UpdateSourceTrigger=PropertyChanged vs Intro).
                                 B-07 (auditoria Opus vs TEdit): "hoy no hay ni cursor de texto
                                 anunciado, ni borde al pasar el raton, ni ningun indicio - se puede
                                 modificar el nombre real por accidente al hacer clic para enfocar
                                 la ventana". Borde real que aparece al pasar el raton o al tener el
                                 foco (BorderThickness=0 en reposo, para no cambiar el aspecto
                                 "filled" ya establecido cuando no se esta usando) + ToolTip que
                                 anuncia la accion. -->
                            <!-- C-14 (auditoria de pulido final, cierra H3): tope real de ancho -
                                 sin el, un nombre largo se seguia comiendo la columna central
                                 entera (solo tenia MinWidth, nunca MaxWidth). TextBox no tiene
                                 TextTrimming real (a diferencia de TextBlock) - MaxWidth por si
                                 solo ya basta para el objetivo real (no dejar crecer la columna),
                                 el propio TextBox se desplaza solo al escribir/enfocar. -->
                            <TextBox Text="{Binding CharacterName, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnCommitTextOnEnter"
                                     FontFamily="{StaticResource AppFont}" FontSize="14" FontWeight="SemiBold"
                                     Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource BgElevatedBrush}"
                                     Padding="4,2" MinWidth="80" MaxWidth="220" VerticalAlignment="Center"
                                     ToolTip="{Binding Loc[tt_click_to_rename], Mode=OneWay}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush0}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderThickness" Value="1" />
                                            </Trigger>
                                            <Trigger Property="IsFocused" Value="True">
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <TextBlock Text="●" FontSize="16" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="6,0,0,0"
                                       ToolTip="{Binding Loc[label_unsaved_changes], Mode=OneWay}"
                                       Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" />
                            <!-- H-1/F2: "Aviso discreto si el nombre del archivo no coincide" - un
                                 .plr renombrado/copiado por fuera puede tener un nombre real
                                 distinto del nombre del fichero, confusion real al distinguir dos
                                 ventanas del Explorador. -->
                            <TextBlock Text="⚠" FontSize="13" Foreground="{StaticResource OrangeBrush}" VerticalAlignment="Center" Margin="6,0,0,0"
                                       ToolTip="{Binding Loc[tt_name_mismatch], Mode=OneWay}"
                                       Visibility="{Binding NameFileMismatch, Converter={StaticResource BoolToVis}}" />
                            <Border Background="{StaticResource BgHoverBrush}" CornerRadius="3" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Appearance.DifficultyLabel}" Style="{StaticResource CaptionText}" FontSize="11" />
                            </Border>
                            <Border Background="{StaticResource CalamityBrush}" CornerRadius="3" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding HasCalamityData, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Calamity" FontSize="11" Foreground="White" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <!-- H-2: "Sin rastro de la version ni del archivo abierto - hay que ir a la
                             pestaña Version (tercer nivel)... no hay forma de distinguir dos
                             personajes con el mismo nombre en carpetas distintas". -->
                        <TextBlock Text="{Binding FileVersionLine}" Style="{StaticResource CaptionText}" FontSize="11" Margin="4,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="0" Text="{Binding Loc[label_no_character_loaded], Mode=OneWay}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                           Visibility="{Binding IsCharacterLoaded, Converter={StaticResource InverseBoolToVis}}" />

                <!-- H5-10: franja real de constantes vitales - vida/mana SIEMPRE visibles (lo
                     mas consultado), defensa/dinero/horas+ultimo guardado solo con sitio real
                     (IsVitalsStripExpanded, mismo mecanismo de SizeClass de H5-08). Todos los
                     datos YA se calculaban en algun sitio (Apariencia/Equipamiento/Monedas) -
                     nada nuevo que extraer, solo un sitio real donde verlo de un vistazo.
                     Auditoria de redimensionado, R-04a/H-04a: WrapPanel en vez de StackPanel
                     Horizontal, sin HorizontalAlignment="Center" - a MinWidth=1080 la tira
                     compacta (Vida+Mana, 196px) ya no cabia en los ~192px reales que le dejaban
                     las dos columnas Auto de los lados, y perdia el icono de vida ENTERO (9px) sin
                     avisar. Con WrapPanel, si no cabe pasa a una segunda linea (la fila del Grid es
                     Height="Auto", crece sola) - nunca se pierde nada, a ningun ancho. -->
                <!-- F-15 (auditoria de Opus vs TEdit, cierra B-01/B-06): ShowVitalsStrip ya
                     excluye la pestaña Exploracion (antes solo IsCharacterLoaded - la franja de
                     vitales podia seguir ahi aunque el usuario estuviera mirando un mundo). -->
                <!-- C-12 (auditoria de pulido final): igual que las insignias de tarjeta de
                     personaje, esta tira solo llevaba margen horizontal - a un ancho de ventana
                     que fuerza el WrapPanel (R-04a/H-04a) a una segunda linea, vida/mana y el
                     resto quedaban pegados sin hueco vertical (captura real del usuario, barra
                     superior). Margen inferior en cada hijo directo. -->
                <WrapPanel Grid.Column="1" VerticalAlignment="Center"
                            Visibility="{Binding ShowVitalsStrip, Converter={StaticResource BoolToVis}}">
                    <!-- Vida -->
                    <TextBlock Text="♥" FontSize="13" Foreground="{StaticResource CalamityBrush}" VerticalAlignment="Center" Margin="0,0,0,4" />
                    <!-- C-14 (auditoria de pulido final, cierra H3): 20 en vez de 14 - razon 5:1
                         en vez de 3,5:1 frente al hueco interno (4), para que vida/mana se lean
                         como DOS pares, no como una tira uniforme de 4 numeros. -->
                    <Grid Width="70" Height="10" Margin="4,0,20,4" ToolTip="{Binding Loc[label_health], Mode=OneWay}">
                        <Border Background="{StaticResource BgPrimaryBrush}" CornerRadius="3" />
                        <Border Background="{StaticResource CalamityBrush}" CornerRadius="3" HorizontalAlignment="Left"
                                Width="{Binding Appearance.HealthFraction, Converter={StaticResource FractionToWidth}, ConverterParameter=70}" />
                        <TextBlock Text="{Binding Appearance.HealthLabel}" FontSize="8.5" Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <!-- Maná -->
                    <TextBlock Text="✦" FontSize="13" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,0,4" />
                    <Grid Width="70" Height="10" Margin="4,0,14,4" ToolTip="{Binding Loc[label_mana], Mode=OneWay}">
                        <Border Background="{StaticResource BgPrimaryBrush}" CornerRadius="3" />
                        <Border Background="{StaticResource AccentBrush}" CornerRadius="3" HorizontalAlignment="Left"
                                Width="{Binding Appearance.ManaFraction, Converter={StaticResource FractionToWidth}, ConverterParameter=70}" />
                        <TextBlock Text="{Binding Appearance.ManaLabel}" FontSize="8.5" Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4" Visibility="{Binding IsVitalsStripExpanded, Converter={StaticResource BoolToVis}}">
                        <!-- Defensa (del loadout que se este mirando ahora en Equipamiento -
                             mismo dato real ya en pantalla ahi, EquipmentGroupViewModel). -->
                        <TextBlock Text="🛡" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding EquipmentGroup.TotalDefense}" Style="{StaticResource CaptionText}" Margin="3,0,14,0" VerticalAlignment="Center"
                                   ToolTip="{Binding EquipmentGroup.ActiveSetBonusText, TargetNullValue='Defensa total (loadout que se está viendo en Equipamiento)'}" />
                        <!-- Dinero total -->
                        <TextBlock Text="{Binding MoneyText}" Style="{StaticResource CaptionText}" Margin="0,0,14,0" VerticalAlignment="Center"
                                   ToolTip="{Binding Loc[tt_total_money], Mode=OneWay}" />
                        <!-- Horas jugadas + Último guardado -->
                        <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center" ToolTip="{Binding Loc[tt_hours_played], Mode=OneWay}">
                            <Run Text="{Binding Appearance.PlayHours, StringFormat='{}{0:0}h'}" />
                        </TextBlock>
                        <TextBlock Text="{Binding LastSavedText}" Style="{StaticResource CaptionText}" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Visibility="{Binding LastSavedText, Converter={StaticResource NullToVis}}" />
                    </StackPanel>
                </WrapPanel>

                <!-- F-15 (auditoria de Opus vs TEdit, cierra B-01/B-06): contenido EXCLUSIVO con
                     el WrapPanel de arriba - en Exploracion, con un mundo real cargado, la
                     columna central pasa a mostrar el mundo en vez de quedar hueca. Mismos
                     campos que ya calcula F-6/P-1 para la franja de estado del mapa (asi la
                     info sigue disponible incluso con la barra lateral plegada en el futuro,
                     F-10). -->
                <WrapPanel Grid.Column="1" VerticalAlignment="Center"
                            Visibility="{Binding IsExplorationTabActive, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding Exploration.IsWorldLoaded, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Exploration.WorldTitle}" Style="{StaticResource BodyText}" VerticalAlignment="Center"
                                   MaxWidth="200" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Exploration.WorldSizeText}" Style="{StaticResource CaptionText}" Margin="10,0,0,0" VerticalAlignment="Center"
                                   ToolTip="{Binding Loc[tt_world_size], Mode=OneWay}" />
                        <TextBlock Style="{StaticResource CaptionText}" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource LocFormat}">
                                    <Binding Path="Loc[explore_zoom_pct]" Mode="OneWay" />
                                    <Binding Path="Exploration.Zoom" Mode="OneWay" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Text="{Binding Exploration.HoverCoordText}" Style="{StaticResource CaptionText}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Exploration.HoverLayerText}" FontSize="11" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Foreground>
                                <SolidColorBrush Color="{Binding Exploration.HoverLayerColor}" />
                            </TextBlock.Foreground>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="{Binding Loc[explore_no_world_loaded], Mode=OneWay}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                               Visibility="{Binding Exploration.IsWorldLoaded, Converter={StaticResource InverseBoolToVis}}" />
                </WrapPanel>

                <!-- H5-05 (quinta auditoria de Opus): "¿Dónde lo tengo?" - panel real anclado al
                     boton de la cabecera, visible en CUALQUIER pestaña. StaysOpen=False lo
                     cierra solo con un clic fuera (mismo gesto real que cualquier menu/combo de
                     Windows) - no hace falta ningun manejador nuevo para cerrarlo a mano. -->
                <Popup x:Name="WhereIsItPopup" IsOpen="{Binding IsWhereIsItOpen}" PlacementTarget="{Binding ElementName=WhereIsItButton}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                       Opened="OnWhereIsItPopupOpened">
                    <Border Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Width="400" Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc[where_is_it_title], Mode=OneWay}" Style="{StaticResource SectionText}" Margin="0,0,0,8" />
                            <TextBox x:Name="WhereIsItSearchBox" Text="{Binding WhereIsItSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="7,5" Background="{StaticResource BgElevatedBrush}"
                                     Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" FontSize="12"
                                     ToolTip="{Binding Loc[tt_search_grammar_basic], Mode=OneWay}" />
                            <TextBlock Text="{Binding WhereIsItSummary}" Style="{StaticResource CaptionText}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding WhereIsItSummary, Converter={StaticResource EmptyToCollapsed}}" />
                            <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"
                                          Visibility="{Binding WhereIsItResults.Count, Converter={StaticResource CountToVis}}">
                                <ItemsControl ItemsSource="{Binding WhereIsItResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:WhereIsItResultViewModel}">
                                            <!-- Un clic navega, selecciona el slot real y dispara el
                                                 flash de T-14 - pedido explicito del informe. Button
                                                 real (no Border+MouseBinding, ver RowClickButton en
                                                 Theme.xaml para el porque real - un clic real dentro
                                                 de este Popup StaysOpen=False dejaba la interfaz
                                                 bloqueada). -->
                                            <Button Style="{StaticResource RowClickButton}"
                                                    Command="{Binding DataContext.NavigateToWhereIsItResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="{Binding IconPath}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,8,0"
                                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                           Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyText}" />
                                                        <TextBlock Style="{StaticResource CaptionText}">
                                                            <Run Text="{Binding ContainerName, Mode=OneWay}" />
                                                            <Run Text="{Binding Loc[label_dash_slot], Mode=OneWay}" />
                                                            <Run Text="{Binding SlotNumber, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
        <TabControl Style="{StaticResource NavTabControl}" SelectedIndex="{Binding SelectedTabIndex}">
        <!-- ===================== INICIO ===================== -->
        <!-- H5-14 (quinta auditoria de Opus): "Ctrl+1...6 para las 6 pestañas raiz, numero
             anunciado en el propio rotulo" - mismo criterio T-H/F1 (tooltip real, no un atajo
             que nadie descubre). -->
        <TabItem Header="{Binding Loc[tab_home], Mode=OneWay}" ToolTip="Ctrl+1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="14">
                <!-- I-c (segunda auditoria de Opus, Fable): MaxWidth dependiente de SizeClass -
                     en una ventana Amplia el WrapPanel de tarjetas de abajo tiene sitio real
                     para repartirse en una fila mas ancha en vez de dejar ~1000px negros. -->
                <StackPanel MaxWidth="{Binding InicioContentMaxWidth}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                        <Image Source="pack://siteoforigin:,,,/Assets/branding/logo-128.png" Width="56" Height="56" />
                        <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Text="{Binding About.AppName}" Style="{StaticResource TitleText}" FontSize="26" />
                            <TextBlock Text="{Binding Loc[about_tagline], Mode=OneWay}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                    <!-- H4-09 (cuarta auditoria de Opus, Fable): MaxWidth sin HorizontalAlignment
                         explicito deja el TextBlock en Stretch por omision - un hijo Stretch mas
                         estrecho que su contenedor por el propio MaxWidth queda CENTRADO en vez
                         de pegado a la izquierda (mismo defecto real ya corregido en Desbloqueos
                         y en la pestaña Versión, D-a - aqui se habia quedado sin aplicar). -->
                    <!-- Bloque 1 del idioma (pedido explicito del usuario, 5-sep-2026): primer
                         texto real migrado al diccionario Loc (LocalizationService), prueba de
                         concepto de la infraestructura antes de migrar el resto de la app en
                         bloques posteriores. Path="[clave]" es sintaxis real de WPF para
                         indexadores - MainViewModel.Loc expone LocalizationService.Instance, que
                         refresca EN VIVO via PropertyChanged("Item[]") al cambiar el idioma en
                         Ajustes, sin reiniciar. ".plr"/".tplr" NO se traducen (son la extension
                         real del archivo, igual en cualquier idioma). -->
                    <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" LineHeight="20" Margin="0,10,0,24" MaxWidth="700" HorizontalAlignment="Left">
                        <Run Text="{Binding Loc[home_description_part1], Mode=OneWay}" />
                        <Run Text=".plr" FontStyle="Italic" />
                        <Run Text="{Binding Loc[home_description_part2], Mode=OneWay}" />
                        <Run Text=".tplr" FontStyle="Italic" />
                        <Run Text="{Binding Loc[home_description_part3], Mode=OneWay}" />
                        <Run Text="{Binding Loc[home_description_color], Mode=OneWay}" Foreground="{StaticResource CalamityBrush}" FontWeight="SemiBold" />
                        <Run Text="{Binding Loc[home_description_part4], Mode=OneWay}" />
                    </TextBlock>

                    <!-- Auditoria de Opus, I-1: "Inicio" era una pagina de bienvenida estatica -
                         ni un solo personaje real a la vista, obligaba a abrir el Explorador de
                         archivos incluso para el caso normal (P1/P2). Lanzador real: si hay
                         .plr en la carpeta real de tModLoader, aparecen aqui de un plumazo, con
                         su doll/dificultad/insignia/fecha reales - un click carga y salta a
                         Personaje. Si no hay ninguno (carpeta vacia o instalacion sin
                         detectar), se cae al boton manual de siempre. -->
                    <!-- T-G (segunda auditoria de Opus, Fable): "IsScanning ya existia pero sin
                         ningun binding real - un interruptor que nunca encendia nada". Ahora que
                         el escaneo real es async (ver HomeViewModel.RefreshAsync), este hueco
                         SI hace falta - mientras dura, Characters.Count sigue en 0 Y ScanMessage
                         sigue vacio (nada del bloque de abajo ni del de "Empezar" seria visible
                         todavia sin esto, una pantalla en blanco real durante el escaneo). -->
                    <!-- H5-07 (quinta auditoria de Opus): "Inicio ofrece 'Continuar con Nombre'
                         como accion destacada (con aviso de fichero cambiado por fuera si la
                         fecha no cuadra, nunca carga automatica silenciosa)". La accion MAS
                         destacada de la pantalla, antes que cualquier otra cosa - un clic real,
                         explicito, del usuario (Home.ContinueCommand -> CharacterChosen, mismo
                         camino real que elegir una tarjeta). -->
                    <Border Background="{StaticResource AccentGradientBrush}" CornerRadius="10" Padding="18,14" Margin="0,0,0,20"
                            Effect="{StaticResource CardShadow}" Cursor="Hand"
                            Visibility="{Binding Home.LastSessionCharacterName, Converter={StaticResource NullToVis}}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding Home.ContinueCommand}" />
                        </Border.InputBindings>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▶" FontSize="16" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Style="{StaticResource SectionText}" Foreground="White" VerticalAlignment="Center">
                                    <Run Text="{Binding Loc[home_continue_with], Mode=OneWay}" /><Run Text="{Binding Home.LastSessionCharacterName, Mode=OneWay}" FontWeight="Bold" />
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Text="{Binding Home.LastSessionStalenessWarning}" Foreground="White" FontSize="11" TextWrapping="Wrap" Margin="26,6,0,0"
                                       Visibility="{Binding Home.LastSessionStalenessWarning, Converter={StaticResource NullToVis}}" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,26" Visibility="{Binding Home.IsScanning, Converter={StaticResource BoolToVis}}">
                        <ProgressBar IsIndeterminate="True" Width="120" Height="4" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Loc[home_loading], Mode=OneWay}" Style="{StaticResource CaptionText}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding Home.Characters.Count, Converter={StaticResource CountToVis}}" Margin="0,0,0,26">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="{Binding Loc[home_your_characters], Mode=OneWay}" Style="{StaticResource SectionText}" VerticalAlignment="Center" />
                            <Button Content="{Binding Loc[home_refresh], Mode=OneWay}" FontSize="11" Padding="8,2" Margin="12,0,0,0"
                                    Command="{Binding Home.RefreshCommand}" />
                            <Button Content="{Binding Loc[home_load_other_folder], Mode=OneWay}" FontSize="11" Padding="8,2" Margin="8,0,0,0"
                                    Click="OnLoadClick" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Home.Characters}" ItemTemplate="{StaticResource CharacterCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>

                    <Button Style="{StaticResource NavCardButton}" HorizontalAlignment="Left" Margin="0,0,0,26"
                            Visibility="{Binding Home.ScanMessage, Converter={StaticResource EmptyToCollapsed}}"
                            Click="OnLoadClick">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="4" Background="{StaticResource AccentBrush}" CornerRadius="2" Margin="0,0,16,0" />
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[home_start_load_character], Mode=OneWay}" Style="{StaticResource SectionText}" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="{Binding Home.ScanMessage}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="520" Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="{Binding Loc[home_more_actions], Mode=OneWay}" Style="{StaticResource SectionText}" Margin="0,0,0,12" />
                    <!-- I-c/F2 (segunda auditoria de Opus, Fable): MinHeight en vez de Height fijo
                         en las 5 tarjetas de abajo - un titulo/descripcion real que necesite mas
                         de las 2 lineas habituales (ej. una traduccion mas larga) hace crecer la
                         tarjeta en vez de recortarse contra un alto fijo. -->
                    <ItemsControl>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <Button Style="{StaticResource NavCardButton}" Width="270" MinHeight="108" Margin="0,0,14,14"
                                Command="{Binding GoToTabCommand}" CommandParameter="Libreria">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[home_card_library_title], Mode=OneWay}" Style="{StaticResource SectionText}" />
                                <TextBlock Text="{Binding Loc[home_card_library_desc], Mode=OneWay}"
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavCardButton}" Width="270" MinHeight="108" Margin="0,0,14,14"
                                Command="{Binding GoToTabCommand}" CommandParameter="Builds">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[home_card_builds_title], Mode=OneWay}" Style="{StaticResource SectionText}" />
                                <TextBlock Text="{Binding Loc[home_card_builds_desc], Mode=OneWay}"
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavCardButton}" Width="270" MinHeight="108" Margin="0,0,14,14"
                                Tag="Pink" Command="{Binding GoToTabCommand}" CommandParameter="Exploracion">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[home_card_exploration_title], Mode=OneWay}" Style="{StaticResource SectionText}" />
                                <TextBlock Text="{Binding Loc[home_card_exploration_desc], Mode=OneWay}"
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavCardButton}" Width="270" MinHeight="108" Margin="0,0,14,14"
                                Tag="Teal" Command="{Binding GoToTabCommand}" CommandParameter="Novedades">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[home_card_whatsnew_title], Mode=OneWay}" Style="{StaticResource SectionText}" />
                                <TextBlock Text="{Binding Loc[home_card_whatsnew_desc], Mode=OneWay}"
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavCardButton}" Width="270" MinHeight="108" Margin="0,0,14,14"
                                Tag="Orange" Command="{Binding GoToTabCommand}" CommandParameter="AcercaDe">
                            <!-- N-c (segunda auditoria de Opus, Fable): esta tarjeta decia "¡Sobre esta
                                 versión!" pero llevaba a una pestaña con la cabecera "Acerca de" - dos
                                 nombres distintos para el MISMO destino. Se unifica con el nombre real de
                                 la pestaña (la cabecera es la fuente de verdad); "¡Sobre esta versión!"
                                 sigue vivo dentro, como titulo real de la subseccion del changelog. -->
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[home_card_about_title], Mode=OneWay}" Style="{StaticResource SectionText}" />
                                <TextBlock Text="{Binding Loc[home_card_about_desc], Mode=OneWay}"
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            </StackPanel>
                        </Button>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ===================== PERSONAJE ===================== -->
        <TabItem Header="{Binding Loc[tab_character], Mode=OneWay}" ToolTip="Ctrl+2">
            <Grid>
            <DockPanel Margin="14">
                <!-- Auditoria de Opus, N-1: Cargar/Guardar/nombre de personaje ya viven en la
                     cabecera global (MainWindow.xaml, visible en cualquier pestaña) - repetirlos
                     aqui era la misma accion dos veces en dos sitios (contra P6, simetria real:
                     una unica fuente real por accion). Solo se queda el mensaje de estado, que
                     es especifico de la ultima operacion real. -->
                <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}"
                           Margin="0,0,0,12" TextWrapping="Wrap" />

                <TabControl Style="{StaticResource InnerTabControl}" SelectedIndex="{Binding PersonajeInnerTabIndex}">
                    <TabItem Header="{Binding Loc[char_tab_objects], Mode=OneWay}">
                        <!-- Layout real de Terrasavr (pedido explicito 1-sep-2026): el inventario/equipo
                             arriba, la Libreria (arbol + buscador) siempre visible debajo, a la derecha
                             del arbol - nunca una pestaña aparte a la que hay que ir, para que arrastrar
                             una tarjeta de la Libreria hasta un slot visible sea posible de verdad. -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- Antes fija en 270px SIEMPRE (46% del alto util de esta
                                     pestaña) - pregunta a Opus sobre el diseño (2-sep-2026):
                                     Auto dejaba que la cabecera colapsable de abajo decidiera
                                     su propio alto real, pero un "Auto" con un hijo de 238px
                                     fijo SIEMPRE cobra esos 238px primero, sea cual sea el alto
                                     real disponible - la fila "*" de arriba (el contenido
                                     principal, Inventario/Almacenes/Equipamiento) se quedaba
                                     con lo que sobrara, hasta cero si hacia falta - "el
                                     Inventario estaba subvencionando a la Libreria" (consulta a
                                     Opus, septima pasada). Las DOS filas compiten de verdad por
                                     el alto real disponible (ambas "*" cuando la Libreria esta
                                     desplegada) - Objetos con prioridad y un suelo real (216px
                                     = 5 filas de Inventario a 40px + huecos, el caso mas
                                     exigente de los 3 sub-tabs que comparten esta fila).
                                     Segunda auditoria de Opus (Fable), B-1 - BUG REAL
                                     encontrado y arreglado ya una vez (octava pasada, commit
                                     83fd33c) y perdido por un revert de rango demasiado ancho
                                     (c38c960): al pasar de "Auto" a "*" para resolver lo de
                                     arriba, PLEGAR la Libreria dejo de devolver espacio de
                                     verdad - la fila seguia siendo "1*" con MinHeight=150
                                     SIEMPRE, asi que plegada seguia dejando una banda vacia de
                                     150-238px con forma de Libreria (el usuario la veia como
                                     "expandida" aunque el boton dijera lo contrario).
                                     Height/MinHeight de la fila de la Libreria ahora dependen
                                     de IsLibraryVisible (ver MainViewModel) via
                                     BoolToGridLength/BoolToDouble - colapsada de verdad,
                                     Height=Auto MinHeight=0 (se encoge al alto real de la barra
                                     "Librería ▼ Desplegar", ~34px, cero hueco muerto);
                                     desplegada, "2*" con suelo 200. MaxHeight se queda fijo,
                                     sin depender de la visibilidad (un techo generoso no
                                     molesta estando colapsada, Auto ya no crece de mas por si
                                     solo).
                                     H3-18 (tercera auditoria de Opus, Fable, nota - no es un
                                     arreglo de codigo): el MinHeight=216 de arriba se penso para
                                     "5 filas de Inventario a 40px + huecos", pero cabeceras
                                     añadidas DESPUES de esa medicion (contador real "Inventario
                                     (N/50)", A-c) le restan alto real disponible - a 1080x700
                                     (el minimo real de la ventana) con la Libreria desplegada,
                                     la 5ª fila del Inventario ya NO cabe entera sin desplazar
                                     (el ScrollViewer de seguridad de mas abajo ya lo cubre, sigue
                                     siendo accesible). Documentado aqui a proposito para que no
                                     se redescubra como una regresion nueva la proxima vez que se
                                     mida - es una limitacion conocida y aceptada, no un bug. -->
                                <RowDefinition Height="3*" MinHeight="216" />
                                <RowDefinition Height="{Binding IsLibraryVisible, Converter={StaticResource BoolToGridLength}, ConverterParameter=2}"
                                               MinHeight="{Binding IsLibraryVisible, Converter={StaticResource BoolToDouble}, ConverterParameter=200}"
                                               MaxHeight="{Binding LibraryRowMaxHeight}" />
                            </Grid.RowDefinitions>

                            <!-- Contenedores a la izquierda + panel "Editar" a la derecha (equivalente real
                                 de app.TabInventory.initSide: sideCtr con las pestañas Edit/Library reales -
                                 aqui Library ya vive fijo abajo, ver Grid.Row=1, y Editar sigue al slot
                                 SELECCIONADO sea cual sea el contenedor activo). -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="300" />
                                </Grid.ColumnDefinitions>

                                <!-- Antes: 21 pestañas planas en una sola fila (9 contenedores + 12 de
                                     loadout puesto/1/2/3 x armadura/vanidad/tintes) - se amontonaba
                                     al reducir la ventana (pedido explicito 2-sep-2026). Ahora: solo 2
                                     pestañas externas, "Equipamiento" consolida los 12 sub-contenedores
                                     con su propio selector (equivalente real de app.TabEquips/Sb, ver
                                     bitacora.md "Fase D"). -->
                                <!-- H4-02 (cuarta auditoria de Opus, Fable): "Almacenes seleccionada y luego
                                     oculta en Amplio deja un contenido huérfano sin pestaña activa" - esta
                                     pestaña interna (Equipamiento=0/Inventario=1/Almacenes=2) no tenia
                                     SelectedIndex enlazado - MainViewModel.OnSizeClassChanged mueve la
                                     seleccion a Inventario si Almacenes (ahora oculta) era la activa. -->
                                <TabControl Grid.Column="0" Style="{StaticResource InnerTabControl}" Margin="0,0,10,0"
                                            SelectedIndex="{Binding ObjetosSubTabIndex}">
                                    <TabItem Header="{Binding Loc[char_tab_equipment], Mode=OneWay}">
                                        <!-- Fusion con Monturas/Monedas como laterales (pregunta a Opus
                                             sobre el diseño, quinta pasada: "yo juntaría la página de
                                             munición mascotas gancho... y dinero en equipamiento en una
                                             sola ventana pero a los lados... mascotas etc mejor en
                                             vertical"). UN solo marco naranja para todo el bloque (3
                                             marcos compitiendo en ~672px seria el mismo amontonamiento
                                             que ya se resolvio en la tercera pasada) - los laterales se
                                             distinguen "hundiendose" (BgPrimaryBrush, mismo idioma que
                                             el arbol de la Libreria y los huecos vacios de
                                             ItemSlotCardCompact) en vez de con su propio contorno.
                                             SlotRowHost (no un Grid a secas) para que ReferenceWidth de
                                             los 3 SlotGridPanel de esta fila se enlace de forma fiable
                                             (ver SlotGridPanel.cs) contra el ancho de TODA la fila
                                             fusionada, no el de cada columna estrecha por separado -
                                             sin esto los 3 colapsarian a MinCell=44, mas pequeños que
                                             Inventario, el problema inverso de la cuarta pasada. -->
                                        <Border BorderBrush="{StaticResource OrangeBrush}" BorderThickness="2" CornerRadius="10"
                                                Background="{StaticResource BgSecondaryBrush}" Padding="10" Margin="0,6,0,0">
                                            <!-- Columnas de ancho real, no proporciones puras (consulta a
                                                 Opus, septima pasada): "2*/5*/4*" no guardaba ninguna
                                                 relacion con los anchos minimos REALES de cada bloque (52/
                                                 216/192px medidos) - a la resolucion minima de la propia
                                                 ventana la columna central (Armadura/Accesorios, la que
                                                 mas lo necesita) se quedaba corta y su contenido real
                                                 (SlotGridPanel no recorta solo, WPF Panel no clipea a sus
                                                 hijos por defecto) desbordaba visiblemente sobre el lateral
                                                 de Monedas/Municion. Los laterales van a "Auto" con un
                                                 MinWidth real (su contenido ya se autolimita via MinCell/
                                                 ReferenceWidth, el MinWidth es solo la red de seguridad);
                                                 el centro se queda con TODO el sobrante ("*"). ClipToBounds
                                                 en el propio SlotRowHost como segunda red de seguridad -
                                                 nunca deberia activarse ya con esto, pero si algun caso
                                                 raro se escapa, prefiere recortar en silencio a solapar
                                                 visiblemente encima de otro contenido.

                                                 AR-14 (6-sep-2026, queja real del usuario: "los slots de
                                                 accesorios se vuelven a solapar con las monedas/municion a
                                                 pantalla mas pequeña"). Los DOS laterales tenian su MinWidth
                                                 real desde la septima pasada; el centro, que es el unico que
                                                 puede desbordar de verdad, se quedo SIN NINGUNO - o sea, sin
                                                 ninguna garantia: se lleva "todo el sobrante", y lo que sobre
                                                 puede ser cualquier cosa porque las dos laterales son "Auto"
                                                 y crecen con su contenido. La cuenta que importa:
                                                 SlotGridPanel congela la celda en MinCell (40) cuando el
                                                 ancho no da para mas y devuelve igualmente
                                                 5*40 + 4*Gap(4) = 216px - o sea que por debajo de 216px de
                                                 columna la rejilla NO encoge, se sale, y el ScrollViewer de
                                                 ContainerCompactTemplate (HorizontalScrollBarVisibility=
                                                 "Disabled") la recorta en seco: el ultimo accesorio se ve
                                                 CORTADO justo donde empieza la caja de Monedas, que es
                                                 literalmente lo reportado. MinWidth=216 aqui convierte eso en
                                                 imposible por construccion (WPF recorta antes las columnas
                                                 Auto que el MinWidth de una columna estrella), sin fijar
                                                 ningun ancho ni quitarle sitio a nadie mientras haya de
                                                 sobra. -->
                                            <controls:SlotRowHost ClipToBounds="True">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MinWidth="140" />
                                                    <ColumnDefinition Width="*" MinWidth="216" />
                                                    <ColumnDefinition Width="Auto" MinWidth="200" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <!-- Lateral izquierdo: Mascota/Montura/Gancho + Tinte, en
                                                     vertical (Columns=1, ver MainViewModel.AddContainer).
                                                     RowSpan=2 para aprovechar tambien la franja del
                                                     selector Loadout/Vista (que no la necesita, es solo
                                                     texto+pildoras) - propio ScrollViewer de seguridad:
                                                     10 slots reales en 1 columna no siempre caben sin
                                                     scroll en ventanas pequeñas, y NO sacrificar
                                                     legibilidad (MinCell=44) es mas importante que nunca
                                                     scrollear aqui. -->
                                                <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Background="{StaticResource BgPrimaryBrush}"
                                                        CornerRadius="8" Padding="6" Margin="0,0,8,0">
                                                    <!-- Mascota/Montura y Tinte UNO AL LADO DEL OTRO, no apilados
                                                         (consulta a Opus, septima pasada, corregido con medicion
                                                         real tras implementar su recomendacion original): apilados
                                                         verticalmente son 2 rejillas de 5 filas = 10 filas reales
                                                         que compartir en la misma columna - medido con el arnes de
                                                         UI Automation, a la altura minima real de la ventana
                                                         necesitan ~412px y solo hay ~278px, un desfase real de
                                                         ~134px que NINGUN ajuste de MinCell/MaxCell puede cerrar
                                                         sin bajar de 30px (el suelo real de "mancha de color" de
                                                         Opus) - hay mas ancho de sobra que alto en este lateral
                                                         (confirmado, Auto ya no tiene techo que perseguir gracias
                                                         al MaxCell propio de arriba), asi que la solucion real es
                                                         usar ESE ancho: en horizontal, cada rejilla solo necesita
                                                         5 filas de alto, no 10 - el ScrollViewer de seguridad se
                                                         queda (para ventanas aun mas pequeñas que esta), solo
                                                         VERTICAL - HorizontalScrollBarVisibility="Disabled" sigue
                                                         siendo correcto, la columna Auto ya crece si hace falta. -->
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                        <StackPanel Orientation="Horizontal">
                                                            <StackPanel Margin="0,0,10,0">
                                                                <!-- TextWrapping="Wrap" + MaxWidth (consulta a Opus,
                                                                     septima pasada): un TextBlock sin envolver
                                                                     RECORTA en seco cuando la columna es mas
                                                                     estrecha que el texto ("Mascota /" sin
                                                                     "Montura", capturado real a la resolucion
                                                                     minima) - el MaxWidth es real, no decorativo:
                                                                     esta columna es "Auto" y WPF mide sus hijos con
                                                                     ancho INFINITO en la primera pasada, asi que sin
                                                                     este tope el texto sin envolver (~100px) seria
                                                                     mas ancho que la propia rejilla de iconos y
                                                                     terminaria fijando el ancho real de la columna
                                                                     entera. -->
                                                                <TextBlock Text="{Binding Loc[char_pet_mount_label], Mode=OneWay}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="70" Margin="0,0,0,3" />
                                                                <ContentControl Content="{Binding MountsContainer}" ContentTemplate="{StaticResource ContainerCompactTemplate}" />
                                                            </StackPanel>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Loc[char_dye_label], Mode=OneWay}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="70" Margin="0,0,0,3" />
                                                                <ContentControl Content="{Binding DyesContainer}" ContentTemplate="{StaticResource ContainerCompactTemplate}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </ScrollViewer>
                                                </Border>

                                                <!-- Selector Loadout/Vista, ColumnSpan=2 (centro+derecha) -
                                                     DataContext local a EquipmentGroup, sin heredarlo al
                                                     resto de la fila fusionada (los laterales necesitan
                                                     el MainViewModel directamente). -->
                                                <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="0" Margin="0,0,0,6"
                                                            DataContext="{Binding EquipmentGroup}">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                        <TextBlock Text="{Binding Loc[char_loadout_label], Mode=OneWay}" Style="{StaticResource CaptionText}"
                                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <ItemsControl ItemsSource="{Binding LoadoutOptions}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type vm:EquipmentOptionViewModel}">
                                                                    <!-- DisplayLabel (no Label): marca con un punto el conjunto
                                                                         que el personaje llevaba PUESTO al guardar. Antes esa
                                                                         informacion la daba una 4ª pildora "Puesto" que no existe
                                                                         en el juego real - ver EquipmentGroupViewModel. -->
                                                                    <Button Content="{Binding DisplayLabel}" Style="{StaticResource PrefixMetaButton}"
                                                                            ToolTip="{Binding ToolTipText}"
                                                                            Command="{Binding DataContext.EquipmentGroup.SelectLoadoutCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                    <!-- Auditoria de Opus, E-2: con sitio real para las 3 vistas a
                                                         la vez (SizeClass.Amplio) no hay nada que "elegir" -
                                                         este selector solo tiene sentido cuando hay que
                                                         turnarse un unico hueco entre las 3. -->
                                                    <StackPanel Orientation="Horizontal"
                                                                Visibility="{Binding DataContext.IsEquipmentExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}">
                                                        <TextBlock Text="{Binding Loc[char_view_label], Mode=OneWay}" Style="{StaticResource CaptionText}"
                                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <ItemsControl ItemsSource="{Binding KindOptions}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type vm:EquipmentOptionViewModel}">
                                                                    <Button Content="{Binding Label}" Style="{StaticResource PrefixGroupButton}"
                                                                            Command="{Binding DataContext.EquipmentGroup.SelectKindCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                    <!-- Auditoria de Opus, E-4: "el dato ya esta, solo falta
                                                         enseñarlo" - defensa real sumada de este loadout
                                                         (Armadura+Accesorios) y el bono de set REALMENTE
                                                         activo (VanillaArmorSetCatalog.BonusForEquipped, ya
                                                         existia sin usar), en vez del hipotetico del tooltip. -->
                                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0">
                                                        <Run Text="{Binding Loc[char_total_defense], Mode=OneWay}" />
                                                        <Run Text="{Binding TotalDefense, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding ActiveSetBonusText}" Style="{StaticResource CaptionText}"
                                                               Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                               Visibility="{Binding ActiveSetBonusText, Converter={StaticResource NullToVis}}" />
                                                </StackPanel>

                                                <!-- Centro: Equipamiento 5x2 real (Columns=5, ver
                                                     EquipmentGroupViewModel.AddSlotSet). Un unico panel a
                                                     la vez (pildoras "Vista:" de arriba) en Compacto/Normal. -->
                                                <ContentControl Grid.Column="1" Grid.Row="1" Content="{Binding EquipmentGroup.Current}"
                                                                ContentTemplate="{StaticResource ContainerCompactTemplate}"
                                                                Visibility="{Binding IsEquipmentExpanded, Converter={StaticResource InverseBoolToVis}}" />

                                                <!-- Auditoria de Opus, E-2: "las 3 vistas se podrian ver a la
                                                     vez con sitio real" - en SizeClass.Amplio, Armadura/
                                                     Vanidad/Tintes del loadout actual, lado a lado, cada una
                                                     con su propia etiqueta (sin pildoras que elegir, ver el
                                                     StackPanel de arriba). Mismo ContainerCompactTemplate de
                                                     siempre - ninguna plantilla nueva, solo mas sitio para
                                                     mostrar lo mismo de golpe (P3). -->
                                                <Grid Grid.Column="1" Grid.Row="1"
                                                      Visibility="{Binding IsEquipmentExpanded, Converter={StaticResource BoolToVis}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- E-b (segunda auditoria de Opus, Fable): "la etiqueta de
                                                         cada columna usa el DisplayName largo pensado para el
                                                         panel Editar, repitiendo 'Equipo puesto -' tres veces -
                                                         ya existen literalmente en KindOptions, solo hay que
                                                         reutilizarlos" - EquipmentKind.Items=0/Social=1/Dyes=2,
                                                         mismo orden real que KindOptions ya declara. -->
                                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding EquipmentGroup.KindOptions[0].Label}" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                                        <ContentControl Content="{Binding EquipmentGroup.CurrentItems}" ContentTemplate="{StaticResource ContainerCompactTemplate}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding EquipmentGroup.KindOptions[1].Label}" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
