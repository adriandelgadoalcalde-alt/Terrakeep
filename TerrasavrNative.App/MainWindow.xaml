                                    <!-- Antes: 9 pestañas planas aqui dentro, luego 5 (pregunta a Opus
                                         sobre el diseño, 2-sep-2026 y quinta pasada) - Monturas/Monedas
                                         se fusionaron dentro de Equipamiento (arriba) como laterales,
                                         asi que solo quedan Inventario/Almacenes aqui. Los 9
                                         ContainerViewModel siguen siendo los MISMOS de siempre
                                         (MainViewModel.Containers) - riesgo cero para guardar/cargar,
                                         ver StorageGroupViewModel.cs. -->
                                    <TabItem Header="{Binding Loc[char_tab_inventory], Mode=OneWay}">
                                        <Grid>
                                        <Border BorderBrush="{StaticResource OrangeBrush}" BorderThickness="2" CornerRadius="10"
                                                Background="{StaticResource BgSecondaryBrush}" Padding="10" Margin="0,6,0,0"
                                                Visibility="{Binding IsStorageExpanded, Converter={StaticResource InverseBoolToVis}}">
                                            <!-- A-c (segunda auditoria de Opus, Fable): "Inventario (47/50) seria
                                                 igual de util y no existe en ningun sitio" - la vista Amplia (mas
                                                 abajo) ya tenia esta cabecera, la normal/compacta no tenia
                                                 ninguna. -->
                                            <DockPanel>
                                                <!-- A-d (segunda auditoria de Opus, Fable): "operaciones en bloque -
                                                     ordenar, vaciar contenedor, mover todo al banco" - ver los 3
                                                     comandos reales en ContainerViewModel/MainViewModel. -->
                                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                                    <!-- Auditoria de redimensionado, R-01/H-08: WrapPanel en vez de
                                                         StackPanel - a 1080px de ancho, 6 botones en una sola fila
                                                         recortaban el titulo "Inventario (N/M)" que viene detras
                                                         (DockPanel corta el ultimo hijo cuando no le queda sitio). Con
                                                         WrapPanel los botones pasan a 2 filas si hace falta, el titulo
                                                         nunca se pierde. -->
                                                    <WrapPanel DockPanel.Dock="Right">
                                                        <!-- H5-03 (quinta auditoria de Opus): "guardar/cargar conjuntos de
                                                             objetos, funcion de primera clase en el Terrasavr original" -
                                                             el dialogo real de fichero vive en la View (MainViewModel es
                                                             headless), ver OnSaveInventorySetClick/OnLoadInventorySetClick/
                                                             OnAppendInventorySetClick. -->
                                                        <Button Content="{Binding Loc[action_save_set], Mode=OneWay}" Click="OnSaveInventorySetClick"
                                                                ToolTip="{Binding Loc[tt_save_inventory_json], Mode=OneWay}"
                                                                Tag="Ghost" Padding="6,3" FontSize="10.5" Margin="0,0,6,0" />
                                                        <Button Content="{Binding Loc[action_load_ellipsis], Mode=OneWay}" Click="OnLoadInventorySetClick"
                                                                ToolTip="{Binding Loc[tt_load_inventory_replace], Mode=OneWay}"
                                                                Tag="Ghost" Padding="6,3" FontSize="10.5" Margin="0,0,6,0" />
                                                        <Button Content="{Binding Loc[action_add_ellipsis], Mode=OneWay}" Click="OnAppendInventorySetClick"
                                                                ToolTip="{Binding Loc[tt_add_inventory_fill], Mode=OneWay}"
                                                                Tag="Ghost" Padding="6,3" FontSize="10.5" Margin="0,0,6,0" />
                                                        <Button Content="{Binding Loc[action_move_all_to_storage], Mode=OneWay}" Command="{Binding MoveInventoryToStorageCommand}"
                                                                ToolTip="{Binding Loc[tt_move_all_storage_tab], Mode=OneWay}"
                                                                Tag="Ghost" Padding="6,3" FontSize="10.5" Margin="0,0,6,0" />
                                                        <Button Content="{Binding Loc[action_sort], Mode=OneWay}" Command="{Binding InventoryContainer.SortCommand}"
                                                                ToolTip="{Binding Loc[tt_sort_by_id], Mode=OneWay}" Tag="Ghost" Padding="6,3" FontSize="10.5" Margin="0,0,6,0" />
                                                        <Button Content="{Binding Loc[action_empty_container], Mode=OneWay}" Command="{Binding InventoryContainer.ClearAllCommand}"
                                                                ToolTip="{Binding Loc[tt_empty_inventory], Mode=OneWay}" Tag="Ghost" Padding="6,3" FontSize="10.5" />
                                                    </WrapPanel>
                                                    <!-- Auditoria de redimensionado, AR-08/H-08: el WrapPanel de R-01 ya reduce
                                                         mucho el recorte (de ~660px de una fila sin envolver a un residual real
                                                         de 14px a 1080px, medido - el hueco restante entre los 6 botones ya en 2
                                                         filas y este titulo sigue siendo mas estrecho de lo que hace falta a ese
                                                         ancho concreto). TextTrimming honesto en vez de un corte seco silencioso -
                                                         parche previsto explicitamente en el propio informe para este residual. -->
                                                    <TextBlock Text="{Binding InventoryContainer.DisplayName}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <ContentControl Content="{Binding InventoryContainer}" ContentTemplate="{StaticResource ContainerCompactTemplate}" />
                                            </DockPanel>
                                        </Border>

                                        <!-- Auditoria de Opus, A-4: Inventario + el Almacen seleccionado lado
                                             a lado, con sitio real - arrastrar de un lado al otro ya
                                             funciona solo (ver el comentario real en MainViewModel.
                                             IsStorageExpanded), esto solo pone a ambos a la vista de golpe. -->
                                        <Grid Visibility="{Binding IsStorageExpanded, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" BorderBrush="{StaticResource OrangeBrush}" BorderThickness="2" CornerRadius="10"
                                                    Background="{StaticResource BgSecondaryBrush}" Padding="10" Margin="0,6,4,0">
                                                <DockPanel>
                                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                                        <!-- Auditoria de redimensionado, R-01/H-01 (el hallazgo mas grave del
                                                             informe): esta copia a mano de la cabecera de arriba se dejo
                                                             fuera "Guardar conjunto...", "Cargar..." y "Añadir..." - a partir
                                                             de 1500px de ancho (IsStorageExpanded=True) NO HABIA FORMA de
                                                             guardar/cargar un conjunto de objetos del Inventario, ni un aviso
                                                             en pantalla de por que. Restaurados aqui, WrapPanel para que
                                                             quepan en la mitad del ancho sin recortar nada. -->
                                                        <WrapPanel DockPanel.Dock="Right">
                                                            <Button Content="{Binding Loc[action_save_set], Mode=OneWay}" Click="OnSaveInventorySetClick"
                                                                    ToolTip="{Binding Loc[tt_save_inventory_json], Mode=OneWay}"
                                                                    Tag="Ghost" Padding="6,3" FontSize="10.5" Margin="0,0,6,0" />
                                                            <Button Content="{Binding Loc[action_load_ellipsis], Mode=OneWay}" Click="OnLoadInventorySetClick"
                                                                    ToolTip="{Binding Loc[tt_load_inventory_replace], Mode=OneWay}"
                                                                    Tag="Ghost" Padding="6,3" FontSize="10.5" Margin="0,0,6,0" />
                                                            <Button Content="{Binding Loc[action_add_ellipsis], Mode=OneWay}" Click="OnAppendInventorySetClick"
                                                                    ToolTip="{Binding Loc[tt_add_inventory_fill], Mode=OneWay}"
                                                                    Tag="Ghost" Padding="6,3" FontSize="10.5" Margin="0,0,6,0" />
                                                            <Button Content="{Binding Loc[action_move_all_to_storage], Mode=OneWay}" Command="{Binding MoveInventoryToStorageCommand}"
                                                                    ToolTip="{Binding Loc[tt_move_all_storage_right], Mode=OneWay}"
                                                                    Tag="Ghost" Padding="6,3" FontSize="10.5" Margin="0,0,6,0" />
                                                            <Button Content="{Binding Loc[action_sort], Mode=OneWay}" Command="{Binding InventoryContainer.SortCommand}"
                                                                    ToolTip="{Binding Loc[tt_sort_by_id], Mode=OneWay}" Tag="Ghost" Padding="6,3" FontSize="10.5" Margin="0,0,6,0" />
                                                            <Button Content="{Binding Loc[action_empty_container], Mode=OneWay}" Command="{Binding InventoryContainer.ClearAllCommand}"
                                                                    ToolTip="{Binding Loc[tt_empty_inventory], Mode=OneWay}" Tag="Ghost" Padding="6,3" FontSize="10.5" />
                                                        </WrapPanel>
                                                        <!-- Auditoria de redimensionado, AR-08/H-08: el WrapPanel de R-01 ya reduce
                                                         mucho el recorte (de ~660px de una fila sin envolver a un residual real
                                                         de 14px a 1080px, medido - el hueco restante entre los 6 botones ya en 2
                                                         filas y este titulo sigue siendo mas estrecho de lo que hace falta a ese
                                                         ancho concreto). TextTrimming honesto en vez de un corte seco silencioso -
                                                         parche previsto explicitamente en el propio informe para este residual. -->
                                                    <TextBlock Text="{Binding InventoryContainer.DisplayName}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                    <ContentControl Content="{Binding InventoryContainer}" ContentTemplate="{StaticResource ContainerCompactTemplate}" />
                                                </DockPanel>
                                            </Border>
                                            <Border Grid.Column="1" BorderBrush="{StaticResource OrangeBrush}" BorderThickness="2" CornerRadius="10"
                                                    Background="{StaticResource BgSecondaryBrush}" Padding="10" Margin="4,6,0,0"
                                                    DataContext="{Binding StorageGroup}">
                                                <DockPanel>
                                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                                        <!-- Auditoria de redimensionado, R-01/H-01: mismo hallazgo que la
                                                             mitad Inventario de al lado - esta copia se dejo fuera los 3
                                                             botones de conjunto del almacen (H5-03), y ademas la pestaña
                                                             "Almacenes" que SI los tenia se oculta entera en Amplio
                                                             (linea de arriba, IsStorageExpanded). Restaurados con los
                                                             MISMOS handlers reales que ya usa esa pestaña
                                                             (OnSaveStorageSetClick/OnLoadStorageSetClick/
                                                             OnAppendStorageSetClick, que leen el DataContext=StorageGroup
                                                             heredado del Border de arriba - identico aqui). -->
                                                        <WrapPanel DockPanel.Dock="Right">
                                                            <Button Content="{Binding Loc[action_save_set], Mode=OneWay}" Click="OnSaveStorageSetClick"
                                                                    ToolTip="{Binding Loc[tt_save_storage_json], Mode=OneWay}"
                                                                    Tag="Ghost" Padding="6,3" FontSize="10.5" Margin="0,0,6,0" />
                                                            <Button Content="{Binding Loc[action_load_ellipsis], Mode=OneWay}" Click="OnLoadStorageSetClick"
                                                                    ToolTip="{Binding Loc[tt_load_storage_replace], Mode=OneWay}"
                                                                    Tag="Ghost" Padding="6,3" FontSize="10.5" Margin="0,0,6,0" />
                                                            <Button Content="{Binding Loc[action_add_ellipsis], Mode=OneWay}" Click="OnAppendStorageSetClick"
                                                                    ToolTip="{Binding Loc[tt_add_storage_fill], Mode=OneWay}"
                                                                    Tag="Ghost" Padding="6,3" FontSize="10.5" Margin="0,0,6,0" />
                                                            <Button Content="{Binding Loc[action_sort], Mode=OneWay}" Command="{Binding Current.SortCommand}"
                                                                    ToolTip="{Binding Loc[tt_sort_by_id], Mode=OneWay}" Tag="Ghost" Padding="6,3" FontSize="10.5" Margin="0,0,6,0" />
                                                            <Button Content="{Binding Loc[action_empty_container], Mode=OneWay}" Command="{Binding Current.ClearAllCommand}"
                                                                    ToolTip="{Binding Loc[tt_empty_storage], Mode=OneWay}" Tag="Ghost" Padding="6,3" FontSize="10.5" />
                                                        </WrapPanel>
                                                        <ItemsControl ItemsSource="{Binding Options}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type vm:EquipmentOptionViewModel}">
                                                                    <Button Content="{Binding DisplayLabel}" Style="{StaticResource PrefixMetaButton}"
                                                                            Command="{Binding DataContext.StorageGroup.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </DockPanel>
                                                    <ContentControl Content="{Binding Current}" ContentTemplate="{StaticResource ContainerCompactTemplate}" />
                                                </DockPanel>
                                            </Border>
                                        </Grid>
                                        </Grid>
                                    </TabItem>
                                    <!-- A-a (segunda auditoria de Opus, Fable): con la ventana Amplia, la pestaña
                                         "Inventario" YA muestra el Almacen seleccionado al lado (A-4, arriba) - esta
                                         pestaña quedaba como un segundo camino redundante al MISMO StorageGroup,
                                         visible y clicable a la vez que su duplicado. Se oculta (no se borra: en
                                         Compacto/Normal sigue siendo el unico camino real). -->
                                    <TabItem Header="{Binding Loc[char_tab_storage], Mode=OneWay}" Visibility="{Binding IsStorageExpanded, Converter={StaticResource InverseBoolToVis}}">
                                        <Border BorderBrush="{StaticResource OrangeBrush}" BorderThickness="2" CornerRadius="10"
                                                Background="{StaticResource BgSecondaryBrush}" Padding="10" Margin="0,6,0,0">
                                            <DockPanel DataContext="{Binding StorageGroup}">
                                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                                    <!-- Auditoria de redimensionado, R-01: WrapPanel por el mismo motivo
                                                         que la cabecera de Inventario (H-08) - 5 botones en una fila no
                                                         debe poder recortar la fila de pildoras de almacen que va detras. -->
                                                    <WrapPanel DockPanel.Dock="Right">
                                                        <!-- H5-03: mismos 3 botones reales que Inventario, operando sobre
                                                             el almacen SELECCIONADO ahora mismo (Current) - igual que
                                                             Ordenar/Vaciar contenedor ya hacen aqui al lado. -->
                                                        <Button Content="{Binding Loc[action_save_set], Mode=OneWay}" Click="OnSaveStorageSetClick"
                                                                ToolTip="{Binding Loc[tt_save_storage_json], Mode=OneWay}"
                                                                Tag="Ghost" Padding="6,3" FontSize="10.5" Margin="0,0,6,0" />
                                                        <Button Content="{Binding Loc[action_load_ellipsis], Mode=OneWay}" Click="OnLoadStorageSetClick"
                                                                ToolTip="{Binding Loc[tt_load_storage_replace], Mode=OneWay}"
                                                                Tag="Ghost" Padding="6,3" FontSize="10.5" Margin="0,0,6,0" />
                                                        <Button Content="{Binding Loc[action_add_ellipsis], Mode=OneWay}" Click="OnAppendStorageSetClick"
                                                                ToolTip="{Binding Loc[tt_add_storage_fill], Mode=OneWay}"
                                                                Tag="Ghost" Padding="6,3" FontSize="10.5" Margin="0,0,6,0" />
                                                        <Button Content="{Binding Loc[action_sort], Mode=OneWay}" Command="{Binding Current.SortCommand}"
                                                                ToolTip="{Binding Loc[tt_sort_by_id], Mode=OneWay}" Tag="Ghost" Padding="6,3" FontSize="10.5" Margin="0,0,6,0" />
                                                        <Button Content="{Binding Loc[action_empty_container], Mode=OneWay}" Command="{Binding Current.ClearAllCommand}"
                                                                ToolTip="{Binding Loc[tt_empty_storage], Mode=OneWay}" Tag="Ghost" Padding="6,3" FontSize="10.5" />
                                                    </WrapPanel>
                                                    <ItemsControl ItemsSource="{Binding Options}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <!-- Auditoria de Opus, A-1: "para saber si el Banco esta lleno hay
                                                                 que pulsar su pildora y contar" - DisplayLabel ya trae el
                                                                 recuento real en vivo ("Banco (38/40)"). -->
                                                            <DataTemplate DataType="{x:Type vm:EquipmentOptionViewModel}">
                                                                <Button Content="{Binding DisplayLabel}" Style="{StaticResource PrefixMetaButton}"
                                                                        Command="{Binding DataContext.StorageGroup.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </DockPanel>
                                                <ContentControl Content="{Binding Current}" ContentTemplate="{StaticResource ContainerCompactTemplate}" />
                                            </DockPanel>
                                        </Border>
                                    </TabItem>
                                </TabControl>

                                <Border Grid.Column="1" Style="{StaticResource SidePanelCard}">
                                    <ContentControl Content="{Binding ItemEdit}" ContentTemplate="{StaticResource ItemEditTemplate}" />
                                </Border>
                            </Grid>

                            <!-- Libreria: arbol de carpetas real (vanilla + Calamity, ver
                                 LibraryViewModel.BuildCategoryTree) + buscador, SIEMPRE visible aqui abajo. -->
                            <Border Grid.Row="1" Background="{StaticResource BgSecondaryBrush}" CornerRadius="8" Padding="8">
                                <DockPanel>
                                    <!-- Cabecera SIEMPRE visible (pregunta a Opus sobre el diseño,
                                         2-sep-2026: plegar la Libreria es la mayor ganancia de
                                         espacio real de toda la pantalla, mas que optimizar las
                                         pestañas) - se puede plegar/desplegar a mano, y se
                                         auto-despliega sola al elegir "Elegir..."/"Cambiar" en
                                         cualquier slot (MainViewModel.RequestPickForSlot), para que
                                         nunca quede escondida justo cuando hace falta. -->
                                    <!-- T-H/F1: Ctrl+F ya salta aqui Y despliega esta Libreria (OnWindowKeyDown) -
                                         no se anunciaba en ningun sitio. -->
                                    <Button DockPanel.Dock="Top" Command="{Binding ToggleLibraryCollapsedCommand}"
                                            Style="{StaticResource BarButton}" ToolTip="{Binding Loc[tt_ctrlf_library], Mode=OneWay}"
                                            HorizontalContentAlignment="Stretch" Padding="8,5" Margin="0,0,0,4">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="▲ Plegar" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLibraryCollapsed}" Value="True">
                                                                <Setter Property="Text" Value="▼ Desplegar" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Loc[library_title], Mode=OneWay}" Style="{StaticResource SectionText}" FontSize="12.5" />
                                        </DockPanel>
                                    </Button>

                                    <Border DockPanel.Dock="Top" Background="{StaticResource AccentBrush}" CornerRadius="6" Padding="8,5" Margin="0,0,0,6"
                                            Visibility="{Binding Library.IsPicking, Converter={StaticResource BoolToVis}}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="{Binding Loc[action_cancel], Mode=OneWay}" Command="{Binding Library.CancelPickCommand}"
                                                    Tag="Ghost" Foreground="{StaticResource BgPrimaryBrush}" Padding="6,2" ToolTip="{Binding Loc[shortcut_esc], Mode=OneWay}" />
                                            <TextBlock Text="{Binding Loc[library_pick_item_placeholder], Mode=OneWay}"
                                                       Foreground="{StaticResource BgPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="11.5" />
                                        </DockPanel>
                                    </Border>

                                    <Grid Visibility="{Binding IsLibraryVisible, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="210" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{StaticResource BgPrimaryBrush}" CornerRadius="6"
                                                Padding="5" Margin="0,0,8,0">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Top" Content="{Binding Loc[action_view_all], Mode=OneWay}" HorizontalAlignment="Left"
                                                        Padding="5,2" FontSize="10" Margin="0,0,0,4"
                                                        Command="{Binding Library.ClearCategoryCommand}" />
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding Library.RootCategories}"
                                                                  ItemTemplate="{StaticResource CategoryNodeTemplate}" />
                                                </ScrollViewer>
                                            </DockPanel>
                                        </Border>

                                        <DockPanel Grid.Column="1">
                                            <!-- H4-01 (cuarta auditoria de Opus, Fable): MaxWidth CON
                                                 HorizontalAlignment="Left" mide al contenido (colapsaba a
                                                 ~30px vacio, crecia letra a letra al escribir) - quitado
                                                 Left, el DockPanel ya estira este hijo a lo ancho por
                                                 omision (igual que el TextBlock de resumen de debajo),
                                                 MaxWidth solo pone un techo en ventanas grandes. Marcador
                                                 de posicion real (Grid con TextBlock superpuesto,
                                                 IsHitTestVisible=False) para que se reconozca como
                                                 buscador de un vistazo, sin esperar a escribir. -->
                                            <Grid DockPanel.Dock="Top" MaxWidth="360" Margin="0,0,0,4">
                                                <TextBox x:Name="LibrarySearchBox" Text="{Binding Library.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                         Padding="7,5" Background="{StaticResource BgElevatedBrush}"
                                                         Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0"
                                                         FontSize="12"
                                                         ToolTip="{Binding Loc[tt_search_grammar_full], Mode=OneWay}" />
                                                <TextBlock Text="{Binding Loc[action_search_ellipsis], Mode=OneWay}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextSecondaryBrush}" IsHitTestVisible="False"
                                                           Visibility="{Binding Library.SearchText, Converter={StaticResource EmptyToVisible}}" />
                                            </Grid>
                                            <!-- L-b (segunda auditoria de Opus, Fable): "el aviso de 'solo validos
                                                 para el slot seleccionado' es un texto mas, facil de pasar por
                                                 alto - y ni siquiera dice CUAL slot". Pildora real y separada, con
                                                 el rol real del slot (Cabeza/Accesorio 3/Tinte...). -->
                                            <Border DockPanel.Dock="Top" Background="{StaticResource AccentMutedBrush}" CornerRadius="99"
                                                    Padding="10,4" Margin="0,0,0,6" HorizontalAlignment="Left"
                                                    Visibility="{Binding Library.SlotRestrictionLabel, Converter={StaticResource NullToVis}}">
                                                <TextBlock Style="{StaticResource CaptionText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource LocFormat}">
                                                            <Binding Path="Loc[library_only_valid_for]" Mode="OneWay" />
                                                            <Binding Path="Library.SlotRestrictionLabel" Mode="OneWay" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Border>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding Library.ResultsSummary}" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                            <!-- Pregunta a Opus sobre el diseño (2-sep-2026, quinta pasada: "la libreria
                                                 sigue sin tener las rejillas como en inventario... no debe tener scroll a
                                                 menos que sea una categoria que logicamente tiene muchos ítems"). Misma
                                                 SlotGridPanel que el resto de la app - con estos parametros reales
                                                 (medidos contra la franja real de ~772x186px) no aparece scroll hasta
                                                 ~48 resultados (4 filas x 12 columnas a MinCell=40), y con pocos
                                                 resultados la celda crece hasta MaxCell=96 topada por ReferenceColumns=10
                                                 (~73px aqui) - ni vacio ni deforme. MinCell=40 en vez de 44 a proposito:
                                                 con 44 el scroll aparecia por solo 2px de diferencia real (4*44+12=188
                                                 contra 186 disponibles). Sin AvailableHeight el panel mediria con alto
                                                 infinito y SIEMPRE elegiria MaxCell + SIEMPRE scrollearia. -->
                                            <!-- H5-13 (quinta auditoria de Opus): "el estado vacio de la Libreria...
                                                 es un rectangulo en blanco - sin busqueda/carpeta/restriccion de
                                                 slot, la mitad derecha del panel es superficie muerta". Mismo
                                                 mecanismo real ya en produccion en Investigacion (H4-07 punto 3,
                                                 ShowRootCategoryCards - subido a la base compartida por H5-15) -
                                                 tarjetas grandes (NavCardButton) a las carpetas RAIZ reales, un
                                                 atajo mas grande al mismo arbol de la izquierda. -->
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          Visibility="{Binding Library.ShowRootCategoryCards, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl ItemsSource="{Binding Library.RootCategories}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:CategoryNodeViewModel}">
                                                            <Button Style="{StaticResource NavCardButton}" Width="200" MinHeight="90" Margin="0,0,12,12"
                                                                    Command="{Binding SelectCommand}" CommandParameter="{Binding}">
                                                                <StackPanel>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                                        <Image Source="{Binding IconPath}" Width="22" Height="22" Stretch="Uniform" Margin="0,0,8,0"
                                                                               Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource SectionText}" TextWrapping="Wrap"
                                                                                   VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding ItemCountLabel, Mode=OneWay}"
                                                                               Style="{StaticResource CaptionText}" />
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                            <!-- Auditoria de Opus, L-7: x:Name muerto, sin ningun uso real en el
                                                 codigo-behind - limpieza real, no cambio de comportamiento. -->
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                          Visibility="{Binding Library.ShowRootCategoryCards, Converter={StaticResource InverseBoolToVis}}">
                                                <ItemsControl ItemsSource="{Binding Library.Results}" ItemTemplate="{StaticResource LibraryCardTemplate}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <controls:SlotGridPanel Columns="12" MinCell="40" MaxCell="90" Gap="4"
                                                                                     ReferenceColumns="10"
                                                                                     AvailableHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </DockPanel>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem Header="{Binding Loc[char_tab_buffs], Mode=OneWay}">
                        <!-- Rework 2-sep-2026, cuarta pasada (pregunta a Opus sobre el diseño).
                             Fase 1 (ya en produccion): rejilla de 44 slots reales + panel
                             Editar, mismo formato que Objetos>Inventario. Fase 2 (esta): la
                             Libreria de buffs de abajo, mismo patron exacto que la de Objetos
                             (arbol real + buscador + resultados en rejilla, plegable) pero con
                             el arbol REAL de Terrasavr para buffs (BuffLibraryTreeBuilder,
                             calcado de app.BuffSide real - no del arbol de objetos). El viejo
                             boton "Añadir buff..." desaparece, sustituido por esta Libreria. -->
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <!-- Auditoria de Opus (octava pasada, B-1) - BUG REAL de layout
                                     encontrado y arreglado: esta fila era "Auto" con el Border de
                                     abajo forzando Height="380" - exactamente el mismo
                                     anti-patron ya diagnosticado y arreglado en Objetos en la
                                     septima pasada ("un Auto con un hijo fijo cobra siempre
                                     primero, sea cual sea el alto real disponible"), pero se
                                     quedo sin aplicar aqui. En ventana grande la rejilla de
                                     buffs no crecia nunca (380px fijo, desaprovechando el
                                     espacio); en ventana minima 380+150 cabia por apenas ~30px
                                     de margen real. Mismo arreglo ya validado: "*" con
                                     MinHeight, sin altura fija en el Border. -->
                                <RowDefinition Height="3*" MinHeight="216" />
                                <!-- Segunda auditoria de Opus (Fable), B-1 - mismo bug real y
                                     mismo arreglo real que la Libreria de Objetos (ver ese
                                     comentario, mas arriba en este mismo fichero): "*" con
                                     MinHeight fijo NO colapsa de verdad al plegar - la fila
                                     dependia solo de la ventana apretando, nunca de
                                     IsBuffLibraryCollapsed. Height/MinHeight dependen ahora de
                                     IsBuffLibraryVisible. -->
                                <RowDefinition Height="{Binding IsBuffLibraryVisible, Converter={StaticResource BoolToGridLength}, ConverterParameter=2}"
                                               MinHeight="{Binding IsBuffLibraryVisible, Converter={StaticResource BoolToDouble}, ConverterParameter=200}"
                                               MaxHeight="{Binding LibraryRowMaxHeight}" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="300" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" BorderBrush="{StaticResource OrangeBrush}" BorderThickness="2" CornerRadius="10"
                                        Background="{StaticResource BgSecondaryBrush}" Padding="10" Margin="0,0,10,0">
                                    <DockPanel>
                                        <!-- H4-06 (cuarta auditoria de Opus, Fable): "la rejilla de Buffs no
                                             tiene contador ni operaciones en bloque, su gemela de objetos si" -
                                             misma cabecera real (DisplayName con recuento vivo + Vaciar todos). -->
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                            <!-- Pedido explicito del usuario (4-sep-2026): "la pestaña de buff
                                                 no tiene nada de guardar json ni tampoco cargar para guardar
                                                 combinaciones de buff" - gemelo real de los botones de
                                                 Guardar/Cargar/Añadir conjunto de objetos (H5-03), mismo
                                                 formato JSON, ver OnSaveBuffSetClick/OnLoadBuffSetClick/
                                                 OnAppendBuffSetClick. -->
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Content="{Binding Loc[action_save_set], Mode=OneWay}" Click="OnSaveBuffSetClick"
                                                        ToolTip="{Binding Loc[tt_save_buffs_json], Mode=OneWay}"
                                                        Tag="Ghost" Padding="6,3" FontSize="10.5" Margin="0,0,6,0" />
                                                <Button Content="{Binding Loc[action_load_ellipsis], Mode=OneWay}" Click="OnLoadBuffSetClick"
                                                        ToolTip="{Binding Loc[tt_load_buffs_replace], Mode=OneWay}"
                                                        Tag="Ghost" Padding="6,3" FontSize="10.5" Margin="0,0,6,0" />
                                                <Button Content="{Binding Loc[action_add_ellipsis], Mode=OneWay}" Click="OnAppendBuffSetClick"
                                                        ToolTip="{Binding Loc[tt_add_buffs_fill], Mode=OneWay}"
                                                        Tag="Ghost" Padding="6,3" FontSize="10.5" Margin="0,0,6,0" />
                                                <Button Content="{Binding Loc[action_empty_all], Mode=OneWay}" Command="{Binding Buffs.Container.ClearAllCommand}"
                                                        ToolTip="{Binding Loc[tt_empty_buffs], Mode=OneWay}" Tag="Ghost" Padding="6,3" FontSize="10.5" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Buffs.Container.DisplayName}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <ContentControl Content="{Binding Buffs.Container}" ContentTemplate="{StaticResource BuffContainerCompactTemplate}" />
                                    </DockPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource SidePanelCard}">
                                    <ContentControl Content="{Binding BuffEdit}" ContentTemplate="{StaticResource BuffEditTemplate}" />
                                </Border>
                            </Grid>

                            <!-- Libreria de buffs: mismo patron que Objetos (cabecera plegable +
                                 banner de "eligiendo" + arbol real a la izquierda + buscador y
                                 resultados en rejilla a la derecha). -->
                            <Border Grid.Row="1" Background="{StaticResource BgSecondaryBrush}" CornerRadius="8" Padding="8">
                                <DockPanel>
                                    <!-- H4-13 (cuarta auditoria de Opus, Fable): faltaba el tooltip real que su
                                         gemela de objetos SI anuncia - ahora tambien cierto aqui (Ctrl+F es
                                         contextual, ver GoToContextualLibraryCommand). -->
                                    <Button DockPanel.Dock="Top" Command="{Binding ToggleBuffLibraryCollapsedCommand}"
                                            Style="{StaticResource BarButton}" ToolTip="{Binding Loc[tt_ctrlf_buff_library], Mode=OneWay}"
                                            HorizontalContentAlignment="Stretch" Padding="8,5" Margin="0,0,0,4">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="▲ Plegar" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBuffLibraryCollapsed}" Value="True">
                                                                <Setter Property="Text" Value="▼ Desplegar" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Loc[buff_library_title], Mode=OneWay}" Style="{StaticResource SectionText}" FontSize="12.5" />
                                        </DockPanel>
                                    </Button>

                                    <Border DockPanel.Dock="Top" Background="{StaticResource AccentBrush}" CornerRadius="6" Padding="8,5" Margin="0,0,0,6"
                                            Visibility="{Binding BuffLibrary.IsPicking, Converter={StaticResource BoolToVis}}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="{Binding Loc[action_cancel], Mode=OneWay}" Command="{Binding BuffLibrary.CancelPickCommand}"
                                                    Tag="Ghost" Foreground="{StaticResource BgPrimaryBrush}" Padding="6,2" ToolTip="{Binding Loc[shortcut_esc], Mode=OneWay}" />
                                            <!-- H4-13 (cuarta auditoria de Opus, Fable): faltaba "(o arrastra)" -
                                                 arrastrar buffs desde esta Libreria funciona desde la quinta
                                                 pasada, pero el aviso no lo mencionaba (su gemelo de objetos si). -->
                                            <TextBlock Text="{Binding Loc[buff_library_pick_placeholder], Mode=OneWay}"
                                                       Foreground="{StaticResource BgPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="11.5" />
                                        </DockPanel>
                                    </Border>

                                    <Grid Visibility="{Binding IsBuffLibraryVisible, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="210" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{StaticResource BgPrimaryBrush}" CornerRadius="6"
                                                Padding="5" Margin="0,0,8,0">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Top" Content="{Binding Loc[action_view_all], Mode=OneWay}" HorizontalAlignment="Left"
                                                        Padding="5,2" FontSize="10" Margin="0,0,0,4"
                                                        Command="{Binding BuffLibrary.ClearCategoryCommand}" />
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding BuffLibrary.RootCategories}"
                                                                  ItemTemplate="{StaticResource CategoryNodeTemplate}" />
                                                </ScrollViewer>
                                            </DockPanel>
                                        </Border>

                                        <DockPanel Grid.Column="1">
                                            <!-- H4-01: mismo arreglo real que la Libreria de objetos, ver ahi el porque. -->
                                            <Grid DockPanel.Dock="Top" MaxWidth="360" Margin="0,0,0,4">
                                                <TextBox x:Name="BuffLibrarySearchBox" Text="{Binding BuffLibrary.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                         Padding="7,5" Background="{StaticResource BgElevatedBrush}"
                                                         Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0"
                                                         FontSize="12"
                                                         ToolTip="{Binding Loc[tt_search_grammar_full], Mode=OneWay}" />
                                                <TextBlock Text="{Binding Loc[action_search_ellipsis], Mode=OneWay}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextSecondaryBrush}" IsHitTestVisible="False"
                                                           Visibility="{Binding BuffLibrary.SearchText, Converter={StaticResource EmptyToVisible}}" />
                                            </Grid>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding BuffLibrary.ResultsSummary}" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                            <!-- H5-13 (quinta auditoria de Opus): mismo mecanismo real que la
                                                 Libreria de objetos de arriba, ver ahi el comentario completo. -->
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          Visibility="{Binding BuffLibrary.ShowRootCategoryCards, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl ItemsSource="{Binding BuffLibrary.RootCategories}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:CategoryNodeViewModel}">
                                                            <Button Style="{StaticResource NavCardButton}" Width="200" MinHeight="90" Margin="0,0,12,12"
                                                                    Command="{Binding SelectCommand}" CommandParameter="{Binding}">
                                                                <StackPanel>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                                        <Image Source="{Binding IconPath}" Width="22" Height="22" Stretch="Uniform" Margin="0,0,8,0"
                                                                               Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource SectionText}" TextWrapping="Wrap"
                                                                                   VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding BuffCountLabel, Mode=OneWay}"
                                                                               Style="{StaticResource CaptionText}" />
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                          Visibility="{Binding BuffLibrary.ShowRootCategoryCards, Converter={StaticResource InverseBoolToVis}}">
                                                <ItemsControl ItemsSource="{Binding BuffLibrary.Results}" ItemTemplate="{StaticResource BuffLibraryCardTemplate}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <controls:SlotGridPanel Columns="11" MinCell="40" MaxCell="90" Gap="4"
                                                                                     ReferenceColumns="10"
                                                                                     AvailableHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </DockPanel>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem Header="{Binding Loc[char_tab_research], Mode=OneWay}">
                        <!-- Antes: una unica lista plana (hasta miles de objetos, "es
                             larguisimo" - pedido explicito 2-sep-2026). Ahora: mismo arbol de
                             carpetas real que la Libreria (Research.RootCategories, ver
                             LibraryCategoryTreeBuilder) - mismos nombres y sprites de
                             siempre, solo cambia como se navega. -->
                        <DockPanel Margin="0,10,0,0">
                            <!-- R-g (segunda auditoria de Opus, Fable): "ninguna advertencia si el
                                 personaje no es Modo Viaje - el dato ya esta a mano". La
                                 Investigacion solo desbloquea recetas de verdad en Modo Viaje. -->
                            <Border DockPanel.Dock="Top" Background="{StaticResource CalamityBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,10"
                                    Visibility="{Binding Research.IsJourneyMode, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Foreground="White" TextWrapping="Wrap" FontSize="12"
                                           Text="{Binding Loc[research_not_journey_mode], Mode=OneWay}" />
                            </Border>
                            <!-- H5-02 (quinta auditoria de Opus): "Quitar toda la investigacion" -
                                 el equivalente real del "Remove All" del Terrasavr original
                                 (app.TabResearch), que hoy no existia en absoluto - junto al ya
                                 real "Investigar todo" ("Unlock All"), los 2 al mismo nivel, mismo
                                 criterio real de la app original. Barra de progreso real (R-f
                                 ya calculaba N/Total como frase, ahora tambien como barra). -->
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                    <Button Content="{Binding Loc[action_research_all], Mode=OneWay}" Tag="Accent" Command="{Binding ResearchAllCommand}" />
                                    <Button Content="{Binding Loc[action_remove_all_research], Mode=OneWay}" Tag="Ghost" Margin="8,0,0,0"
                                            Command="{Binding Research.ClearAllResearchCommand}"
                                            ToolTip="{Binding Loc[tt_remove_all_research], Mode=OneWay}" />
                                </StackPanel>
                                <ProgressBar DockPanel.Dock="Top" Margin="0,6,0,0" Height="6" Minimum="0" Maximum="1"
                                             Value="{Binding Research.ProgressFraction, Mode=OneWay}"
                                             Foreground="{StaticResource AccentBrush}"
                                             ToolTip="{Binding Research.GlobalProgressSummary}" />
                            </DockPanel>
                            <!-- H4-13 (cuarta auditoria de Opus, Fable): el mismo bloque real
                                 "arbol+resultados" va envuelto en BgSecondaryBrush en Libreria y
                                 Libreria de buffs, pero aqui iba desnudo sobre el fondo primario -
                                 mismo componente, dos tratamientos distintos sin motivo real. -->
                            <Border Background="{StaticResource BgSecondaryBrush}" CornerRadius="8" Padding="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="{StaticResource BgPrimaryBrush}" CornerRadius="6"
                                        Padding="5" Margin="0,0,8,0">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Top" Content="{Binding Loc[action_view_all], Mode=OneWay}" HorizontalAlignment="Left"
                                                Padding="5,2" FontSize="10" Margin="0,0,0,4"
                                                Command="{Binding Research.ClearCategoryCommand}" />
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Research.RootCategories}"
                                                          ItemTemplate="{StaticResource CategoryNodeTemplate}" />
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>

                                <DockPanel Grid.Column="1">
                                    <!-- R-e (segunda auditoria de Opus, Fable): "sin buscador -
                                         Libreria y Libreria de buffs si lo tienen... asimetria
                                         pura". Misma gramatica real (LibrarySearchGrammar, L-a). -->
                                    <!-- H4-01: mismo arreglo real que la Libreria de objetos, ver ahi el porque. -->
                                    <Grid DockPanel.Dock="Top" MaxWidth="360" Margin="0,0,0,4">
                                        <TextBox Text="{Binding Research.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="7,5" Background="{StaticResource BgElevatedBrush}"
                                                 Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0"
                                                 FontSize="12"
                                                 ToolTip="{Binding Loc[tt_search_grammar_research], Mode=OneWay}" />
                                        <TextBlock Text="{Binding Loc[action_search_ellipsis], Mode=OneWay}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}" IsHitTestVisible="False"
                                                   Visibility="{Binding Research.SearchText, Converter={StaticResource EmptyToVisible}}" />
                                    </Grid>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                        <!-- H5-02: "dos acciones por carpeta - Investigar esta
                                             carpeta/Quitar - junto a las dos globales" - solo
                                             tienen sentido real con una carpeta elegida. -->
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                    Visibility="{Binding Research.SelectedCategory, Converter={StaticResource NullToVis}}">
                                            <Button Content="{Binding Loc[action_research_folder], Mode=OneWay}" Tag="Ghost" Padding="6,2" FontSize="10.5"
                                                    Command="{Binding Research.ResearchFolderCommand}" Margin="0,0,6,0" />
                                            <Button Content="{Binding Loc[action_remove], Mode=OneWay}" Tag="Ghost" Padding="6,2" FontSize="10.5"
                                                    Command="{Binding Research.ClearFolderCommand}"
                                                    ToolTip="{Binding Loc[tt_remove_folder_research], Mode=OneWay}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Research.ResultsSummary}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <!-- H4-07 punto 3 (cuarta auditoria de Opus, Fable): sin
                                         carpeta ni busqueda, el area de resultados se quedaba en
                                         blanco salvo por la frase de arriba - tarjetas grandes
                                         (mismo NavCardButton real de Inicio) a las carpetas RAIZ,
                                         un atajo mas grande al mismo arbol de la izquierda. -->
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  Visibility="{Binding Research.ShowRootCategoryCards, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl ItemsSource="{Binding Research.RootCategories}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:CategoryNodeViewModel}">
                                                    <Button Style="{StaticResource NavCardButton}" Width="200" MinHeight="90" Margin="0,0,12,12"
                                                            Command="{Binding SelectCommand}" CommandParameter="{Binding}">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                                <Image Source="{Binding IconPath}" Width="22" Height="22" Stretch="Uniform" Margin="0,0,8,0"
                                                                       Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                                                                <TextBlock Text="{Binding Name}" Style="{StaticResource SectionText}" TextWrapping="Wrap"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                            <!-- H5-13 (quinta auditoria de Opus): ItemCount ya viene poblado
                                                                 real por LibraryCategoryTreeBuilder para todo nodo (Libreria e
                                                                 Investigacion comparten el mismo arbol cacheado) - un unico
                                                                 campo canonico en vez de 2 formas distintas de leer el mismo
                                                                 numero (esta usaba ItemIdsOrdered.Count a mano). -->
                                                            <TextBlock Text="{Binding ItemCountLabel, Mode=OneWay}"
                                                                       Style="{StaticResource CaptionText}" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  Visibility="{Binding Research.ShowRootCategoryCards, Converter={StaticResource InverseBoolToVis}}">
                                        <ItemsControl ItemsSource="{Binding Research.Results}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ResearchRowViewModel}">
                                                    <Border Background="{StaticResource BgElevatedBrush}" CornerRadius="4" Margin="0,0,6,6" Padding="6,4">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCalamity}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{StaticResource CalamityBrush}" />
                                                                        <Setter Property="BorderThickness" Value="1" />
                                                                    </DataTrigger>
                                                                    <!-- H5-02 (quinta auditoria de Opus): sin investigar se atenua (resaltar
                                                                         en vez de ocultar - mismo criterio real ya validado en X-c para los
                                                                         NPCs del mapa) - nunca desaparece, sigue ahi para investigarlo. -->
                                                                    <DataTrigger Binding="{Binding IsResearched}" Value="False">
                                                                        <Setter Property="Opacity" Value="0.45" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <!-- H5-02: clic real alterna investigado/no investigado - el conteo
                                                                 completo real por id (ResearchViewModel.FullResearchCount) o 0. -->
                                                            <Button Command="{Binding DataContext.Research.ToggleRowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Width="20" Height="20" Padding="0" FontSize="11" Margin="0,0,5,0"
                                                                    ToolTip="{Binding Loc[tt_toggle_researched], Mode=OneWay}">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                        <Setter Property="Tag" Value="Ghost" />
                                                                        <Setter Property="Content" Value="○" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsResearched}" Value="True">
                                                                                <Setter Property="Content" Value="✓" />
                                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                            <Image Source="{Binding IconPath}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,6,0"
                                                                   Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource CaptionText}" />
                                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                    <!-- H5-02: campo de conteo REAL editable - antes de solo lectura -
                                                                         acepta parciales a mano (investigacion real del juego). -->
                                                                    <TextBox Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}"
                                                                             Width="38" FontSize="9.5" Padding="2,0"
                                                                             Background="{StaticResource BgPrimaryBrush}"
                                                                             Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0"
                                                                             ToolTip="{Binding Loc[tt_research_count], Mode=OneWay}" />
                                                                    <!-- Auditoria de Opus, R-1: "x/N" real (VanillaResearchCountCatalog,
                                                                         extraido del TSV real de sacrificios de tModLoader) - ver
                                                                         ResearchRowViewModel.CountLabel. -->
                                                                    <TextBlock Text="{Binding CountLabel}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}"
                                                                               Margin="4,0,0,0" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Grid>
                            </Border>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="{Binding Loc[char_tab_appearance], Mode=OneWay}">
                        <!-- Auditoria de Opus, Bloque 4 (P-1): "el preview se desplaza fuera de
                             vista justo cuando mas falta hace verlo - al mover un slider de
                             color" - antes todo (preview incluido) vivia en un unico
                             ScrollViewer/StackPanel vertical. Ahora 2 columnas reales: el
                             preview se queda FIJO a la izquierda (nunca se desplaza), todo lo
                             editable (genero/peinado/tinte/colores/estadisticas) vive en su
                             propio ScrollViewer independiente a la derecha - el resultado de
                             cualquier ajuste se ve siempre, sin tener que volver a subir. -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Auditoria de redimensionado, R-07/H-07: la columna 1 de al lado ya
                                 tiene su ScrollViewer de seguridad (justo debajo) - esta no lo
                                 tenia, asi que en ventanas bajas (~700px de alto) la ultima linea
                                 del parrafo se recortaba SIN forma de alcanzarla (ni scroll ni
                                 nada). Mismo patron que el resto de la app. -->
                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel VerticalAlignment="Top" Margin="0,0,20,0">
                                <Border Background="{StaticResource BgElevatedBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                                    <Image Source="{Binding Appearance.PreviewImage}" Width="240" Height="336"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Uniform" />
                                </Border>
                                <!-- H6-06 (sexta auditoria de Opus, Tanda D - "unificar con el doll de
                                     Inicio, que YA muestra la armadura/vanidad real puesta"): fiel al
                                     guardado real (PrimaryLoadout) por defecto, igual que Inicio - este
                                     toggle apaga el overlay para ver solo piel/pelo/colores base. -->
                                <CheckBox IsChecked="{Binding Appearance.ShowEquipment}" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Loc[appearance_show_equipment], Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" />
                                </CheckBox>
                                <TextBlock Text="{Binding Loc[tt_appearance_preview], Mode=OneWay}"
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Width="240" />
                            </StackPanel>
                            </ScrollViewer>

                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <!-- H4-07 (cuarta auditoria de Opus, Fable): mismo patron real que
                                 InicioContentMaxWidth (I-c) - 640px fijos dejaban ~70% del ancho en
                                 negro en Amplio, donde las tarjetas de color (WrapPanel real) tienen
                                 sitio de sobra para repartirse en mas columnas. -->
                            <StackPanel MaxWidth="{Binding AppearanceContentMaxWidth}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="{Binding Loc[appearance_gender], Mode=OneWay}" Style="{StaticResource SectionText}" Margin="0,0,0,4" />
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton GroupName="Gender" Content="{Binding Loc[appearance_male], Mode=OneWay}" IsChecked="{Binding Appearance.IsMale}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,12,0" />
                                            <RadioButton GroupName="Gender" Content="{Binding Loc[appearance_female], Mode=OneWay}" IsChecked="{Binding Appearance.IsFemale}" Foreground="{StaticResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="{Binding Loc[appearance_hairstyle], Mode=OneWay}" Style="{StaticResource SectionText}" Margin="0,0,0,4" />
                                        <Button Command="{Binding Appearance.OpenHairPickerCommand}" Padding="8,6" HorizontalContentAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource LocFormat}">
                                                            <Binding Path="Loc[appearance_hair_style_n]" Mode="OneWay" />
                                                            <Binding Path="Appearance.HairStyle" Mode="OneWay" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock Text="&#9998;" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Loc[appearance_hair_dye], Mode=OneWay}" Style="{StaticResource SectionText}" Margin="0,0,0,4" />
                                        <Button Command="{Binding Appearance.OpenHairDyePickerCommand}" Padding="8,6" HorizontalContentAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Appearance.HairDyeDisplayName}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="&#9998;" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Selector visual de tinte de pelo - pedido explicito 1-sep-2026 (sprites en vez
                                     de escribir un id a mano) - mismo patron de overlay que el peinado de arriba. -->
                                <Border Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,18"
                                        Visibility="{Binding Appearance.IsHairDyePickerOpen, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <Button DockPanel.Dock="Right" Content="{Binding Loc[action_close], Mode=OneWay}" Command="{Binding Appearance.CloseHairDyePickerCommand}" Padding="8,3" />
                                            <TextBlock Text="{Binding Loc[appearance_choose_hair_dye], Mode=OneWay}" Style="{StaticResource SectionText}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Appearance.HairDyeOptions}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:HairDyeOptionViewModel}">
                                                        <Button Command="{Binding DataContext.Appearance.SelectHairDyeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding Index}" Margin="2" Padding="6"
                                                                Background="{StaticResource BgElevatedBrush}" BorderThickness="0"
                                                                ToolTip="{Binding DisplayName}">
                                                            <StackPanel Width="54">
                                                                <Image Source="{Binding IconPath}" Width="28" Height="28" Stretch="Uniform"
                                                                       HorizontalAlignment="Center"
                                                                       Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                                                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource CaptionText}"
                                                                           FontSize="9" TextWrapping="Wrap" TextAlignment="Center" Margin="0,3,0,0" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>

                                <!-- Selector visual de peinado - pedido explicito 1-sep-2026 (sprites en vez de
                                     ids a mano). Mismo patron de overlay que ya usan el picker de prefijo y de
                                     buffs (Border de acento superpuesto, no un Popup real). -->
                                <Border Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,18"
                                        Visibility="{Binding Appearance.IsHairPickerOpen, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <Button DockPanel.Dock="Right" Content="{Binding Loc[action_close], Mode=OneWay}" Command="{Binding Appearance.CloseHairPickerCommand}" Padding="8,3" />
                                            <TextBlock Text="{Binding Loc[appearance_choose_hairstyle], Mode=OneWay}" Style="{StaticResource SectionText}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Appearance.HairOptions}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:HairOptionViewModel}">
                                                        <!-- H6-04 (Opus, sexta pasada): Id es el valor REAL 0-based que se guarda
                                                             (CommandParameter, sin cambios) - el tooltip muestra DisplayNumber
                                                             (Id+1), el mismo numero que el propio juego enseña en su creador de
                                                             personajes real. -->
                                                        <Button Command="{Binding DataContext.Appearance.SelectHairCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding Id}" Margin="2" Padding="4"
                                                                Background="{StaticResource BgElevatedBrush}" BorderThickness="0"
                                                                ToolTip="{Binding DisplayNumber}">
                                                            <Image Source="{Binding Thumbnail}" Width="30" Height="42"
                                                                   RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Uniform" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>

                                <ItemsControl ItemsSource="{Binding Appearance.Swatches}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ColorSwatchViewModel}">
                                            <Border Background="{StaticResource BgElevatedBrush}" CornerRadius="6" Margin="0,0,10,10" Padding="10">
                                                <StackPanel Width="150">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <Border Width="20" Height="20" CornerRadius="3" Background="{Binding Preview}"
                                                                BorderBrush="{StaticResource BorderBrush0}" BorderThickness="1" Margin="0,0,7,0" />
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <Slider Minimum="0" Maximum="255" Value="{Binding R}" Foreground="#E05555" Margin="0,2" />
                                                    <Slider Minimum="0" Maximum="255" Value="{Binding G}" Foreground="#55C065" Margin="0,2" />
                                                    <Slider Minimum="0" Maximum="255" Value="{Binding B}" Foreground="#5580E0" Margin="0,2" />
                                                    <!-- Ap-c (segunda auditoria de Opus, Fable): "sin valor hexadecimal ni
                                                         paleta para los colores" - antes solo los 3 sliders en crudo, sin
                                                         ningun numero visible ni forma de pegar un color conocido de un
                                                         vistazo. Sin UpdateSourceTrigger=PropertyChanged a proposito (mismo
                                                         criterio real que "Índice (id)", T-17) - confirma al salir del
                                                         campo, no aplica un hex a medio escribir letra a letra. -->
                                                    <TextBox Text="{Binding Hex}" Padding="6,4" Margin="0,6,0,0"
                                                             Background="{StaticResource BgPrimaryBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                                             BorderThickness="0" FontFamily="Consolas" HorizontalContentAlignment="Center"
                                                             ToolTip="{Binding Loc[tt_hex_color], Mode=OneWay}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding Loc[appearance_stats], Mode=OneWay}" Style="{StaticResource SectionText}" Margin="0,20,0,8" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="{Binding Loc[appearance_difficulty], Mode=OneWay}" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding Appearance.DifficultyLabels}" SelectedIndex="{Binding Appearance.Difficulty}"
                                                  Width="120" Padding="6,4" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="{Binding Loc[appearance_health], Mode=OneWay}" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Text="{Binding Appearance.HealthNow, UpdateSourceTrigger=PropertyChanged}" Width="60" Padding="6,4"
                                                     Background="{StaticResource BgElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                                            <TextBlock Text="/" VerticalAlignment="Center" Margin="4,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBox Text="{Binding Appearance.HealthMax, UpdateSourceTrigger=PropertyChanged}" Width="60" Padding="6,4"
                                                     Background="{StaticResource BgElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Loc[appearance_mana], Mode=OneWay}" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Text="{Binding Appearance.ManaNow, UpdateSourceTrigger=PropertyChanged}" Width="60" Padding="6,4"
                                                     Background="{StaticResource BgElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                                            <TextBlock Text="/" VerticalAlignment="Center" Margin="4,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBox Text="{Binding Appearance.ManaMax, UpdateSourceTrigger=PropertyChanged}" Width="60" Padding="6,4"
                                                     Background="{StaticResource BgElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="{Binding Loc[appearance_fishing_quests], Mode=OneWay}" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Appearance.FishingQuestsCompleted, UpdateSourceTrigger=PropertyChanged}" Width="70" Padding="6,4"
                                                 Background="{StaticResource BgElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="{Binding Loc[appearance_golf_score], Mode=OneWay}" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Appearance.GolferScore, UpdateSourceTrigger=PropertyChanged}" Width="70" Padding="6,4"
                                                 Background="{StaticResource BgElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Loc[appearance_hours_played], Mode=OneWay}" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Appearance.PlayHours, UpdateSourceTrigger=PropertyChanged, StringFormat=N1}" Width="70" Padding="6,4"
                                                 Background="{StaticResource BgElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                    <TabItem Header="{Binding Loc[char_tab_spawnpoints], Mode=OneWay}">
                        <!-- S-b (segunda auditoria de Opus, Fable): "anchos fijos de 494px
                             repetidos por fila + cabecera repetida en cada fila" - cada tarjeta
                             volvia a escribir "Nombre"/"Spawn X"/"Spawn Y"/"Id" como si fuera la
                             primera vez. Grid.IsSharedSizeScope aqui (en el ancestro comun real
                             de la cabecera Y de cada fila del ItemsControl) + SharedSizeGroup
                             por columna - una UNICA fila de cabecera de verdad, con las columnas
                             de cada tarjeta sincronizadas contra ella (no solo repitiendo el
                             mismo numero fijo a mano). -->
                        <DockPanel Margin="0,10,0,0" Grid.IsSharedSizeScope="True">
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="{Binding Loc[spawn_points_intro], Mode=OneWay}"
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <Button Content="{Binding Loc[action_add_spawnpoint], Mode=OneWay}" Tag="Accent" Command="{Binding Servers.AddEntryCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                            <Grid DockPanel.Dock="Top" Margin="12,0,12,6"
                                  Visibility="{Binding Servers.Entries.Count, Converter={StaticResource CountToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" SharedSizeGroup="SpawnName" />
                                    <ColumnDefinition Width="80" SharedSizeGroup="SpawnX" />
                                    <ColumnDefinition Width="80" SharedSizeGroup="SpawnY" />
                                    <ColumnDefinition Width="70" SharedSizeGroup="SpawnId" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="SpawnMap" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="SpawnRemove" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Loc[label_name], Mode=OneWay}" Style="{StaticResource CaptionText}" Margin="0,0,14,0" />
                                <TextBlock Grid.Column="1" Text="{Binding Loc[label_spawn_x], Mode=OneWay}" Style="{StaticResource CaptionText}" Margin="0,0,14,0" />
                                <TextBlock Grid.Column="2" Text="{Binding Loc[label_spawn_y], Mode=OneWay}" Style="{StaticResource CaptionText}" Margin="0,0,14,0" />
                                <!-- S-d (segunda auditoria de Opus, Fable): "'Id' ocupa el mismo protagonismo
                                     que los campos utiles, pese a decir 'no suele hacer falta tocarlo'" - tono
                                     secundario real (TextSecondaryBrush) tambien en la cabecera. -->
                                <TextBlock Grid.Column="3" Text="{Binding Loc[label_id], Mode=OneWay}" Style="{StaticResource CaptionText}" Foreground="{StaticResource TextSecondaryBrush}"
                                           ToolTip="{Binding Loc[tt_world_internal_id], Mode=OneWay}" />
                            </Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Servers.Entries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ServerEntryRowViewModel}">
                                            <Border Background="{StaticResource BgElevatedBrush}" CornerRadius="6" Margin="0,0,0,8" Padding="12,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="220" SharedSizeGroup="SpawnName" />
                                                        <ColumnDefinition Width="80" SharedSizeGroup="SpawnX" />
                                                        <ColumnDefinition Width="80" SharedSizeGroup="SpawnY" />
                                                        <ColumnDefinition Width="70" SharedSizeGroup="SpawnId" />
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="SpawnMap" />
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="SpawnRemove" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,14,0"
                                                             Background="{StaticResource BgPrimaryBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                                                    <TextBox Grid.Column="1" Text="{Binding SpawnX, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,14,0"
                                                             Background="{StaticResource BgPrimaryBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                                                    <TextBox Grid.Column="2" Text="{Binding SpawnY, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,14,0"
                                                             Background="{StaticResource BgPrimaryBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                                                    <TextBox Grid.Column="3" Text="{Binding WorldId, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,14,0" FontSize="11"
                                                             Background="{StaticResource BgPrimaryBrush}" Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="0"
                                                             ToolTip="{Binding Loc[tt_world_internal_id], Mode=OneWay}" />
                                                    <!-- S-c (segunda auditoria de Opus, Fable): "sin enlace al mapa de
                                                         Exploracion" - salta a Exploracion y centra el mapa en estas
                                                         coordenadas exactas (mismo mecanismo real ya usado por los NPCs). -->
                                                    <Button Grid.Column="4" Content="{Binding Loc[action_view_on_map], Mode=OneWay}" FontSize="10.5" Padding="6,4" Margin="0,0,10,0"
                                                            VerticalAlignment="Center" Tag="Ghost"
                                                            ToolTip="{Binding Loc[tt_goto_map_spawn], Mode=OneWay}"
                                                            Command="{Binding DataContext.ViewSpawnOnMapCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <!-- T-F (segunda auditoria de Opus, Fable): CircleCloseButton (gira 90° y se tiñe
                                                         de rojo al pasar el raton, gesto real de Terrasavr) existia en Theme.xaml sin
                                                         que ningun boton "quitar" real lo usara todavia - este es el candidato real. -->
                                                    <Button Grid.Column="5" Content="✕" Style="{StaticResource CircleCloseButton}" VerticalAlignment="Center"
                                                            ToolTip="{Binding Loc[tt_remove_spawnpoint], Mode=OneWay}"
                                                            Command="{Binding DataContext.Servers.RemoveEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="{Binding Loc[char_tab_unlocks], Mode=OneWay}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                            <!-- D-a (segunda auditoria de Opus, Fable): las demas pestañas internas de
                                 Personaje (Inicio, Apariencia...) fijan HorizontalAlignment="Left" junto a
                                 su MaxWidth - sin el, Stretch (el valor por defecto) centra el StackPanel
                                 entero en vez de pegarlo al borde izquierdo real, unica de estas dos que
                                 se veia descentrada frente al resto. -->
                            <!-- D-b (segunda auditoria de Opus, Fable): "13 casillas planas, sin
                                 agrupar, en una columna sola" - 4 subtitulos reales agrupando por
                                 familia (modo de dificultad, antorchas de bioma, consumibles
                                 permanentes de las Bound NPC quests, eventos/otros).
                                 H5-09 (quinta auditoria de Opus): las 4 familias ya agrupadas de D-b
                                 pasan de columna unica a tarjetas reales dentro de un WrapPanel - con
                                 sitio real (DetailContentMaxWidth) se reparten en 2-3 columnas en vez
                                 de una tira vertical larguisima. -->
                            <StackPanel MaxWidth="{Binding DetailContentMaxWidth}" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Loc[unlocks_intro], Mode=OneWay}"
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,10" />

                                <!-- D-d (segunda auditoria de Opus, Fable): "sin accion en bloque para
                                     los flags" - marcar/desmarcar una a una era el unico camino, incluso
                                     para el caso real mas comun (un completista, "todos los desbloqueos
                                     puestos" de golpe). -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="{Binding Loc[action_check_all], Mode=OneWay}" Tag="Ghost" Padding="8,4" Margin="0,0,8,0" Command="{Binding Flags.MarkAllCommand}" />
                                    <Button Content="{Binding Loc[action_uncheck_all], Mode=OneWay}" Tag="Ghost" Padding="8,4" Command="{Binding Flags.MarkNoneCommand}" />
                                </StackPanel>

                                <!-- Bug real encontrado verificando H5-09 con el arnes UIA (captura
                                     h5-09-desbloqueos-amplio.png), no en el hallazgo original: Border
                                     con CornerRadius recorta silenciosamente cualquier hijo que se pase
                                     de su ancho (mismo mecanismo real de WPF que ya redondea las
                                     esquinas), y CheckBox.Content como string NO hace word-wrap por
                                     defecto (ContentPresenter, a diferencia de TextBlock.Text, no hereda
                                     TextWrapping) - a 260px varias etiquetas largas ("Alcance de mesa de
                                     trabajo aumentado...") se veian cortadas en seco contra el borde de
                                     la tarjeta. Contenido explicito con TextBlock TextWrapping="Wrap" en
                                     vez de Content="..." plano en los 13 CheckBox de este bloque. -->
                                <WrapPanel>
                                    <Border Background="{StaticResource BgSecondaryBrush}" CornerRadius="8" Padding="14" Margin="0,0,10,10" Width="280">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Loc[flag_difficulty_mode], Mode=OneWay}" Style="{StaticResource CaptionText}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <CheckBox IsChecked="{Binding Flags.ExtraAccessory}" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Loc[flag_extra_accessory], Mode=OneWay}" TextWrapping="Wrap" MaxWidth="210" Foreground="{StaticResource TextPrimaryBrush}" />
                                            </CheckBox>
                                            <!-- D-e (segunda auditoria de Opus, Fable): "sin aviso si el flag no
                                                 existe todavia en la version real del personaje" - umbrales reales
                                                 YA verificados en PlrBodySerializer (no inventados): por debajo,
                                                 Guardar pierde el cambio en silencio (el campo ni se escribe). -->
                                            <TextBlock Text="{Binding Loc[version_warning_1_3_0], Mode=OneWay}"
                                                       Style="{StaticResource CaptionText}" Foreground="{StaticResource OrangeBrush}" TextWrapping="Wrap" Margin="0,-4,0,0"
                                                       Visibility="{Binding Flags.ExtraAccessoryBelowVersion, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{StaticResource BgSecondaryBrush}" CornerRadius="8" Padding="14" Margin="0,0,10,10" Width="280">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Loc[flag_biome_torches_group], Mode=OneWay}" Style="{StaticResource CaptionText}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <CheckBox IsChecked="{Binding Flags.UnlockedBiomeTorches}" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Loc[flag_biome_torch_unlocked], Mode=OneWay}" TextWrapping="Wrap" MaxWidth="210" Foreground="{StaticResource TextPrimaryBrush}" />
                                            </CheckBox>
                                            <CheckBox IsChecked="{Binding Flags.UsingBiomeTorches}" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Loc[flag_biome_torch_active], Mode=OneWay}" TextWrapping="Wrap" MaxWidth="210" Foreground="{StaticResource TextPrimaryBrush}" />
                                            </CheckBox>
                                            <TextBlock Text="{Binding Loc[version_warning_1_4_0_5], Mode=OneWay}"
                                                       Style="{StaticResource CaptionText}" Foreground="{StaticResource OrangeBrush}" TextWrapping="Wrap" Margin="0,-4,0,0"
                                                       Visibility="{Binding Flags.BiomeTorchesBelowVersion, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{StaticResource BgSecondaryBrush}" CornerRadius="8" Padding="14" Margin="0,0,10,10" Width="280">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Loc[flag_permanent_consumables_group], Mode=OneWay}" Style="{StaticResource CaptionText}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <CheckBox IsChecked="{Binding Flags.ArtisanBread}" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Loc[flag_workbench_range], Mode=OneWay}" TextWrapping="Wrap" MaxWidth="210" Foreground="{StaticResource TextPrimaryBrush}" />
                                            </CheckBox>
                                            <CheckBox IsChecked="{Binding Flags.VitalCrystal}" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Loc[flag_life_regen], Mode=OneWay}" TextWrapping="Wrap" MaxWidth="210" Foreground="{StaticResource TextPrimaryBrush}" />
                                            </CheckBox>
                                            <CheckBox IsChecked="{Binding Flags.AegisFruit}" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Loc[flag_defense_boost], Mode=OneWay}" TextWrapping="Wrap" MaxWidth="210" Foreground="{StaticResource TextPrimaryBrush}" />
                                            </CheckBox>
                                            <CheckBox IsChecked="{Binding Flags.ArcaneCrystal}" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Loc[flag_mana_regen], Mode=OneWay}" TextWrapping="Wrap" MaxWidth="210" Foreground="{StaticResource TextPrimaryBrush}" />
                                            </CheckBox>
                                            <CheckBox IsChecked="{Binding Flags.GalaxyPearl}" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Loc[flag_luck_boost], Mode=OneWay}" TextWrapping="Wrap" MaxWidth="210" Foreground="{StaticResource TextPrimaryBrush}" />
                                            </CheckBox>
                                            <CheckBox IsChecked="{Binding Flags.GummyWorm}" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Loc[flag_fishing_power], Mode=OneWay}" TextWrapping="Wrap" MaxWidth="210" Foreground="{StaticResource TextPrimaryBrush}" />
                                            </CheckBox>
                                            <CheckBox IsChecked="{Binding Flags.Ambrosia}" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Loc[flag_mining_speed], Mode=OneWay}" TextWrapping="Wrap" MaxWidth="210" Foreground="{StaticResource TextPrimaryBrush}" />
                                            </CheckBox>
                                            <TextBlock Text="{Binding Loc[version_warning_1_4_4_0], Mode=OneWay}"
                                                       Style="{StaticResource CaptionText}" Foreground="{StaticResource OrangeBrush}" TextWrapping="Wrap" Margin="0,-4,0,0"
                                                       Visibility="{Binding Flags.ExtraUsingFlagsBelowVersion, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{StaticResource BgSecondaryBrush}" CornerRadius="8" Padding="14" Margin="0,0,10,10" Width="280">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Loc[flag_events_group], Mode=OneWay}" Style="{StaticResource CaptionText}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <CheckBox IsChecked="{Binding Flags.FinishedDD2Event}" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Loc[flag_dd2_event], Mode=OneWay}" TextWrapping="Wrap" MaxWidth="210" Foreground="{StaticResource TextPrimaryBrush}" />
                                            </CheckBox>
                                            <TextBlock Text="{Binding Loc[version_warning_1_3_4], Mode=OneWay}"
                                                       Style="{StaticResource CaptionText}" Foreground="{StaticResource OrangeBrush}" TextWrapping="Wrap" Margin="0,-4,0,8"
                                                       Visibility="{Binding Flags.FinishedDD2EventBelowVersion, Converter={StaticResource BoolToVis}}" />
                                            <CheckBox IsChecked="{Binding Flags.UnlockedSuperMinecart}" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Loc[flag_super_minecart_unlocked], Mode=OneWay}" TextWrapping="Wrap" MaxWidth="210" Foreground="{StaticResource TextPrimaryBrush}" />
                                            </CheckBox>
                                            <CheckBox IsChecked="{Binding Flags.UsingSuperMinecart}" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Loc[flag_super_minecart_active], Mode=OneWay}" TextWrapping="Wrap" MaxWidth="210" Foreground="{StaticResource TextPrimaryBrush}" />
                                            </CheckBox>
                                            <TextBlock Text="{Binding Loc[version_warning_below_253], Mode=OneWay}"
                                                       Style="{StaticResource CaptionText}" Foreground="{StaticResource OrangeBrush}" TextWrapping="Wrap" Margin="0,-4,0,0"
                                                       Visibility="{Binding Flags.SuperMinecartBelowVersion, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{Binding Loc[char_tab_version], Mode=OneWay}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                            <!-- D-a (segunda auditoria de Opus, Fable): mismo arreglo que Desbloqueos,
                                 arriba - HorizontalAlignment="Left" real, no centrado por omision.
                                 H5-09: mismo DetailContentMaxWidth compartido. -->
                            <StackPanel MaxWidth="{Binding DetailContentMaxWidth}" HorizontalAlignment="Left">
                                <Border Background="{StaticResource CalamityBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,14">
                                    <TextBlock Foreground="White" TextWrapping="Wrap" FontSize="12"
                                               Text="{Binding Loc[version_warning_change], Mode=OneWay}" />
                                </Border>
                                <!-- V-c (segunda auditoria de Opus, Fable): "bajar de version no
                                     advierte de lo que se pierde - el aviso generico no dice que
                                     secciones dejaran de guardarse, los datos reales del personaje
                                     ya estan a mano para decirlo con numeros". -->
                                <Border Background="{StaticResource OrangeBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,14"
                                        Visibility="{Binding VersionEditor.DowngradeWarning, Converter={StaticResource NullToVis}}">
                                    <TextBlock Foreground="White" TextWrapping="Wrap" FontSize="12" Text="{Binding VersionEditor.DowngradeWarning}" />
                                </Border>
                                <TextBlock Text="{Binding Loc[version_raw_number], Mode=OneWay}" Style="{StaticResource SectionText}" Margin="0,0,0,4" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBox Text="{Binding VersionEditor.RawVersion, UpdateSourceTrigger=PropertyChanged}"
                                             Width="90" Padding="6,4" HorizontalAlignment="Left"
                                             Background="{StaticResource BgElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                                    <!-- H3-14 (tercera auditoria de Opus, Fable): "279 se muestra crudo,
                                         nunca '1.4.4.0+'" - resumen legible real (mismo calco de
                                         TabVersion.getBestText que VersionEditorViewModel.BestMatchLabel). -->
                                    <TextBlock Text="{Binding VersionEditor.BestMatchLabel}" Style="{StaticResource CaptionText}"
                                               VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>

                                <!-- H5-09: los 4 grupos reales (1.1.x/1.2.x/1.3.x/1.4.x) se repartian en
                                     una columna unica pese a ser candidatos naturales a ir lado a lado -
                                     mismo WrapPanel real que el resto de la app, con sitio real
                                     (DetailContentMaxWidth) entran los 4 a la vez en Amplio. -->
                                <ItemsControl ItemsSource="{Binding VersionEditor.Groups}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:VersionGroup}">
                                            <StackPanel Margin="0,0,24,14" Width="200">
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource CaptionText}" Margin="0,0,0,6" />
                                                <ItemsControl ItemsSource="{Binding Options}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:VersionOption}">
                                                            <!-- V-a (segunda auditoria de Opus, Fable): mismo patron real ya usado en la
                                                                 rejilla de prefijos (D-6, IsCurrent) - antes ningun boton de version
                                                                 indicaba cual era la YA puesta, habia que leer el numero en crudo de al
                                                                 lado y hacer la cuenta a mano.
                                                                 H4-11 (cuarta auditoria de Opus, Fable): "otro lenguaje visual que el
                                                                 resto de selectores" - pintaba Background/FontWeight a mano en vez de
                                                                 usar la misma pildora con Tag="Accent" que el resto de la app. -->
                                                            <Button Content="{Binding Label}" Style="{StaticResource VersionOptionButton}"
                                                                    Command="{Binding DataContext.VersionEditor.SetVersionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding Number}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </DockPanel>
            </Grid>
        </TabItem>

        <!-- ===================== BUILDS ===================== -->
        <TabItem Header="{Binding Loc[tab_builds], Mode=OneWay}" ToolTip="Ctrl+3">
            <DockPanel Margin="14">
                <!-- Bd-d (segunda auditoria de Opus, Fable): "buscador/filtro por clase" - antes
                     una unica lista plana de TODAS las clases de TODAS las etapas de golpe. -->
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Builds.ClassFilterOptions}" Margin="0,0,0,10">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BuildClassFilterOptionViewModel}">
                            <Button Content="{Binding Label}" Style="{StaticResource PrefixMetaButton}"
                                    Command="{Binding DataContext.Builds.SelectClassFilterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TabControl Style="{StaticResource InnerTabControl}">
                <TabItem Header="Vanilla">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Builds.VanillaStages}" Margin="4,10,0,0" />
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Calamity Mod">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Builds.CalamityStages}" Margin="4,10,0,0" />
                    </ScrollViewer>
                </TabItem>
                </TabControl>
            </DockPanel>
        </TabItem>

        <!-- ===================== NOVEDADES ===================== -->
        <!-- Pedido explicito del usuario (2-sep-2026): "dos pestañas, una con las novedades de
             Terraria vanilla y otra de tModLoader y Calamity Mod" - antes una unica lista
             mezclando las dos cosas bajo la etiqueta generica "JUEGO". -->
        <TabItem Header="{Binding Loc[tab_whatsnew], Mode=OneWay}" ToolTip="Ctrl+4">
            <DockPanel Margin="14">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,10">
                    <Run Text="{Binding Loc[whatsnew_intro_1], Mode=OneWay}" />
                    <Run Text="{Binding Loc[whatsnew_intro_game], Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                    <Run Text="{Binding Loc[whatsnew_intro_2], Mode=OneWay}" />
                    <Run Text="{Binding Loc[whatsnew_intro_link], Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                    <Run Text="." />
                </TextBlock>
                <TabControl Style="{StaticResource InnerTabControl}">
                    <!-- H5-09: MaxWidth compartido (DetailContentMaxWidth) + las tarjetas de version
                         pasan de tira unica a UniformGrid de verdad (DetailCardColumns, 2 en Amplio)
                         en vez de "una tira unica" (texto literal del hallazgo). -->
                    <TabItem Header="Terraria">
                        <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="{Binding DetailContentMaxWidth}" HorizontalAlignment="Left">
                                <ItemsControl ItemsSource="{Binding WhatsNew.VanillaEntries}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="{Binding DetailCardColumns}" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="tModLoader / Calamity Mod">
                        <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="{Binding DetailContentMaxWidth}" HorizontalAlignment="Left">
                                <ItemsControl ItemsSource="{Binding WhatsNew.CalamityEntries}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="{Binding DetailCardColumns}" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </TabItem>

        <!-- ===================== EXPLORACION ===================== -->
        <TabItem Header="{Binding Loc[tab_exploration], Mode=OneWay}" ToolTip="Ctrl+5">
            <DockPanel Margin="14">
                <!-- Auditoria de redimensionado, R-11/§4.11: endurecimiento SIN defecto medido -
                     un StackPanel horizontal nunca envuelve ni recorta, empuja fuera de la
                     ventana en silencio si no cabe. Con el nombre de mundo mas largo real de esta
                     maquina sobraban ~100px a 1080px, pero el margen es pequeño y depende de un
                     dato del usuario (Terraria permite nombres bastante mas largos). WrapPanel +
                     tope al titulo lo hacen imposible en vez de solo improbable. -->
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button Content="{Binding Loc[explore_load_world], Mode=OneWay}" Tag="Accent" Click="OnLoadWorldClick"
                            IsEnabled="{Binding Exploration.IsNotLoading}" />
                    <TextBlock Style="{StaticResource SectionText}" VerticalAlignment="Center" Margin="20,0,0,0"
                               MaxWidth="320" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Exploration.IsWorldLoaded, Converter={StaticResource BoolToVis}}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource LocFormat}">
                                <Binding Path="Loc[explore_world_title]" Mode="OneWay" />
                                <Binding Path="Exploration.WorldTitle" Mode="OneWay" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <!-- X-h (segunda auditoria de Opus, Fable): "no dice que es solo lectura" -
                         antes solo un comentario de codigo (ExplorationViewModel), invisible para
                         el usuario real - nada en pantalla avisaba de que este visor no puede
                         colocar/quitar bloques (a diferencia de Objetos/Apariencia/etc., donde
                         cada cambio SI se guarda). -->
                    <Border Background="{StaticResource BgElevatedBrush}" CornerRadius="99" Padding="9,3" Margin="10,0,0,0"
                            VerticalAlignment="Center" ToolTip="{Binding Loc[explore_readonly_tooltip], Mode=OneWay}"
                            Visibility="{Binding Exploration.IsWorldLoaded, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Loc[explore_readonly_badge], Mode=OneWay}" Style="{StaticResource CaptionText}" />
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding Exploration.IsWorldLoaded, Converter={StaticResource BoolToVis}}">
                        <!-- P-8 (auditoria Opus vs TEdit): "−"/"+" eran los unicos botones sin
                             tooltip de la fila; "Restablecer" no decia a que restablecia. -->
                        <!-- P-1 (auditoria Opus vs TEdit): el indicador de porcentaje se mudo a la
                             franja de estado fija bajo el mapa (mas cerca de donde se mira al
                             hacer zoom) - los botones de aqui se quedan, solo se fue el numero. -->
                        <!-- F-9 (auditoria Opus vs TEdit, E-09): atajos anunciados en el ToolTip del
                             boton equivalente - "es la mitad del valor" (cita literal del informe),
                             mismo criterio ya usado por T-H/F1 en la barra superior. Solo activos
                             con Exploracion en pantalla y el foco fuera de un TextBox. -->
                        <Button Content="&#8722;" Command="{Binding Exploration.ZoomOutCommand}" Padding="10,2"
                                ToolTip="{Binding Loc[explore_zoom_out], Mode=OneWay}" />
                        <Button Content="+" Command="{Binding Exploration.ZoomInCommand}" Padding="10,2" Margin="4,0,0,0"
                                ToolTip="{Binding Loc[explore_zoom_in], Mode=OneWay}" />
                        <!-- P-5 (auditoria Opus vs TEdit): escala de espaciado unica del proyecto
                             (4/6/10/14/20) - 4 entre hermanos directos (−/+, ya lo eran), 10
                             entre controles relacionados (antes 8, sin motivo real). -->
                        <Button Content="{Binding Loc[action_reset], Mode=OneWay}" Command="{Binding Exploration.ZoomResetCommand}" Padding="8,2" Margin="10,0,0,0"
                                ToolTip="{Binding Loc[explore_zoom_100], Mode=OneWay}" />
                        <!-- X-a (segunda auditoria de Opus, Fable): "Restablecer" vuelve al 100%,
                             que para un mundo de 8400x2400 significa ver el 12% del ancho - "la
                             accion mas obviamente ausente de la pantalla". El calculo real (necesita
                             el tamaño real del viewport del ScrollViewer, que la ViewModel no
                             conoce) vive en el code-behind, igual que el resto de gestos del mapa. -->
                        <Button Content="{Binding Loc[explore_fit_window], Mode=OneWay}" Click="OnFitToWindowClick" Padding="8,2" Margin="10,0,0,0"
                                ToolTip="(0)" />
                        <!-- F-12 (auditoria Opus vs TEdit, E-13): "genera un WriteableBitmap
                             completo del mundo y lo congela - un PngBitmapEncoder son ~8 lineas.
                             No existe." -->
                        <Button Content="{Binding Loc[explore_export_png], Mode=OneWay}" Click="OnExportMapClick" Padding="8,2" Margin="10,0,0,0"
                                ToolTip="{Binding Loc[explore_export_png_tooltip], Mode=OneWay}" />
                    </StackPanel>
                </WrapPanel>

                <!-- H5-11 (quinta auditoria de Opus): "el lanzador de mundos desaparece para
                     siempre en cuanto cargas uno" - tira PERMANENTE de pildoras (visible con
                     mundo cargado o no, a diferencia del overlay grande de mas abajo, que solo
                     vive en el estado vacio) para poder pasar de un mundo a otro sin volver al
                     dialogo de Explorador cada vez. -->
                <!-- C-07 (auditoria de pulido final, cierra E1): 20px de aire por encima (10 del
                     WrapPanel de arriba + 10 de aqui) y 0 por debajo - el lienzo del mapa quedaba
                     pegado a las pildoras. Escala 4/6/10/14/20 ya fijada por P-5: 4 arriba (deja
                     14 sumando el margen inferior del WrapPanel superior) y 10 abajo. -->
                <DockPanel DockPanel.Dock="Top" Margin="0,4,0,10"
                           Visibility="{Binding Exploration.Worlds.Count, Converter={StaticResource CountToVis}}">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Loc[explore_your_worlds], Mode=OneWay}" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button DockPanel.Dock="Left" Content="{Binding Loc[home_refresh], Mode=OneWay}" FontSize="11" Padding="8,2" Margin="0,0,10,0"
                            Command="{Binding Exploration.RefreshWorldsCommand}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Exploration.Worlds}" ItemTemplate="{StaticResource WorldPillTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Exploration.StatusMessage}"
                           Style="{StaticResource CaptionText}" Margin="0,10,0,0" TextWrapping="Wrap" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <!-- X-f (segunda auditoria de Opus, Fable): "columna de NPCs 220px fija" -
                             Auto+MinWidth/MaxWidth (mismo criterio ya establecido en el resto de la
                             app, ver ContainerViewModel/AddContainer) en vez de un numero fijo que
                             nunca respira con la ventana - el mapa ("*") se sigue llevando siempre
                             todo el sobrante real. -->
                        <!-- Punto 4 (advisor Opus, ESPEC-ui-exploracion.md#8-D4): la columna crece de
                             220-300 a 260-380 - inventario + resultados no cabian en el ancho anterior
                             (TEdit diseña este mismo panel a 400px, FindSidebarView.xaml:12).
                             Auditoria de redimensionado, R-02/H-02: el MaxWidth se movio de aqui al
                             DockPanel de abajo - una ColumnDefinition Width="Auto" mide su contenido
                             con ancho INFINITO antes de aplicar el MaxWidth, asi que el WrapPanel de
                             las 5 pildoras de categoria nunca envolvia de verdad (pedia 408px en una
                             sola fila) y WPF recortaba la diferencia sin reorganizar nada - "Objetos"
                             perdia 60 de 97px, A CUALQUIER tamaño de ventana, incluido 4K. -->
                        <!-- F-10 (auditoria de Opus vs TEdit, E-10): sustituye por completo el
                             mecanismo Auto+MaxWidth de arriba (R-02/H-02) por un GridSplitter real
                             - la columna ahora es un GridLength LITERAL (Settings.
                             ExplorationSidebarWidth, TwoWay), que se mide con un ancho REAL desde
                             el principio, asi que el bug de "Auto mide con ancho infinito" queda
                             eliminado de raiz (no solo evitado). MinWidth=0 para que plegar a 0
                             sea alcanzable; el suelo real de 260 al expandir lo aplica
                             OnExplorationSidebarWidthChanged en el propio ViewModel. -->
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="{Binding Settings.ExplorationSidebarWidth, Mode=TwoWay, Converter={x:Static conv:DoubleToGridLengthConverter.Instance}}"
                                          MinWidth="0" MaxWidth="520" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource BgSecondaryBrush}" CornerRadius="8" Margin="0,0,10,0">
                        <Grid>
                        <DockPanel>
                            <!-- P-1 (auditoria de Opus vs TEdit, cierra E-01 estetico): antes esta
                                 caja aparecia/desaparecia con el hover (Visibility=EmptyToCollapsed)
                                 y el mapa CAMBIABA DE ALTO al entrar/salir el raton (estaba en
                                 DockPanel.Dock=Bottom del mismo DockPanel que el mapa) - salto de
                                 layout constante. Ahora: altura FIJA (Height=26), SIEMPRE presente,
                                 con campos separados (F-6 los calcula: HoverCoordText/LayerText/
                                 DepthText/TileText/WallText/LiquidText, "—" cuando no hay hover, la
                                 franja nunca cambia de tamaño). El Viewbox DownOnly es el mismo
                                 recurso real de TEdit (MainWindow.xaml:276, Viewbox
                                 StretchDirection=DownOnly en su barra de estado) - en vez de
                                 recortar campos en una ventana estrecha, el texto se encoge
                                 tipograficamente entero. El tooltip flotante que sigue al cursor
                                 (mas abajo) NO se toca, sigue usando HoverInfo tal cual. -->
                            <Border x:Name="MapStatusBar" DockPanel.Dock="Bottom" Background="{StaticResource BgElevatedBrush}"
                                    CornerRadius="0,0,8,8" Height="26" Padding="10,0">
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Stretch">
                                    <DockPanel LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Loc[explore_zoom_label], Mode=OneWay}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Exploration.Zoom, StringFormat={}{0:P0}}" Style="{StaticResource BodyText}"
                                                       FontSize="11" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Exploration.HoverCoordText}" Style="{StaticResource BodyText}" FontSize="11" VerticalAlignment="Center" />
                                            <Border Width="1" Background="{StaticResource BorderBrush0}" Margin="10,5" />
                                            <!-- Color real de la zona (map_colors.json, MapColorCatalog.Global -
                                                 el mismo que ya pinta el fondo del mapa, WorldRenderer.cs:39) -
                                                 color CON SIGNIFICADO, no decorativo. -->
                                            <TextBlock Text="{Binding Exploration.HoverLayerText}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                                                <TextBlock.Foreground>
                                                    <SolidColorBrush Color="{Binding Exploration.HoverLayerColor}" />
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                            <TextBlock Text=" · " Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Exploration.HoverDepthText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                            <Border Width="1" Background="{StaticResource BorderBrush0}" Margin="10,5" />
                                            <TextBlock Text="{Binding Exploration.HoverTileText}" Style="{StaticResource BodyText}" FontSize="11" VerticalAlignment="Center"
                                                       MaxWidth="180" TextTrimming="CharacterEllipsis" />
                                            <Border Width="1" Background="{StaticResource BorderBrush0}" Margin="10,5" />
                                            <TextBlock Text="{Binding Exploration.HoverWallText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                                       MaxWidth="150" TextTrimming="CharacterEllipsis" />
                                            <Border Width="1" Background="{StaticResource BorderBrush0}" Margin="10,5" />
                                            <TextBlock Text="{Binding Exploration.HoverLiquidText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DockPanel>
                                </Viewbox>
                            </Border>
                            <!-- Arrastrar para desplazar (pan) + rueda para zoom, sin necesitar Ctrl - los
                                 gestores reales viven en el code-behind (MainWindow.xaml.cs) porque
                                 necesitan tocar los offsets del ScrollViewer, que la ViewModel no conoce.
                                 Cursor="Hand" (no "SizeAll", las 4 flechas que el usuario rechazo
                                 explicitamente 1-sep-2026) - WPF no trae un cursor de "mano de agarre"
                                 nativo como el pan de TEdit/Photoshop, esto es lo mas cercano sin
                                 fabricar un .cur propio. -->
                            <Grid>
                                <ScrollViewer x:Name="WorldMapScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                              PreviewMouseWheel="OnWorldMapPreviewMouseWheel"
                                              PreviewMouseLeftButtonDown="OnWorldMapMouseDown"
                                              PreviewMouseMove="OnWorldMapMouseMove"
                                              PreviewMouseLeftButtonUp="OnWorldMapMouseUp"
                                              MouseLeave="OnWorldMapMouseLeave"
                                              ScrollChanged="OnWorldMapScrollChanged"
                                              Cursor="Hand">
                                    <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <Grid.LayoutTransform>
                                            <ScaleTransform ScaleX="{Binding Exploration.Zoom}" ScaleY="{Binding Exploration.Zoom}" />
                                        </Grid.LayoutTransform>
                                        <Image x:Name="WorldMapImage" Source="{Binding Exploration.WorldImage}" Stretch="None"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                               HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
                                        <!-- Punto 4 (Minerales, "Marcar en el mapa" - ver ESPEC-ui-exploracion.md#11.3):
                                             capa de resaltado, una SEGUNDA Image dentro del MISMO Grid escalado -
                                             hereda zoom/desplazamiento gratis, sin tocar MainWindow.xaml.cs. Null =
                                             sin marcar nada (WorldHighlightRenderer nunca se llama). -->
                                        <Image Source="{Binding Exploration.WorldHighlight}" Stretch="None"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                               HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
                                        <ItemsControl ItemsSource="{Binding Exploration.Npcs}" IsHitTestVisible="True">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><Canvas IsItemsHost="True" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding TileX}" />
                                                    <Setter Property="Canvas.Top" Value="{Binding TileY}" />
                                                    <!-- X-c (segunda auditoria de Opus, Fable): "el buscador de NPCs
                                                         oculta marcadores del mapa" - Npcs ya no se filtra (arriba,
                                                         siempre completo), esto RESALTA los que coinciden en vez de
                                                         ocultar los que no (atenuados, no invisibles - siguen dando su
                                                         posicion real). Sin busqueda activa, IsMatch=true para todos,
                                                         cero cambio visual respecto a como estaba. -->
                                                    <Setter Property="Opacity" Value="1" />
                                                    <Setter Property="Panel.ZIndex" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMatch}" Value="False">
                                                            <Setter Property="Opacity" Value="0.25" />
                                                            <Setter Property="Panel.ZIndex" Value="0" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <!-- H6-08/H6-09/H6-10 (sexta auditoria de Opus, "el mapa muestra puntos
                                                     rosas que el usuario cree que son mascotas -en realidad son NPCs,
                                                     concretamente las mascotas de pueblo reales 637/638/656- deberia
                                                     verse solo cabezas de NPC"): CABEZA real (Images/NPC_Head_{indice}
                                                     real, el mismo asset e indice reales que usa el propio mapa del
                                                     juego - ver NpcHeadProfile.cs, portado de TownNPCProfiles.cs
                                                     decompilado), no el cuerpo entero de pie (IconPath, que se queda
                                                     para la lista lateral). Ancla CENTRADA (una cabeza no tiene "pies"
                                                     con los que anclar abajo, a diferencia del sprite de cuerpo
                                                     anterior). Si el juego real tampoco tiene cabeza para ese NPC
                                                     (OldMan/SkeletonMerchant, HeadIconPath null) cae al punto magenta
                                                     de siempre. -->
                                                <DataTemplate DataType="{x:Type vm:WorldNpcRowViewModel}">
                                                    <!-- F-2 (auditoria de Opus vs TEdit, E-03/P-3): mismo tratamiento de
                                                         tamaño constante que el marcador de resultado - ver el
                                                         comentario completo mas abajo, en WorldSearchHitRowViewModel. -->
                                                    <Grid ToolTip="{Binding Name}" Cursor="Hand" RenderTransformOrigin="0.5,0.5">
                                                        <Grid.RenderTransform>
                                                            <ScaleTransform ScaleX="{Binding DataContext.Exploration.Zoom, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static conv:InverseValueConverter.Instance}}"
                                                                            ScaleY="{Binding DataContext.Exploration.Zoom, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static conv:InverseValueConverter.Instance}}" />
                                                        </Grid.RenderTransform>
                                                        <Image Source="{Binding HeadIconPath}" Width="16" Stretch="Uniform"
                                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                               Margin="-8,-8,0,0"
                                                               Visibility="{Binding HeadIconPath, Converter={StaticResource NullToVis}}" />
                                                        <Ellipse Width="11" Height="11" Margin="-5.5,-5.5,0,0"
                                                                 Fill="Magenta" Stroke="White" StrokeThickness="1.5"
                                                                 Visibility="{Binding HeadIconPath, Converter={StaticResource NullToCollapsed}}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- X-g (segunda auditoria de Opus, Fable): "el mapa no sabe nada
                                             del personaje real" - antes Exploracion era un visor totalmente
                                             independiente de Personaje. Marcador real (estrella violeta,
                                             color del acento de la app - distinto a proposito del magenta de
                                             "NPC sin icono") en la aparicion principal y cada Spawn Point
                                             real guardado. -->
                                        <ItemsControl ItemsSource="{Binding Exploration.CharacterSpawns}" IsHitTestVisible="True">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><Canvas IsItemsHost="True" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding TileX}" />
                                                    <Setter Property="Canvas.Top" Value="{Binding TileY}" />
                                                    <Setter Property="Panel.ZIndex" Value="2" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:CharacterSpawnRowViewModel}">
                                                    <!-- F-2 (auditoria de Opus vs TEdit, E-03/P-3): mismo tratamiento de
                                                         tamaño constante que el marcador de resultado (ver comentario
                                                         completo mas abajo, WorldSearchHitRowViewModel). -->
                                                    <TextBlock Text="&#9733;" FontSize="18" Foreground="{StaticResource AccentBrush}"
                                                               Margin="-9,-18,0,0" ToolTip="{Binding Label}" Cursor="Hand"
                                                               RenderTransformOrigin="0.5,0.5">
                                                        <TextBlock.RenderTransform>
                                                            <ScaleTransform ScaleX="{Binding DataContext.Exploration.Zoom, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static conv:InverseValueConverter.Instance}}"
                                                                            ScaleY="{Binding DataContext.Exploration.Zoom, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static conv:InverseValueConverter.Instance}}" />
                                                        </TextBlock.RenderTransform>
                                                        <TextBlock.Effect>
                                                            <DropShadowEffect ShadowDepth="0" BlurRadius="3" Color="Black" Opacity="0.9" />
                                                        </TextBlock.Effect>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- F-7 (auditoria de Opus vs TEdit, E-06): spawn del MUNDO
                                             (Header.SpawnX/Y - antes solo se usaba para calcular
                                             distancia, ningun marcador en el mapa) y mazmorra
                                             (DungeonX/Y, antes ni siquiera se leian - ver
                                             WldReader.cs). Tabla de forma+color de P-3: casa
                                             naranja para el spawn del mundo (distinto a proposito
                                             de la estrella violeta = spawn del PERSONAJE, arriba),
                                             rombo hueco rojo para la mazmorra. Mismo tratamiento de
                                             tamaño constante (RenderTransform inverso al Zoom) que
                                             el resto de marcadores. -->
                                        <!-- C-01 (auditoria de pulido final, cierra E4b): los dos
                                             marcadores eran hijos DIRECTOS de este Grid (el mismo
                                             que lleva el ScaleTransform), y Canvas.Left/Top son
                                             propiedades adjuntas que SOLO lee un panel Canvas en su
                                             ArrangeOverride - un Grid las ignora sin error ni aviso.
                                             Envueltos en su propio Canvas (mismo patron que los tres
                                             ItemsControl vecinos, cuyo ItemsPanel ya es un Canvas
                                             real), Canvas.Left/Top empiezan a posicionar de verdad. -->
                                        <Canvas IsHitTestVisible="True">
                                            <TextBlock Text="&#8962;" FontSize="18" Foreground="{StaticResource OrangeBrush}"
                                                       Canvas.Left="{Binding Exploration.WorldSpawnX}" Canvas.Top="{Binding Exploration.WorldSpawnY}"
                                                       Margin="-9,-9,0,0" ToolTip="{Binding Loc[explore_world_spawn], Mode=OneWay}" Cursor="Hand"
                                                       Visibility="{Binding Exploration.IsWorldLoaded, Converter={StaticResource BoolToVis}}"
                                                       Panel.ZIndex="2" RenderTransformOrigin="0.5,0.5">
                                                <TextBlock.RenderTransform>
                                                    <ScaleTransform ScaleX="{Binding Exploration.Zoom, Converter={x:Static conv:InverseValueConverter.Instance}}"
                                                                    ScaleY="{Binding Exploration.Zoom, Converter={x:Static conv:InverseValueConverter.Instance}}" />
                                                </TextBlock.RenderTransform>
                                                <TextBlock.Effect>
                                                    <DropShadowEffect ShadowDepth="0" BlurRadius="3" Color="Black" Opacity="0.9" />
                                                </TextBlock.Effect>
                                            </TextBlock>
                                            <TextBlock Text="&#9671;" FontSize="18" Foreground="{StaticResource CalamityBrush}"
                                                       Canvas.Left="{Binding Exploration.WorldDungeonX}" Canvas.Top="{Binding Exploration.WorldDungeonY}"
                                                       Margin="-9,-9,0,0" ToolTip="{Binding Loc[explore_dungeon], Mode=OneWay}" Cursor="Hand"
                                                       Visibility="{Binding Exploration.IsWorldLoaded, Converter={StaticResource BoolToVis}}"
                                                       Panel.ZIndex="2" RenderTransformOrigin="0.5,0.5">
                                                <TextBlock.RenderTransform>
                                                    <ScaleTransform ScaleX="{Binding Exploration.Zoom, Converter={x:Static conv:InverseValueConverter.Instance}}"
                                                                    ScaleY="{Binding Exploration.Zoom, Converter={x:Static conv:InverseValueConverter.Instance}}" />
                                                </TextBlock.RenderTransform>
                                                <TextBlock.Effect>
                                                    <DropShadowEffect ShadowDepth="0" BlurRadius="3" Color="Black" Opacity="0.9" />
                                                </TextBlock.Effect>
                                            </TextBlock>
                                        </Canvas>
                                        <!-- Bug real reportado por el usuario (6-sep-2026, captura): en
                                             "Cofre a cofre", con la casilla de acercar marcada, al
                                             seleccionar un cofre el mapa NO lo marcaba de forma que se
                                             distinguiera - hubo que buscarlo a mano con el raton. Causa
                                             real: la capa de marcadores de aqui abajo se alimenta SOLO de
                                             WorldSearchResults, y "Cofre a cofre" es la unica vista con su
                                             propia lista (ChestRows), que no aparecia en ninguna capa del
                                             mapa. Un marcador para el cofre actual (uno solo, no las
                                             cientos de filas de la lista), con el MISMO lenguaje visual que
                                             el resultado activo de la busqueda: marco teal hueco de 24px y
                                             tamaño constante en pantalla via ScaleTransform inverso al
                                             Zoom, igual que sus vecinos. -->
                                        <Canvas IsHitTestVisible="False">
                                            <Rectangle x:Name="CurrentChestMarker" Width="24" Height="24" Margin="-12,-12,0,0"
                                                       Stroke="{StaticResource TealBrush}" StrokeThickness="2.5" Fill="Transparent"
                                                       Canvas.Left="{Binding Exploration.CurrentChestX}" Canvas.Top="{Binding Exploration.CurrentChestY}"
                                                       Visibility="{Binding Exploration.HasCurrentChest, Converter={StaticResource BoolToVis}}"
                                                       Panel.ZIndex="4" RenderTransformOrigin="0.5,0.5">
                                                <Rectangle.RenderTransform>
                                                    <ScaleTransform ScaleX="{Binding Exploration.Zoom, Converter={x:Static conv:InverseValueConverter.Instance}}"
                                                                    ScaleY="{Binding Exploration.Zoom, Converter={x:Static conv:InverseValueConverter.Instance}}" />
                                                </Rectangle.RenderTransform>
                                            </Rectangle>
                                        </Canvas>
                                        <!-- Punto 4 (feedback del usuario, "buscador de todo tipo de
                                             objetos del mundo") - Fase 1 de ESPEC-buscador-mundo-tedit.md
                                             (advisor Opus): capa de marcadores WPF por encima del mapa en
                                             vez de oscurecerlo entero (seccion 5.3 punto 6 del espec,
                                             decision deliberada frente al overlay por shader de TEdit) -
                                             mismo mecanismo Canvas+TileX/TileY ya usado por NPCs/Spawns
                                             arriba. -->
                                        <ItemsControl ItemsSource="{Binding Exploration.WorldSearchResults}" IsHitTestVisible="True">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><Canvas IsItemsHost="True" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding TileX}" />
                                                    <Setter Property="Canvas.Top" Value="{Binding TileY}" />
                                                    <Setter Property="Panel.ZIndex" Value="3" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <!-- F-2 + P-3 (auditoria de Opus vs TEdit, E-03): antes una elipse
                                                     RELLENA que escalaba con el Zoom del Grid contenedor (a "Ajustar a
                                                     la ventana" en un mundo Grande, ~0,09 de zoom, quedaba en menos de
                                                     1px). Ahora: (1) marco HUECO (Rectangle con Stroke, sin Fill - dejа
                                                     ver que hay debajo, mismo espiritu que la reticula de 4 barras de
                                                     TEdit, WorldRenderXna.xaml.cs:6919-6922), (2) tamaño CONSTANTE en
                                                     pantalla via un RenderTransform inverso al Zoom del mapa (no
                                                     afecta al layout, Canvas.Left/Top en coordenadas de tile se
                                                     conserva gratis) - 10px normal, 24px el resultado activo, igual
                                                     que el rango real 24-48px de TEdit, (3) pulso de un solo ciclo al
                                                     convertirse en el resultado activo (EnterActions de la
                                                     DataTrigger, mismo mecanismo Storyboard/DoubleAnimation ya usado
                                                     en Theme.xaml:280-310/373-398).
                                                     Fase 3 (ESPEC-buscador-mundo-tedit.md#5.3 punto 4): el resultado
                                                     "actual" de Anterior/Siguiente sigue siendo el mas grande - gemelo
                                                     visual real de ShowCrosshair/GoToCurrentResult de TEdit. -->
                                                <DataTemplate DataType="{x:Type vm:WorldSearchHitRowViewModel}">
                                                    <Grid ToolTip="{Binding Name}" Cursor="Hand">
                                                        <Grid.RenderTransform>
                                                            <ScaleTransform ScaleX="{Binding DataContext.Exploration.Zoom, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static conv:InverseValueConverter.Instance}}"
                                                                            ScaleY="{Binding DataContext.Exploration.Zoom, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static conv:InverseValueConverter.Instance}}" />
                                                        </Grid.RenderTransform>
                                                        <Grid.RenderTransformOrigin>0.5,0.5</Grid.RenderTransformOrigin>
                                                        <!-- Anillo de pulso: invisible en reposo (Opacity=0), un solo ciclo
                                                             de Storyboard al llegar a ser el resultado activo. -->
                                                        <Rectangle x:Name="PulseRing" Width="10" Height="10" Margin="-5,-5,0,0"
                                                                   Stroke="{StaticResource TealBrush}" StrokeThickness="1.5" Fill="Transparent"
                                                                   Opacity="0" RenderTransformOrigin="0.5,0.5">
                                                            <Rectangle.RenderTransform>
                                                                <ScaleTransform x:Name="PulseScale" ScaleX="1" ScaleY="1" />
                                                            </Rectangle.RenderTransform>
                                                        </Rectangle>
                                                        <Rectangle x:Name="Marco" Width="10" Height="10" Margin="-5,-5,0,0"
                                                                   Stroke="{StaticResource TealBrush}" StrokeThickness="1.5" Fill="Transparent" />
                                                    </Grid>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter TargetName="Marco" Property="Width" Value="24" />
                                                            <Setter TargetName="Marco" Property="Height" Value="24" />
                                                            <Setter TargetName="Marco" Property="Margin" Value="-12,-12,0,0" />
                                                            <Setter TargetName="Marco" Property="StrokeThickness" Value="2.5" />
                                                            <Setter TargetName="Marco" Property="Panel.ZIndex" Value="1" />
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleX"
                                                                                         From="1" To="1.6" Duration="0:0:0.4">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <QuadraticEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                        <DoubleAnimation Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleY"
                                                                                         From="1" To="1.6" Duration="0:0:0.4">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <QuadraticEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                        <DoubleAnimation Storyboard.TargetName="PulseRing" Storyboard.TargetProperty="Opacity"
                                                                                         From="1" To="0" Duration="0:0:0.4" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </ScrollViewer>

                                <!-- Tooltip flotante que sigue al cursor sobre el mapa (estilo TEdit),
                                     ADEMAS del texto fijo de abajo (pedido explicito 1-sep-2026: "tambien
                                     tiene que decirlo cuando pasas el raton por encima", sin quitar el de
                                     abajo). Canvas superpuesto en vez de Popup real - un Popup es un HWND
                                     aparte y parpadea al mover el raton rapido; el Canvas se recorta solo
                                     al area visible del mapa. Reposicionado a mano en
                                     OnWorldMapMouseMove (MainWindow.xaml.cs), que es quien ya conoce la
                                     posicion real del cursor sobre el mapa. -->
                                <Canvas x:Name="MapTooltipCanvas" IsHitTestVisible="False">
                                    <Border x:Name="MapTooltipBorder" Background="{StaticResource BgElevatedBrush}"
                                            CornerRadius="4" Padding="8,4" Effect="{StaticResource CardShadow}"
                                            Visibility="{Binding Exploration.HoverInfo, Converter={StaticResource EmptyToCollapsed}}">
                                        <TextBlock Text="{Binding Exploration.HoverInfo}" Style="{StaticResource CaptionText}" />
                                    </Border>
                                </Canvas>
                            </Grid>
                        </DockPanel>

                        <!-- Auditoria de Opus, X-7/T-13: leer+pintar un mundo real (~1.4s
                             medidos en uno de 11MB de esta maquina) es el unico freeze real
                             medido de toda la ronda (personaje ~8ms, "Investigar todo" ~3ms,
                             ninguno de los dos perceptible) - se hizo async (Task.Run,
                             ExplorationViewModel.LoadFromPathAsync) y este overlay avisa de
                             verdad mientras dura, en vez de que la ventana parezca colgada. -->
                        <!-- P-8 (auditoria Opus vs TEdit): el tinte oscuro solo tiene sentido si hay
                             un mapa anterior real debajo que tapar (recarga de otro mundo) - con el
                             lienzo ya vacio (primera carga) oscurecerlo no aporta nada. -->
                        <Border Background="#B0000000" CornerRadius="8"
                                Visibility="{Binding Exploration.IsLoadingOverExistingWorld, Converter={StaticResource BoolToVis}}" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding Exploration.IsLoading, Converter={StaticResource BoolToVis}}">
                            <ProgressBar IsIndeterminate="True" Width="160" Height="6" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="{Binding Loc[explore_loading_map], Mode=OneWay}" Style="{StaticResource CaptionText}" Margin="0,10,0,0" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- F-8 (auditoria de Opus vs TEdit, E-05): "la unica referencia espacial
                             cuando estas ampliado son las dos barras del ScrollViewer - no hay
                             ninguna vista en miniatura". Reutiliza el bitmap del mundo YA
                             congelado (WorldRenderer.cs) - un segundo Image con el mismo Source,
                             sin renderizar nada de nuevo. El rectangulo de viewport y el clic
                             para navegar viven en el code-behind (UpdateMinimapViewport/
                             OnMinimapClick, MainWindow.xaml.cs) - necesitan la geometria real
                             del ScrollViewer, que la ViewModel no conoce. Plegable (persistido,
                             Settings.IsMinimapVisible): en MinWidth=1080 un minimapa fijo se come
                             sitio real. -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"
                                Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource BorderBrush0}"
                                BorderThickness="1" CornerRadius="6" Padding="3" Effect="{StaticResource CardShadow}"
                                Visibility="{Binding Exploration.IsWorldLoaded, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="2,0,2,2">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Loc[explore_map_label], Mode=OneWay}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                    <Button DockPanel.Dock="Right" Content="&#8964;" Tag="Ghost" Padding="4,0" FontSize="10"
                                            Click="OnToggleMinimapClick"
                                            ToolTip="{Binding Loc[explore_toggle_minimap], Mode=OneWay}" />
                                </DockPanel>
                                <!-- C-02 (auditoria de pulido final, cierra E2): cinturon de
                                     seguridad ademas del recorte real en UpdateMinimapViewport -
                                     ningun contenedor de esta jerarquia (Border/StackPanel/Grid)
                                     llevaba ClipToBounds, y en WPF el valor por omision es False
                                     para los tres por igual. -->
                                <Grid ClipToBounds="True" Visibility="{Binding Settings.IsMinimapVisible, Converter={StaticResource BoolToVis}}">
                                    <Image x:Name="MinimapImage" Source="{Binding Exploration.WorldImage}" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Width="220" Height="63" MouseLeftButtonDown="OnMinimapClick" Cursor="Hand"
                                           SizeChanged="OnMinimapSizeChanged" />
                                    <Canvas IsHitTestVisible="False">
                                        <Rectangle x:Name="MinimapViewportRect" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Fill="Transparent" />
                                    </Canvas>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- H4-08 (cuarta auditoria de Opus, Fable): "la version buena - un
                             lanzador de mundos calcado del de personajes de Inicio" - antes solo
                             "Sin mundo cargado." en el tamaño de letra mas pequeño de la app, en
                             la esquina inferior izquierda. Mismo patron real que el overlay de
                             IsLoading de arriba (centrado en el propio lienzo) mas el mismo
                             escaneo asincrono/tarjetas ya probado en HomeViewModel.
                             H5-11 (quinta auditoria de Opus): el listado real de "Tus mundos" (antes
                             SOLO vivia aqui dentro, atado a IsEmpty) se mudo a la tira permanente de
                             pildoras de la barra superior (siempre visible, con mundo cargado o no) -
                             este overlay se queda solo con el aviso "Sin mundo cargado" y el boton de
                             carga directa, tal y como el informe pide explicitamente para el primer
                             arranque. -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="640"
                                    Visibility="{Binding Exploration.IsEmpty, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding Loc[explore_no_world_loaded], Mode=OneWay}" Style="{StaticResource TitleText}" FontSize="18"
                                       HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14"
                                        Visibility="{Binding Exploration.IsScanningWorlds, Converter={StaticResource BoolToVis}}">
                                <ProgressBar IsIndeterminate="True" Width="120" Height="4" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Loc[explore_scanning_worlds], Mode=OneWay}" Style="{StaticResource CaptionText}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="{Binding Loc[explore_load_prompt], Mode=OneWay}" Style="{StaticResource CaptionText}"
                                       HorizontalAlignment="Center" Margin="0,0,0,10"
                                       Visibility="{Binding Exploration.ScanMessage, Converter={StaticResource EmptyToCollapsed}}" />
                            <Button Content="{Binding Loc[explore_load_world], Mode=OneWay}" Tag="Accent" Click="OnLoadWorldClick" HorizontalAlignment="Center"
                                    Visibility="{Binding Exploration.ScanMessage, Converter={StaticResource EmptyToCollapsed}}" />
                        </StackPanel>
                        </Grid>
                    </Border>

                    <!-- F-10: 5px de agarre real pero 1px de linea visible en reposo, 3px de
                         acento al pasar el raton o arrastrar - mismo lenguaje real que TEdit
                         (MainWindow.xaml:451-477, "VS Code style: subtle until hovered/dragged"),
                         reimplementado con los pinceles del propio tema (nada nuevo). -->
                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                  Background="Transparent" ShowsPreview="False">
                        <GridSplitter.Style>
                            <Style TargetType="GridSplitter">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Settings.ExplorationSidebarWidth}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </GridSplitter.Style>
                        <GridSplitter.Template>
                            <ControlTemplate TargetType="GridSplitter">
                                <Border Background="Transparent">
                                    <Border x:Name="Linea" Width="1" HorizontalAlignment="Center" Background="{StaticResource BorderBrush0}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Linea" Property="Width" Value="3" />
                                        <Setter TargetName="Linea" Property="Background" Value="{StaticResource AccentBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </GridSplitter.Template>
                    </GridSplitter>

                    <!-- Bug real reportado por el usuario probando la app (6-sep-2026): "en todas
                         las secciones de Exploracion se pierde contenido con el scroll". Causa real
                         medida con el arnes (AR-11a/AR-11c): esta columna era un DockPanel PELADO,
                         sin ninguna via de scroll. Un DockPanel sirve a sus hijos Dock=Top/Bottom
                         PRIMERO y le deja al relleno (el contenido de la categoria: chips, botones y
                         la lista real) solo lo que sobre - a 1080x700 con "Este mundo" desplegado
                         eso eran 14px, y los chips "Por tipo de cofre"/"Por lo que contienen"/
                         "Cofre a cofre", "Marcar en el mapa"/"Quitar marcas", "Buscar seleccionados"
                         y "NPCs que faltan" quedaban recortados 14-17px SIN ninguna barra con la que
                         llegar a ellos: contenido perdido de verdad, en las 5 categorias.
                         El arreglo es un ScrollViewer con Height ligado al ViewportHeight del PROPIO
                         ScrollViewer mas un MinHeight real:
                           - Ventana con sitio: Height = viewport exacto -> reparto IDENTICO al de
                             antes (listas estiradas, sin barra, nada cambia).
                           - Ventana baja: gana MinHeight -> el contenido pasa a ser mas alto que el
                             viewport y aparece la barra; nada se pierde.
                         Height (no MinHeight a secas sobre el DockPanel) es deliberado: el
                         ScrollViewer mide a su hijo con alto INFINITO, y un ListBox medido con
                         infinito realiza TODOS sus contenedores - justo la virtualizacion que F-5
                         monto para las listas largas (cientos de cofres). Con Height/MinHeight la
                         medida es SIEMPRE finita y la virtualizacion sigue viva.
                         MinHeight=600 no es un numero redondo al azar: el viewport real de esta
                         columna al tamaño por defecto del arnes (1180x860) son 626px medidos, y
                         AR-11f comprueba de forma permanente que a ese tamaño NO aparece barra
                         (con 640 aparecia por 14px - el scroll debe ser la red de seguridad, no
                         el modo normal de usar la columna). -->
                    <ScrollViewer Grid.Column="2" x:Name="ExplorationSidebarScroll"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <DockPanel x:Name="ExplorationSidebarPanel"
                               Height="{Binding ViewportHeight, ElementName=ExplorationSidebarScroll, Mode=OneWay}"
                               MinHeight="600">
                        <!-- Punto 4 (advisor Opus, "una nueva barra lateral... que ya no solo salgan
                             los npc, eso se traslada dentro de una rama madre donde salgan varios
                             botones" - ver ESPEC-ui-exploracion.md#9). Rediseño completo: la lista de
                             NPCs deja de vivir suelta, pasa a ser una categoria mas (D3: fila de
                             pildoras en vez de TabControl/Expander - TEdit se permite 4 pestañas
                             porque diseña este panel a 400px, aqui son 260-380). -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Loc[explore_search_title], Mode=OneWay}" Style="{StaticResource SectionText}" />
                                <TextBlock Text="{Binding Loc[explore_search_subtitle], Mode=OneWay}" Style="{StaticResource CaptionText}"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"
                                           Visibility="{Binding Exploration.IsWorldLoaded, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                            <!-- F-10: plegado real - alterna entre el ancho guardado y 0 (logica
                                 en el code-behind, OnToggleExplorationSidebarClick, para poder
                                 recordar el ancho de antes de plegar sin perderlo). -->
                            <Button Grid.Column="1" Content="&#8250;" Tag="Ghost" Padding="6,2" VerticalAlignment="Top"
                                    Click="OnToggleExplorationSidebarClick"
                                    ToolTip="{Binding Loc[explore_collapse_sidebar], Mode=OneWay}" />
                        </Grid>

                        <!-- F-14 (auditoria de Opus vs TEdit, E-16/E-17): "Este mundo" - Expander
                             bajo la cabecera (no una 6ª pildora, para no tocar el WrapPanel de 5
                             que R-02 ya dejo bien medido). Empieza colapsado, mismo criterio que
                             "NPCs que faltan" (X-f). Todo el contenido ya estaba calculado
                             (WldHeader/WorldPresenceIndex) - esto es solo un sitio real donde
                             verlo de un vistazo, cero recorridos nuevos. -->
                        <Expander DockPanel.Dock="Top" Header="{Binding Loc[explore_this_world], Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,8" IsExpanded="False"
                                  Visibility="{Binding Exploration.IsWorldLoaded, Converter={StaticResource BoolToVis}}">
                            <!-- AR-11a: desplegado, este bloque pedia ~225px de golpe y se los
                                 quitaba al contenido de la categoria (que en un DockPanel cobra el
                                 ultimo). Con tope + scroll propio deja de poder vaciar la columna, y
                                 lo que no cabe sigue siendo alcanzable dentro del propio Expander. -->
                            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Style="{StaticResource CaptionText}">
                                    <Run Text="{Binding Loc[explore_seed_label], Mode=OneWay}" /><Run Text="{Binding Exploration.WorldSeedText, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0">
                                    <Run Text="{Binding Loc[explore_version_label], Mode=OneWay}" /><Run Text="{Binding Exploration.WorldVersionText, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" />
                                </TextBlock>
                                <!-- Hallazgo real (feedback directo del usuario, 5-sep-2026): unica
                                     excepcion real a "Solo lectura" en toda la app - la dificultad
                                     del mundo, las 4 posibilidades reales de Terraria (ver tambien
                                     el tooltip actualizado de la insignia "Solo lectura" de arriba).
                                     Mismo patron de chips (RadioButton+EnumEquals) ya usado abajo
                                     para ChestViewMode/ObjectsViewMode - tocar un chip NUNCA
                                     escribe nada por si solo, solo cambia la seleccion en memoria;
                                     el boton "Guardar" (solo activo si de verdad cambio algo) es
                                     el UNICO punto que toca el archivo real. -->
                                <TextBlock Text="{Binding Loc[appearance_difficulty], Mode=OneWay}" Style="{StaticResource CaptionText}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,4" />
                                <!-- AR-11b: cuartos, todavia mas estrechos que los tercios de Cofres
                                     - mismo TextBlock hijo con Wrap por el mismo motivo real. -->
                                <UniformGrid Columns="4">
                                    <RadioButton Style="{StaticResource ViewSelector}" GroupName="DificultadMundo" Padding="2,4" Margin="0,0,3,0"
                                                 IsChecked="{Binding Exploration.WorldGameMode, Converter={StaticResource EnumEquals}, ConverterParameter=0}">
                                        <TextBlock Text="{Binding Loc[explore_gamemode_classic], Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center" />
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource ViewSelector}" GroupName="DificultadMundo" Padding="2,4" Margin="3,0,3,0"
                                                 IsChecked="{Binding Exploration.WorldGameMode, Converter={StaticResource EnumEquals}, ConverterParameter=1}">
                                        <TextBlock Text="{Binding Loc[explore_gamemode_expert], Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center" />
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource ViewSelector}" GroupName="DificultadMundo" Padding="2,4" Margin="3,0,3,0"
                                                 IsChecked="{Binding Exploration.WorldGameMode, Converter={StaticResource EnumEquals}, ConverterParameter=2}">
                                        <TextBlock Text="{Binding Loc[explore_gamemode_master], Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center" />
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource ViewSelector}" GroupName="DificultadMundo" Padding="2,4" Margin="3,0,0,0"
                                                 IsChecked="{Binding Exploration.WorldGameMode, Converter={StaticResource EnumEquals}, ConverterParameter=3}">
                                        <TextBlock Text="{Binding Loc[explore_gamemode_journey], Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center" />
                                    </RadioButton>
                                </UniformGrid>
                                <Button Content="{Binding Loc[explore_save_difficulty], Mode=OneWay}" Margin="0,6,0,0" HorizontalAlignment="Stretch"
                                        Command="{Binding Exploration.SaveWorldGameModeCommand}"
                                        ToolTip="{Binding Loc[explore_save_difficulty_tooltip], Mode=OneWay}" />
                                <TextBlock Text="{Binding Exploration.WorldGameModeSaveStatus}" Style="{StaticResource CaptionText}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"
                                           Visibility="{Binding Exploration.WorldGameModeSaveStatus, Converter={StaticResource NullToCollapsed}}" />
                                <Border Height="1" Background="{StaticResource BorderBrush0}" Margin="0,8" />
                                <TextBlock Style="{StaticResource CaptionText}">
                                    <Run Text="{Binding Loc[explore_air_label], Mode=OneWay}" /><Run Text="{Binding Exploration.WorldAirPercentText, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <Run Text="{Binding Loc[explore_tile_types_label], Mode=OneWay}" /><Run Text="{Binding Exploration.ObjectsPillCount, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <Run Text="{Binding Loc[explore_walls_label], Mode=OneWay}" /><Run Text="{Binding Exploration.WallTypesPresentCount, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0">
                                    <Run Text="{Binding Loc[explore_chests_label], Mode=OneWay}" /><Run Text="{Binding Exploration.ChestsPillCount, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <Run Text="{Binding Loc[explore_signs_label], Mode=OneWay}" /><Run Text="{Binding Exploration.SignCount, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <Run Text="{Binding Loc[explore_npcs_label], Mode=OneWay}" /><Run Text="{Binding Exploration.Npcs.Count, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" />
                                </TextBlock>
                                <Button Content="{Binding Loc[explore_save_report], Mode=OneWay}" Tag="Ghost" Margin="0,8,0,0" HorizontalAlignment="Left" Padding="8,3"
                                        Click="OnSaveWorldReportClick" />
                            </StackPanel>
                            </ScrollViewer>
                        </Expander>

                        <!-- 9.1: selector de categoria - RadioButton real (GroupName real de WPF),
                             IsChecked de doble via con EnumEquals (el proyecto no tiene un
                             EnumToBooleanConverter generico y 5 propiedades bool serian mas
                             verboso). Cada pildora lleva su contador real. -->
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <!-- Bug real encontrado con el arnes (UI Automation, no a ciegas de una
                                 captura): Content="{Binding ..., StringFormat=...}" como ATRIBUTO
                                 del RadioButton perdia el StringFormat en runtime (el Name real de
                                 automatizacion salia "14", no "NPCs (14)") - un TextBlock hijo con
                                 el mismo StringFormat, el patron YA establecido en el resto de este
                                 fichero para cualquier texto formateado, si funciona. -->
                            <RadioButton Style="{StaticResource CategorySelector}" GroupName="ExploracionCategoria"
                                         IsEnabled="{Binding Exploration.IsWorldLoaded}" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding Loc[explore_load_first], Mode=OneWay}"
                                         IsChecked="{Binding Exploration.SelectedCategory, Converter={StaticResource EnumEquals}, ConverterParameter=All}">
                                <TextBlock Text="{Binding Loc[explore_category_all], Mode=OneWay}" />
                            </RadioButton>
                            <RadioButton Style="{StaticResource CategorySelector}" GroupName="ExploracionCategoria"
                                         IsEnabled="{Binding Exploration.IsWorldLoaded}" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding Loc[explore_load_first], Mode=OneWay}"
                                         IsChecked="{Binding Exploration.SelectedCategory, Converter={StaticResource EnumEquals}, ConverterParameter=Npcs}">
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LocFormat}">
                                            <Binding Path="Loc[explore_pill_npcs]" Mode="OneWay" />
                                            <Binding Path="Exploration.Npcs.Count" Mode="OneWay" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </RadioButton>
                            <RadioButton Style="{StaticResource CategorySelector}" GroupName="ExploracionCategoria"
                                         IsEnabled="{Binding Exploration.IsWorldLoaded}" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding Loc[explore_load_first], Mode=OneWay}"
                                         IsChecked="{Binding Exploration.SelectedCategory, Converter={StaticResource EnumEquals}, ConverterParameter=Chests}">
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LocFormat}">
                                            <Binding Path="Loc[explore_pill_chests]" Mode="OneWay" />
                                            <Binding Path="Exploration.ChestsPillCount" Mode="OneWay" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </RadioButton>
                            <RadioButton Style="{StaticResource CategorySelector}" GroupName="ExploracionCategoria"
                                         IsEnabled="{Binding Exploration.IsWorldLoaded}" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding Loc[explore_load_first], Mode=OneWay}"
                                         IsChecked="{Binding Exploration.SelectedCategory, Converter={StaticResource EnumEquals}, ConverterParameter=Ores}">
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LocFormat}">
                                            <Binding Path="Loc[explore_pill_ores]" Mode="OneWay" />
                                            <Binding Path="Exploration.OresPillCount" Mode="OneWay" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </RadioButton>
                            <RadioButton Style="{StaticResource CategorySelector}" GroupName="ExploracionCategoria"
                                         IsEnabled="{Binding Exploration.IsWorldLoaded}" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding Loc[explore_load_first], Mode=OneWay}"
                                         IsChecked="{Binding Exploration.SelectedCategory, Converter={StaticResource EnumEquals}, ConverterParameter=Objects}">
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LocFormat}">
                                            <Binding Path="Loc[explore_pill_objects]" Mode="OneWay" />
                                            <Binding Path="Exploration.ObjectsPillCount" Mode="OneWay" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </RadioButton>
                        </WrapPanel>

                        <!-- 9.2: cuadro de busqueda comun - UN SOLO TextBox, cambia de semantica
                             segun la categoria (ver el comentario real de
                             ExplorationViewModel.OnWorldSearchTextChanged): en "Todo" lanza el
                             barrido real (con debounce); en las demas filtra el inventario en
                             memoria, inmediato. -->
                        <TextBox x:Name="WorldSearchBox" DockPanel.Dock="Top" Text="{Binding Exploration.WorldSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="7,5" Background="{StaticResource BgElevatedBrush}"
                                 Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0"
                                 FontSize="12" Margin="0,0,0,4"
                                 IsEnabled="{Binding Exploration.IsWorldLoaded}" ToolTipService.ShowOnDisabled="True">
                            <TextBox.ToolTip>
                                <TextBlock Text="{Binding Loc[explore_search_grammar], Mode=OneWay}" TextWrapping="Wrap" MaxWidth="260" />
                            </TextBox.ToolTip>
                        </TextBox>

                        <!-- P-2 (auditoria Opus vs TEdit): "los tres bloques de la barra lateral
                             estan todos sobre el mismo fondo, sin ninguna separacion" - linea de
                             1px entre el cuadro de busqueda y el contenido de la categoria. -->
                        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderBrush0}" Margin="0,8,0,0" />

                        <!-- Bloque de resultados COMPARTIDO (distancia al spawn, resumen, ‹/›,
                             lista) - identico al que ya habia, solo oculto en NPCs (que muestra su
                             propia lista, NpcSearchResults, mas abajo).
                             P-2: Border con BgPrimaryBrush (un escalon POR DEBAJO del fondo de
                             panel) en vez de StackPanel a secas - "lo que ha salido" se lee de un
                             vistazo, frente a "lo que estoy pidiendo" (cuadro+pildoras de arriba). -->
                        <Border x:Name="ExplorationResultsBlock" DockPanel.Dock="Bottom" Background="{StaticResource BgPrimaryBrush}" CornerRadius="8" Padding="10" Margin="0,8,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Exploration.SelectedCategory}" Value="Npcs">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                            <!-- F-4 (auditoria Opus vs TEdit, E-02): el barrido del mundo (hasta
                                 20M de tiles) no avisaba de que estaba en marcha ni dejaba
                                 cancelarlo, pese a que _worldSearchCts ya existia entero por
                                 dentro. Mismo lenguaje visual que el overlay de carga del mapa
                                 (ProgressBar indeterminada + AccentBrush). -->
                            <Grid Visibility="{Binding Exploration.IsSearching, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ProgressBar Grid.Column="0" IsIndeterminate="True" Height="3" VerticalAlignment="Center"
                                             Foreground="{StaticResource AccentBrush}" />
                                <Button Grid.Column="1" Content="{Binding Loc[action_cancel], Mode=OneWay}" Tag="Ghost" Padding="8,2" Margin="8,0,0,0" FontSize="11"
                                        Command="{Binding Exploration.CancelWorldSearchCommand}" />
                            </Grid>
                            <CheckBox Content="{Binding Loc[explore_sort_by_spawn_distance], Mode=OneWay}" IsChecked="{Binding Exploration.ShowSpawnDistance}"
                                      Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,8,0,6"
                                      Visibility="{Binding Exploration.WorldSearchResults.Count, Converter={StaticResource CountToVis}}" />
                            <!-- F-3 (auditoria Opus vs TEdit, E-12): apagada por defecto, igual que
                                 TEdit (AutoZoomOnNavigate, "Default false"). -->
                            <CheckBox Content="{Binding Loc[explore_zoom_on_navigate], Mode=OneWay}" IsChecked="{Binding Exploration.AutoZoomOnNavigate}"
                                      ToolTip="{Binding Loc[explore_zoom_on_navigate_tooltip], Mode=OneWay}"
                                      Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,6"
                                      Visibility="{Binding Exploration.WorldSearchResults.Count, Converter={StaticResource CountToVis}}" />
                            <!-- F-1 (auditoria Opus vs TEdit, E-01): antes este TextBlock vivia
                                 DENTRO del Grid de abajo, cuya visibilidad depende de
                                 WorldSearchResults.Count>0 - justo la condicion falsa cuando la
                                 busqueda no encuentra nada, asi que "Sin resultados." (que la
                                 ViewModel SI calcula, WorldSearchSummary) nunca llegaba a
                                 mostrarse. Ahora vive fuera, con su propia visibilidad
                                 (EmptyToCollapsed) sin condicion de recuento - las flechas ‹/›
                                 siguen ligadas al recuento a proposito, navegar sin resultados no
                                 tiene sentido. -->
                            <TextBlock Text="{Binding Exploration.WorldSearchSummary}" Style="{StaticResource CaptionText}"
                                       TextWrapping="Wrap" Margin="0,0,0,6"
                                       Visibility="{Binding Exploration.ShowCompactSummary, Converter={StaticResource BoolToVis}}" />
                            <!-- P-6 (auditoria Opus vs TEdit, cierra E-01 estetico): 0 resultados
                                 en "Todo" ya no es solo el CaptionText de 11px de arriba - mismo
                                 patron visual que el estado vacio de "sin mundo cargado"
                                 (:3665-3681 aprox., BodyText + sugerencia en CaptionText). -->
                            <StackPanel x:Name="ZeroResultsPanel" HorizontalAlignment="Center" Margin="0,4,0,10"
                                        Visibility="{Binding Exploration.ShowZeroResultsState, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" TextAlignment="Center">
                                    <Run Text="{Binding Loc[explore_no_match_prefix], Mode=OneWay}" /><Run Text="{Binding Exploration.WorldSearchText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="{Binding Loc[explore_no_match_suffix], Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Loc[explore_no_match_hint], Mode=OneWay}" Style="{StaticResource CaptionText}"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                            <Grid Margin="0,0,0,6"
                                  Visibility="{Binding Exploration.WorldSearchResults.Count, Converter={StaticResource CountToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Hallazgo real (feedback directo del usuario): esta lista de
                                     resultados (coordenadas de cada mena/objeto/NPC encontrado) no
                                     tenia ninguna forma de contraerse/cerrarse salvo lanzar una
                                     busqueda nueva - panel COMPARTIDO por las 5 categorias (Todo/
                                     NPCs/Cofres/Minerales/Objetos), un unico boton aqui las cierra
                                     todas. ClearOreMarksCommand ya limpiaba resaltado+lista+resumen
                                     de por si (nombre historico de "Minerales", logica generica). -->
                                <Button Grid.Column="1" Content="{Binding Loc[explore_close_results], Mode=OneWay}" Tag="Ghost" Padding="8,2" Margin="0,0,4,0"
                                        ToolTip="{Binding Loc[explore_close_results_tooltip], Mode=OneWay}" Command="{Binding Exploration.ClearOreMarksCommand}" />
                                <!-- Navegacion circular anterior/siguiente - mismo gesto real que
                                     NavigateNext/NavigatePrevious de TEdit (pan, sin zoom). -->
                                <Button Grid.Column="2" Content="&#8249;" Tag="Ghost" Padding="8,2" Margin="4,0,0,0"
                                        ToolTip="{Binding Loc[explore_prev_result], Mode=OneWay}" Command="{Binding Exploration.PreviousWorldSearchResultCommand}" />
                                <Button Grid.Column="3" Content="&#8250;" Tag="Ghost" Padding="8,2" Margin="4,0,0,0"
                                        ToolTip="{Binding Loc[explore_next_result], Mode=OneWay}" Command="{Binding Exploration.NextWorldSearchResultCommand}" />
                            </Grid>
                            <ListBox MaxHeight="240" ItemContainerStyle="{StaticResource VirtualRowContainer}"
                                     Background="Transparent" BorderThickness="0" Focusable="False"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     Visibility="{Binding Exploration.WorldSearchResults.Count, Converter={StaticResource CountToVis}}"
                                     ItemsSource="{Binding Exploration.WorldSearchResults}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:WorldSearchHitRowViewModel}">
                                            <!-- Bug real medido con el arnes (AR-13a, 6-sep-2026): este Button
                                                 declaraba HorizontalContentAlignment="Stretch" y NUNCA se le
                                                 aplicaba - sin Style propio caia en el estilo implicito de Button
                                                 del tema, cuyo ControlTemplate tiene
                                                 <ContentPresenter HorizontalAlignment="Center"> FIJO
                                                 (Styles/Theme.xaml:277), no {TemplateBinding
                                                 HorizontalContentAlignment}. Resultado medido: la fila entera se
                                                 quedaba CENTRADA en 182px de los 281 reales, con 49px muertos a
                                                 cada lado - el "espacio vacio" que reporto el usuario, aqui por una
                                                 causa distinta a la de Cofres. RowClickButton es el estilo que este
                                                 fichero ya usa para toda fila clicable y si respeta el Stretch. -->
                                            <Button Style="{StaticResource RowClickButton}" Background="Transparent" Padding="0" Margin="0,0,0,5"
                                                    HorizontalContentAlignment="Stretch"
                                                    ToolTip="{Binding Loc[explore_goto_position], Mode=OneWay}"
                                                    Command="{Binding DataContext.Exploration.GoToWorldSearchHitCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Border Background="{StaticResource BgElevatedBrush}" CornerRadius="5" Padding="8,5" BorderThickness="1.5">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="Transparent" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{StaticResource TealBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <!-- Mismo reparto horizontal que las otras 4 categorias (ver el
                                                         comentario largo de InventoryRowTemplate, 6-sep-2026): antes
                                                         eran tres lineas apiladas a la izquierda (nombre+chip /
                                                         posicion / distancia) con toda la mitad derecha vacia, y el
                                                         nombre encima medido dentro de un StackPanel Horizontal, que
                                                         mide a sus hijos con ancho INFINITO - un nombre largo se salia
                                                         de la fila y lo recortaba el Border, sin puntos suspensivos ni
                                                         nada que avisara. Ahora: posicion y distancia a la derecha
                                                         (los dos datos numericos, alineados y comparables de fila a
                                                         fila), y nombre+chip a la izquierda con el resto del ancho -
                                                         DockPanel de verdad, asi que el nombre SI se mide con el ancho
                                                         real y envuelve en vez de desbordarse. -->
                                                    <DockPanel LastChildFill="True">
                                                        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" MaxWidth="104" Margin="8,0,0,0">
                                                            <TextBlock Text="{Binding Position}" Style="{StaticResource CaptionText}"
                                                                       TextAlignment="Right" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding DistanceLabel}" Style="{StaticResource CaptionText}"
                                                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="10.5"
                                                                       TextAlignment="Right" TextWrapping="Wrap"
                                                                       Visibility="{Binding DistanceLabel, Converter={StaticResource NullToVis}}" />
                                                        </StackPanel>
                                                        <Border DockPanel.Dock="Right" Background="{Binding KindColor}" CornerRadius="99" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding KindLabel}" FontSize="9.5" Foreground="White" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}"
                                                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <!-- Relleno: contenido especifico de cada categoria, superpuesto y con
                             visibilidad exclusiva por SelectedCategory (DataTrigger de cadena -
                             WPF convierte el texto al valor del enum solo con el TypeConverter
                             nativo, sin falta ningun converter). -->
                        <Grid x:Name="ExplorationCategoryContent">
                            <!-- NPCs: chips + lista propia (ya existente) + "NPCs que faltan".
                                 Bug real reportado por el usuario probando la app (6-sep-2026): "la
                                 lista de NPCs que faltan SOLO se ve completa con la ventana a
                                 pantalla completa; con la ventana a un tamaño normal se corta y no
                                 se ven todos". Medido con AR-15 sobre el mundo real de pruebas (26
                                 de los 40 NPCs del roster vanilla faltan): maximizada 26/26, pero
                                 1600x1000 23/26, 1400x900 18/26, 1180x860 (el tamaño por defecto)
                                 16/26 y 1080x700 (el suelo real de la ventana) 15/26 - hasta 11
                                 filas perdidas SIN ninguna barra con la que llegar a ellas.

                                 Causa real, DOS piezas y ninguna es la del bug anterior de esta
                                 misma columna:
                                   1. El ItemsControl de "NPCs que faltan" no tenia ninguna via de
                                      scroll propia. Cuando el Expander recibia menos alto del que
                                      pedia, las filas de abajo simplemente dejaban de pintarse.
                                      Ojo: AR-11c no podia verlo porque el recorte lo hacia un
                                      ANCESTRO - una fila que cae por debajo del corte no lleva
                                      clip propio, asi que VisualTreeHelper.GetClip sobre ella da
                                      null y "no hay recorte" era mentira.
                                   2. Era un DockPanel y el Expander iba Dock=Bottom: un DockPanel
                                      sirve a sus hijos Dock PRIMERO y con su DesiredSize ENTERO -
                                      desplegar "NPCs que faltan" se comia la categoria entera y
                                      dejaba la lista de NPCs del mundo con 0px medidos en los
                                      CINCO tamaños no maximizados (tambien medido por AR-15).
                                 Grid con reparto real en su lugar: la lista del mundo se queda una
                                 fila estrella con suelo propio y "NPCs que faltan", solo mientras
                                 esta desplegado, otra de 2* (BoolToGridLength ya existente, el
                                 mismo converter que usa la fila de la Libreria) - dos filas star
                                 reparten SIEMPRE el hueco exacto, nunca desbordan, en cualquier
                                 tamaño de ventana. Colapsado vuelve a Auto y todo queda como
                                 estaba. Lo que no cabe se alcanza con el scroll propio de cada
                                 lista, que es la misma red de seguridad que la ronda anterior le
                                 puso a la columna entera y al bloque "Este mundo". -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Exploration.SelectedCategory}" Value="Npcs">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <!-- MinHeight real (no 0): con "Este mundo" desplegado a
                                         1080x700 el hueco de la categoria son 201px medidos, y sin
                                         suelo la lista del mundo se quedaria en nada. 90px son tres
                                         filas reales de NPC, suficiente para que siga siendo una
                                         lista y no un recorte. -->
                                    <RowDefinition Height="*" MinHeight="90" />
                                    <RowDefinition Height="{Binding IsExpanded, ElementName=MissingNpcsExpander, Converter={StaticResource BoolToGridLength}, ConverterParameter=2}" />
                                </Grid.RowDefinitions>

                                <!-- Punto 4 (advisor Opus, "npcs escondidos en el subsuelo que puedas
                                     encontrarlos facilmente" - ver ESPEC-ui-exploracion.md#12): tres
                                     chips multiseleccion, OR entre ellos y AND con el texto. -->
                                <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                                    <ToggleButton Style="{StaticResource ViewSelector}" Content="{Binding Loc[explore_npc_housed], Mode=OneWay}" IsChecked="{Binding Exploration.NpcFilterWithHome}" />
                                    <ToggleButton Style="{StaticResource ViewSelector}" Content="{Binding Loc[explore_npc_homeless], Mode=OneWay}" IsChecked="{Binding Exploration.NpcFilterHomeless}" />
                                    <ToggleButton Style="{StaticResource ViewSelector}" Content="{Binding Loc[explore_npc_underground], Mode=OneWay}" IsChecked="{Binding Exploration.NpcFilterUnderground}"
                                                  ToolTip="{Binding Loc[explore_sort_by_depth_tooltip], Mode=OneWay}" />
                                </WrapPanel>

                                <!-- X-f: "NPCs que faltan" empieza colapsado - vive dentro de esta
                                     categoria, ya no en la columna entera. -->
                                <Expander x:Name="MissingNpcsExpander" Grid.Row="2" Header="{Binding Loc[explore_missing_npcs], Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}"
                                          Margin="0,10,0,0" IsExpanded="False"
                                          Visibility="{Binding Exploration.MissingNpcs.Count, Converter={StaticResource CountToVis}}">
                                    <!-- Scroll propio: es lo que faltaba de verdad (ver el
                                         comentario largo del Grid de arriba). Sin el, en cuanto la
                                         fila del Grid no da para las 26 filas reales, las de abajo
                                         se dejan de pintar y no hay forma humana de llegar a ellas. -->
                                    <ScrollViewer x:Name="MissingNpcsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="MissingNpcsList" ItemsSource="{Binding Exploration.MissingNpcs}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:MissingNpcRowViewModel}">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <Image Source="{Binding IconPath}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,5,0"
                                                           Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                                                    <!-- P-8 (auditoria Opus vs TEdit): CalamityBrush (rojo) significa "Calamity/peligro"
                                                         en el resto del tema - para "todavia no lo tienes" (nada peligroso) encaja mejor
                                                         el mismo tono neutro que ya usa la propia pildora de recuento de arriba. -->
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource CaptionText}"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </ScrollViewer>
                                </Expander>

                                <ScrollViewer x:Name="NpcResultsList" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <!-- X-c: la lista lateral de TEXTO si se filtra de verdad (NpcSearchResults) -
                                         Npcs (el mapa, arriba) se queda siempre completo. -->
                                    <ItemsControl ItemsSource="{Binding Exploration.NpcSearchResults}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:WorldNpcRowViewModel}">
                                                <!-- Mismo bug real que la fila de resultados (AR-13a): sin Style
                                                     propio, el estilo implicito de Button centra el contenido y se
                                                     come el Stretch declarado - medido, 32px muertos a cada lado de
                                                     una fila de 303px. -->
                                                <Button Style="{StaticResource RowClickButton}" Background="Transparent" Padding="0" Margin="0,0,0,5"
                                                        HorizontalContentAlignment="Stretch"
                                                        ToolTip="{Binding Loc[explore_goto_position], Mode=OneWay}"
                                                        Command="{Binding DataContext.Exploration.GoToNpcCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Border Background="{StaticResource BgElevatedBrush}" CornerRadius="5" Padding="8,5">
                                                        <!-- Mismo reparto horizontal que las otras 4 categorias (ver el
                                                             comentario largo de InventoryRowTemplate, 6-sep-2026). Esta
                                                             era ademas la peor de las cinco: un StackPanel Horizontal
                                                             mide a sus hijos con ancho INFINITO, asi que la columna del
                                                             texto ni siquiera sabia cuanto sitio tenia - un nombre de NPC
                                                             largo se salia de la fila y lo recortaba el Border en seco.
                                                             DockPanel real: icono a la izquierda, posicion+profundidad a
                                                             la derecha (el hueco que estaba vacio), nombre con el resto
                                                             y envolviendo. -->
                                                        <DockPanel LastChildFill="True">
                                                            <Image DockPanel.Dock="Left" Source="{Binding IconPath}" Width="28" Height="28" Stretch="Uniform" Margin="0,0,8,0"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                                                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" MaxWidth="104" Margin="8,0,0,0">
                                                                <TextBlock Text="{Binding Position}" Style="{StaticResource CaptionText}"
                                                                           TextAlignment="Right" TextWrapping="Wrap" />
                                                                <!-- Punto 4: profundidad real escrita, solo si esta bajo tierra -
                                                                     "(3200, 1450)" no le dice nada a nadie, "412 tiles bajo el
                                                                     suelo" si. -->
                                                                <TextBlock Text="{Binding DepthLabel}" Style="{StaticResource CaptionText}"
                                                                           Foreground="{StaticResource TealBrush}" FontSize="10.5"
                                                                           TextAlignment="Right" TextWrapping="Wrap"
                                                                           Visibility="{Binding DepthLabel, Converter={StaticResource NullToVis}}" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}"
                                                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                                                        </DockPanel>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>

                            <!-- Cofres: dos vistas alternadas (9.3-C) - precedente real de este
                                 gesto: los ToggleButton "Terraria"/"Mods" de TabbedPickerControl.xaml
                                 de TEdit. -->
                            <DockPanel>
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Exploration.SelectedCategory}" Value="Chests">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <!-- RadioButton real (no ToggleButton) - GroupName da la exclusion
                                     mutua nativa de WPF, mismo criterio que las pildoras de
                                     categoria de arriba (EnumEqualsConverter tambien sirve para
                                     int, ver su comentario real). -->
                                <!-- C-06 (informe de pulido final, cierra E8): tercer modo real,
                                     junto a los dos ya existentes - una fila por cofre REAL del
                                     mundo (nunca agrupado por variante ni por contenido), con su
                                     contenido exacto desplegable. -->
                                <!-- Bug real reportado por el usuario probando la app (6-sep-2026,
                                     captura): "contienen" salia CORTADA. Causa real medida con el
                                     arnes (AR-11b): Content="cadena" a secas se presenta en un
                                     TextBlock implicito SIN TextWrapping, y el UniformGrid da a
                                     cada chip un tercio EXACTO de la columna - "Por lo que
                                     contienen" (el mas largo de los tres) pedia 22px mas de los
                                     que su celda tiene a CUALQUIER ancho de ventana, incluido 4K,
                                     porque la barra lateral no crece con la ventana (es un ancho
                                     fijo con GridSplitter, F-10). Mismo patron ya establecido en
                                     este fichero para las pildoras de categoria: un TextBlock hijo
                                     explicito, aqui con Wrap real - el chip crece a dos lineas en
                                     vez de comerse el texto. -->
                                <!-- Tercer punto del encargo del 6-sep-2026 (el usuario, sobre la
                                     lista de Cofres: "se han colado paradores"): eran los
                                     APARADORES (tile 88, "Aparador de obsidiana" en el mundo real
                                     de la captura). No es ningun fallo de clasificacion: en
                                     Terraria un aparador es una entrada mas de la lista de cofres
                                     del mundo - WorldGen.PlaceDresserDirect llama a
                                     Chest.CreateChest igual que PlaceChestDirect
                                     (TerrariaVanilla\Terraria\WorldGen.cs:58373 y :58338), y lo
                                     mismo pasa con barriles y papeleras, que son frames del propio
                                     tile 21. Esconderlos seria perder contenedores REALES con
                                     objetos dentro; lo que faltaba era decir que cuenta como
                                     "cofre" aqui, y eso cabe en el tooltip de los tres chips sin
                                     robarle ni un pixel de alto a la columna (AR-11f mide que a
                                     1180x860 no aparezca barra de scroll). -->
                                <UniformGrid x:Name="ChestModeSelector" DockPanel.Dock="Top" Columns="3" Margin="0,0,0,8">
                                    <RadioButton Style="{StaticResource ViewSelector}" GroupName="CofresVista" Margin="0,0,3,0"
                                                 ToolTip="{Binding Loc[explore_chests_kinds_tooltip], Mode=OneWay}"
                                                 IsChecked="{Binding Exploration.ChestViewMode, Converter={StaticResource EnumEquals}, ConverterParameter=0}">
                                        <TextBlock Text="{Binding Loc[explore_chests_by_type], Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center" />
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource ViewSelector}" GroupName="CofresVista" Margin="3,0,3,0"
                                                 ToolTip="{Binding Loc[explore_chests_kinds_tooltip], Mode=OneWay}"
                                                 IsChecked="{Binding Exploration.ChestViewMode, Converter={StaticResource EnumEquals}, ConverterParameter=1}">
                                        <TextBlock Text="{Binding Loc[explore_chests_by_contents], Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center" />
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource ViewSelector}" GroupName="CofresVista" Margin="3,0,0,0"
                                                 ToolTip="{Binding Loc[explore_chests_kinds_tooltip], Mode=OneWay}"
                                                 IsChecked="{Binding Exploration.ChestViewMode, Converter={StaticResource EnumEquals}, ConverterParameter=2}">
                                        <TextBlock Text="{Binding Loc[explore_chests_one_by_one], Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center" />
                                    </RadioButton>
                                </UniformGrid>

                                <!-- Bug real de maquetacion encontrado midiendo la fila con el arnes
                                     (AR-13a, 6-sep-2026, y la causa de fondo de "mira todo el
                                     espacio que hay vacio para mostrar los nombres de los cofres"):
                                     estos dos paneles de modo eran hermanos DIRECTOS del DockPanel
                                     de la categoria, y un DockPanel solo estira a su ULTIMO hijo
                                     (LastChildFill). El ultimo era el de "Cofre a cofre", asi que
                                     el de "Por tipo"/"Por lo que contienen" se colocaba como
                                     Dock=Left con su ancho DESEADO: 150px medidos de una columna de
                                     298 - la mitad exacta de la barra lateral, vacia, y los nombres
                                     de cofre apretados en la otra mitad. Un Grid contenedor (mismo
                                     patron que ExplorationCategoryContent, que ya superpone asi las
                                     5 categorias) estira a TODOS sus hijos, no solo al ultimo. -->
                                <Grid>
                                <!-- Modos 0/1: la lista generica de siempre. -->
                                <DockPanel>
                                    <DockPanel.Style>
                                        <Style TargetType="DockPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Exploration.ChestViewMode}" Value="2">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DockPanel.Style>
                                    <Button DockPanel.Dock="Top" Content="{Binding Loc[explore_search_checked], Mode=OneWay}" Tag="Ghost" Margin="0,0,0,8" HorizontalAlignment="Left"
                                            Command="{Binding Exploration.SearchCheckedInventoryCommand}" />
                                    <ListBox ItemsSource="{Binding Exploration.Inventory}" ItemTemplate="{StaticResource InventoryRowTemplate}"
                                             ItemContainerStyle="{StaticResource VirtualRowContainer}"
                                             Background="Transparent" BorderThickness="0" Focusable="False"
                                             ScrollViewer.CanContentScroll="True"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling"
                                             VirtualizingPanel.ScrollUnit="Pixel" />
                                </DockPanel>

                                <!-- Modo 2 (C-06): Cofre a cofre - virtualizada, un mundo Grande
                                     tiene del orden de cientos de cofres (mismo criterio real ya
                                     aplicado por F-5 al resto de listas). -->
                                <DockPanel>
                                    <DockPanel.Style>
                                        <Style TargetType="DockPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Exploration.ChestViewMode}" Value="2">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DockPanel.Style>
                                    <!-- Punto 4 del encargo del usuario (6-sep-2026): casilla de
                                         acercar PROPIA de "Cofre a cofre", independiente de la
                                         global que comparten las demas secciones (que vive en el
                                         bloque de resultados, mas arriba, y sigue mandando alli).
                                         Aqui, ademas, esta SIEMPRE visible: la global se oculta
                                         cuando no hay resultados de busqueda (WorldSearchResults.
                                         Count), condicion que en esta vista no se cumple nunca
                                         porque su lista es otra (ChestRows) - parte real de que el
                                         usuario no pudiera controlar el zoom de este modo. -->
                                    <CheckBox DockPanel.Dock="Top" Content="{Binding Loc[explore_zoom_on_navigate_chest], Mode=OneWay}"
                                              IsChecked="{Binding Exploration.AutoZoomOnChestNavigate}"
                                              ToolTip="{Binding Loc[explore_zoom_on_navigate_chest_tooltip], Mode=OneWay}"
                                              Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8" />
                                    <ListBox x:Name="ChestByChestList" ItemsSource="{Binding Exploration.ChestRows}" ItemTemplate="{StaticResource ChestRowTemplate}"
                                             ItemContainerStyle="{StaticResource VirtualRowContainer}"
                                             Background="Transparent" BorderThickness="0" Focusable="False"
                                             ScrollViewer.CanContentScroll="True"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling"
                                             VirtualizingPanel.ScrollUnit="Pixel" />
                                </DockPanel>
                                </Grid>
                            </DockPanel>

                            <!-- Minerales: inventario en 3 grupos con cabecera + marcado en el mapa
                                 (9.3-D/11). -->
                            <DockPanel>
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Exploration.SelectedCategory}" Value="Ores">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <UniformGrid DockPanel.Dock="Top" Columns="2" Margin="0,0,0,8">
                                    <Button Tag="Accent" Content="{Binding Loc[explore_mark_on_map], Mode=OneWay}" Margin="0,0,3,0"
                                            ToolTip="{Binding Loc[explore_mark_ores_tooltip], Mode=OneWay}"
                                            Command="{Binding Exploration.MarkOresOnMapCommand}" />
                                    <Button Tag="Ghost" Content="{Binding Loc[explore_clear_marks], Mode=OneWay}" Margin="3,0,0,0"
                                            Command="{Binding Exploration.ClearOreMarksCommand}" />
                                </UniformGrid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <!-- P-2 (auditoria Opus vs TEdit): "las cabeceras de grupo
                                             de Minerales pesan lo mismo que las cifras que
                                             agrupan" - SemiBold + margen superior real (jerarquia
                                             por peso, no por color nuevo). -->
                                        <TextBlock Text="{Binding Loc[explore_category_ores], Mode=OneWay}" Style="{StaticResource CaptionText}" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"
                                                   Margin="0,10,0,4" Visibility="{Binding Exploration.OreMetals.Count, Converter={StaticResource CountToVis}}" />
                                        <ItemsControl ItemsSource="{Binding Exploration.OreMetals}" ItemTemplate="{StaticResource InventoryRowTemplate}" Margin="0,0,0,8" />
                                        <TextBlock Text="{Binding Loc[explore_gems], Mode=OneWay}" Style="{StaticResource CaptionText}" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"
                                                   Margin="0,10,0,4" Visibility="{Binding Exploration.OreGems.Count, Converter={StaticResource CountToVis}}" />
                                        <ItemsControl ItemsSource="{Binding Exploration.OreGems}" ItemTemplate="{StaticResource InventoryRowTemplate}" Margin="0,0,0,8" />
                                        <TextBlock Text="{Binding Loc[explore_other_targets], Mode=OneWay}" Style="{StaticResource CaptionText}" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"
                                                   Margin="0,10,0,4" Visibility="{Binding Exploration.OreTargets.Count, Converter={StaticResource CountToVis}}" />
                                        <ItemsControl ItemsSource="{Binding Exploration.OreTargets}" ItemTemplate="{StaticResource InventoryRowTemplate}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>

                            <!-- Objetos: Tiles/Paredes/Liquidos (9.3-E). ALCANCE DELIBERADO: sin el
                                 arbol de dos niveles por variante de UV que propone el espec -
                                 "Cofres/Por tipo de cofre" ya cubre el caso real donde mas importa
                                 distinguir variantes. -->
                            <DockPanel>
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Exploration.SelectedCategory}" Value="Objects">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <!-- Mismo arreglo real que los chips de Cofres (AR-11b): TextBlock
                                     hijo con Wrap en vez de Content="cadena", que no envuelve. Estos
                                     tres son mas cortos en español y hoy no se cortan, pero comparten
                                     el mismo UniformGrid de tercios y el mismo riesgo con cualquier
                                     otro idioma - se arregla la CAUSA, no solo el caso visto. -->
                                <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,0,0,4">
                                    <RadioButton Style="{StaticResource ViewSelector}" GroupName="ObjetosVista" Margin="0,0,3,0"
                                                 IsChecked="{Binding Exploration.ObjectsViewMode, Converter={StaticResource EnumEquals}, ConverterParameter=0}">
                                        <TextBlock Text="{Binding Loc[explore_tiles], Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center" />
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource ViewSelector}" GroupName="ObjetosVista" Margin="3,0,3,0"
                                                 IsChecked="{Binding Exploration.ObjectsViewMode, Converter={StaticResource EnumEquals}, ConverterParameter=1}">
                                        <TextBlock Text="{Binding Loc[explore_walls], Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center" />
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource ViewSelector}" GroupName="ObjetosVista" Margin="3,0,0,0"
                                                 IsChecked="{Binding Exploration.ObjectsViewMode, Converter={StaticResource EnumEquals}, ConverterParameter=2}">
                                        <TextBlock Text="{Binding Loc[explore_liquids], Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center" />
                                    </RadioButton>
                                </UniformGrid>
                                <Button DockPanel.Dock="Top" Content="{Binding Loc[explore_search_checked], Mode=OneWay}" Tag="Ghost" Margin="0,4,0,8" HorizontalAlignment="Left"
                                        Command="{Binding Exploration.SearchCheckedInventoryCommand}" />
                                <!-- C-04 (informe de pulido final, cierra E6/E7): mismo par de botones que
                                     ya tiene Minerales (resaltado sin tope + lista agrupada topada),
                                     generalizado aqui a Tiles/Paredes/Liquidos - el tick de cualquier
                                     fila ya lo aplica solo con debounce, estos son "aplicar ya"/
                                     "desmarcar todo". -->
                                <UniformGrid DockPanel.Dock="Top" Columns="2" Margin="0,0,0,8">
                                    <Button Tag="Accent" Content="{Binding Loc[explore_mark_on_map], Mode=OneWay}" Margin="0,0,3,0"
                                            ToolTip="{Binding Loc[explore_mark_objects_tooltip], Mode=OneWay}"
                                            Command="{Binding Exploration.MarkObjectsOnMapCommand}" />
                                    <Button Tag="Ghost" Content="{Binding Loc[explore_clear_marks], Mode=OneWay}" Margin="3,0,0,0"
                                            Command="{Binding Exploration.ClearOreMarksCommand}" />
                                </UniformGrid>
                                <ListBox ItemsSource="{Binding Exploration.Inventory}" ItemTemplate="{StaticResource InventoryRowTemplate}"
                                         ItemContainerStyle="{StaticResource VirtualRowContainer}"
                                         Background="Transparent" BorderThickness="0" Focusable="False"
                                         ScrollViewer.CanContentScroll="True"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         VirtualizingPanel.ScrollUnit="Pixel" />
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </TabItem>

        <!-- ===================== ACERCA DE ===================== -->
        <!-- H5-09 (quinta auditoria de Opus): MaxWidth compartido (DetailContentMaxWidth) para
             que el Changelog reparta en columnas reales con sitio (DetailCardColumns) - pero el
             texto corrido (creditos, intro) NO crece con el contenedor, MaxWidth propio de 680
             para mantener el tope de linea real por legibilidad (pedido explicito del informe). -->
        <TabItem Header="{Binding Loc[tab_about], Mode=OneWay}" ToolTip="Ctrl+6">
            <ScrollViewer Margin="14" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="{Binding DetailContentMaxWidth}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,20">
                        <Image Source="pack://siteoforigin:,,,/Assets/branding/logo-128.png" Width="72" Height="72" />
                        <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Text="{Binding About.AppName}" Style="{StaticResource TitleText}" FontSize="28" />
                            <TextBlock Text="{Binding Loc[about_tagline], Mode=OneWay}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="680" HorizontalAlignment="Left" />
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0">
                                <Run Text="{Binding Loc[about_version_label], Mode=OneWay}" /><Run Text="{Binding About.Version, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <!-- C-18 (informe de pulido final, cierra N2): bloque propio de autoria, no
                         una frase enterrada en CreditsText - justo debajo del nombre/version, y
                         antes de las atribuciones a terceros (que dicen cosas distintas y no
                         deben mezclarse). -->
                    <TextBlock Text="{Binding Loc[about_authorship], Mode=OneWay}" Style="{StaticResource TitleText}" FontSize="18" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding Loc[about_author_text], Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,20"
                               MaxWidth="680" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding Loc[about_credits_text], Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,24"
                               MaxWidth="680" HorizontalAlignment="Left" />

                    <!-- H5-07 (quinta auditoria de Opus): "no existe ninguna pantalla de
                         Ajustes... quien tenga Terraria en otro disco/Documentos redirigidos/
                         instalacion portable ve el lanzador vacio sin forma de arreglarlo desde
                         la app". Sitio real: dentro de "Acerca de" (la pestaña con menos
                         densidad, pedido explicito del informe). -->
                    <TextBlock Text="{Binding Loc[about_settings_title], Mode=OneWay}" Style="{StaticResource TitleText}" FontSize="20" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="680" HorizontalAlignment="Left" Margin="0,0,0,14">
                        <Run Text="{Binding Loc[settings_extra_folders_1], Mode=OneWay}" />
                        <Run Text="{Binding Loc[settings_extra_folders_path], Mode=OneWay}" FontStyle="Italic" />
                        <Run Text="{Binding Loc[settings_extra_folders_2], Mode=OneWay}" />
                    </TextBlock>

                    <TextBlock Text="{Binding Loc[settings_extra_character_folders], Mode=OneWay}" Style="{StaticResource SectionText}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Settings.ExtraCharacterFolders}" MaxWidth="680" HorizontalAlignment="Left">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgElevatedBrush}" CornerRadius="6" Padding="8,5" Margin="0,0,0,6">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource CircleCloseButton}"
                                                ToolTip="{Binding Loc[settings_remove_folder], Mode=OneWay}"
                                                Command="{Binding DataContext.Settings.RemoveCharacterFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock Text="{Binding}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{Binding Loc[settings_add_character_folder], Mode=OneWay}" Tag="Ghost" Padding="8,4" Margin="0,0,0,18" HorizontalAlignment="Left"
                            Click="OnAddCharacterFolderClick" />

                    <TextBlock Text="{Binding Loc[settings_extra_world_folders], Mode=OneWay}" Style="{StaticResource SectionText}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Settings.ExtraWorldFolders}" MaxWidth="680" HorizontalAlignment="Left">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgElevatedBrush}" CornerRadius="6" Padding="8,5" Margin="0,0,0,6">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource CircleCloseButton}"
                                                ToolTip="{Binding Loc[settings_remove_folder], Mode=OneWay}"
                                                Command="{Binding DataContext.Settings.RemoveWorldFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock Text="{Binding}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{Binding Loc[settings_add_world_folder], Mode=OneWay}" Tag="Ghost" Padding="8,4" Margin="0,0,0,18" HorizontalAlignment="Left"
                            Click="OnAddWorldFolderClick" />

                    <TextBlock Text="{Binding Loc[settings_backup_cap_label], Mode=OneWay}" Style="{StaticResource SectionText}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Settings.BackupHistoryCap, UpdateSourceTrigger=PropertyChanged}" Width="80" Padding="6,4"
                             HorizontalAlignment="Left" Background="{StaticResource BgElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                             BorderThickness="0" Margin="0,0,0,24"
                             ToolTip="{Binding Loc[settings_backup_cap_tooltip], Mode=OneWay}" />

                    <!-- Pedido explicito del usuario (5-sep-2026): fijar el tamaño/posicion
                         ACTUALES de la ventana como los de arranque, con un tick que se puede
                         activar/desactivar - independiente de que la ventana YA recuerde
                         siempre el ultimo tamaño usado (WindowPlacementService, sin tick,
                         comportamiento de fabrica desde T-3). Checked/Unchecked en vez de un
                         binding TwoWay normal - solo la View conoce el Window real para
                         capturar sus bounds actuales en el instante de marcar el tick. -->
                    <TextBlock Text="{Binding Loc[settings_window_title], Mode=OneWay}" Style="{StaticResource SectionText}" Margin="0,0,0,6" />
                    <CheckBox Content="{Binding Loc[settings_pin_window_label], Mode=OneWay}"
                              IsChecked="{Binding Settings.IsWindowSizePinned, Mode=OneWay}"
                              Checked="OnPinWindowSizeChecked" Unchecked="OnPinWindowSizeUnchecked"
                              Margin="0,0,0,24"
                              ToolTip="{Binding Loc[settings_pin_window_tooltip], Mode=OneWay}" />

                    <!-- Pedido explicito del usuario (5-sep-2026): "de momento solo daremos
                         soporte ingles y español de forma nativa" - primer bloque real de la
                         infraestructura de idioma (LocalizationService), en vivo sin reiniciar.
                         EnumEquals ya sirve para string (ver su propio comentario real,
                         value?.ToString()==parameter) - mismo patron de chips ya usado arriba
                         para ChestViewMode/ObjectsViewMode/dificultad del mundo. -->
                    <TextBlock Text="{Binding Loc[settings_language_title], Mode=OneWay}" Style="{StaticResource SectionText}" Margin="0,0,0,6" />
                    <UniformGrid Columns="2" MaxWidth="300" HorizontalAlignment="Left" Margin="0,0,0,24">
                        <RadioButton Style="{StaticResource ViewSelector}" GroupName="Idioma" Content="{Binding Loc[settings_language_spanish], Mode=OneWay}" Margin="0,0,3,0"
                                     IsChecked="{Binding Settings.Language, Converter={StaticResource EnumEquals}, ConverterParameter=es}" />
                        <RadioButton Style="{StaticResource ViewSelector}" GroupName="Idioma" Content="{Binding Loc[settings_language_english], Mode=OneWay}" Margin="3,0,0,0"
                                     IsChecked="{Binding Settings.Language, Converter={StaticResource EnumEquals}, ConverterParameter=en}" />
                    </UniformGrid>

                    <TextBlock Text="{Binding Loc[about_this_version_title], Mode=OneWay}" Style="{StaticResource TitleText}" FontSize="20" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,14" MaxWidth="680" HorizontalAlignment="Left">
                        <Run Text="{Binding Loc[about_changelog_1], Mode=OneWay}" />
                        <Run Text="{Binding Loc[about_changelog_editor], Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        <Run Text="{Binding Loc[about_changelog_2], Mode=OneWay}" />
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Changelog.Entries}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="{Binding DetailCardColumns}" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        </TabControl>

        <!-- Confirmacion visual real de guardado (pedido explicito 2-sep-2026: "debe ser mas
             visual que se allá confirmado el guardado no solamente un mensajito abajo a la
             izquierda") - banner flotante con animacion de entrada real, aparte del
             StatusMessage de siempre (que se queda para los errores, que no deben ser tan
             efimeros). MainViewModel.Save() lo activa un momento tras un guardado con exito
             real, ver SaveConfirmationVisible/DispatcherTimer ahi mismo. Auditoria de Opus,
             N-1: movido de dentro de la pestaña Personaje a este nivel (hermano del TabControl
             raiz, Grid.Row=1) - Guardar ya se puede pulsar desde cualquier pestaña via la
             cabecera global, la confirmacion debe verse igual sea cual sea la pestaña activa. -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"
                Background="{StaticResource TealGradientBrush}" CornerRadius="10" Padding="18,10"
                Effect="{StaticResource CardShadow}" IsHitTestVisible="False"
                Visibility="{Binding SaveConfirmationVisible, Converter={StaticResource BoolToVis}}"
                RenderTransformOrigin="0.5,0.5" Panel.ZIndex="99">
            <Border.RenderTransform>
                <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
            </Border.RenderTransform>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Opacity" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SaveConfirmationVisible}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#10003;" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="{Binding Loc[save_confirmation_title], Mode=OneWay}" FontSize="13.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- H-3 (segunda auditoria de Opus, Fable): "Guardar ya funciona desde cualquier pestaña
             (N-1) pero un error de guardado va a un TextBlock que 5 de 6 pestañas no ven" -
             mismo nivel real que el banner de "Guardado" de arriba (hermano del TabControl raiz),
             visible sea cual sea la pestaña activa. Solo errores reales (cargar/guardar/deshacer
             fallido) - los exitos efimeros siguen siendo solo el banner verde de arriba, StatusMessage
             se queda para el detalle informativo dentro de Personaje. Se cierra sola en el siguiente
             exito real, o a mano con el boton "✕". -->
        <!-- H4-12 (cuarta auditoria de Opus, Fable): este banner aparecia en seco (un salto de
             Collapsed a Visible sin transicion) mientras su gemelo verde de arriba entra con una
             animacion real - justo el aviso que MAS conviene que no aparezca "de golpe", al
             reves de como estaba. Mismo Storyboard/RenderTransform real que el banner verde,
             solo cambia el disparador (GlobalErrorMessage no vacio en vez de un bool). -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" MaxWidth="520"
                Background="{StaticResource CalamityBrush}" CornerRadius="10" Padding="18,10"
                Effect="{StaticResource CardShadow}"
                Visibility="{Binding GlobalErrorMessage, Converter={StaticResource EmptyToCollapsed}}"
                RenderTransformOrigin="0.5,0.5" Panel.ZIndex="99">
            <Border.RenderTransform>
                <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
            </Border.RenderTransform>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Opacity" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding GlobalErrorMessage, Converter={StaticResource EmptyToCollapsed}}" Value="Visible">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#9888;" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="{Binding GlobalErrorMessage}" FontSize="13.5" Foreground="White" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="400" />
                <Button Content="✕" Style="{StaticResource CircleCloseButton}" Foreground="White" Margin="10,0,0,0"
                        Command="{Binding DismissGlobalErrorCommand}" ToolTip="{Binding Loc[close_notice_tooltip], Mode=OneWay}" />
            </StackPanel>
        </Border>
        </Grid>
    </Grid>
</Window>
