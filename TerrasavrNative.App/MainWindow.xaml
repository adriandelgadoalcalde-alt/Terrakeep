<Window x:Class="TerrasavrNative.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TerrasavrNative.App"
        xmlns:vm="clr-namespace:TerrasavrNative.App.ViewModels"
        xmlns:data="clr-namespace:TerrasavrNative.Core.Data;assembly=TerrasavrNative.Core"
        xmlns:controls="clr-namespace:TerrasavrNative.App.Controls"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="860" Width="1180" MinWidth="1080" MinHeight="700"
        Background="{StaticResource BgPrimaryBrush}" Closing="OnWindowClosing" KeyDown="OnWindowKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Panel "Editar" compartido - equivalente real de app.TabEdit: sigue al slot
             SELECCIONADO (ItemEditViewModel.Slot), no a uno fijo, para poder vivir fuera del
             TabControl de contenedores y "acompañar" a Inventario/Banco/Caja fuerte/Fragua/
             Boveda/Loadouts por igual (pedido explicito 1-sep-2026). -->
        <DataTemplate x:Key="ItemEditTemplate" DataType="{x:Type vm:ItemEditViewModel}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Editar" Style="{StaticResource SectionText}" Margin="0,0,0,10" />

                <TextBlock DockPanel.Dock="Top" Text="{Binding NoPrefixMessage}" Style="{StaticResource CaptionText}"
                           TextWrapping="Wrap" Margin="0,0,0,10"
                           Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}" />

                <!-- Auditoria de Opus, Bloque 5 (T-5): leyenda real de los 3 codigos de color de
                     un slot (fondo verde/punto rojo/borde morado) - antes habia que
                     descubrirlos por prueba y error. Solo aqui, en el hueco real que deja "sin
                     seleccion" (StaticResource nunca compite con el contenido de edicion real). -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10"
                            Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}">
                    <TextBlock Text="Leyenda" Style="{StaticResource CaptionText}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Border Width="14" Height="14" CornerRadius="3" Background="{StaticResource EquippedGreenBrush}" Opacity="0.5" Margin="0,0,6,0" />
                        <TextBlock Text="Fondo verde = objeto equipado" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Ellipse Width="10" Height="10" Fill="{StaticResource CalamityBrush}" Margin="2,0,6,0" />
                        <TextBlock Text="Punto rojo = objeto de Calamity" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="14" Height="14" CornerRadius="3" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" Margin="0,0,6,0" />
                        <TextBlock Text="Borde morado = slot seleccionado" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <DockPanel Margin="0,0,0,10">
                        <!-- La tarjeta compacta (Inventario/Almacenes, pregunta a Opus sobre el
                             diseño 2-sep-2026) ya no tiene sitio para un boton "✕" propio -
                             este panel, que acompaña a cualquier slot seleccionado sea cual sea
                             el contenedor, es donde vive ahora tambien para esos casos (la
                             tarjeta rica conserva el suyo ademas, por comodidad). -->
                        <Button DockPanel.Dock="Right" Content="Vaciar slot" Command="{Binding Slot.ClearCommand}"
                                ToolTip="Vaciar este slot" Tag="Ghost" Padding="6,3" FontSize="10.5" VerticalAlignment="Center" />
                        <Image Source="{Binding Slot.IconPath}" Width="32" Height="32" Stretch="Uniform" Margin="0,0,8,0"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               VerticalAlignment="Center"
                               Visibility="{Binding Slot.IconPath, Converter={StaticResource NullToVis}}" />
                        <StackPanel VerticalAlignment="Center">
                            <!-- Auditoria de Opus, D-3: color real de rareza (null = color de
                                 texto normal, ver VanillaRarityColorCatalog). -->
                            <TextBlock Text="{Binding Slot.DisplayName}" Style="{StaticResource BodyText}" TextWrapping="Wrap" MaxWidth="220"
                                       Foreground="{Binding Slot.RarityBrush, TargetNullValue={StaticResource TextPrimaryBrush}}" />
                            <TextBlock Style="{StaticResource CaptionText}">
                                <Run Text="{Binding Slot.ContainerName, Mode=OneWay}" />
                                <Run Text=" · slot " />
                                <Run Text="{Binding Slot.SlotIndex, Mode=OneWay}" />
                            </TextBlock>
                            <!-- Auditoria de Opus, E-3: "un usuario que no conoce el juego no
                                 sabe que el slot 3 es 'Accesorio 1'" - respaldado por el
                                 original real (locClass Helmet/Shirt/Pants/Accessory $1). -->
                            <TextBlock Text="{Binding Slot.SlotRoleLabel}" Style="{StaticResource CaptionText}"
                                       FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"
                                       Visibility="{Binding Slot.SlotRoleLabel, Converter={StaticResource NullToVis}}" />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="Índice (id)" Style="{StaticResource CaptionText}" Margin="0,0,0,3" />
                    <!-- Auditoria de Opus (octava pasada, T-17) - BUG REAL encontrado y
                         arreglado: con PropertyChanged, escribir "100" pasaba de verdad por
                         Id=1 y Id=10 antes de llegar a 100 - CADA digito colocaba un objeto
                         real (OnItemIdChanged llama a PlaceItem de inmediato), asi que escribir
                         un id de 3 cifras colocaba 2 objetos equivocados antes del correcto.
                         Sin UpdateSourceTrigger explicito, el TextBox usa su valor real por
                         defecto (LostFocus) - confirma al salir del campo; OnCommitTextOnEnter
                         (code-behind) fuerza el mismo commit real al pulsar Intro, sin tener
                         que hacer clic fuera. -->
                    <TextBox Text="{Binding Slot.ItemId}" Padding="6,4" Margin="0,0,0,8" KeyDown="OnCommitTextOnEnter"
                             Background="{StaticResource BgElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                    <!-- Restriccion de slot (consulta a Opus, sexta pasada): el unico camino
                         de los tres (Libreria filtrada/arrastrar y soltar/Indice a mano) donde
                         el silencio confunde de verdad - aqui SI hace falta una linea real,
                         nada modal. Collapsed no reserva espacio, no cambia el espaciado
                         normal cuando no hay mensaje. -->
                    <TextBlock Text="{Binding Slot.RejectionMessage}" Style="{StaticResource CaptionText}"
                               Foreground="{StaticResource CalamityBrush}" TextWrapping="Wrap" Margin="0,-4,0,8"
                               Visibility="{Binding Slot.RejectionMessage, Converter={StaticResource NullToVis}}" />

                    <TextBlock Text="Cantidad" Style="{StaticResource CaptionText}" Margin="0,0,0,3" />
                    <TextBox Text="{Binding Slot.Count, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,8"
                             Background="{StaticResource BgElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />

                    <TextBlock Text="Prefijo (id)" Style="{StaticResource CaptionText}" Margin="0,0,0,3" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <!-- Mismo arreglo real que "Índice" de arriba (T-17) - PrefixId tambien
                             ejecuta una accion inmediata (SetPrefix) en cada cambio. -->
                        <TextBox Text="{Binding Slot.PrefixId}" Width="50" Padding="6,4" KeyDown="OnCommitTextOnEnter"
                                 Background="{StaticResource BgElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                        <!-- Pregunta a Opus sobre el diseño (2-sep-2026, quinta pasada): el
                             Background="Transparent" puesto a mano aqui era letra muerta - la
                             plantilla real de Button (Theme.xaml) ignora esa propiedad, solo
                             reacciona a Tag. ★ = accion principal (Accent); Quitar = deshacer
                             (Ghost, ya sustituye ese Background/Foreground a mano). -->
                        <Button Content="★" Command="{Binding ApplyBestPrefixCommand}" ToolTip="Aplicar el mejor prefijo real"
                                Tag="Accent" Padding="6,2" Margin="6,0,0,0" FontSize="12"
                                Visibility="{Binding Slot.HasBestPrefixSuggestion, Converter={StaticResource BoolToVis}}" />
                        <Button Content="Quitar" Command="{Binding ClearPrefixCommand}" ToolTip="Quitar el prefijo actual"
                                Tag="Ghost" Padding="6,2" Margin="6,0,0,0" FontSize="11" />
                    </StackPanel>
                    <TextBlock Text="{Binding Slot.PrefixDisplay}" Style="{StaticResource CaptionText}" Margin="0,0,0,6"
                               Visibility="{Binding Slot.PrefixDisplay, Converter={StaticResource EmptyToCollapsed}}" />

                    <TextBlock Text="{Binding CategoriesLabel}" Style="{StaticResource CaptionText}" Foreground="{StaticResource AccentBrush}"
                               Margin="0,4,0,10" Visibility="{Binding CanHavePrefix, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- Selector de prefijo real de 3 niveles (equivalente exacto de los botones
                     btMeta/btGroups/btPrefix reales de app.TabEdit, ya filtrados por lo que es
                     legal de verdad para este objeto - ver PrefixGroupCatalog/PrefixRulesCatalog). -->
                <StackPanel Visibility="{Binding CanHavePrefix, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Metas}" Margin="0,0,0,6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PrefixMetaButtonViewModel}">
                                <Button Content="{Binding Label}" Style="{StaticResource PrefixMetaButton}"
                                        Command="{Binding DataContext.ItemEdit.SelectMetaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Groups}" Margin="0,0,0,6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PrefixGroupButtonViewModel}">
                                <Button Content="{Binding Label}" Style="{StaticResource PrefixGroupButton}"
                                        Command="{Binding DataContext.ItemEdit.SelectGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Prefixes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PrefixCatalogEntryViewModel}">
                                    <!-- Auditoria de Opus, D-6: antes una lista de 20 nombres
                                         opacos - el efecto real ya se sabe calcular
                                         (PrefixEffectCatalog), solo faltaba mostrarlo aqui. -->
                                    <Button Content="{Binding DisplayName}" ToolTip="{Binding EffectDescription}"
                                            Command="{Binding DataContext.ItemEdit.ApplyPrefixCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" Padding="7,4" Margin="0,0,5,5" FontSize="11"
                                            Background="{StaticResource BgElevatedBrush}" BorderThickness="0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCalamity}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource CalamityBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AccentMutedBrush}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <!-- Nodo del arbol de categorias de la Libreria (recursivo - se referencia a si mismo
             por StaticResource, patron real de WPF para arboles sin usar TreeView). Un clic
             selecciona/deselecciona la carpeta como filtro Y despliega/pliega sus subcarpetas
             a la vez (LibraryViewModel.SelectCategoryCommand). -->
        <!-- Auditoria de Opus, Bloque 6 (T-18): antes 3 copias identicas de esta plantilla
             (Libreria/Investigacion/Buffs), solo distintas en A QUE SelectCategoryCommand
             apuntaba cada boton - cada nodo lleva ahora su propio comando real
             (CategoryNodeViewModel.SelectCommand, asignado una vez por cada ViewModel dueño
             justo tras construir su arbol), asi que una UNICA plantilla real sirve a los 3
             arboles (Libreria, Investigacion y Buffs, cada uno con su propia instancia de
             arbol e igual de correcto). -->
        <DataTemplate x:Key="CategoryNodeTemplate" DataType="{x:Type vm:CategoryNodeViewModel}">
            <StackPanel>
                <Button Command="{Binding SelectCommand}"
                        CommandParameter="{Binding}" HorizontalContentAlignment="Left" Padding="4,3" Margin="0,0,0,1"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource BgHoverBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentMutedBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding IconPath}" Width="16" Height="16" Margin="0,0,6,0" Stretch="Uniform"
                               VerticalAlignment="Center"
                               Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                        <!-- Sin sufijo de recuento aparte (pedido explicito 2-sep-2026, "calca
                             exactamente"): los nombres reales YA llevan su propio "(N)" cuando
                             el propio Terrasavr lo pone (carpetas calculadas por predicado,
                             ej. "Melee damage (316)") - añadir otro aqui duplicaria el numero.
                             Las carpetas con lista literal de ids (ej. "Copper & Tin") tampoco
                             llevan recuento en el Terrasavr real, asi que no se inventa uno. -->
                        <!-- Bug real encontrado 2-sep-2026 ("hay nombres cortados"): un
                             StackPanel Horizontal le da ancho infinito a este TextBlock al
                             medir, asi que TextWrapping no bastaba solo - hacia falta un
                             MaxWidth real para que el texto tuviera un limite del que
                             envolver, en vez de desbordar en silencio fuera de la columna. -->
                        <TextBlock Text="{Binding Name}" FontSize="11.5" VerticalAlignment="Center"
                                   MaxWidth="165" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
                <ItemsControl ItemsSource="{Binding Children}" Margin="16,0,0,0"
                              ItemTemplate="{DynamicResource CategoryNodeTemplate}"
                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DataTemplate>

        <!-- Tarjeta compacta de slot (todos los contenedores reales) - pregunta a Opus sobre
             el diseño 2-sep-2026. Reutiliza los MISMOS handlers de drag&drop que la tarjeta
             rica (leen sender.DataContext, no dependen de la forma de la tarjeta) y el mismo
             ItemSlotCommand/triggers reales (equipado en verde, Calamity en rojo, seleccionado
             con el glow de acento). Sin Width/Height explicitos - los da SlotGridPanel al
             hacer Arrange. -->
        <DataTemplate x:Key="SlotCompactTemplate" DataType="{x:Type vm:ItemSlotViewModel}">
            <Border AllowDrop="True" ToolTipService.IsEnabled="{Binding ShowTooltip}"
                    PreviewMouseLeftButtonDown="OnItemSlotMouseDown" MouseMove="OnItemSlotMouseMove"
                    DragOver="OnItemSlotDragOver" Drop="OnItemSlotDrop">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding ChooseFromLibraryCommand}" />
                </Border.InputBindings>
                <Border.ToolTip>
                    <ToolTip DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <StackPanel MaxWidth="240">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" TextWrapping="Wrap"
                                       Foreground="{Binding RarityBrush, TargetNullValue={StaticResource TextPrimaryBrush}}"
                                       Visibility="{Binding IsNotEmpty, Converter={StaticResource BoolToVis}}" />
                            <!-- Auditoria de Opus, E-3 -->
                            <TextBlock Text="{Binding SlotRoleLabel}" Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource AccentBrush}"
                                       Visibility="{Binding SlotRoleLabel, Converter={StaticResource NullToVis}}" />
                            <TextBlock Style="{StaticResource CaptionText}"
                                       Visibility="{Binding PrefixDisplay, Converter={StaticResource EmptyToCollapsed}}">
                                <Run Text="Prefijo: " />
                                <Run Text="{Binding PrefixDisplay, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock Text="{Binding StatsTooltip}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                       Visibility="{Binding StatsTooltip, Converter={StaticResource NullToVis}}" />
                            <!-- 6º/7º hueco de accesorio real (consulta a Opus, sexta pasada:
                                 "la etiqueta de color sola es un codigo que el usuario tiene
                                 que aprender; el tooltip lo resuelve gratis") - se ve tambien
                                 con el slot vacio, ver ShowTooltip. -->
                            <TextBlock Text="Hueco extra - Modo Experto (Corazón de Demonio)" Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource PinkBrush}" TextWrapping="Wrap"
                                       Visibility="{Binding IsExpertAccessorySlot, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="Hueco extra - Modo Maestro" Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource MasterGoldBrush}" TextWrapping="Wrap"
                                       Visibility="{Binding IsMasterAccessorySlot, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </ToolTip>
                </Border.ToolTip>
                <!-- El menu contextual TAMPOCO hereda el DataContext solo (es un Popup fuera del
                     arbol visual, igual que el ToolTip de arriba) - mismo remedio real. -->
                <!-- Pregunta a Opus sobre el diseño (2-sep-2026, quinta pasada: "el menú de
                     clic derecho... sale un recuadro rectangular super pequeño que no sirve de
                     nada"). Antes "Vaciar slot" desaparecia por completo si el slot ya estaba
                     vacio (Visibility) - un slot vacio con un unico item real ("Aplicar mejor
                     prefijo", tambien oculto ahi) podia acabar con el menu con 0 filas
                     visibles. IsEnabled en vez de Visibility: la fila SIEMPRE esta, solo se
                     apaga cuando no aplica - comunica el porque en vez de cambiar de forma. -->
                <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Elegir objeto..." Command="{Binding ChooseFromLibraryCommand}" />
                        <MenuItem Header="Aplicar mejor prefijo" Command="{Binding ApplyBestPrefixCommand}"
                                  Visibility="{Binding HasBestPrefixSuggestion, Converter={StaticResource BoolToVis}}" />
                        <MenuItem Header="Vaciar slot" Command="{Binding ClearCommand}" IsEnabled="{Binding IsNotEmpty}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ItemSlotCardCompact}">
                        <Style.Triggers>
                            <!-- El fondo de "hueco vacio" ya lo pone el estilo BASE
                                 (ItemSlotCardCompact en Theme.xaml, pregunta a Opus sobre el
                                 diseño 2-sep-2026 - segunda consulta). Antes había aquí
                                 un DataTrigger de Opacity 0.35 que lavaba ese color contra el
                                 fondo del panel (los triggers del estilo derivado se evalúan
                                 DESPUÉS que los del base) - quitado a propósito, la opacidad ya
                                 no debe tocar el fondo del slot vacío. -->
                            <!-- Auditoria de Opus (octava pasada, T-4/E-1) - BUG REAL encontrado
                                 y arreglado: aqui vivian TAMBIEN los triggers de "es de
                                 Calamity" (borde rojo) y "esta equipado" (borde verde), y en
                                 WPF el ULTIMO trigger activo declarado gana - un objeto de
                                 Calamity equipado (el caso real mas comun, EquipmentGroupViewModel
                                 construye SIEMPRE isEquipped:true) se pintaba SIEMPRE verde,
                                 nunca rojo. Se perdia la señal central "esto es de Calamity" en
                                 la propia pantalla de Equipamiento. Arreglo real (no un parche
                                 de orden): el borde pasa a significar UNA sola cosa
                                 (seleccionado, unico trigger que queda aqui) - "equipado" se
                                 mueve al FONDO (mancha verde suave, ver el Border de relleno de
                                 mas abajo) y "Calamity" a un punto real en la esquina (ver el
                                 Ellipse de mas abajo) - los 3 estados se leen SIEMPRE a la vez,
                                 ninguno tapa a otro. -->
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                                <Setter Property="Effect" Value="{StaticResource AccentGlow}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <!-- Canal real de "equipado" (antes competia por el borde con Calamity/
                         seleccionado, ver el comentario de arriba) - mancha de fondo suave,
                         nunca tapa nada, se lee a la vez que el resto. -->
                    <Border Background="{StaticResource EquippedGreenBrush}" Opacity="0.16" CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsEquipped}" Value="True" />
                                            <Condition Binding="{Binding IsEmpty}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <!-- Auditoria de Opus, Bloque 3 (T-14): "el usuario no tiene ninguna
                         confirmacion visual de que su edicion se aplico" - flash real de un
                         instante, IsHitTestVisible=False (nunca roba el clic/arrastre real del
                         slot) y en su propio canal independiente (Opacity de este Border
                         suyo, no comparte trigger con seleccionado/equipado/Calamity - mismo
                         criterio anti-conflicto del comentario de arriba, T-4/E-1). Disparado
                         SOLO en una edicion real de usuario, ver ItemSlotViewModel.JustEdited/
                         MainViewModel.HookSlotEditing. -->
                    <Border Background="{StaticResource AccentBrush}" CornerRadius="4" Opacity="0" IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding JustEdited}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="0.45" Duration="0:0:0.22" AutoReverse="True" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <!-- Icono fantasma real (extraido del propio juego, ver
                         SlotGhostIconResolver.cs/scripts/extraer-iconos-fantasma-slot.js) -
                         solo visible con el slot vacio, igual que en Terraria real
                         (Color.White*0.35f alli; aqui retintado a TextSecondaryBrush en el
                         propio PNG, ver el script de extraccion). -->
                    <Image Source="{Binding GhostIconPath}" Stretch="Uniform" Margin="6" Opacity="0.35"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                    <Image Source="{Binding IconPath}" Stretch="Uniform" Margin="4"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                    <!-- Canal real de "es de Calamity" - punto en la esquina, siempre visible,
                         nunca tapado por el borde de seleccion ni por la mancha de equipado. -->
                    <Ellipse Width="8" Height="8" Fill="{StaticResource CalamityBrush}"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                             Visibility="{Binding IsCalamity, Converter={StaticResource BoolToVis}}"
                             ToolTip="Objeto de Calamity" />
                    <TextBlock Text="{Binding Count}" FontSize="9.5" Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,1"
                               Visibility="{Binding ShowCount, Converter={StaticResource BoolToVis}}">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" Direction="0" ShadowDepth="0" BlurRadius="3" Opacity="0.9" />
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="&#9733;" FontSize="9" Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,0,0,0"
                               Visibility="{Binding HasBestPrefixSuggestion, Converter={StaticResource BoolToVis}}" />
                    <!-- 6º/7º hueco de accesorio real (consulta a Opus, sexta pasada): una
                         franja vertical en el borde interior izquierdo en vez del contorno (el
                         contorno ya carga 3 significados mutuamente excluyentes - Calamity/
                         Equipado/Seleccionado - y esto es identidad PERMANENTE del hueco, debe
                         leerse a la vez que esos tres, no competir con ellos). Rosa para el 6º
                         (Experto, Corazón de Demonio), oro para el 7º (Modo Maestro) - paleta
                         propia de Terrakeep, no el arcoíris/pulso real del juego (ver el
                         comentario de EquipmentGroupViewModel para el porque). -->
                    <Rectangle Width="3" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="2"
                               Fill="{StaticResource PinkBrush}"
                               Visibility="{Binding IsExpertAccessorySlot, Converter={StaticResource BoolToVis}}" />
                    <Rectangle Width="3" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="2"
                               Fill="{StaticResource MasterGoldBrush}"
                               Visibility="{Binding IsMasterAccessorySlot, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Rejilla compacta de UN contenedor entero - pregunta a Opus sobre el diseño
             2-sep-2026, unificada tras el feedback del usuario ("equipamiento no tiene el mismo
             formato que inventario y el resto de las 9 pestañas"): usada ahora por los 9
             contenedores reales (Equipamiento/Inventario/Almacenes/Monturas/Monedas), no solo
             los de >10 slots. SlotGridPanel (TerrasavrNative.App/Controls) calcula un tamaño de
             celda real entre 44 y 96px que crece/encoge con la ventana; si no cabria ni a 44px,
             aparece scroll (nunca se sacrifica la legibilidad). Columns viene de
             ContainerViewModel.Columns (10 por defecto, 5 para los contenedores de Equipamiento
             - ver EquipmentGroupViewModel.AddSlotSet) para que cada uno mantenga su forma real
             en vez de una unica fila larga. AvailableHeight se enlaza al ActualHeight del propio
             ScrollViewer via RelativeSource AncestorType (recorrido real del arbol visual - un
             ElementName aqui seria fragil, ver SlotGridPanel.cs). -->
        <DataTemplate x:Key="ContainerCompactTemplate" DataType="{x:Type vm:ContainerViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Slots}" ItemTemplate="{StaticResource SlotCompactTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- ReferenceWidth (pregunta a Opus sobre el diseño, quinta pasada -
                                 fusion de Equipamiento con laterales): sin ancestro
                                 SlotRowHost real (el caso de siempre, Inventario/Almacenes/
                                 Equipamiento en solitario) este binding no encuentra nada y
                                 ReferenceWidth se queda en su default 0 = desactivado,
                                 comportamiento identico a como estaba. Solo tiene efecto real
                                 dentro de la fila fusionada de Equipamiento. -->
                            <controls:SlotGridPanel Columns="{Binding Columns}" MinCell="{Binding MinCell}" MaxCell="{Binding MaxCell}" Gap="4"
                                                     ReferenceColumns="10"
                                                     ReferenceWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=controls:SlotRowHost}}"
                                                     AvailableHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </DataTemplate>

        <!-- Un objeto/arma/accesorio recomendado dentro de una build, ya con icono real -->
        <DataTemplate DataType="{x:Type vm:BuildItemRowViewModel}">
            <Border Background="{StaticResource BgElevatedBrush}" CornerRadius="5" Margin="0,0,6,6" Padding="8,5"
                    ToolTip="{Binding StatsTooltip}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderThickness" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCalamity}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource CalamityBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <Image Source="{Binding IconPath}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,7,0"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                    <StackPanel>
                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyText}" />
                        <TextBlock Text="{Binding PrefixText}" Style="{StaticResource CaptionText}"
                                   Visibility="{Binding PrefixText, Converter={StaticResource NullToVis}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Una clase dentro de una etapa (melee/ranged/mage/summoner/rogue) -->
        <DataTemplate x:Key="BuildClassTemplate" DataType="{x:Type vm:BuildClassGearViewModel}">
            <StackPanel Margin="0,0,24,16" MinWidth="220">
                <DockPanel Margin="0,0,0,6">
                    <!-- Bug real encontrado 2-sep-2026 ("el boton apenas se diferencia con el
                         fondo"): Background/Foreground puestos a mano aqui NO HACEN NADA - la
                         plantilla real de Button (Theme.xaml) ignora la propiedad Background
                         del control (usa un SolidColorBrush con nombre fijo) y solo reacciona
                         a Tag="Accent"/"Teal"/"Pink"/"Orange", igual que el resto de botones
                         de color solido de la app (Cargar/Guardar/...). -->
                    <Button DockPanel.Dock="Right" Content="Auto-equipar" FontSize="11" Padding="7,2"
                            Tag="Accent"
                            Command="{Binding DataContext.AutoEquipCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding Source}"
                            IsEnabled="{Binding DataContext.IsCharacterLoaded, RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="Reemplaza SIN CONFIRMACION la armadura y los accesorios puestos en el loadout seleccionado (las armas se colocan en el primer hueco libre del inventario, sin sobrescribir nada) - no lo guardes si no estabas seguro" />
                    <TextBlock Text="{Binding ClassName}" Style="{StaticResource SectionText}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="Armadura" Style="{StaticResource CaptionText}" Margin="0,4,0,2" />
                <ItemsControl ItemsSource="{Binding Armor}" />
                <TextBlock Text="Armas" Style="{StaticResource CaptionText}" Margin="0,6,0,2" />
                <ItemsControl ItemsSource="{Binding Weapons}" />
                <TextBlock Text="Accesorios" Style="{StaticResource CaptionText}" Margin="0,6,0,2" />
                <ItemsControl ItemsSource="{Binding Accessories}" />
            </StackPanel>
        </DataTemplate>

        <!-- Una etapa completa (Pre-Hardmode/Hardmode temprano/Endgame) -->
        <DataTemplate DataType="{x:Type vm:BuildStageViewModel}">
            <StackPanel Margin="0,0,0,28">
                <TextBlock Text="{Binding Label}" Style="{StaticResource TitleText}" Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding Classes}" ItemTemplate="{StaticResource BuildClassTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!-- Una entrada de "Novedades" -->
        <DataTemplate DataType="{x:Type vm:WhatsNewEntryViewModel}">
            <Border Background="{StaticResource BgSecondaryBrush}" CornerRadius="8" Margin="0,0,0,14" Padding="16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Version}" Style="{StaticResource TitleText}" />
                        <TextBlock Text="{Binding DisplayDate}" Style="{StaticResource CaptionText}"
                                   Margin="10,0,0,0" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TextBlock Text="{Binding DisplayNote}" Style="{StaticResource CaptionText}"
                               Margin="0,4,0,8" TextWrapping="Wrap"
                               Visibility="{Binding DisplayNote, Converter={StaticResource EmptyToCollapsed}}" />
                    <ItemsControl ItemsSource="{Binding Changes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type data:WhatsNewChange}">
                                <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,2">
                                    <Run Text="- " Foreground="{StaticResource AccentBrush}" />
                                    <Run Text="{Binding DisplayText, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Objetos nuevos" Style="{StaticResource SectionText}" Margin="0,10,0,4"
                               Visibility="{Binding Items.Count, Converter={StaticResource CountToVis}}" />
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <!-- N-d (segunda auditoria de Opus, Fable): "toda la app enseña
                                 sprites; aqui no, y el resolvedor de iconos ya esta a mano". -->
                            <DataTemplate DataType="{x:Type vm:WhatsNewItemViewModel}">
                                <Border Background="{StaticResource BgElevatedBrush}" CornerRadius="4" Margin="0,0,6,6" Padding="7,3">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding IconPath}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,5,0"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                               Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Changelog del propio EDITOR (Terrakeep, pestaña "Acerca de") - distinto de
             WhatsNewEntry, que es el changelog del juego/Calamity. -->
        <DataTemplate DataType="{x:Type data:ChangelogEntry}">
            <Border Background="{StaticResource BgSecondaryBrush}" CornerRadius="8" Margin="0,0,0,14" Padding="16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Version}" Style="{StaticResource TitleText}" FontSize="18" />
                        <TextBlock Text="{Binding Date}" Style="{StaticResource CaptionText}"
                                   Margin="10,0,0,0" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionText}"
                               Margin="0,4,0,8" TextWrapping="Wrap" />

                    <TextBlock Text="Añadido" Style="{StaticResource SectionText}" FontSize="12" Margin="0,4,0,2"
                               Visibility="{Binding Added.Count, Converter={StaticResource CountToVis}}" />
                    <ItemsControl ItemsSource="{Binding Added}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,2">
                                    <Run Text="+ " Foreground="{StaticResource TealBrush}" />
                                    <Run Text="{Binding Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Arreglado" Style="{StaticResource SectionText}" FontSize="12" Margin="0,8,0,2"
                               Visibility="{Binding Fixed.Count, Converter={StaticResource CountToVis}}" />
                    <ItemsControl ItemsSource="{Binding Fixed}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,2">
                                    <Run Text="- " Foreground="{StaticResource PinkBrush}" />
                                    <Run Text="{Binding Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Rework de Buffs (pregunta a Opus sobre el diseño 2-sep-2026, cuarta pasada: "la
             misma rejilla cantidad de slots y contorno y todo que inventario"). Tarjeta
             compacta de un slot de buff - calco de SlotCompactTemplate, sin Count/estrella de
             prefijo (un buff no tiene cantidad ni prefijo). -->
        <DataTemplate x:Key="BuffSlotCompactTemplate" DataType="{x:Type vm:BuffSlotViewModel}">
            <Border AllowDrop="True" ToolTipService.IsEnabled="{Binding IsNotEmpty}"
                    PreviewMouseLeftButtonDown="OnBuffSlotMouseDown" MouseMove="OnBuffSlotMouseMove"
                    Drop="OnBuffSlotDrop">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding ChooseFromLibraryCommand}" />
                </Border.InputBindings>
                <Border.ToolTip>
                    <ToolTip DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <StackPanel MaxWidth="240">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                       Visibility="{Binding Description, Converter={StaticResource NullToVis}}" />
                        </StackPanel>
                    </ToolTip>
                </Border.ToolTip>
                <!-- Pregunta a Opus sobre el diseño (2-sep-2026, quinta pasada: "mejor sería
                     que tuviera igual que en las armas añadir buff o quitar buff si lo hay") -
                     mismo par de acciones reales que ya tiene la tarjeta de objetos
                     (ChooseFromLibraryCommand ya existe, lo usa el doble clic de arriba) +
                     IsEnabled en vez de Visibility, mismo criterio que el menu de objetos. -->
                <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Elegir buff..." Command="{Binding ChooseFromLibraryCommand}" />
                        <MenuItem Header="Vaciar slot" Command="{Binding ClearCommand}" IsEnabled="{Binding IsNotEmpty}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <!-- Auditoria de Opus, Bloque 5 (T-4): BUG REAL encontrado y arreglado - mismo
                     anti-patron ya diagnosticado y arreglado en SlotCompactTemplate (E-1,
                     octava pasada): "es de Calamity" y "esta seleccionado" competian por
                     BorderBrush, y en WPF el ULTIMO trigger activo declarado gana. Un buff de
                     Calamity seleccionado para editarlo (camino real y comun, ver
                     MainViewModel.SelectBuffSlot) perdia el borde rojo justo mientras se estaba
                     editando - se perdia la señal "esto es de Calamity" en el momento en que
                     mas falta hace. Mismo arreglo real: el borde pasa a significar UNA sola
                     cosa (seleccionado), "Calamity" se mueve a un punto real en la esquina
                     (Ellipse de mas abajo) - ambos estados se leen siempre a la vez. -->
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ItemSlotCardCompact}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                                <Setter Property="Effect" Value="{StaticResource AccentGlow}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Image Source="{Binding IconPath}" Stretch="Uniform" Margin="4"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                    <Ellipse Width="8" Height="8" Fill="{StaticResource CalamityBrush}"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                             Visibility="{Binding IsCalamity, Converter={StaticResource BoolToVis}}"
                             ToolTip="Buff de Calamity" />
                    <!-- Bu-a (segunda auditoria de Opus, Fable): "T-14 se porto a objetos y no a
                         buffs, aunque los comentarios declaran a los dos paneles como gemelos" -
                         calco literal del flash real de SlotCompactTemplate (T-14), mismo canal
                         independiente (Opacity propio, IsHitTestVisible=False). -->
                    <Border Background="{StaticResource AccentBrush}" CornerRadius="4" Opacity="0" IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding JustEdited}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="0.45" Duration="0:0:0.22" AutoReverse="True" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Rejilla compacta de los 44/22/10 slots de buff reales - calco de
             ContainerCompactTemplate, misma SlotGridPanel/ReferenceColumns=10 (mismo tamaño de
             icono que el resto de rejillas de la app). -->
        <DataTemplate x:Key="BuffContainerCompactTemplate" DataType="{x:Type vm:BuffContainerViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Slots}" ItemTemplate="{StaticResource BuffSlotCompactTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:SlotGridPanel Columns="{Binding Columns}" MinCell="40" MaxCell="90" Gap="4"
                                                     ReferenceColumns="10"
                                                     AvailableHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </DataTemplate>

        <!-- Panel "Editar buff seleccionado" - calco reducido de ItemEditTemplate. -->
        <DataTemplate x:Key="BuffEditTemplate" DataType="{x:Type vm:BuffEditViewModel}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Editar buff" Style="{StaticResource SectionText}" Margin="0,0,0,10" />

                <TextBlock DockPanel.Dock="Top" Text="{Binding NoSelectionMessage}" Style="{StaticResource CaptionText}"
                           TextWrapping="Wrap" Margin="0,0,0,10"
                           Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}" />

                <!-- Auditoria de Opus, Bloque 5 (T-5): mismo criterio que ItemEditTemplate -
                     leyenda real, solo en el hueco de "sin seleccion" (aqui sin "equipado",
                     los buffs no tienen ese estado). -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10"
                            Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}">
                    <TextBlock Text="Leyenda" Style="{StaticResource CaptionText}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Ellipse Width="10" Height="10" Fill="{StaticResource CalamityBrush}" Margin="2,0,6,0" />
                        <TextBlock Text="Punto rojo = buff de Calamity" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="14" Height="14" CornerRadius="3" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" Margin="0,0,6,0" />
                        <TextBlock Text="Borde morado = slot seleccionado" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Vaciar slot" Command="{Binding ClearSlotCommand}"
                                ToolTip="Vaciar este slot" Tag="Ghost" Padding="6,3" FontSize="10.5" VerticalAlignment="Center" />
                        <Image Source="{Binding Slot.IconPath}" Width="32" Height="32" Stretch="Uniform" Margin="0,0,8,0"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               VerticalAlignment="Center"
                               Visibility="{Binding Slot.IconPath, Converter={StaticResource NullToVis}}" />
                        <TextBlock Text="{Binding Slot.DisplayName}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                   MaxWidth="200" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- Bu-b (segunda auditoria de Opus, Fable): mismo patron real ya usado en
                         ItemEditTemplate - RejectionMessage, sin nada modal. -->
                    <TextBlock Text="{Binding Slot.RejectionMessage}" Style="{StaticResource CaptionText}"
                               Foreground="{StaticResource CalamityBrush}" TextWrapping="Wrap" Margin="0,-4,0,8"
                               Visibility="{Binding Slot.RejectionMessage, Converter={StaticResource NullToVis}}" />

                    <TextBlock Text="{Binding Slot.Description}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                               Margin="0,0,0,10" Visibility="{Binding Slot.Description, Converter={StaticResource NullToVis}}" />

                    <TextBlock Text="Duración (s)" Style="{StaticResource CaptionText}" Margin="0,0,0,3" />
                    <TextBox Text="{Binding Slot.DurationSeconds, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,10"
                             Background="{StaticResource BgElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />

                    <!-- 3 botones reales (pregunta a Opus sobre el diseño 2-sep-2026, cuarta
                         pasada): Minima = dato real extraido del buffTime de la pocion base (o
                         la moda real como aproximacion honesta, ver MinTooltip); Media = 2x
                         Minima (unico precedente real de escalera, Pocion de la suerte);
                         Maxima = S.getMaxTime() real del propio Terrasavr. -->
                    <!-- Jerarquia real (pregunta a Opus sobre el diseño, quinta pasada): los 3
                         son valores del MISMO control, no 3 acciones de peso distinto - Maxima
                         (la que el 95% quiere) en Accent, Minima/Media en AccentSoft. -->
                    <UniformGrid Columns="3" Rows="1">
                        <Button Content="{Binding MinLabel}" Command="{Binding ApplyMinCommand}" ToolTip="{Binding MinTooltip}"
                                Tag="AccentSoft" FontSize="10.5" Padding="4,6" Margin="0,0,4,0" />
                        <Button Content="{Binding MediaLabel}" Command="{Binding ApplyMediaCommand}"
                                ToolTip="2x la duración mínima - único precedente real de escalera en el juego (Poción de la suerte)"
                                Tag="AccentSoft" FontSize="10.5" Padding="4,6" Margin="0,0,4,0" />
                        <Button Content="{Binding MaxLabel}" Command="{Binding ApplyMaxCommand}"
                                ToolTip="Duración máxima real permitida por Terrasavr"
                                Tag="Accent" FontSize="10.5" Padding="4,6" />
                    </UniformGrid>
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <!-- Tarjeta de un objeto del catalogo completo en la Libreria (quinta pasada, pregunta a
             Opus sobre el diseño: "la libreria sigue sin tener las rejillas como en
             inventario"). Sustituye la tarjeta fija 80x86 con caption de nombre - obligatorio
             quitar Width/Height fijos porque SlotGridPanel.ArrangeOverride hace
             Arrange(new Rect(x,y,_cell,_cell)), un tamaño fijo se saldria de una celda pequeña
             y se solaparia con la vecina. El nombre se quita de la tarjeta (vivia recortado en
             silencio sin puntos suspensivos en categorias con muchos resultados) y se compone
             solo en el tooltip, que ya lo hacia - mismo patron ya validado en
             BuffLibraryCardTemplate. Arrastre igual que siempre (OnLibraryCardMouseDown/Move,
             no dependen de la forma de la tarjeta). -->
        <DataTemplate x:Key="LibraryCardTemplate" DataType="{x:Type vm:LibraryItemViewModel}">
            <Border Padding="0" CornerRadius="6" Background="{StaticResource BgElevatedBrush}" BorderThickness="1" Cursor="Hand"
                    PreviewMouseLeftButtonDown="OnLibraryCardMouseDown" MouseMove="OnLibraryCardMouseMove">
                <Border.ToolTip>
                    <ToolTip DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <StackPanel MaxWidth="240">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" TextWrapping="Wrap"
                                       Foreground="{Binding RarityBrush, TargetNullValue={StaticResource TextPrimaryBrush}}" />
                            <TextBlock Text="{Binding StatsTooltip}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                       Visibility="{Binding StatsTooltip, Converter={StaticResource NullToVis}}" />
                        </StackPanel>
                    </ToolTip>
                </Border.ToolTip>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush0}" />
                        <Style.Triggers>
                            <!-- Auditoria de Opus (octava pasada, L-6) - BUG REAL encontrado y
                                 arreglado: el hover ponia TAMBIEN el borde en acento, declarado
                                 ANTES que el DataTrigger de Calamity - sobre una tarjeta de
                                 Calamity, el borde de hover nunca se veia (gana el rojo,
                                 declarado despues). El hover ya se lee de sobra solo con el
                                 fondo (mismo criterio que BuffLibraryCardTemplate, que nunca
                                 tuvo este bug); el borde queda libre para significar solo
                                 "es de Calamity", visible siempre. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BgHoverBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCalamity}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource CalamityBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Image Source="{Binding IconPath}" Stretch="Uniform" Margin="4"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                    <!-- Auditoria de Opus, T-10: suelo real de legibilidad - 8px era mas pequeño
                         que cualquier otro texto real de la app (el resto usa 9px o mas para
                         palabras reales), aqui subido a 9. -->
                    <Button Content="Colocar" Tag="Accent" FontSize="9" Padding="0,1" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                            Command="{Binding DataContext.Library.PlaceInTargetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Visibility="{Binding DataContext.Library.IsPicking, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Tarjeta de un buff del catalogo completo en la Libreria de buffs (Fase 2, pregunta
             a Opus sobre el diseño 2-sep-2026: "resultados en rejilla, misma tarjeta que la de
             arriba") - mismo lenguaje visual que BuffSlotCompactTemplate (icono cuadrado,
             borde rojo si es Calamity), sin estados de vacio/seleccion (una entrada de
             catalogo no tiene ninguno de los dos) y con el boton "Colocar" solo cuando hay un
             slot esperando (BuffLibrary.IsPicking). -->
        <DataTemplate x:Key="BuffLibraryCardTemplate" DataType="{x:Type vm:BuffCatalogEntryViewModel}">
            <Border Padding="0" CornerRadius="6" Background="{StaticResource BgElevatedBrush}" BorderThickness="1" Cursor="Hand"
                    PreviewMouseLeftButtonDown="OnBuffLibraryCardMouseDown" MouseMove="OnBuffLibraryCardMouseMove">
                <Border.ToolTip>
                    <ToolTip DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <StackPanel MaxWidth="240">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                       Visibility="{Binding Description, Converter={StaticResource NullToVis}}" />
                        </StackPanel>
                    </ToolTip>
                </Border.ToolTip>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush0}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BgHoverBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCalamity}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource CalamityBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Image Source="{Binding IconPath}" Stretch="Uniform" Margin="4"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                    <!-- Auditoria de Opus, T-10: suelo real de legibilidad - 8px era mas pequeño
                         que cualquier otro texto real de la app (el resto usa 9px o mas para
                         palabras reales), aqui subido a 9. -->
                    <Button Content="Colocar" Tag="Accent" FontSize="9" Padding="0,1" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                            Command="{Binding DataContext.BuffLibrary.PlaceInTargetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Visibility="{Binding DataContext.BuffLibrary.IsPicking, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Auditoria de Opus, I-1: tarjeta real de un personaje encontrado de un plumazo en el
             lanzador de Inicio - doll de cuerpo completo real (PlayerPreviewRenderer, mismos
             datos que ya guarda el propio .plr), dificultad, insignia de Calamity si tiene
             .tplr al lado, y fecha real de ultima modificacion - un click carga y salta a
             Personaje (MainViewModel, Home.CharacterChosen). -->
        <DataTemplate x:Key="CharacterCardTemplate" DataType="{x:Type vm:CharacterListEntryViewModel}">
            <Border Padding="12" CornerRadius="8" Background="{StaticResource BgElevatedBrush}" BorderThickness="1"
                    Width="240" Margin="0,0,14,14" Cursor="Hand"
                    Effect="{StaticResource CardShadow}"
                    Tag="{Binding DataContext.Home, RelativeSource={RelativeSource AncestorType=Window}}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.Home.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                </Border.InputBindings>
                <!-- I-b (segunda auditoria de Opus, Fable): "Sin ninguna accion secundaria en la
                     tarjeta - faltan las 3 obvias y baratas". Menu contextual real (clic derecho).
                     Un ContextMenu real es un popup APARTE del arbol visual de la ventana -
                     RelativeSource AncestorType=Window (el truco de arriba) no llega hasta aqui
                     dentro, por eso HomeViewModel viaja en el propio Tag del Border (inerte, sitio
                     real donde dejarlo) y PlacementTarget.Tag lo recupera desde el menu. -->
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Abrir carpeta"
                                  Command="{Binding PlacementTarget.Tag.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Duplicar personaje"
                                  Command="{Binding PlacementTarget.Tag.DuplicateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Restaurar copia de seguridad"
                                  Command="{Binding PlacementTarget.Tag.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush0}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BgHoverBrush}" />
                                <Setter Property="Effect" Value="{StaticResource CardShadowHover}" />
                            </Trigger>
                            <!-- I-a: "No se distingue que personaje esta cargado - las tarjetas se
                                 ven identicas al volver a Inicio". -->
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="{Binding Preview}" Width="52" Height="72.8" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <DockPanel>
                            <TextBlock Text="✓" DockPanel.Dock="Right" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" Margin="4,0,0,0"
                                       ToolTip="Este es el personaje cargado ahora mismo"
                                       Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding Name}" Style="{StaticResource SectionText}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border Background="{StaticResource BgHoverBrush}" CornerRadius="3" Padding="5,1">
                                <TextBlock Text="{Binding DifficultyLabel}" Style="{StaticResource CaptionText}" FontSize="10" />
                            </Border>
                            <Border Background="{StaticResource CalamityBrush}" CornerRadius="3" Padding="5,1" Margin="5,0,0,0"
                                    Visibility="{Binding IsCalamity, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Calamity" FontSize="10" Foreground="White" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding LastModifiedText}" Style="{StaticResource CaptionText}" FontSize="10" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Auditoria de Opus, N-1: "el personaje cargado, si tiene cambios sin guardar, y las
             propias acciones de Cargar/Guardar solo se veian dentro de la pestaña Personaje" -
             viola P2 (todo a mano, nada se esconde): cambiar a Builds/Exploracion/etc perdia de
             vista con QUE personaje se estaba trabajando, y guardar exigia volver a Personaje
             primero. Barra real, visible en CUALQUIER pestaña - mismo doll de
             PlayerPreviewRenderer que ya usa Apariencia (real, no un icono generico), nombre,
             dificultad, insignia de Calamity (mismo criterio que en todos los demas sitios,
             HasCalamityData) y el punto de "sin guardar" ya real de WindowTitle/IsDirty. -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource BorderBrush0}"
                BorderThickness="0,0,0,1" Padding="16,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- T-H/F1 (segunda auditoria de Opus, Fable): "N-3 esta bien hecho pero no se
                         anuncia en ningun sitio (sin ToolTip en la cabecera)... un atajo que nadie
                         descubre no mejora la practicidad" - los 4 atajos reales (OnWindowKeyDown)
                         ya existian, solo faltaba decirlo donde el usuario los va a usar. -->
                    <Button Content="Cargar personaje (.plr)..." Tag="Accent" Click="OnLoadClick" ToolTip="Ctrl+O" />
                    <!-- T-C (segunda auditoria de Opus, Fable): el .bak real que Guardar ya deja
                         (CharacterFileService.WriteAtomic) ahora tiene una forma real de usarse
                         desde la propia UI, sin ir a buscarlo a mano al Explorador de archivos. -->
                    <Button Content="Deshacer último guardado" Margin="10,0,0,0" Command="{Binding UndoLastSaveCommand}"
                            ToolTip="Restaura el personaje tal y como estaba ANTES del último 'Guardar' real (usa la copia .bak)" />
                    <Button Content="Guardar" Tag="Orange" Margin="10,0,0,0" Command="{Binding SaveCommand}" ToolTip="Ctrl+S" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsCharacterLoaded, Converter={StaticResource BoolToVis}}">
                    <Image Source="{Binding Appearance.PreviewImage}" Width="28" Height="39.2" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <!-- H-1 (segunda auditoria de Opus, Fable): "PlrCharacter.Name se lee y
                                 se escribe sin problema... y muestra el nombre como texto muerto" -
                                 TextBox real con el estilo "filled" ya usado en el resto de la app
                                 (BgElevatedBrush, sin borde) + OnCommitTextOnEnter (ya existe, T-17
                                 resolvio el gotcha de UpdateSourceTrigger=PropertyChanged vs Intro). -->
                            <TextBox Text="{Binding CharacterName, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnCommitTextOnEnter"
                                     FontFamily="{StaticResource AppFont}" FontSize="14" FontWeight="SemiBold"
                                     Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource BgElevatedBrush}"
                                     BorderThickness="0" Padding="4,2" MinWidth="80" VerticalAlignment="Center" />
                            <TextBlock Text="●" FontSize="16" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="6,0,0,0"
                                       ToolTip="Hay cambios sin guardar"
                                       Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" />
                            <!-- H-1/F2: "Aviso discreto si el nombre del archivo no coincide" - un
                                 .plr renombrado/copiado por fuera puede tener un nombre real
                                 distinto del nombre del fichero, confusion real al distinguir dos
                                 ventanas del Explorador. -->
                            <TextBlock Text="⚠" FontSize="13" Foreground="{StaticResource OrangeBrush}" VerticalAlignment="Center" Margin="6,0,0,0"
                                       ToolTip="El nombre del personaje no coincide con el nombre del archivo"
                                       Visibility="{Binding NameFileMismatch, Converter={StaticResource BoolToVis}}" />
                            <Border Background="{StaticResource BgHoverBrush}" CornerRadius="3" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Appearance.DifficultyLabel}" Style="{StaticResource CaptionText}" FontSize="11" />
                            </Border>
                            <Border Background="{StaticResource CalamityBrush}" CornerRadius="3" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding HasCalamityData, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Calamity" FontSize="11" Foreground="White" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <!-- H-2: "Sin rastro de la version ni del archivo abierto - hay que ir a la
                             pestaña Version (tercer nivel)... no hay forma de distinguir dos
                             personajes con el mismo nombre en carpetas distintas". -->
                        <TextBlock Text="{Binding FileVersionLine}" Style="{StaticResource CaptionText}" FontSize="11" Margin="4,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="Sin personaje cargado" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                           Visibility="{Binding IsCharacterLoaded, Converter={StaticResource InverseBoolToVis}}" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
        <TabControl Style="{StaticResource NavTabControl}" SelectedIndex="{Binding SelectedTabIndex}">
        <!-- ===================== INICIO ===================== -->
        <TabItem Header="Inicio">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="14">
                <!-- I-c (segunda auditoria de Opus, Fable): MaxWidth dependiente de SizeClass -
                     en una ventana Amplia el WrapPanel de tarjetas de abajo tiene sitio real
                     para repartirse en una fila mas ancha en vez de dejar ~1000px negros. -->
                <StackPanel MaxWidth="{Binding InicioContentMaxWidth}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                        <Image Source="pack://siteoforigin:,,,/Assets/branding/logo-128.png" Width="56" Height="56" />
                        <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Text="{Binding About.AppName}" Style="{StaticResource TitleText}" FontSize="26" />
                            <TextBlock Text="{Binding About.Tagline}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" LineHeight="20" Margin="0,10,0,24" MaxWidth="700">
                        <Run Text="Editor de personajes de Terraria - vanilla y Calamity Mod (tModLoader) a la vez, con el mismo archivo. Edición nativa: sin Electron, sin Chromium embebido, arranque instantáneo. Carga un " />
                        <Run Text=".plr" FontStyle="Italic" />
                        <Run Text=" (con su " />
                        <Run Text=".tplr" FontStyle="Italic" />
                        <Run Text=" si lo tiene) y edita inventario, equipo por loadout, buffs, investigación, mascotas/monturas, apariencia y más - los objetos de Calamity se detectan y editan igual que los vanilla, marcados en " />
                        <Run Text="rojo" Foreground="{StaticResource CalamityBrush}" FontWeight="SemiBold" />
                        <Run Text=" para distinguirlos." />
                    </TextBlock>

                    <!-- Auditoria de Opus, I-1: "Inicio" era una pagina de bienvenida estatica -
                         ni un solo personaje real a la vista, obligaba a abrir el Explorador de
                         archivos incluso para el caso normal (P1/P2). Lanzador real: si hay
                         .plr en la carpeta real de tModLoader, aparecen aqui de un plumazo, con
                         su doll/dificultad/insignia/fecha reales - un click carga y salta a
                         Personaje. Si no hay ninguno (carpeta vacia o instalacion sin
                         detectar), se cae al boton manual de siempre. -->
                    <StackPanel Visibility="{Binding Home.Characters.Count, Converter={StaticResource CountToVis}}" Margin="0,0,0,26">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Tus personajes" Style="{StaticResource SectionText}" VerticalAlignment="Center" />
                            <Button Content="Actualizar" FontSize="11" Padding="8,2" Margin="12,0,0,0"
                                    Command="{Binding Home.RefreshCommand}" />
                            <Button Content="Cargar desde otra carpeta..." FontSize="11" Padding="8,2" Margin="8,0,0,0"
                                    Click="OnLoadClick" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Home.Characters}" ItemTemplate="{StaticResource CharacterCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>

                    <Button Style="{StaticResource NavCardButton}" HorizontalAlignment="Left" Margin="0,0,0,26"
                            Visibility="{Binding Home.ScanMessage, Converter={StaticResource EmptyToCollapsed}}"
                            Click="OnLoadClick">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="4" Background="{StaticResource AccentBrush}" CornerRadius="2" Margin="0,0,16,0" />
                            <StackPanel>
                                <TextBlock Text="Empezar: cargar un personaje" Style="{StaticResource SectionText}" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="{Binding Home.ScanMessage}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="520" Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="Qué más puedes hacer" Style="{StaticResource SectionText}" Margin="0,0,0,12" />
                    <!-- I-c/F2 (segunda auditoria de Opus, Fable): MinHeight en vez de Height fijo
                         en las 5 tarjetas de abajo - un titulo/descripcion real que necesite mas
                         de las 2 lineas habituales (ej. una traduccion mas larga) hace crecer la
                         tarjeta en vez de recortarse contra un alto fijo. -->
                    <ItemsControl>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <Button Style="{StaticResource NavCardButton}" Width="270" MinHeight="108" Margin="0,0,14,14"
                                Command="{Binding GoToTabCommand}" CommandParameter="Libreria">
                            <StackPanel>
                                <TextBlock Text="Librería" Style="{StaticResource SectionText}" />
                                <TextBlock Text="Busca entre miles de objetos vanilla y de Calamity por nombre y colócalos directamente en cualquier slot."
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavCardButton}" Width="270" MinHeight="108" Margin="0,0,14,14"
                                Command="{Binding GoToTabCommand}" CommandParameter="Builds">
                            <StackPanel>
                                <TextBlock Text="Builds" Style="{StaticResource SectionText}" />
                                <TextBlock Text="Equipo recomendado por clase y etapa del juego (vanilla y Calamity), con auto-equipar de un click."
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavCardButton}" Width="270" MinHeight="108" Margin="0,0,14,14"
                                Tag="Pink" Command="{Binding GoToTabCommand}" CommandParameter="Exploracion">
                            <StackPanel>
                                <TextBlock Text="Exploración" Style="{StaticResource SectionText}" />
                                <TextBlock Text="Carga un mundo .wld y navega su mapa completo: pan, zoom y NPCs de pueblo con su posición."
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavCardButton}" Width="270" MinHeight="108" Margin="0,0,14,14"
                                Tag="Teal" Command="{Binding GoToTabCommand}" CommandParameter="Novedades">
                            <StackPanel>
                                <TextBlock Text="Novedades" Style="{StaticResource SectionText}" />
                                <TextBlock Text="Qué ha cambiado en cada versión del JUEGO y de Calamity Mod - objetos nuevos, arreglos, etc."
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavCardButton}" Width="270" MinHeight="108" Margin="0,0,14,14"
                                Tag="Orange" Command="{Binding GoToTabCommand}" CommandParameter="AcercaDe">
                            <!-- N-c (segunda auditoria de Opus, Fable): esta tarjeta decia "¡Sobre esta
                                 versión!" pero llevaba a una pestaña con la cabecera "Acerca de" - dos
                                 nombres distintos para el MISMO destino. Se unifica con el nombre real de
                                 la pestaña (la cabecera es la fuente de verdad); "¡Sobre esta versión!"
                                 sigue vivo dentro, como titulo real de la subseccion del changelog. -->
                            <StackPanel>
                                <TextBlock Text="Acerca de" Style="{StaticResource SectionText}" />
                                <TextBlock Text="Que ha cambiado en el propio Terrakeep, versión instalada y créditos."
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            </StackPanel>
                        </Button>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ===================== PERSONAJE ===================== -->
        <TabItem Header="Personaje">
            <Grid>
            <DockPanel Margin="14">
                <!-- Auditoria de Opus, N-1: Cargar/Guardar/nombre de personaje ya viven en la
                     cabecera global (MainWindow.xaml, visible en cualquier pestaña) - repetirlos
                     aqui era la misma accion dos veces en dos sitios (contra P6, simetria real:
                     una unica fuente real por accion). Solo se queda el mensaje de estado, que
                     es especifico de la ultima operacion real. -->
                <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}"
                           Margin="0,0,0,12" TextWrapping="Wrap" />

                <TabControl Style="{StaticResource InnerTabControl}" SelectedIndex="{Binding PersonajeInnerTabIndex}">
                    <TabItem Header="Objetos">
                        <!-- Layout real de Terrasavr (pedido explicito 1-sep-2026): el inventario/equipo
                             arriba, la Libreria (arbol + buscador) siempre visible debajo, a la derecha
                             del arbol - nunca una pestaña aparte a la que hay que ir, para que arrastrar
                             una tarjeta de la Libreria hasta un slot visible sea posible de verdad. -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- Antes fija en 270px SIEMPRE (46% del alto util de esta
                                     pestaña) - pregunta a Opus sobre el diseño (2-sep-2026):
                                     Auto dejaba que la cabecera colapsable de abajo decidiera
                                     su propio alto real, pero un "Auto" con un hijo de 238px
                                     fijo SIEMPRE cobra esos 238px primero, sea cual sea el alto
                                     real disponible - la fila "*" de arriba (el contenido
                                     principal, Inventario/Almacenes/Equipamiento) se quedaba
                                     con lo que sobrara, hasta cero si hacia falta - "el
                                     Inventario estaba subvencionando a la Libreria" (consulta a
                                     Opus, septima pasada). Las DOS filas compiten de verdad por
                                     el alto real disponible (ambas "*" cuando la Libreria esta
                                     desplegada) - Objetos con prioridad y un suelo real (216px
                                     = 5 filas de Inventario a 40px + huecos, el caso mas
                                     exigente de los 3 sub-tabs que comparten esta fila).
                                     Segunda auditoria de Opus (Fable), B-1 - BUG REAL
                                     encontrado y arreglado ya una vez (octava pasada, commit
                                     83fd33c) y perdido por un revert de rango demasiado ancho
                                     (c38c960): al pasar de "Auto" a "*" para resolver lo de
                                     arriba, PLEGAR la Libreria dejo de devolver espacio de
                                     verdad - la fila seguia siendo "1*" con MinHeight=150
                                     SIEMPRE, asi que plegada seguia dejando una banda vacia de
                                     150-238px con forma de Libreria (el usuario la veia como
                                     "expandida" aunque el boton dijera lo contrario).
                                     Height/MinHeight de la fila de la Libreria ahora dependen
                                     de IsLibraryVisible (ver MainViewModel) via
                                     BoolToGridLength/BoolToDouble - colapsada de verdad,
                                     Height=Auto MinHeight=0 (se encoge al alto real de la barra
                                     "Librería ▼ Desplegar", ~34px, cero hueco muerto);
                                     desplegada, "2*" con suelo 200. MaxHeight se queda fijo,
                                     sin depender de la visibilidad (un techo generoso no
                                     molesta estando colapsada, Auto ya no crece de mas por si
                                     solo). -->
                                <RowDefinition Height="3*" MinHeight="216" />
                                <RowDefinition Height="{Binding IsLibraryVisible, Converter={StaticResource BoolToGridLength}, ConverterParameter=2}"
                                               MinHeight="{Binding IsLibraryVisible, Converter={StaticResource BoolToDouble}, ConverterParameter=200}"
                                               MaxHeight="460" />
                            </Grid.RowDefinitions>

                            <!-- Contenedores a la izquierda + panel "Editar" a la derecha (equivalente real
                                 de app.TabInventory.initSide: sideCtr con las pestañas Edit/Library reales -
                                 aqui Library ya vive fijo abajo, ver Grid.Row=1, y Editar sigue al slot
                                 SELECCIONADO sea cual sea el contenedor activo). -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="300" />
                                </Grid.ColumnDefinitions>

                                <!-- Antes: 21 pestañas planas en una sola fila (9 contenedores + 12 de
                                     loadout puesto/1/2/3 x armadura/vanidad/tintes) - se amontonaba
                                     al reducir la ventana (pedido explicito 2-sep-2026). Ahora: solo 2
                                     pestañas externas, "Equipamiento" consolida los 12 sub-contenedores
                                     con su propio selector (equivalente real de app.TabEquips/Sb, ver
                                     bitacora.md "Fase D"). -->
                                <TabControl Grid.Column="0" Style="{StaticResource InnerTabControl}" Margin="0,0,10,0">
                                    <TabItem Header="Equipamiento">
                                        <!-- Fusion con Monturas/Monedas como laterales (pregunta a Opus
                                             sobre el diseño, quinta pasada: "yo juntaría la página de
                                             munición mascotas gancho... y dinero en equipamiento en una
                                             sola ventana pero a los lados... mascotas etc mejor en
                                             vertical"). UN solo marco naranja para todo el bloque (3
                                             marcos compitiendo en ~672px seria el mismo amontonamiento
                                             que ya se resolvio en la tercera pasada) - los laterales se
                                             distinguen "hundiendose" (BgPrimaryBrush, mismo idioma que
                                             el arbol de la Libreria y los huecos vacios de
                                             ItemSlotCardCompact) en vez de con su propio contorno.
                                             SlotRowHost (no un Grid a secas) para que ReferenceWidth de
                                             los 3 SlotGridPanel de esta fila se enlace de forma fiable
                                             (ver SlotGridPanel.cs) contra el ancho de TODA la fila
                                             fusionada, no el de cada columna estrecha por separado -
                                             sin esto los 3 colapsarian a MinCell=44, mas pequeños que
                                             Inventario, el problema inverso de la cuarta pasada. -->
                                        <Border BorderBrush="{StaticResource OrangeBrush}" BorderThickness="2" CornerRadius="10"
                                                Background="{StaticResource BgSecondaryBrush}" Padding="10" Margin="0,6,0,0">
                                            <!-- Columnas de ancho real, no proporciones puras (consulta a
                                                 Opus, septima pasada): "2*/5*/4*" no guardaba ninguna
                                                 relacion con los anchos minimos REALES de cada bloque (52/
                                                 216/192px medidos) - a la resolucion minima de la propia
                                                 ventana la columna central (Armadura/Accesorios, la que
                                                 mas lo necesita) se quedaba corta y su contenido real
                                                 (SlotGridPanel no recorta solo, WPF Panel no clipea a sus
                                                 hijos por defecto) desbordaba visiblemente sobre el lateral
                                                 de Monedas/Municion. Los laterales van a "Auto" con un
                                                 MinWidth real (su contenido ya se autolimita via MinCell/
                                                 ReferenceWidth, el MinWidth es solo la red de seguridad);
                                                 el centro se queda con TODO el sobrante ("*"). ClipToBounds
                                                 en el propio SlotRowHost como segunda red de seguridad -
                                                 nunca deberia activarse ya con esto, pero si algun caso
                                                 raro se escapa, prefiere recortar en silencio a solapar
                                                 visiblemente encima de otro contenido. -->
                                            <controls:SlotRowHost ClipToBounds="True">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MinWidth="140" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" MinWidth="200" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <!-- Lateral izquierdo: Mascota/Montura/Gancho + Tinte, en
                                                     vertical (Columns=1, ver MainViewModel.AddContainer).
                                                     RowSpan=2 para aprovechar tambien la franja del
                                                     selector Loadout/Vista (que no la necesita, es solo
                                                     texto+pildoras) - propio ScrollViewer de seguridad:
                                                     10 slots reales en 1 columna no siempre caben sin
                                                     scroll en ventanas pequeñas, y NO sacrificar
                                                     legibilidad (MinCell=44) es mas importante que nunca
                                                     scrollear aqui. -->
                                                <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Background="{StaticResource BgPrimaryBrush}"
                                                        CornerRadius="8" Padding="6" Margin="0,0,8,0">
                                                    <!-- Mascota/Montura y Tinte UNO AL LADO DEL OTRO, no apilados
                                                         (consulta a Opus, septima pasada, corregido con medicion
                                                         real tras implementar su recomendacion original): apilados
                                                         verticalmente son 2 rejillas de 5 filas = 10 filas reales
                                                         que compartir en la misma columna - medido con el arnes de
                                                         UI Automation, a la altura minima real de la ventana
                                                         necesitan ~412px y solo hay ~278px, un desfase real de
                                                         ~134px que NINGUN ajuste de MinCell/MaxCell puede cerrar
                                                         sin bajar de 30px (el suelo real de "mancha de color" de
                                                         Opus) - hay mas ancho de sobra que alto en este lateral
                                                         (confirmado, Auto ya no tiene techo que perseguir gracias
                                                         al MaxCell propio de arriba), asi que la solucion real es
                                                         usar ESE ancho: en horizontal, cada rejilla solo necesita
                                                         5 filas de alto, no 10 - el ScrollViewer de seguridad se
                                                         queda (para ventanas aun mas pequeñas que esta), solo
                                                         VERTICAL - HorizontalScrollBarVisibility="Disabled" sigue
                                                         siendo correcto, la columna Auto ya crece si hace falta. -->
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                        <StackPanel Orientation="Horizontal">
                                                            <StackPanel Margin="0,0,10,0">
                                                                <!-- TextWrapping="Wrap" + MaxWidth (consulta a Opus,
                                                                     septima pasada): un TextBlock sin envolver
                                                                     RECORTA en seco cuando la columna es mas
                                                                     estrecha que el texto ("Mascota /" sin
                                                                     "Montura", capturado real a la resolucion
                                                                     minima) - el MaxWidth es real, no decorativo:
                                                                     esta columna es "Auto" y WPF mide sus hijos con
                                                                     ancho INFINITO en la primera pasada, asi que sin
                                                                     este tope el texto sin envolver (~100px) seria
                                                                     mas ancho que la propia rejilla de iconos y
                                                                     terminaria fijando el ancho real de la columna
                                                                     entera. -->
                                                                <TextBlock Text="Mascota / Montura" Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="70" Margin="0,0,0,3" />
                                                                <ContentControl Content="{Binding MountsContainer}" ContentTemplate="{StaticResource ContainerCompactTemplate}" />
                                                            </StackPanel>
                                                            <StackPanel>
                                                                <TextBlock Text="Tinte" Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="70" Margin="0,0,0,3" />
                                                                <ContentControl Content="{Binding DyesContainer}" ContentTemplate="{StaticResource ContainerCompactTemplate}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </ScrollViewer>
                                                </Border>

                                                <!-- Selector Loadout/Vista, ColumnSpan=2 (centro+derecha) -
                                                     DataContext local a EquipmentGroup, sin heredarlo al
                                                     resto de la fila fusionada (los laterales necesitan
                                                     el MainViewModel directamente). -->
                                                <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="0" Margin="0,0,0,6"
                                                            DataContext="{Binding EquipmentGroup}">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                        <TextBlock Text="Loadout:" Style="{StaticResource CaptionText}"
                                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <ItemsControl ItemsSource="{Binding LoadoutOptions}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type vm:EquipmentOptionViewModel}">
                                                                    <Button Content="{Binding Label}" Style="{StaticResource PrefixMetaButton}"
                                                                            Command="{Binding DataContext.EquipmentGroup.SelectLoadoutCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                    <!-- Auditoria de Opus, E-2: con sitio real para las 3 vistas a
                                                         la vez (SizeClass.Amplio) no hay nada que "elegir" -
                                                         este selector solo tiene sentido cuando hay que
                                                         turnarse un unico hueco entre las 3. -->
                                                    <StackPanel Orientation="Horizontal"
                                                                Visibility="{Binding DataContext.IsEquipmentExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}">
                                                        <TextBlock Text="Vista:" Style="{StaticResource CaptionText}"
                                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <ItemsControl ItemsSource="{Binding KindOptions}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type vm:EquipmentOptionViewModel}">
                                                                    <Button Content="{Binding Label}" Style="{StaticResource PrefixGroupButton}"
                                                                            Command="{Binding DataContext.EquipmentGroup.SelectKindCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                    <!-- Auditoria de Opus, E-4: "el dato ya esta, solo falta
                                                         enseñarlo" - defensa real sumada de este loadout
                                                         (Armadura+Accesorios) y el bono de set REALMENTE
                                                         activo (VanillaArmorSetCatalog.BonusForEquipped, ya
                                                         existia sin usar), en vez del hipotetico del tooltip. -->
                                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0">
                                                        <Run Text="Defensa total: " />
                                                        <Run Text="{Binding TotalDefense, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding ActiveSetBonusText}" Style="{StaticResource CaptionText}"
                                                               Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                               Visibility="{Binding ActiveSetBonusText, Converter={StaticResource NullToVis}}" />
                                                </StackPanel>

                                                <!-- Centro: Equipamiento 5x2 real (Columns=5, ver
                                                     EquipmentGroupViewModel.AddSlotSet). Un unico panel a
                                                     la vez (pildoras "Vista:" de arriba) en Compacto/Normal. -->
                                                <ContentControl Grid.Column="1" Grid.Row="1" Content="{Binding EquipmentGroup.Current}"
                                                                ContentTemplate="{StaticResource ContainerCompactTemplate}"
                                                                Visibility="{Binding IsEquipmentExpanded, Converter={StaticResource InverseBoolToVis}}" />

                                                <!-- Auditoria de Opus, E-2: "las 3 vistas se podrian ver a la
                                                     vez con sitio real" - en SizeClass.Amplio, Armadura/
                                                     Vanidad/Tintes del loadout actual, lado a lado, cada una
                                                     con su propia etiqueta (sin pildoras que elegir, ver el
                                                     StackPanel de arriba). Mismo ContainerCompactTemplate de
                                                     siempre - ninguna plantilla nueva, solo mas sitio para
                                                     mostrar lo mismo de golpe (P3). -->
                                                <Grid Grid.Column="1" Grid.Row="1"
                                                      Visibility="{Binding IsEquipmentExpanded, Converter={StaticResource BoolToVis}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- E-b (segunda auditoria de Opus, Fable): "la etiqueta de
                                                         cada columna usa el DisplayName largo pensado para el
                                                         panel Editar, repitiendo 'Equipo puesto -' tres veces -
                                                         ya existen literalmente en KindOptions, solo hay que
                                                         reutilizarlos" - EquipmentKind.Items=0/Social=1/Dyes=2,
                                                         mismo orden real que KindOptions ya declara. -->
                                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding EquipmentGroup.KindOptions[0].Label}" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                                        <ContentControl Content="{Binding EquipmentGroup.CurrentItems}" ContentTemplate="{StaticResource ContainerCompactTemplate}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding EquipmentGroup.KindOptions[1].Label}" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                                        <ContentControl Content="{Binding EquipmentGroup.CurrentSocial}" ContentTemplate="{StaticResource ContainerCompactTemplate}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{Binding EquipmentGroup.KindOptions[2].Label}" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                                        <ContentControl Content="{Binding EquipmentGroup.CurrentDyes}" ContentTemplate="{StaticResource ContainerCompactTemplate}" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Lateral derecho: Monedas + Municion, horizontal (ya lo
                                                     estaba - Columns=10 por defecto, 4 slots caben en una
                                                     unica fila corta) - pedido explicito "municion asi en
                                                     horizontal esta bien". -->
                                                <Border Grid.Column="2" Grid.Row="1" Background="{StaticResource BgPrimaryBrush}"
                                                        CornerRadius="8" Padding="6" Margin="8,0,0,0">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding CoinsContainer.DisplayName}" Style="{StaticResource CaptionText}" Margin="0,0,0,3" />
                                                        <ContentControl Content="{Binding CoinsContainer}" ContentTemplate="{StaticResource ContainerCompactTemplate}" />
                                                        <TextBlock Text="{Binding AmmoContainer.DisplayName}" Style="{StaticResource CaptionText}" Margin="0,10,0,3" />
                                                        <ContentControl Content="{Binding AmmoContainer}" ContentTemplate="{StaticResource ContainerCompactTemplate}" />
                                                    </StackPanel>
                                                </Border>
                                            </controls:SlotRowHost>
                                        </Border>
                                    </TabItem>
                                    <!-- Antes: 9 pestañas planas aqui dentro, luego 5 (pregunta a Opus
                                         sobre el diseño, 2-sep-2026 y quinta pasada) - Monturas/Monedas
                                         se fusionaron dentro de Equipamiento (arriba) como laterales,
                                         asi que solo quedan Inventario/Almacenes aqui. Los 9
                                         ContainerViewModel siguen siendo los MISMOS de siempre
                                         (MainViewModel.Containers) - riesgo cero para guardar/cargar,
                                         ver StorageGroupViewModel.cs. -->
                                    <TabItem Header="Inventario">
                                        <Grid>
                                        <Border BorderBrush="{StaticResource OrangeBrush}" BorderThickness="2" CornerRadius="10"
                                                Background="{StaticResource BgSecondaryBrush}" Padding="10" Margin="0,6,0,0"
                                                Visibility="{Binding IsStorageExpanded, Converter={StaticResource InverseBoolToVis}}">
                                            <ContentControl Content="{Binding InventoryContainer}" ContentTemplate="{StaticResource ContainerCompactTemplate}" />
                                        </Border>

                                        <!-- Auditoria de Opus, A-4: Inventario + el Almacen seleccionado lado
                                             a lado, con sitio real - arrastrar de un lado al otro ya
                                             funciona solo (ver el comentario real en MainViewModel.
                                             IsStorageExpanded), esto solo pone a ambos a la vista de golpe. -->
                                        <Grid Visibility="{Binding IsStorageExpanded, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" BorderBrush="{StaticResource OrangeBrush}" BorderThickness="2" CornerRadius="10"
                                                    Background="{StaticResource BgSecondaryBrush}" Padding="10" Margin="0,6,4,0">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Top" Text="{Binding InventoryContainer.DisplayName}" Style="{StaticResource CaptionText}" Margin="0,0,0,6" />
                                                    <ContentControl Content="{Binding InventoryContainer}" ContentTemplate="{StaticResource ContainerCompactTemplate}" />
                                                </DockPanel>
                                            </Border>
                                            <Border Grid.Column="1" BorderBrush="{StaticResource OrangeBrush}" BorderThickness="2" CornerRadius="10"
                                                    Background="{StaticResource BgSecondaryBrush}" Padding="10" Margin="4,6,0,0"
                                                    DataContext="{Binding StorageGroup}">
                                                <DockPanel>
                                                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Options}" Margin="0,0,0,6">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:EquipmentOptionViewModel}">
                                                                <Button Content="{Binding DisplayLabel}" Style="{StaticResource PrefixMetaButton}"
                                                                        Command="{Binding DataContext.StorageGroup.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <ContentControl Content="{Binding Current}" ContentTemplate="{StaticResource ContainerCompactTemplate}" />
                                                </DockPanel>
                                            </Border>
                                        </Grid>
                                        </Grid>
                                    </TabItem>
                                    <!-- A-a (segunda auditoria de Opus, Fable): con la ventana Amplia, la pestaña
                                         "Inventario" YA muestra el Almacen seleccionado al lado (A-4, arriba) - esta
                                         pestaña quedaba como un segundo camino redundante al MISMO StorageGroup,
                                         visible y clicable a la vez que su duplicado. Se oculta (no se borra: en
                                         Compacto/Normal sigue siendo el unico camino real). -->
                                    <TabItem Header="Almacenes" Visibility="{Binding IsStorageExpanded, Converter={StaticResource InverseBoolToVis}}">
                                        <Border BorderBrush="{StaticResource OrangeBrush}" BorderThickness="2" CornerRadius="10"
                                                Background="{StaticResource BgSecondaryBrush}" Padding="10" Margin="0,6,0,0">
                                            <DockPanel DataContext="{Binding StorageGroup}">
                                                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Options}" Margin="0,0,0,6">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <!-- Auditoria de Opus, A-1: "para saber si el Banco esta lleno hay
                                                             que pulsar su pildora y contar" - DisplayLabel ya trae el
                                                             recuento real en vivo ("Banco (38/40)"). -->
                                                        <DataTemplate DataType="{x:Type vm:EquipmentOptionViewModel}">
                                                            <Button Content="{Binding DisplayLabel}" Style="{StaticResource PrefixMetaButton}"
                                                                    Command="{Binding DataContext.StorageGroup.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ContentControl Content="{Binding Current}" ContentTemplate="{StaticResource ContainerCompactTemplate}" />
                                            </DockPanel>
                                        </Border>
                                    </TabItem>
                                </TabControl>

                                <Border Grid.Column="1" Style="{StaticResource SidePanelCard}">
                                    <ContentControl Content="{Binding ItemEdit}" ContentTemplate="{StaticResource ItemEditTemplate}" />
                                </Border>
                            </Grid>

                            <!-- Libreria: arbol de carpetas real (vanilla + Calamity, ver
                                 LibraryViewModel.BuildCategoryTree) + buscador, SIEMPRE visible aqui abajo. -->
                            <Border Grid.Row="1" Background="{StaticResource BgSecondaryBrush}" CornerRadius="8" Padding="8">
                                <DockPanel>
                                    <!-- Cabecera SIEMPRE visible (pregunta a Opus sobre el diseño,
                                         2-sep-2026: plegar la Libreria es la mayor ganancia de
                                         espacio real de toda la pantalla, mas que optimizar las
                                         pestañas) - se puede plegar/desplegar a mano, y se
                                         auto-despliega sola al elegir "Elegir..."/"Cambiar" en
                                         cualquier slot (MainViewModel.RequestPickForSlot), para que
                                         nunca quede escondida justo cuando hace falta. -->
                                    <!-- T-H/F1: Ctrl+F ya salta aqui Y despliega esta Libreria (OnWindowKeyDown) -
                                         no se anunciaba en ningun sitio. -->
                                    <Button DockPanel.Dock="Top" Command="{Binding ToggleLibraryCollapsedCommand}"
                                            Style="{StaticResource BarButton}" ToolTip="Ctrl+F salta aqui y enfoca el buscador"
                                            HorizontalContentAlignment="Stretch" Padding="8,5" Margin="0,0,0,4">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="▲ Plegar" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLibraryCollapsed}" Value="True">
                                                                <Setter Property="Text" Value="▼ Desplegar" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="Librería" Style="{StaticResource SectionText}" FontSize="12.5" />
                                        </DockPanel>
                                    </Button>

                                    <Border DockPanel.Dock="Top" Background="{StaticResource AccentBrush}" CornerRadius="6" Padding="8,5" Margin="0,0,0,6"
                                            Visibility="{Binding Library.IsPicking, Converter={StaticResource BoolToVis}}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Cancelar" Command="{Binding Library.CancelPickCommand}"
                                                    Tag="Ghost" Foreground="{StaticResource BgPrimaryBrush}" Padding="6,2" ToolTip="Esc" />
                                            <TextBlock Text="Elige (o arrastra) un objeto para colocarlo en el slot seleccionado..."
                                                       Foreground="{StaticResource BgPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="11.5" />
                                        </DockPanel>
                                    </Border>

                                    <Grid Visibility="{Binding IsLibraryVisible, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="210" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{StaticResource BgPrimaryBrush}" CornerRadius="6"
                                                Padding="5" Margin="0,0,8,0">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Top" Content="Ver todo" HorizontalAlignment="Left"
                                                        Padding="5,2" FontSize="10" Margin="0,0,0,4"
                                                        Command="{Binding Library.ClearCategoryCommand}" />
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding Library.RootCategories}"
                                                                  ItemTemplate="{StaticResource CategoryNodeTemplate}" />
                                                </ScrollViewer>
                                            </DockPanel>
                                        </Border>

                                        <DockPanel Grid.Column="1">
                                            <TextBox x:Name="LibrarySearchBox" DockPanel.Dock="Top" Text="{Binding Library.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="7,5" Background="{StaticResource BgElevatedBrush}"
                                                     Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0"
                                                     MaxWidth="360" HorizontalAlignment="Left" FontSize="12" Margin="0,0,0,4"
                                                     ToolTip="Coma = varias búsquedas a la vez, espacio = todas las palabras a la vez, #123 = por id, #100-200 = por rango de id, .texto = busca en la descripción" />
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding Library.ResultsSummary}" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                            <!-- Pregunta a Opus sobre el diseño (2-sep-2026, quinta pasada: "la libreria
                                                 sigue sin tener las rejillas como en inventario... no debe tener scroll a
                                                 menos que sea una categoria que logicamente tiene muchos ítems"). Misma
                                                 SlotGridPanel que el resto de la app - con estos parametros reales
                                                 (medidos contra la franja real de ~772x186px) no aparece scroll hasta
                                                 ~48 resultados (4 filas x 12 columnas a MinCell=40), y con pocos
                                                 resultados la celda crece hasta MaxCell=96 topada por ReferenceColumns=10
                                                 (~73px aqui) - ni vacio ni deforme. MinCell=40 en vez de 44 a proposito:
                                                 con 44 el scroll aparecia por solo 2px de diferencia real (4*44+12=188
                                                 contra 186 disponibles). Sin AvailableHeight el panel mediria con alto
                                                 infinito y SIEMPRE elegiria MaxCell + SIEMPRE scrollearia. -->
                                            <!-- Auditoria de Opus, L-7: x:Name muerto, sin ningun uso real en el
                                                 codigo-behind - limpieza real, no cambio de comportamiento. -->
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl ItemsSource="{Binding Library.Results}" ItemTemplate="{StaticResource LibraryCardTemplate}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <controls:SlotGridPanel Columns="12" MinCell="40" MaxCell="90" Gap="4"
                                                                                     ReferenceColumns="10"
                                                                                     AvailableHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </DockPanel>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Buffs">
                        <!-- Rework 2-sep-2026, cuarta pasada (pregunta a Opus sobre el diseño).
                             Fase 1 (ya en produccion): rejilla de 44 slots reales + panel
                             Editar, mismo formato que Objetos>Inventario. Fase 2 (esta): la
                             Libreria de buffs de abajo, mismo patron exacto que la de Objetos
                             (arbol real + buscador + resultados en rejilla, plegable) pero con
                             el arbol REAL de Terrasavr para buffs (BuffLibraryTreeBuilder,
                             calcado de app.BuffSide real - no del arbol de objetos). El viejo
                             boton "Añadir buff..." desaparece, sustituido por esta Libreria. -->
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <!-- Auditoria de Opus (octava pasada, B-1) - BUG REAL de layout
                                     encontrado y arreglado: esta fila era "Auto" con el Border de
                                     abajo forzando Height="380" - exactamente el mismo
                                     anti-patron ya diagnosticado y arreglado en Objetos en la
                                     septima pasada ("un Auto con un hijo fijo cobra siempre
                                     primero, sea cual sea el alto real disponible"), pero se
                                     quedo sin aplicar aqui. En ventana grande la rejilla de
                                     buffs no crecia nunca (380px fijo, desaprovechando el
                                     espacio); en ventana minima 380+150 cabia por apenas ~30px
                                     de margen real. Mismo arreglo ya validado: "*" con
                                     MinHeight, sin altura fija en el Border. -->
                                <RowDefinition Height="3*" MinHeight="216" />
                                <!-- Segunda auditoria de Opus (Fable), B-1 - mismo bug real y
                                     mismo arreglo real que la Libreria de Objetos (ver ese
                                     comentario, mas arriba en este mismo fichero): "*" con
                                     MinHeight fijo NO colapsa de verdad al plegar - la fila
                                     dependia solo de la ventana apretando, nunca de
                                     IsBuffLibraryCollapsed. Height/MinHeight dependen ahora de
                                     IsBuffLibraryVisible. -->
                                <RowDefinition Height="{Binding IsBuffLibraryVisible, Converter={StaticResource BoolToGridLength}, ConverterParameter=2}"
                                               MinHeight="{Binding IsBuffLibraryVisible, Converter={StaticResource BoolToDouble}, ConverterParameter=200}"
                                               MaxHeight="460" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="300" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" BorderBrush="{StaticResource OrangeBrush}" BorderThickness="2" CornerRadius="10"
                                        Background="{StaticResource BgSecondaryBrush}" Padding="10" Margin="0,0,10,0">
                                    <ContentControl Content="{Binding Buffs.Container}" ContentTemplate="{StaticResource BuffContainerCompactTemplate}" />
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource SidePanelCard}">
                                    <ContentControl Content="{Binding BuffEdit}" ContentTemplate="{StaticResource BuffEditTemplate}" />
                                </Border>
                            </Grid>

                            <!-- Libreria de buffs: mismo patron que Objetos (cabecera plegable +
                                 banner de "eligiendo" + arbol real a la izquierda + buscador y
                                 resultados en rejilla a la derecha). -->
                            <Border Grid.Row="1" Background="{StaticResource BgSecondaryBrush}" CornerRadius="8" Padding="8">
                                <DockPanel>
                                    <Button DockPanel.Dock="Top" Command="{Binding ToggleBuffLibraryCollapsedCommand}"
                                            Style="{StaticResource BarButton}"
                                            HorizontalContentAlignment="Stretch" Padding="8,5" Margin="0,0,0,4">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="▲ Plegar" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBuffLibraryCollapsed}" Value="True">
                                                                <Setter Property="Text" Value="▼ Desplegar" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="Librería de buffs" Style="{StaticResource SectionText}" FontSize="12.5" />
                                        </DockPanel>
                                    </Button>

                                    <Border DockPanel.Dock="Top" Background="{StaticResource AccentBrush}" CornerRadius="6" Padding="8,5" Margin="0,0,0,6"
                                            Visibility="{Binding BuffLibrary.IsPicking, Converter={StaticResource BoolToVis}}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Cancelar" Command="{Binding BuffLibrary.CancelPickCommand}"
                                                    Tag="Ghost" Foreground="{StaticResource BgPrimaryBrush}" Padding="6,2" ToolTip="Esc" />
                                            <TextBlock Text="Elige un buff para colocarlo en el slot seleccionado..."
                                                       Foreground="{StaticResource BgPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="11.5" />
                                        </DockPanel>
                                    </Border>

                                    <Grid Visibility="{Binding IsBuffLibraryVisible, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="210" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{StaticResource BgPrimaryBrush}" CornerRadius="6"
                                                Padding="5" Margin="0,0,8,0">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Top" Content="Ver todo" HorizontalAlignment="Left"
                                                        Padding="5,2" FontSize="10" Margin="0,0,0,4"
                                                        Command="{Binding BuffLibrary.ClearCategoryCommand}" />
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding BuffLibrary.RootCategories}"
                                                                  ItemTemplate="{StaticResource CategoryNodeTemplate}" />
                                                </ScrollViewer>
                                            </DockPanel>
                                        </Border>

                                        <DockPanel Grid.Column="1">
                                            <TextBox DockPanel.Dock="Top" Text="{Binding BuffLibrary.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="7,5" Background="{StaticResource BgElevatedBrush}"
                                                     Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0"
                                                     MaxWidth="360" HorizontalAlignment="Left" FontSize="12" Margin="0,0,0,4"
                                                     ToolTip="Coma = varias búsquedas a la vez, espacio = todas las palabras a la vez, #123 = por id, #100-200 = por rango de id, .texto = busca en la descripción" />
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding BuffLibrary.ResultsSummary}" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl ItemsSource="{Binding BuffLibrary.Results}" ItemTemplate="{StaticResource BuffLibraryCardTemplate}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <controls:SlotGridPanel Columns="11" MinCell="40" MaxCell="90" Gap="4"
                                                                                     ReferenceColumns="10"
                                                                                     AvailableHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </DockPanel>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Investigación">
                        <!-- Antes: una unica lista plana (hasta miles de objetos, "es
                             larguisimo" - pedido explicito 2-sep-2026). Ahora: mismo arbol de
                             carpetas real que la Libreria (Research.RootCategories, ver
                             LibraryCategoryTreeBuilder) - mismos nombres y sprites de
                             siempre, solo cambia como se navega. -->
                        <DockPanel Margin="0,10,0,0">
                            <!-- R-g (segunda auditoria de Opus, Fable): "ninguna advertencia si el
                                 personaje no es Modo Viaje - el dato ya esta a mano". La
                                 Investigacion solo desbloquea recetas de verdad en Modo Viaje. -->
                            <Border DockPanel.Dock="Top" Background="{StaticResource CalamityBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,10"
                                    Visibility="{Binding Research.IsJourneyMode, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Foreground="White" TextWrapping="Wrap" FontSize="12"
                                           Text="Este personaje no esta en Modo Viaje - la Investigación solo desbloquea recetas de verdad en una partida de ese modo." />
                            </Border>
                            <Button DockPanel.Dock="Top" Content="Investigar todo" Tag="Accent"
                                    Command="{Binding ResearchAllCommand}" HorizontalAlignment="Left" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="{StaticResource BgPrimaryBrush}" CornerRadius="6"
                                        Padding="5" Margin="0,0,8,0">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Top" Content="Ver todo" HorizontalAlignment="Left"
                                                Padding="5,2" FontSize="10" Margin="0,0,0,4"
                                                Command="{Binding Research.ClearCategoryCommand}" />
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Research.RootCategories}"
                                                          ItemTemplate="{StaticResource CategoryNodeTemplate}" />
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>

                                <DockPanel Grid.Column="1">
                                    <!-- R-e (segunda auditoria de Opus, Fable): "sin buscador -
                                         Libreria y Libreria de buffs si lo tienen... asimetria
                                         pura". Misma gramatica real (LibrarySearchGrammar, L-a). -->
                                    <TextBox DockPanel.Dock="Top" Text="{Binding Research.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="7,5" Background="{StaticResource BgElevatedBrush}"
                                             Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0"
                                             MaxWidth="360" HorizontalAlignment="Left" FontSize="12" Margin="0,0,0,4"
                                             ToolTip="Coma = varias búsquedas a la vez, espacio = todas las palabras a la vez, #123 = por id, #100-200 = por rango de id (busca solo entre lo ya investigado)" />
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding Research.ResultsSummary}" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Research.Results}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ResearchRowViewModel}">
                                                    <Border Background="{StaticResource BgElevatedBrush}" CornerRadius="4" Margin="0,0,6,6" Padding="6,4">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCalamity}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{StaticResource CalamityBrush}" />
                                                                        <Setter Property="BorderThickness" Value="1" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Image Source="{Binding IconPath}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,6,0"
                                                                   Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource CaptionText}" />
                                                                <!-- Auditoria de Opus, R-1: "x/N" real (VanillaResearchCountCatalog, extraido
                                                                     del TSV real de sacrificios de tModLoader) en vez de solo el conteo guardado
                                                                     a secas - ver ResearchRowViewModel.CountLabel. -->
                                                                <TextBlock Text="{Binding CountLabel}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Grid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Apariencia">
                        <!-- Auditoria de Opus, Bloque 4 (P-1): "el preview se desplaza fuera de
                             vista justo cuando mas falta hace verlo - al mover un slider de
                             color" - antes todo (preview incluido) vivia en un unico
                             ScrollViewer/StackPanel vertical. Ahora 2 columnas reales: el
                             preview se queda FIJO a la izquierda (nunca se desplaza), todo lo
                             editable (genero/peinado/tinte/colores/estadisticas) vive en su
                             propio ScrollViewer independiente a la derecha - el resultado de
                             cualquier ajuste se ve siempre, sin tener que volver a subir. -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,0,20,0">
                                <Border Background="{StaticResource BgElevatedBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                                    <Image Source="{Binding Appearance.PreviewImage}" Width="240" Height="336"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Uniform" />
                                </Border>
                                <TextBlock Text="Preview real de cuerpo completo (sprites reales del juego) - sin armadura/vestuario equipado, item en mano ni animación, solo la pose de reposo. No aplica el efecto visual del tinte de pelo (shader especial que este preview no reproduce), solo su color de pelo base. Tampoco refleja Chico/Chica (se guarda de verdad en el personaje, pero este preview usa el mismo sprite base para los dos)."
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Width="240" />
                            </StackPanel>

                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="Género" Style="{StaticResource SectionText}" Margin="0,0,0,4" />
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton GroupName="Gender" Content="Chico" IsChecked="{Binding Appearance.IsMale}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,12,0" />
                                            <RadioButton GroupName="Gender" Content="Chica" IsChecked="{Binding Appearance.IsFemale}" Foreground="{StaticResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="Peinado" Style="{StaticResource SectionText}" Margin="0,0,0,4" />
                                        <Button Command="{Binding Appearance.OpenHairPickerCommand}" Padding="8,6" HorizontalContentAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Appearance.HairStyle, StringFormat='Estilo #{0}'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="&#9998;" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Tinte de pelo" Style="{StaticResource SectionText}" Margin="0,0,0,4" />
                                        <Button Command="{Binding Appearance.OpenHairDyePickerCommand}" Padding="8,6" HorizontalContentAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Appearance.HairDyeDisplayName}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="&#9998;" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Selector visual de tinte de pelo - pedido explicito 1-sep-2026 (sprites en vez
                                     de escribir un id a mano) - mismo patron de overlay que el peinado de arriba. -->
                                <Border Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,18"
                                        Visibility="{Binding Appearance.IsHairDyePickerOpen, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <Button DockPanel.Dock="Right" Content="Cerrar" Command="{Binding Appearance.CloseHairDyePickerCommand}" Padding="8,3" />
                                            <TextBlock Text="Elige un tinte de pelo" Style="{StaticResource SectionText}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Appearance.HairDyeOptions}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:HairDyeOptionViewModel}">
                                                        <Button Command="{Binding DataContext.Appearance.SelectHairDyeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding Index}" Margin="2" Padding="6"
                                                                Background="{StaticResource BgElevatedBrush}" BorderThickness="0"
                                                                ToolTip="{Binding DisplayName}">
                                                            <StackPanel Width="54">
                                                                <Image Source="{Binding IconPath}" Width="28" Height="28" Stretch="Uniform"
                                                                       HorizontalAlignment="Center"
                                                                       Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                                                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource CaptionText}"
                                                                           FontSize="9" TextWrapping="Wrap" TextAlignment="Center" Margin="0,3,0,0" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>

                                <!-- Selector visual de peinado - pedido explicito 1-sep-2026 (sprites en vez de
                                     ids a mano). Mismo patron de overlay que ya usan el picker de prefijo y de
                                     buffs (Border de acento superpuesto, no un Popup real). -->
                                <Border Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,18"
                                        Visibility="{Binding Appearance.IsHairPickerOpen, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <Button DockPanel.Dock="Right" Content="Cerrar" Command="{Binding Appearance.CloseHairPickerCommand}" Padding="8,3" />
                                            <TextBlock Text="Elige un peinado" Style="{StaticResource SectionText}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Appearance.HairOptions}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:HairOptionViewModel}">
                                                        <Button Command="{Binding DataContext.Appearance.SelectHairCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding Id}" Margin="2" Padding="4"
                                                                Background="{StaticResource BgElevatedBrush}" BorderThickness="0"
                                                                ToolTip="{Binding Id}">
                                                            <Image Source="{Binding Thumbnail}" Width="30" Height="42"
                                                                   RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Uniform" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>

                                <ItemsControl ItemsSource="{Binding Appearance.Swatches}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ColorSwatchViewModel}">
                                            <Border Background="{StaticResource BgElevatedBrush}" CornerRadius="6" Margin="0,0,10,10" Padding="10">
                                                <StackPanel Width="150">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <Border Width="20" Height="20" CornerRadius="3" Background="{Binding Preview}"
                                                                BorderBrush="{StaticResource BorderBrush0}" BorderThickness="1" Margin="0,0,7,0" />
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <Slider Minimum="0" Maximum="255" Value="{Binding R}" Foreground="#E05555" Margin="0,2" />
                                                    <Slider Minimum="0" Maximum="255" Value="{Binding G}" Foreground="#55C065" Margin="0,2" />
                                                    <Slider Minimum="0" Maximum="255" Value="{Binding B}" Foreground="#5580E0" Margin="0,2" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Estadísticas" Style="{StaticResource SectionText}" Margin="0,20,0,8" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="Dificultad" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding Appearance.DifficultyLabels}" SelectedIndex="{Binding Appearance.Difficulty}"
                                                  Width="120" Padding="6,4" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="Vida (actual / max.)" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Text="{Binding Appearance.HealthNow, UpdateSourceTrigger=PropertyChanged}" Width="60" Padding="6,4"
                                                     Background="{StaticResource BgElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                                            <TextBlock Text="/" VerticalAlignment="Center" Margin="4,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBox Text="{Binding Appearance.HealthMax, UpdateSourceTrigger=PropertyChanged}" Width="60" Padding="6,4"
                                                     Background="{StaticResource BgElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Mana (actual / max.)" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Text="{Binding Appearance.ManaNow, UpdateSourceTrigger=PropertyChanged}" Width="60" Padding="6,4"
                                                     Background="{StaticResource BgElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                                            <TextBlock Text="/" VerticalAlignment="Center" Margin="4,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBox Text="{Binding Appearance.ManaMax, UpdateSourceTrigger=PropertyChanged}" Width="60" Padding="6,4"
                                                     Background="{StaticResource BgElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="Misiones de pesca completadas" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Appearance.FishingQuestsCompleted, UpdateSourceTrigger=PropertyChanged}" Width="70" Padding="6,4"
                                                 Background="{StaticResource BgElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="Puntuación de golf" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Appearance.GolferScore, UpdateSourceTrigger=PropertyChanged}" Width="70" Padding="6,4"
                                                 Background="{StaticResource BgElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Horas jugadas" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Appearance.PlayHours, UpdateSourceTrigger=PropertyChanged, StringFormat=N1}" Width="70" Padding="6,4"
                                                 Background="{StaticResource BgElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Spawn Points">
                        <DockPanel Margin="0,10,0,0">
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="Puntos de aparición guardados por mundo. &quot;Id&quot; es un identificador interno del mundo, no un texto legible - no suele hacer falta tocarlo."
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <Button Content="Añadir spawn point" Tag="Accent" Command="{Binding Servers.AddEntryCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Servers.Entries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ServerEntryRowViewModel}">
                                            <Border Background="{StaticResource BgElevatedBrush}" CornerRadius="6" Margin="0,0,0,8" Padding="12,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel Width="220" Margin="0,0,14,0">
                                                        <TextBlock Text="Nombre" Style="{StaticResource CaptionText}" Margin="0,0,0,3" />
                                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"
                                                                 Background="{StaticResource BgPrimaryBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                                                    </StackPanel>
                                                    <StackPanel Width="80" Margin="0,0,14,0">
                                                        <TextBlock Text="Spawn X" Style="{StaticResource CaptionText}" Margin="0,0,0,3" />
                                                        <TextBox Text="{Binding SpawnX, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"
                                                                 Background="{StaticResource BgPrimaryBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                                                    </StackPanel>
                                                    <StackPanel Width="80" Margin="0,0,14,0">
                                                        <TextBlock Text="Spawn Y" Style="{StaticResource CaptionText}" Margin="0,0,0,3" />
                                                        <TextBox Text="{Binding SpawnY, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"
                                                                 Background="{StaticResource BgPrimaryBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                                                    </StackPanel>
                                                    <!-- S-d (segunda auditoria de Opus, Fable): "'Id' ocupa el mismo protagonismo que
                                                         los campos utiles, pese a decir 'no suele hacer falta tocarlo'" - mas
                                                         estrecho y en un tono secundario real (TextSecondaryBrush, mismo tono que su
                                                         propia etiqueta), en vez de competir en igualdad con Nombre/Spawn X/Y. -->
                                                    <StackPanel Width="70" Margin="0,0,14,0" ToolTip="Identificador interno del mundo, no un texto legible - no suele hacer falta tocarlo">
                                                        <TextBlock Text="Id" Style="{StaticResource CaptionText}" Margin="0,0,0,3" />
                                                        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" FontSize="11"
                                                                 Background="{StaticResource BgPrimaryBrush}" Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="0" />
                                                    </StackPanel>
                                                    <!-- T-F (segunda auditoria de Opus, Fable): CircleCloseButton (gira 90° y se tiñe
                                                         de rojo al pasar el raton, gesto real de Terrasavr) existia en Theme.xaml sin
                                                         que ningun boton "quitar" real lo usara todavia - este es el candidato real. -->
                                                    <Button Content="✕" Style="{StaticResource CircleCloseButton}" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                                            ToolTip="Quitar este punto de aparición"
                                                            Command="{Binding DataContext.Servers.RemoveEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Desbloqueos">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                            <!-- D-a (segunda auditoria de Opus, Fable): las demas pestañas internas de
                                 Personaje (Inicio, Apariencia...) fijan HorizontalAlignment="Left" junto a
                                 su MaxWidth - sin el, Stretch (el valor por defecto) centra el StackPanel
                                 entero en vez de pegarlo al borde izquierdo real, unica de estas dos que
                                 se veia descentrada frente al resto. -->
                            <!-- D-b (segunda auditoria de Opus, Fable): "13 casillas planas, sin
                                 agrupar, en una columna sola" - 4 subtitulos reales agrupando por
                                 familia (modo de dificultad, antorchas de bioma, consumibles
                                 permanentes de las Bound NPC quests, eventos/otros). -->
                            <StackPanel MaxWidth="440" HorizontalAlignment="Left">
                                <TextBlock Text="Desbloqueos y activaciones permanentes del personaje."
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,10" />

                                <TextBlock Text="Modo de dificultad" Style="{StaticResource CaptionText}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <CheckBox Content="Accesorio extra (modo experto/maestro)" IsChecked="{Binding Flags.ExtraAccessory}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />

                                <TextBlock Text="Antorchas de bioma" Style="{StaticResource CaptionText}" FontWeight="SemiBold" Margin="0,10,0,4" />
                                <CheckBox Content="Cambio de antorcha de bioma desbloqueado" IsChecked="{Binding Flags.UnlockedBiomeTorches}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <CheckBox Content="Cambio de antorcha de bioma activado" IsChecked="{Binding Flags.UsingBiomeTorches}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />

                                <TextBlock Text="Consumibles permanentes" Style="{StaticResource CaptionText}" FontWeight="SemiBold" Margin="0,10,0,4" />
                                <CheckBox Content="Alcance de mesa de trabajo aumentado (Pan del Artesano)" IsChecked="{Binding Flags.ArtisanBread}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <CheckBox Content="Regeneracion de vida aumentada (Cristal Vital)" IsChecked="{Binding Flags.VitalCrystal}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <CheckBox Content="Defensa aumentada (Fruta de Egida)" IsChecked="{Binding Flags.AegisFruit}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <CheckBox Content="Regeneracion de mana aumentada (Cristal Arcano)" IsChecked="{Binding Flags.ArcaneCrystal}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <CheckBox Content="Suerte aumentada (Perla de Galaxia)" IsChecked="{Binding Flags.GalaxyPearl}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <CheckBox Content="Poder de pesca aumentado (Gusano de Gominola)" IsChecked="{Binding Flags.GummyWorm}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <CheckBox Content="Velocidad de minería y colocación aumentada (Ambrosia)" IsChecked="{Binding Flags.Ambrosia}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />

                                <TextBlock Text="Eventos y otros" Style="{StaticResource CaptionText}" FontWeight="SemiBold" Margin="0,10,0,4" />
                                <CheckBox Content="Evento de la Segunda Defensa de las Dimensiones completado (puede usar invocaciones)" IsChecked="{Binding Flags.FinishedDD2Event}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <CheckBox Content="Carrito potenciado desbloqueado" IsChecked="{Binding Flags.UnlockedSuperMinecart}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <CheckBox Content="Carrito potenciado activado" IsChecked="{Binding Flags.UsingSuperMinecart}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Versión">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                            <!-- D-a (segunda auditoria de Opus, Fable): mismo arreglo que Desbloqueos,
                                 arriba - HorizontalAlignment="Left" real, no centrado por omision. -->
                            <StackPanel MaxWidth="500" HorizontalAlignment="Left">
                                <Border Background="{StaticResource CalamityBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,14">
                                    <TextBlock Foreground="White" TextWrapping="Wrap" FontSize="12"
                                               Text="Cuidado: cambiar la versión cambia qué campos lee/escribe el guardado. Un valor que no encaje con el contenido real del personaje puede producir un archivo que ni esta app ni el juego sepan releer bien." />
                                </Border>
                                <TextBlock Text="Número de versión en crudo" Style="{StaticResource SectionText}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding VersionEditor.RawVersion, UpdateSourceTrigger=PropertyChanged}"
                                         Width="90" Padding="6,4" HorizontalAlignment="Left" Margin="0,0,0,16"
                                         Background="{StaticResource BgElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />

                                <ItemsControl ItemsSource="{Binding VersionEditor.Groups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:VersionGroup}">
                                            <StackPanel Margin="0,0,0,14">
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource CaptionText}" Margin="0,0,0,6" />
                                                <ItemsControl ItemsSource="{Binding Options}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:VersionOption}">
                                                            <!-- V-a (segunda auditoria de Opus, Fable): mismo patron real ya usado en la
                                                                 rejilla de prefijos (D-6, IsCurrent) - antes ningun boton de version
                                                                 indicaba cual era la YA puesta, habia que leer el numero en crudo de al
                                                                 lado y hacer la cuenta a mano. -->
                                                            <Button Content="{Binding Label}" Margin="0,0,6,6" Padding="8,4"
                                                                    Command="{Binding DataContext.VersionEditor.SetVersionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding Number}">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                                <Setter Property="Background" Value="{StaticResource AccentMutedBrush}" />
                                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </DockPanel>
            </Grid>
        </TabItem>

        <!-- ===================== BUILDS ===================== -->
        <TabItem Header="Builds">
            <TabControl Style="{StaticResource InnerTabControl}" Margin="14">
                <TabItem Header="Vanilla">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Builds.VanillaStages}" Margin="4,10,0,0" />
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Calamity Mod">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Builds.CalamityStages}" Margin="4,10,0,0" />
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </TabItem>

        <!-- ===================== NOVEDADES ===================== -->
        <TabItem Header="Novedades">
            <ScrollViewer Margin="14" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,14">
                        <Run Text="Esto es el registro de cambios del " />
                        <Run Text="JUEGO" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        <Run Text=" (Terraria y Calamity Mod) - objetos nuevos, arreglos, etc. Para ver qué ha cambiado en el propio Terrakeep, ve a " />
                        <Run Text="«¡Sobre esta versión!»" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        <Run Text="." />
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding WhatsNew.Entries}" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ===================== EXPLORACION ===================== -->
        <TabItem Header="Exploración">
            <DockPanel Margin="14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Cargar mundo (.wld)..." Tag="Accent" Click="OnLoadWorldClick"
                            IsEnabled="{Binding Exploration.IsNotLoading}" />
                    <TextBlock Text="{Binding Exploration.WorldTitle, StringFormat='Mundo: {0}'}"
                               Style="{StaticResource SectionText}" VerticalAlignment="Center" Margin="20,0,0,0"
                               Visibility="{Binding Exploration.IsWorldLoaded, Converter={StaticResource BoolToVis}}" />
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding Exploration.IsWorldLoaded, Converter={StaticResource BoolToVis}}">
                        <Button Content="&#8722;" Command="{Binding Exploration.ZoomOutCommand}" Padding="10,2" />
                        <TextBlock Text="{Binding Exploration.Zoom, StringFormat={}{0:P0}}" Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center" Width="50" TextAlignment="Center" />
                        <Button Content="+" Command="{Binding Exploration.ZoomInCommand}" Padding="10,2" Margin="4,0,0,0" />
                        <Button Content="Restablecer" Command="{Binding Exploration.ZoomResetCommand}" Padding="8,2" Margin="8,0,0,0" />
                        <!-- X-a (segunda auditoria de Opus, Fable): "Restablecer" vuelve al 100%,
                             que para un mundo de 8400x2400 significa ver el 12% del ancho - "la
                             accion mas obviamente ausente de la pantalla". El calculo real (necesita
                             el tamaño real del viewport del ScrollViewer, que la ViewModel no
                             conoce) vive en el code-behind, igual que el resto de gestos del mapa. -->
                        <Button Content="Ajustar a la ventana" Click="OnFitToWindowClick" Padding="8,2" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Exploration.StatusMessage}"
                           Style="{StaticResource CaptionText}" Margin="0,10,0,0" TextWrapping="Wrap" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource BgSecondaryBrush}" CornerRadius="8" Margin="0,0,10,0">
                        <Grid>
                        <DockPanel>
                            <Border DockPanel.Dock="Bottom" Background="{StaticResource BgElevatedBrush}"
                                    CornerRadius="0,0,8,8" Padding="10,6"
                                    Visibility="{Binding Exploration.HoverInfo, Converter={StaticResource EmptyToCollapsed}}">
                                <TextBlock Text="{Binding Exploration.HoverInfo}" Style="{StaticResource CaptionText}" />
                            </Border>
                            <!-- Arrastrar para desplazar (pan) + rueda para zoom, sin necesitar Ctrl - los
                                 gestores reales viven en el code-behind (MainWindow.xaml.cs) porque
                                 necesitan tocar los offsets del ScrollViewer, que la ViewModel no conoce.
                                 Cursor="Hand" (no "SizeAll", las 4 flechas que el usuario rechazo
                                 explicitamente 1-sep-2026) - WPF no trae un cursor de "mano de agarre"
                                 nativo como el pan de TEdit/Photoshop, esto es lo mas cercano sin
                                 fabricar un .cur propio. -->
                            <Grid>
                                <ScrollViewer x:Name="WorldMapScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                              PreviewMouseWheel="OnWorldMapPreviewMouseWheel"
                                              PreviewMouseLeftButtonDown="OnWorldMapMouseDown"
                                              PreviewMouseMove="OnWorldMapMouseMove"
                                              PreviewMouseLeftButtonUp="OnWorldMapMouseUp"
                                              MouseLeave="OnWorldMapMouseLeave"
                                              Cursor="Hand">
                                    <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <Grid.LayoutTransform>
                                            <ScaleTransform ScaleX="{Binding Exploration.Zoom}" ScaleY="{Binding Exploration.Zoom}" />
                                        </Grid.LayoutTransform>
                                        <Image x:Name="WorldMapImage" Source="{Binding Exploration.WorldImage}" Stretch="None"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                               HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
                                        <ItemsControl ItemsSource="{Binding Exploration.Npcs}" IsHitTestVisible="True">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><Canvas IsItemsHost="True" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding TileX}" />
                                                    <Setter Property="Canvas.Top" Value="{Binding TileY}" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <!-- Sprite real del NPC (pedido explicito 2-sep-2026: "los npc deben
                                                     salir con sus sprites no puntos rosas que no distingues nada") -
                                                     Assets/npc_icons/{id}.png ya existia en el proyecto (copiado de
                                                     Terrasavr-Calamity-Beta), solo faltaba usarlo aqui. Ancla abajo-
                                                     centro (como un personaje de pie sobre su tile), no centrado como
                                                     el punto de antes. Si algun dia aparece un NPC sin icono real
                                                     (IconPath null - solo pasa con los que no son de pueblo/
                                                     reclutables), cae al punto magenta de siempre en vez de no
                                                     mostrar nada. -->
                                                <DataTemplate DataType="{x:Type vm:WorldNpcRowViewModel}">
                                                    <Grid ToolTip="{Binding Name}" Cursor="Hand">
                                                        <Image Source="{Binding IconPath}" Width="16" Stretch="Uniform"
                                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                               Margin="-8,-22,0,0"
                                                               Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                                                        <Ellipse Width="11" Height="11" Margin="-5.5,-5.5,0,0"
                                                                 Fill="Magenta" Stroke="White" StrokeThickness="1.5"
                                                                 Visibility="{Binding IconPath, Converter={StaticResource NullToCollapsed}}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </ScrollViewer>

                                <!-- Tooltip flotante que sigue al cursor sobre el mapa (estilo TEdit),
                                     ADEMAS del texto fijo de abajo (pedido explicito 1-sep-2026: "tambien
                                     tiene que decirlo cuando pasas el raton por encima", sin quitar el de
                                     abajo). Canvas superpuesto en vez de Popup real - un Popup es un HWND
                                     aparte y parpadea al mover el raton rapido; el Canvas se recorta solo
                                     al area visible del mapa. Reposicionado a mano en
                                     OnWorldMapMouseMove (MainWindow.xaml.cs), que es quien ya conoce la
                                     posicion real del cursor sobre el mapa. -->
                                <Canvas x:Name="MapTooltipCanvas" IsHitTestVisible="False">
                                    <Border x:Name="MapTooltipBorder" Background="{StaticResource BgElevatedBrush}"
                                            CornerRadius="4" Padding="8,4" Effect="{StaticResource CardShadow}"
                                            Visibility="{Binding Exploration.HoverInfo, Converter={StaticResource EmptyToCollapsed}}">
                                        <TextBlock Text="{Binding Exploration.HoverInfo}" Style="{StaticResource CaptionText}" />
                                    </Border>
                                </Canvas>
                            </Grid>
                        </DockPanel>

                        <!-- Auditoria de Opus, X-7/T-13: leer+pintar un mundo real (~1.4s
                             medidos en uno de 11MB de esta maquina) es el unico freeze real
                             medido de toda la ronda (personaje ~8ms, "Investigar todo" ~3ms,
                             ninguno de los dos perceptible) - se hizo async (Task.Run,
                             ExplorationViewModel.LoadFromPathAsync) y este overlay avisa de
                             verdad mientras dura, en vez de que la ventana parezca colgada. -->
                        <Border Background="#B0000000" CornerRadius="8"
                                Visibility="{Binding Exploration.IsLoading, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ProgressBar IsIndeterminate="True" Width="160" Height="6" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="Leyendo y pintando el mapa..." Style="{StaticResource CaptionText}" Margin="0,10,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        </Grid>
                    </Border>

                    <DockPanel Grid.Column="1">
                        <TextBlock DockPanel.Dock="Top" Text="NPCs de pueblo" Style="{StaticResource SectionText}" Margin="0,0,0,8" />
                        <TextBox DockPanel.Dock="Top" Text="{Binding Exploration.NpcSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="7,5" Background="{StaticResource BgElevatedBrush}"
                                 Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0"
                                 FontSize="12" Margin="0,0,0,10" />

                        <Expander DockPanel.Dock="Bottom" Header="NPCs que faltan" Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,10,0,0" IsExpanded="True"
                                  Visibility="{Binding Exploration.MissingNpcs.Count, Converter={StaticResource CountToVis}}">
                            <ItemsControl ItemsSource="{Binding Exploration.MissingNpcs}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:MissingNpcRowViewModel}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <Image Source="{Binding IconPath}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,5,0"
                                                   Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource CaptionText}"
                                                       Foreground="{StaticResource CalamityBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Exploration.Npcs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:WorldNpcRowViewModel}">
                                        <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,5"
                                                HorizontalContentAlignment="Stretch" Cursor="Hand"
                                                ToolTip="Ir a su posición en el mapa"
                                                Command="{Binding DataContext.Exploration.GoToNpcCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Border Background="{StaticResource BgElevatedBrush}" CornerRadius="5" Padding="8,5">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="{Binding IconPath}" Width="28" Height="28" Stretch="Uniform" Margin="0,0,8,0"
                                                           Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" />
                                                        <TextBlock Text="{Binding Position}" Style="{StaticResource CaptionText}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </TabItem>

        <!-- ===================== ACERCA DE ===================== -->
        <TabItem Header="Acerca de">
            <ScrollViewer Margin="14" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,20">
                        <Image Source="pack://siteoforigin:,,,/Assets/branding/logo-128.png" Width="72" Height="72" />
                        <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Text="{Binding About.AppName}" Style="{StaticResource TitleText}" FontSize="28" />
                            <TextBlock Text="{Binding About.Tagline}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0">
                                <Run Text="Versión " /><Run Text="{Binding About.Version, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding About.CreditsText}" Style="{StaticResource BodyText}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,24" />

                    <TextBlock Text="¡Sobre esta versión!" Style="{StaticResource TitleText}" FontSize="20" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,14">
                        <Run Text="Esto es el registro de cambios del propio " />
                        <Run Text="EDITOR" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        <Run Text=" (Terrakeep) - qué se ha añadido y arreglado, versión a versión. Para el registro del juego/Calamity, ve a «Novedades»." />
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Changelog.Entries}" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        </TabControl>

        <!-- Confirmacion visual real de guardado (pedido explicito 2-sep-2026: "debe ser mas
             visual que se allá confirmado el guardado no solamente un mensajito abajo a la
             izquierda") - banner flotante con animacion de entrada real, aparte del
             StatusMessage de siempre (que se queda para los errores, que no deben ser tan
             efimeros). MainViewModel.Save() lo activa un momento tras un guardado con exito
             real, ver SaveConfirmationVisible/DispatcherTimer ahi mismo. Auditoria de Opus,
             N-1: movido de dentro de la pestaña Personaje a este nivel (hermano del TabControl
             raiz, Grid.Row=1) - Guardar ya se puede pulsar desde cualquier pestaña via la
             cabecera global, la confirmacion debe verse igual sea cual sea la pestaña activa. -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"
                Background="{StaticResource TealGradientBrush}" CornerRadius="10" Padding="18,10"
                Effect="{StaticResource CardShadow}" IsHitTestVisible="False"
                Visibility="{Binding SaveConfirmationVisible, Converter={StaticResource BoolToVis}}"
                RenderTransformOrigin="0.5,0.5" Panel.ZIndex="99">
            <Border.RenderTransform>
                <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
            </Border.RenderTransform>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Opacity" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SaveConfirmationVisible}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#10003;" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="Guardado" FontSize="13.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- H-3 (segunda auditoria de Opus, Fable): "Guardar ya funciona desde cualquier pestaña
             (N-1) pero un error de guardado va a un TextBlock que 5 de 6 pestañas no ven" -
             mismo nivel real que el banner de "Guardado" de arriba (hermano del TabControl raiz),
             visible sea cual sea la pestaña activa. Solo errores reales (cargar/guardar/deshacer
             fallido) - los exitos efimeros siguen siendo solo el banner verde de arriba, StatusMessage
             se queda para el detalle informativo dentro de Personaje. Se cierra sola en el siguiente
             exito real, o a mano con el boton "✕". -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" MaxWidth="520"
                Background="{StaticResource CalamityBrush}" CornerRadius="10" Padding="18,10"
                Effect="{StaticResource CardShadow}"
                Visibility="{Binding GlobalErrorMessage, Converter={StaticResource EmptyToCollapsed}}"
                Panel.ZIndex="99">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#9888;" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="{Binding GlobalErrorMessage}" FontSize="13.5" Foreground="White" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="400" />
                <Button Content="✕" Style="{StaticResource CircleCloseButton}" Foreground="White" Margin="10,0,0,0"
                        Command="{Binding DismissGlobalErrorCommand}" ToolTip="Cerrar este aviso" />
            </StackPanel>
        </Border>
        </Grid>
    </Grid>
</Window>
