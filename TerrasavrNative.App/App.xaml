<Application x:Class="TerrasavrNative.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TerrasavrNative.App"
             xmlns:conv="clr-namespace:TerrasavrNative.App.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:NullToVisibilityConverter x:Key="NullToVis" />
            <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
            <conv:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />
            <conv:CountToVisibilityConverter x:Key="CountToVis" />
            <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
