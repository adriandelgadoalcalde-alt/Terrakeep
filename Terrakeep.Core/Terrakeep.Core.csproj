<Project Sdk="Microsoft.NET.Sdk">

  <!-- WS0 de TerrakeepMod (5-sep-2026): Core se compila para DOS destinos a la vez.
       - net10.0 es el de siempre, el que consume la app de escritorio (Terrakeep.App,
         net10.0-windows) y sus tests. No cambia nada para ellos: al referenciar el proyecto,
         NuGet/MSBuild elige automaticamente el activo net10.0 por ser el compatible mas alto.
       - net8.0 existe SOLO para poder reutilizar este mismo codigo dentro de un mod de
         tModLoader. tModLoader corre sobre .NET 8 (comprobado en el fichero real
         "C:\Program Files (x86)\Steam\steamapps\common\tModLoader\tMLMod.targets":
         TargetFramework=net8.0, LangVersion=12.0, y su runtime propio en dotnet\shared\
         Microsoft.NETCore.App\8.0.0) y un DLL compilado para net10 sencillamente NO carga ahi.
       Core no tiene ninguna dependencia externa (0 PackageReference/ProjectReference), asi que
       el unico riesgo real del doble destino es la sintaxis de C#: net8.0 usa C# 12 por defecto
       y net10.0 usa C# 14. Se deja el valor por defecto de cada destino a proposito (sin forzar
       LangVersion) para que cualquier feature de C# 13/14 que se cuele aqui en el futuro rompa
       la build de net8.0 de inmediato, en vez de romper el mod en silencio mas adelante. -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Obstaculo real de build encontrado y resuelto 25-sep-2026 (aplicador-fix, handoff
       e5eaea9e-c261-4199-8e7d-060b6054f58d, autonomia tecnica ya concedida en CLAUDE.md): con
       varios agentes construyendo este mismo proyecto en paralelo con su propia carpeta de salida
       aislada (`-p:BaseIntermediateOutputPath=obj_<algo>/`, convencion ya documentada en
       bitacora.md desde antes de hoy - ej. bin_keepqaDebug), el SDK solo excluye por defecto la
       carpeta "obj/" LITERAL del glob implicito `**/*.cs` (via $(BaseIntermediateOutputPath),
       "obj\**" de serie) - nunca las carpetas "obj_algo/"/"bin_algo/" de OTROS agentes, que
       tambien viven dentro de este mismo directorio de proyecto. El `Terrakeep.Core.AssemblyInfo.
       cs` autogenerado que cada una de esas carpetas stray deja atras se colaba entonces en
       CUALQUIER build (incluido el build por defecto de cualquier agente, sin importar que
       carpeta de salida use el suyo propio) y chocaba por duplicado (CS0579) contra el
       AssemblyInfo.cs real de la compilacion en curso. Exclusion generica por patron (no una lista
       fija de nombres, que quedaria obsoleta en cuanto otro agente use un nombre nuevo). -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj_*/**;bin_*/**;**/obj_*/**;**/bin_*/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- KeepQA (16-sep-2026, paso 1 de la integracion de analisis estatico externo): analizadores
       de .NET de serie (ya vienen con el SDK, sin paquete NuGet) + Roslynator.Analyzers
       (github.com/dotnet/roslynator, Apache-2.0) como segunda pasada de reglas independiente.
       Solo en Core a proposito - es el codigo de formato/logica pura, el que mas se beneficia de
       un analisis limpio; los tres .Tests.csproj se dejan fuera de Roslynator (ver bitacora.md
       del 16-sep para el porque). -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Roslynator.Analyzers" Version="5.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Auditoria final de Opus (5-sep-2026): mismo criterio que Terrakeep.App.csproj - la
       carpeta de publish no debe llevar simbolos de depuracion al equipo del usuario final. Sin
       esto, el .pdb de Core seguia colandose en el publish de Release aunque el de la App ya no
       (comprobado: era el unico .pdb que quedaba). Solo en Release; Debug los sigue generando,
       que es lo que necesitan el depurador y el arnes de pruebas. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

</Project>
