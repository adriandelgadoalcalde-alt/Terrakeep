                                    Command="{Binding BackupHistory.OpenFolderCommand}" />
                            <Button x:Name="BackupCreateNowButton" Content="{Binding Loc[backup_create_now], Mode=OneWay}" Padding="14,5" Tag="Accent"
                                    ToolTip="{Binding Loc[backup_create_now_tip], Mode=OneWay}"
                                    Command="{Binding BackupHistory.CreateManualBackupCommand}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Codigos de build compartibles (13-sep-2026, cuarto de la lista confirmada):
             "exportar una build a un codigo de texto corto/compartible y poder importarlo en
             otra instalacion". Mismo overlay real que Historial de versiones/Comparador (velo
