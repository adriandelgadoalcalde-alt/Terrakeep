                        <DockPanel Margin="20">
                            <Button DockPanel.Dock="Top" Tag="Ghost" Content="{Binding Loc[explore_back_to_map], Mode=OneWay}"
                                    HorizontalAlignment="Left" Margin="0,0,0,14" Click="OnCloseWorldCompareClick" />
                            <UniformGrid DockPanel.Dock="Top" Columns="2" MaxWidth="640" HorizontalAlignment="Left" Margin="0,0,0,12">
                                <Button Tag="Ghost" Margin="0,0,3,0" Click="OnLoadWorldCompareAClick">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Loc[compare_world_load_a], Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding WorldCompare.NameA, Mode=OneWay}" Style="{StaticResource CaptionText}"
                                                   TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding WorldCompare.NameA, Converter={StaticResource NullToVis}}" />
                                    </StackPanel>
                                </Button>
                                <Button Tag="Ghost" Margin="3,0,0,0" Click="OnLoadWorldCompareBClick">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Loc[compare_world_load_b], Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding WorldCompare.NameB, Mode=OneWay}" Style="{StaticResource CaptionText}"
                                                   TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding WorldCompare.NameB, Converter={StaticResource NullToVis}}" />
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding WorldCompare.ErrorMessage}" Foreground="{StaticResource PinkBrush}"
                                       Style="{StaticResource BodyText}" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" Margin="0,0,0,12"
                                       Visibility="{Binding WorldCompare.ErrorMessage, Converter={StaticResource NullToVis}}" />
                            <TextBlock DockPanel.Dock="Top" Text="{Binding Loc[compare_world_hint], Mode=OneWay}"
                                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" Margin="0,0,0,12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding WorldCompare.HasBothLoaded}" Value="False" />
                                                    <Condition Binding="{Binding WorldCompare.ErrorMessage}" Value="{x:Null}" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- Catalogo de ideas Keep, idea 8 ("Informe y comparador de mundos" -
                                 "salida como tarjeta compartible (PNG/HTML)", reconsiderada a
                                 peticion explicita del coordinador el 20-sep-2026). Sin tocar. -->
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12"
                                       Visibility="{Binding WorldCompare.HasBothLoaded, Converter={StaticResource BoolToVis}}">
                                <Button Content="{Binding Loc[action_export_card_html], Mode=OneWay}" Click="OnExportWorldCompareCardHtmlClick"
                                        Padding="8,4" Margin="0,0,8,4" />
                                <Button Content="{Binding Loc[action_export_card_png], Mode=OneWay}" Click="OnExportWorldCompareCardPngClick"
                                        Padding="8,4" Margin="0,0,8,4" />
                            </WrapPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxWidth="900" HorizontalAlignment="Left"
                                          Visibility="{Binding WorldCompare.HasBothLoaded, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding WorldCompare.StatRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:CompareStatRowViewModel}">
                                            <Border CornerRadius="6" Padding="8,5" Margin="0,0,0,2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDifferent}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource AccentMutedBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <!-- AR-EXWIDE-1 (25-sep-2026, Fase G): antes Width="140"
                                                             fija, sin sentido ya en la vista amplia (columna
                                                             estrecha de 260-520px de antes ya no aplica) - pasa
                                                             a proporcional con un MinWidth real como suelo,
                                                             medido de verdad (FormattedText, mismo mecanismo
                                                             que WorldCompareViewModel.ExportCardToPng usa para
                                                             medir texto) sobre CaptionText real (Theme.xaml:205,
                                                             "Segoe UI Variable Display, Segoe UI" 11px): la
                                                             etiqueta mas larga real de esta lista concreta,
                                                             "Versión de formato", mide 92,19px; con
                                                             SizeClass=Extra (CaptionText sube a 12px) sube a
                                                             ~100,5px - +margen de respiro visual -> 112 de
                                                             suelo. -->
                                                        <ColumnDefinition Width="*" MinWidth="112" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ValueA}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                                               TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding ValueB}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                                               TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </TabItem>

