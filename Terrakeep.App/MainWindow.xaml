                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
        <!-- Encargo de pulido visual (17-sep-2026): x:Name real para que MainWindow.xaml.cs pueda
             localizar el ContentPresenter real de esta TabControl (PART_SelectedContentHost, ver
             OnRootTabSelectionChanged) y darle una transicion sutil de fade+slide al cambiar de
             pestaña principal - las pestañas INTERNAS (InnerTabControl, dentro de Personaje/
             Novedades) se quedan fuera a proposito (encargo real: "pestañas PRINCIPALES"). -->
        <TabControl x:Name="RootTabControl" Style="{StaticResource NavTabControl}" SelectedIndex="{Binding SelectedTabIndex}"
                    SelectionChanged="OnRootTabSelectionChanged">
        <!-- ===================== INICIO ===================== -->
        <!-- H5-14 (quinta auditoria de Opus): "Ctrl+1...6 para las 6 pestañas raiz, numero
             anunciado en el propio rotulo" - mismo criterio T-H/F1 (tooltip real, no un atajo
             que nadie descubre). -->
        <TabItem ToolTip="{Binding Loc[tab_home], Mode=OneWay, StringFormat='{}{0} (Ctrl+1)'}"
                 AutomationProperties.Name="{Binding Loc[tab_home], Mode=OneWay}">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⌂" FontSize="16" Width="24" TextAlignment="Center" />
                    <TextBlock Text="{Binding Loc[tab_home], Mode=OneWay}" Style="{StaticResource NavRailLabel}" />
                </StackPanel>
            </TabItem.Header>
            <views:HomeView />
        </TabItem>

        <!-- ===================== PERSONAJE ===================== -->
        <TabItem ToolTip="{Binding Loc[tab_character], Mode=OneWay, StringFormat='{}{0} (Ctrl+2)'}"
                 AutomationProperties.Name="{Binding Loc[tab_character], Mode=OneWay}">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚔" FontSize="16" Width="24" TextAlignment="Center" />
                    <TextBlock Text="{Binding Loc[tab_character], Mode=OneWay}" Style="{StaticResource NavRailLabel}" />
                </StackPanel>
            </TabItem.Header>
            <Grid>
            <DockPanel Margin="14">
                <!-- Auditoria de Opus, N-1: Cargar/Guardar/nombre de personaje ya viven en la
                     cabecera global (MainWindow.xaml, visible en cualquier pestaña) - repetirlos
                     aqui era la misma accion dos veces en dos sitios (contra P6, simetria real:
                     una unica fuente real por accion). Solo se queda el mensaje de estado, que
                     es especifico de la ultima operacion real. -->
                <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}"
                           Margin="0,0,0,12" TextWrapping="Wrap" />

                <TabControl Style="{StaticResource InnerTabControl}" SelectedIndex="{Binding PersonajeInnerTabIndex}">
                    <TabItem Header="{Binding Loc[char_tab_objects], Mode=OneWay}">
                        <!-- ADR-TERRAKEEP-016/031 (27-sep-2026): DECIMOQUINTA y ULTIMA extraccion real de
                             MainWindow.xaml a un UserControl - cierra el plan completo de ADR-TERRAKEEP-016.
                             Objetos (submodo mas grande y acoplado de PERSONAJE, 911 lineas de encargo)
                             movido a Terrakeep.App/Views/ObjetosView.xaml - ver el comentario real alli,
                             incluidas las 3 dependencias cruzadas conocidas (ItemEditTemplate y
                             ContainerCompactTemplate+SlotCompactTemplate movidos ENTEROS por ser exclusivos;
                             CategoryNodeTemplate duplicado localmente como ObjetosCategoryNodeTemplate
                             porque Research/Buffs, sin extraer todavia, siguen usando la definicion
                             ORIGINAL aqui en Window.Resources) y el hallazgo de StartCardDrag/DragAdorner/
                             GetCursorPos (Terrakeep.App/Controls/DragDropSupport.cs, extraidos a un helper
                             compartido porque los gemelos reales de Buffs -OnBuffLibraryCardMouseMove/
                             OnBuffSlotMouseMove- se quedan en MainWindow.xaml.cs y los seguian necesitando).
                             x:Name="ObjetosView" en el host: window.FindName("ObjetosView") seguido de
                             objetosView.FindName("<x:Name real>") en Program.cs/
                             CanarioNav123YClipCardsLibreria.cs/DiagnosticoPosicionNavToggle.cs. -->
                        <views:ObjetosView x:Name="ObjetosView" />
                    </TabItem>
                    <TabItem Header="{Binding Loc[char_tab_buffs], Mode=OneWay}">
                        <!-- Rework 2-sep-2026, cuarta pasada (pregunta a Opus sobre el diseño).
                             Fase 1 (ya en produccion): rejilla de 44 slots reales + panel
                             Editar, mismo formato que Objetos>Inventario. Fase 2 (esta): la
                             Libreria de buffs de abajo, mismo patron exacto que la de Objetos
                             (arbol real + buscador + resultados en rejilla, plegable) pero con
                             el arbol REAL de Terrasavr para buffs (BuffLibraryTreeBuilder,
                             calcado de app.BuffSide real - no del arbol de objetos). El viejo
                             boton "Añadir buff..." desaparece, sustituido por esta Libreria. -->
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <!-- Auditoria de Opus (octava pasada, B-1) - BUG REAL de layout
                                     encontrado y arreglado: esta fila era "Auto" con el Border de
                                     abajo forzando Height="380" - exactamente el mismo
                                     anti-patron ya diagnosticado y arreglado en Objetos en la
                                     septima pasada ("un Auto con un hijo fijo cobra siempre
                                     primero, sea cual sea el alto real disponible"), pero se
                                     quedo sin aplicar aqui. En ventana grande la rejilla de
                                     buffs no crecia nunca (380px fijo, desaprovechando el
                                     espacio); en ventana minima 380+150 cabia por apenas ~30px
                                     de margen real. Mismo arreglo ya validado: "*" con
                                     MinHeight, sin altura fija en el Border. -->
                                <RowDefinition Height="3*" MinHeight="216" />
                                <!-- Segunda auditoria de Opus (Fable), B-1 - mismo bug real y
                                     mismo arreglo real que la Libreria de Objetos (ver ese
                                     comentario, mas arriba en este mismo fichero): "*" con
                                     MinHeight fijo NO colapsa de verdad al plegar - la fila
                                     dependia solo de la ventana apretando, nunca de
                                     IsBuffLibraryCollapsed. Height/MinHeight dependen ahora de
                                     IsBuffLibraryVisible. -->
                                <!-- FASE D del responsive global: RETIRADO MaxHeight="{Binding LibraryRowMaxHeight}" (mismo
                                     tope 460/640 que la Libreria de objetos, ya sin uso real: el reparto 3*/2* nunca lo
                                     alcanzaba salvo en ventanas altisimas, donde solo dejaba alto sin usar). -->
                                <RowDefinition Height="{Binding IsBuffLibraryVisible, Converter={StaticResource BoolToGridLength}, ConverterParameter=2}"
                                               MinHeight="{Binding IsBuffLibraryVisible, Converter={StaticResource BoolToDouble}, ConverterParameter=200}" />
                            </Grid.RowDefinitions>

                            <!-- FASE D del responsive global, correccion D-05 del revisor visual (s10): MISMA composicion que
                                 Objetos (una sola arquitectura) - rejilla 2x2 (contenido / Libreria x * / 300) con el panel
                                 Editar segun EditarTarjetaComposicion y la Libreria segun LibreriaComposicion (Theme.xaml,
                                 Editar siempre en la fila de contenido desde la revision r2). Antes Editar buff vivia siempre solo en la fila de
                                 contenido y Editar objeto siempre a alto completo. -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="300" />
                            </Grid.ColumnDefinitions>

                                <!-- FASE E del responsive global (28-sep-2026, s8/s13/s14/s26 A/s28): la rejilla de Buffs
                                     era la UNICA region que quedaba con un ScrollViewer PROPIO anidado (ver el
                                     comentario retirado de BuffContainerCompactTemplate, mas arriba). Mismo patron ya
                                     verificado por la FASE C para Inventario/Almacenes: ScrollViewer "BuffsPaginaContenedor"
                                     como UNICO scroll owner vertical de esta celda + AjusteAlViewport (mide contra
                                     ViewportHeight, la rejilla encoge/crece la celda entre MinCell..MaxCell y solo si ni
                                     a MinCell cabe crece la pagina lo justo para que la desplace su owner). -->
                                <ScrollViewer x:Name="BuffsPaginaContenedor" Grid.Row="0" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <controls:AjusteAlViewport x:Name="AjusteBuffs" AltoViewport="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                                <Border BorderBrush="{StaticResource OrangeBrush}" BorderThickness="2" CornerRadius="10"
                                        Background="{StaticResource BgSecondaryBrush}" Padding="10" Margin="0,0,10,8">
                                    <DockPanel>
                                        <!-- H4-06 (cuarta auditoria de Opus, Fable): "la rejilla de Buffs no
                                             tiene contador ni operaciones en bloque, su gemela de objetos si" -
                                             misma cabecera real (DisplayName con recuento vivo + Vaciar todos). -->
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                            <!-- Pedido explicito del usuario (4-sep-2026): "la pestaña de buff
                                                 no tiene nada de guardar json ni tampoco cargar para guardar
                                                 combinaciones de buff" - gemelo real de los botones de
                                                 Guardar/Cargar/Añadir conjunto de objetos (H5-03), mismo
                                                 formato JSON, ver OnSaveBuffSetClick/OnLoadBuffSetClick/
                                                 OnAppendBuffSetClick. -->
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Content="{Binding Loc[action_save_set], Mode=OneWay}" Click="OnSaveBuffSetClick"
                                                        ToolTip="{Binding Loc[tt_save_buffs_json], Mode=OneWay}"
                                                        Tag="Ghost" Padding="6,3" FontSize="10.5" Margin="0,0,6,0" />
                                                <Button Content="{Binding Loc[action_load_ellipsis], Mode=OneWay}" Click="OnLoadBuffSetClick"
                                                        ToolTip="{Binding Loc[tt_load_buffs_replace], Mode=OneWay}"
                                                        Tag="Ghost" Padding="6,3" FontSize="10.5" Margin="0,0,6,0" />
                                                <Button Content="{Binding Loc[action_add_ellipsis], Mode=OneWay}" Click="OnAppendBuffSetClick"
                                                        ToolTip="{Binding Loc[tt_add_buffs_fill], Mode=OneWay}"
                                                        Tag="Ghost" Padding="6,3" FontSize="10.5" Margin="0,0,6,0" />
                                                <Button Content="{Binding Loc[action_empty_all], Mode=OneWay}" Command="{Binding Buffs.Container.ClearAllCommand}"
                                                        ToolTip="{Binding Loc[tt_empty_buffs], Mode=OneWay}" Tag="Ghost" Padding="6,3" FontSize="10.5" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Buffs.Container.DisplayName}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <ContentControl Content="{Binding Buffs.Container}" ContentTemplate="{StaticResource BuffContainerCompactTemplate}" />
                                    </DockPanel>
                                </Border>
                                </controls:AjusteAlViewport>
                                </ScrollViewer>

                                <Border x:Name="EditarBuffTarjeta" Style="{StaticResource EditarTarjetaComposicion}">
                                    <ContentControl Content="{Binding BuffEdit}" ContentTemplate="{StaticResource BuffEditTemplate}" />
                                </Border>

                            <!-- Libreria de buffs. FASE D del responsive global (28-sep-2026): MISMA arquitectura que la
                                 Libreria de objetos y que Investigacion (s10/s11 - "no mantener dos arquitecturas
                                 diferentes sin motivo"). RETIRADOS la columna fija de 210px con el arbol de categorias y
                                 su ScrollViewer propio, el ScrollViewer propio de las tarjetas raiz y la fila de buscador
                                 aparte. Cabecera en UNA fila (plegar + buscador), NavegadorCategorias (categorias
                                 principales siempre visibles + ruta/subcategorias), resumen y UN solo scroll owner
                                 vertical (LibreriaBuffsResultados) con columnas adaptativas. -->
                            <Border x:Name="LibreriaBuffsPanel" Grid.Row="1" Style="{StaticResource LibreriaComposicion}">
                                <DockPanel>
                                    <!-- FASE D, correccion D-01/D-04: cabecera (plegar + buscador) dentro del flujo de las categorias
                                         principales, mismo orden que la Libreria de objetos e Investigacion. -->
                                    <views:NavegadorCategorias x:Name="LibreriaBuffsNavegadorCategorias" DockPanel.Dock="Top" DataContext="{Binding BuffLibrary}" Margin="0,0,0,2"
                                                               MostrarNavegacion="{Binding DataContext.IsBuffLibraryVisible, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <!-- La cabecera se declara aqui y NavegadorCategorias.AdoptarCabecera (code-behind del host) la mueve a su
                                         flujo al construir la vista: WPF no deja poner x:Name (LibrarySearchBox, LibraryFiltersButton...) en el
                                         contenido que se le da a un UserControl con nombres propios (MC3093), y esos nombres los usan el
                                         code-behind, el Popup de filtros y el arnes. -->
                                    <Decorator x:Name="SoporteCabeceraLibreriaBuffs" DockPanel.Dock="Top" Visibility="Collapsed">
                                        <StackPanel x:Name="LibreriaBuffsCabecera" Orientation="Horizontal">
                                            <!-- H4-13 (cuarta auditoria de Opus, Fable): mismo tooltip real que su gemela de objetos
                                                 (Ctrl+F es contextual, ver GoToContextualLibraryCommand). Plegada, ocupa la fila. -->
                                            <Button Command="{Binding ToggleBuffLibraryCollapsedCommand}" Style="{StaticResource BarButton}"
                                                    ToolTip="{Binding Loc[tt_ctrlf_buff_library], Mode=OneWay}"
                                                    HorizontalContentAlignment="Stretch" Padding="8,3" VerticalAlignment="Center">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="14,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <!-- Mismo arreglo real que su gemela de objetos (rotulos por Loc). -->
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding Loc[library_collapse], Mode=OneWay}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsBuffLibraryCollapsed}" Value="True">
                                                                        <Setter Property="Text" Value="{Binding Loc[library_expand], Mode=OneWay}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Loc[buff_library_title], Mode=OneWay}" Style="{StaticResource SectionText}" FontSize="12.5" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Button>
                                            <!-- H4-01 / FASE D D-01: mismo arreglo real que la Libreria de objetos (260px en el flujo de la cabecera). -->
                                            <Grid Width="260" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsBuffLibraryVisible, Converter={StaticResource BoolToVis}}">
                                                <TextBox x:Name="BuffLibrarySearchBox" Text="{Binding BuffLibrary.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                         Padding="7,5" Background="{StaticResource BgElevatedBrush}"
                                                         Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0"
                                                         FontSize="12" VerticalContentAlignment="Center"
                                                         ToolTip="{Binding Loc[tt_search_grammar_full], Mode=OneWay}" />
                                                <TextBlock Text="{Binding Loc[action_search_ellipsis], Mode=OneWay}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextSecondaryBrush}" IsHitTestVisible="False"
                                                           Visibility="{Binding BuffLibrary.SearchText, Converter={StaticResource EmptyToVisible}}" />
                                            </Grid>
                                        </StackPanel>
                                        
                                    </Decorator>

                                    <Border DockPanel.Dock="Top" Background="{StaticResource AccentBrush}" CornerRadius="6" Padding="8,5" Margin="0,0,0,6"
                                            Visibility="{Binding BuffLibrary.IsPicking, Converter={StaticResource BoolToVis}}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="{Binding Loc[action_cancel], Mode=OneWay}" Command="{Binding BuffLibrary.CancelPickCommand}"
                                                    Tag="Ghost" Foreground="{StaticResource BgPrimaryBrush}" Padding="6,2" ToolTip="{Binding Loc[shortcut_esc], Mode=OneWay}" />
                                            <!-- H4-13 (cuarta auditoria de Opus, Fable): faltaba "(o arrastra)" -
                                                 arrastrar buffs desde esta Libreria funciona desde la quinta
                                                 pasada, pero el aviso no lo mencionaba (su gemelo de objetos si). -->
                                            <TextBlock Text="{Binding Loc[buff_library_pick_placeholder], Mode=OneWay}"
                                                       Foreground="{StaticResource BgPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="11.5" />
                                        </DockPanel>
                                    </Border>

                                    <DockPanel Visibility="{Binding IsBuffLibraryVisible, Converter={StaticResource BoolToVis}}">
                                        <!-- FASE D: el resumen vive ahora en la linea de ruta de NavegadorCategorias. -->
                                        <!-- Unico scroll owner vertical (s13): tarjetas raiz (H5-13) o resultados en el MISMO
                                             ScrollViewer; imagen2/LIBCARD_CLIP_SOLO: Margin superior en el contenido. -->
                                        <ScrollViewer x:Name="LibreriaBuffsResultados" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <Grid>
                                                <!-- FASE D: tarjetas de carpeta raiz compartidas (Views/TarjetasCategoriasRaiz.xaml), con sus
                                                     subcarpetas de primer nivel - antes una copia de plantilla por superficie. -->
                                                <views:TarjetasCategoriasRaiz Margin="0,4,0,0" DataContext="{Binding BuffLibrary}" EsBuffs="True"
                                                                              AltoDisponible="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                                              Visibility="{Binding ShowRootCategoryCards, Converter={StaticResource BoolToVis}}" />
                                                <!-- Rejilla sin columnas semanticas (s8): mismo AdaptiveColumns + PreferirCeldaGrande que
                                                     la Libreria de objetos. -->
                                                <ItemsControl ItemsSource="{Binding BuffLibrary.Results}" ItemTemplate="{StaticResource BuffLibraryCardTemplate}"
                                                              Visibility="{Binding BuffLibrary.ShowRootCategoryCards, Converter={StaticResource InverseBoolToVis}}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <controls:SlotGridPanel Columns="60" AdaptiveColumns="True" PreferirCeldaGrande="True"
                                                                                     MinCell="{Binding DataContext.Settings.IsCompactMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static conv:CompactCellSizeConverter.Instance}, ConverterParameter=40}"
                                                                                     MaxCell="{Binding DataContext.Settings.IsCompactMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static conv:CompactCellSizeConverter.Instance}, ConverterParameter=90}"
                                                                                     Gap="{Binding DataContext.Settings.IsCompactMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static conv:CompactGapConverter.Instance}}"
                                                                                     ReferenceColumns="10"
                                                                                     AvailableHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </Grid>
                                        </ScrollViewer>
                                    </DockPanel>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem Header="{Binding Loc[char_tab_research], Mode=OneWay}">
                        <!-- Antes: una unica lista plana (hasta miles de objetos, "es
                             larguisimo" - pedido explicito 2-sep-2026). Ahora: mismo arbol de
                             carpetas real que la Libreria (Research.RootCategories, ver
                             LibraryCategoryTreeBuilder) - mismos nombres y sprites de
                             siempre, solo cambia como se navega. -->
                        <DockPanel Margin="0,10,0,0">
                            <!-- R-g (segunda auditoria de Opus, Fable): "ninguna advertencia si el
                                 personaje no es Modo Viaje - el dato ya esta a mano". La
                                 Investigacion solo desbloquea recetas de verdad en Modo Viaje. -->
                            <Border DockPanel.Dock="Top" Background="{StaticResource CalamityBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,10"
