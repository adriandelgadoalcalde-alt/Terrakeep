        <TabItem Tag="GroupStart" ToolTip="{Binding Loc[tab_exploration], Mode=OneWay, StringFormat='{}{0} (Ctrl+5)'}"
                 AutomationProperties.Name="{Binding Loc[tab_exploration], Mode=OneWay}">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⛰" FontSize="16" Width="24" TextAlignment="Center" />
                    <TextBlock Text="{Binding Loc[tab_exploration], Mode=OneWay}" Style="{StaticResource NavRailLabel}" />
                </StackPanel>
            </TabItem.Header>
            <DockPanel Margin="14">
                <!-- Auditoria de redimensionado, R-11/§4.11: endurecimiento SIN defecto medido -
                     un StackPanel horizontal nunca envuelve ni recorta, empuja fuera de la
                     ventana en silencio si no cabe. Con el nombre de mundo mas largo real de esta
                     maquina sobraban ~100px a 1080px, pero el margen es pequeño y depende de un
                     dato del usuario (Terraria permite nombres bastante mas largos). WrapPanel +
                     tope al titulo lo hacen imposible en vez de solo improbable. -->
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button Content="{Binding Loc[explore_load_world], Mode=OneWay}" Tag="Accent" Click="OnLoadWorldClick"
                            IsEnabled="{Binding Exploration.IsNotLoading}" />
                    <!-- Vista previa de generacion de mundo (14-sep-2026, noveno de la lista
                         confirmada): siempre disponible, sin depender de ningun mundo/personaje
                         cargado - calculador puro (ver WorldPreviewViewModel). -->
                    <Button Content="{Binding Loc[worldpreview_open_button], Mode=OneWay}" Margin="10,0,0,0"
                            Command="{Binding OpenWorldPreviewCommand}" />
                    <TextBlock Style="{StaticResource SectionText}" VerticalAlignment="Center" Margin="20,0,0,0"
                               MaxWidth="320" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Exploration.IsWorldLoaded, Converter={StaticResource BoolToVis}}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource LocFormat}">
                                <Binding Path="Loc[explore_world_title]" Mode="OneWay" />
                                <Binding Path="Exploration.WorldTitle" Mode="OneWay" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <!-- X-h (segunda auditoria de Opus, Fable): "no dice que es solo lectura" -
                         antes solo un comentario de codigo (ExplorationViewModel), invisible para
                         el usuario real - nada en pantalla avisaba de que este visor no puede
                         colocar/quitar bloques (a diferencia de Objetos/Apariencia/etc., donde
                         cada cambio SI se guarda). -->
                    <!-- Familia "StateTagNeutral" (rediseno de badges, 25-sep-2026): etiqueta informativa
                         pura, borde fino sin relleno - nunca compite visualmente con una capsula de
                         metrica/recuento real. -->
                    <Border Style="{StaticResource StateTagNeutral}" Margin="10,0,0,0"
                            VerticalAlignment="Center" ToolTip="{Binding Loc[explore_readonly_tooltip], Mode=OneWay}"
                            Visibility="{Binding Exploration.IsWorldLoaded, Converter={StaticResource BoolToVis}}">
                        <!-- FontWeight="Normal" fijado a proposito (24-sep-2026, unificacion de badges) - antes
                             heredaba SemiBold por accidente del Trigger IsSelected del TabItem activo de la
                             rail (Theme.xaml), no por diseño propio de este badge; ver bitacora.md. -->
                        <TextBlock Text="{Binding Loc[explore_readonly_badge], Mode=OneWay}" Style="{StaticResource CaptionText}" FontWeight="Normal" />
                    </Border>
                    <!-- AR-EX6 (15-sep-2026, ronda de cierre): este WrapPanel (arriba, sin ItemHeight
                         fijo) envuelve este StackPanel a una segunda linea con el mundo real
                         cargado en cualquier ancho de 1080 a 1170px (roca_negra.wld, titulo corto
                         "roca negra") - comportamiento QUERIDO de R-11, pero al ocurrir dejaba
                         0px exactos de salto entre la linea 1 y la linea 2 (medido con el arnes,
                         Terrakeep.App.Tests/AuditoriaBarraExploracion.cs: linea 1 termina en
                         y=195,63/196,31px, este StackPanel empezaba en y=196,00px), la MISMA
                         categoria de bug (0px de salto de linea) ya arreglada en la barra de
                         Personaje (MainWindow.xaml:1783, ver KeepQA/src/regresion/casos/
                         terrakeep-cabecera-botones-sin-espacio-salto-linea.json). Margen superior
                         8px (escala 4/6/10/14/20 de P-5, arriba en este mismo WrapPanel) igual
                         que alli. Diferencia real con ese caso: aqui el WrapPanel exterior NO
                         tiene ItemHeight fijo, asi que en el caso NO envuelto (la inmensa mayoria
                         de anchos reales, 1180-1920px+) el centrado vertical de ESTE StackPanel
                         dentro de su fila se desplaza ~4px hacia abajo respecto a sus vecinos
                         (fila la sigue marcando la altura de los botones, 33px, sin cambiar) -
                         medido y aceptado: 4px es la unidad minima de la propia escala del
                         proyecto, por debajo de cualquier umbral de solape/contencion real, y
                         arreglar ese matiz sin tocarlo exigiria un ItemHeight fijo que agrandaria
                         el hueco bajo la barra en TODOS los anchos (no solo el rango 1080-1170px
                         que realmente lo necesita) - una huella mayor que el propio bug. -->
                    <StackPanel Orientation="Horizontal" Margin="20,8,0,0" VerticalAlignment="Center"
                                Visibility="{Binding Exploration.IsWorldLoaded, Converter={StaticResource BoolToVis}}">
                        <!-- P-8 (auditoria Opus vs TEdit): "−"/"+" eran los unicos botones sin
                             tooltip de la fila; "Restablecer" no decia a que restablecia. -->
                        <!-- P-1 (auditoria Opus vs TEdit): el indicador de porcentaje se mudo a la
                             franja de estado fija bajo el mapa (mas cerca de donde se mira al
                             hacer zoom) - los botones de aqui se quedan, solo se fue el numero. -->
                        <!-- F-9 (auditoria Opus vs TEdit, E-09): atajos anunciados en el ToolTip del
                             boton equivalente - "es la mitad del valor" (cita literal del informe),
                             mismo criterio ya usado por T-H/F1 en la barra superior. Solo activos
                             con Exploracion en pantalla y el foco fuera de un TextBox. -->
                        <Button Content="&#8722;" Command="{Binding Exploration.ZoomOutCommand}" Padding="10,2"
                                ToolTip="{Binding Loc[explore_zoom_out], Mode=OneWay}" />
                        <Button Content="+" Command="{Binding Exploration.ZoomInCommand}" Padding="10,2" Margin="4,0,0,0"
                                ToolTip="{Binding Loc[explore_zoom_in], Mode=OneWay}" />
                        <!-- P-5 (auditoria Opus vs TEdit): escala de espaciado unica del proyecto
                             (4/6/10/14/20) - 4 entre hermanos directos (−/+, ya lo eran), 10
                             entre controles relacionados (antes 8, sin motivo real). -->
                        <Button Content="{Binding Loc[action_reset], Mode=OneWay}" Command="{Binding Exploration.ZoomResetCommand}" Padding="8,2" Margin="10,0,0,0"
                                ToolTip="{Binding Loc[explore_zoom_100], Mode=OneWay}" />
                        <!-- X-a (segunda auditoria de Opus, Fable): "Restablecer" vuelve al 100%,
                             que para un mundo de 8400x2400 significa ver el 12% del ancho - "la
                             accion mas obviamente ausente de la pantalla". El calculo real (necesita
                             el tamaño real del viewport del ScrollViewer, que la ViewModel no
                             conoce) vive en el code-behind, igual que el resto de gestos del mapa. -->
                        <Button Content="{Binding Loc[explore_fit_window], Mode=OneWay}" Click="OnFitToWindowClick" Padding="8,2" Margin="10,0,0,0"
                                ToolTip="(0)" />
                        <!-- F-12 (auditoria Opus vs TEdit, E-13): "genera un WriteableBitmap
                             completo del mundo y lo congela - un PngBitmapEncoder son ~8 lineas.
                             No existe." -->
                        <Button Content="{Binding Loc[explore_export_png], Mode=OneWay}" Click="OnExportMapClick" Padding="8,2" Margin="10,0,0,0"
                                ToolTip="{Binding Loc[explore_export_png_tooltip], Mode=OneWay}" />
                    </StackPanel>
                    <!-- Boton "Guardar mundo" (encargo del usuario 28-sep-2026: "deberia de haber
                         un boton de guardar igual que hay uno de cargar mundo?... que este en la
                         derecha del todo") - mismo estilo que "Cargar mundo" de arriba (Tag=
                         "Accent"), ultimo hijo real de este WrapPanel para quedar en el extremo
                         derecho de la barra. Ver el comentario real completo de
                         ExplorationViewModel.CanSaveWorldChanges/SaveWorldChangesAsync: guarda de
                         golpe las 4 secciones de "Editar mundo" que tengan cambios pendientes
                         (modo de juego/spawn/hora y luna/banderas de jefes) - cofres y letreros se
                         guardan aparte, con su propio boton, al editarlos. Solo visible con un
                         mundo cargado, igual que el resto de esta fila; el propio Command se
                         deshabilita solo cuando no hay nada pendiente que guardar. -->
                    <Button Content="{Binding Loc[explore_save_world], Mode=OneWay}" Tag="Accent" Margin="20,0,0,0"
                            Command="{Binding Exploration.SaveWorldChangesCommand}"
                            ToolTip="{Binding Loc[explore_save_world_tooltip], Mode=OneWay}"
                            Visibility="{Binding Exploration.IsWorldLoaded, Converter={StaticResource BoolToVis}}" />
                </WrapPanel>

                <!-- H5-11 (quinta auditoria de Opus): "el lanzador de mundos desaparece para
                     siempre en cuanto cargas uno" - tira PERMANENTE de pildoras (visible con
                     mundo cargado o no, a diferencia del overlay grande de mas abajo, que solo
                     vive en el estado vacio) para poder pasar de un mundo a otro sin volver al
                     dialogo de Explorador cada vez. -->
                <!-- C-07 (auditoria de pulido final, cierra E1): 20px de aire por encima (10 del
                     WrapPanel de arriba + 10 de aqui) y 0 por debajo - el lienzo del mapa quedaba
                     pegado a las pildoras. Escala 4/6/10/14/20 ya fijada por P-5: 4 arriba (deja
                     14 sumando el margen inferior del WrapPanel superior) y 10 abajo. -->
                <DockPanel DockPanel.Dock="Top" Margin="0,4,0,10"
                           Visibility="{Binding Exploration.Worlds.Count, Converter={StaticResource CountToVis}}">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Loc[explore_your_worlds], Mode=OneWay}" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button DockPanel.Dock="Left" Content="{Binding Loc[home_refresh], Mode=OneWay}" FontSize="11" Padding="8,2" Margin="0,0,10,0"
                            Command="{Binding Exploration.RefreshWorldsCommand}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Exploration.Worlds}" ItemTemplate="{StaticResource WorldPillTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Exploration.StatusMessage}"
                           Style="{StaticResource CaptionText}" Margin="0,10,0,0" TextWrapping="Wrap" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <!-- X-f (segunda auditoria de Opus, Fable): "columna de NPCs 220px fija" -
                             Auto+MinWidth/MaxWidth (mismo criterio ya establecido en el resto de la
                             app, ver ContainerViewModel/AddContainer) en vez de un numero fijo que
                             nunca respira con la ventana - el mapa ("*") se sigue llevando siempre
                             todo el sobrante real. -->
                        <!-- Punto 4 (advisor Opus, ESPEC-ui-exploracion.md#8-D4): la columna crece de
                             220-300 a 260-380 - inventario + resultados no cabian en el ancho anterior
                             (TEdit diseña este mismo panel a 400px, FindSidebarView.xaml:12).
                             Auditoria de redimensionado, R-02/H-02: el MaxWidth se movio de aqui al
                             DockPanel de abajo - una ColumnDefinition Width="Auto" mide su contenido
                             con ancho INFINITO antes de aplicar el MaxWidth, asi que el WrapPanel de
                             las 5 pildoras de categoria nunca envolvia de verdad (pedia 408px en una
                             sola fila) y WPF recortaba la diferencia sin reorganizar nada - "Objetos"
                             perdia 60 de 97px, A CUALQUIER tamaño de ventana, incluido 4K. -->
                        <!-- F-10 (auditoria de Opus vs TEdit, E-10): sustituye por completo el
                             mecanismo Auto+MaxWidth de arriba (R-02/H-02) por un GridSplitter real
                             - la columna ahora es un GridLength LITERAL (Settings.
                             ExplorationSidebarWidth, TwoWay), que se mide con un ancho REAL desde
                             el principio, asi que el bug de "Auto mide con ancho infinito" queda
                             eliminado de raiz (no solo evitado). MinWidth=0 para que plegar a 0
                             sea alcanzable; el suelo real de 260 al expandir lo aplica
                             OnExplorationSidebarWidthChanged en el propio ViewModel. -->
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="{Binding Settings.ExplorationSidebarWidth, Mode=TwoWay, Converter={x:Static conv:DoubleToGridLengthConverter.Instance}}"
                                          MinWidth="0" MaxWidth="520" />
                    </Grid.ColumnDefinitions>

                    <!-- T6 (catalogo de rediseño visual, "Exploracion a pantalla completa" - bitacora.md
                         20-sep-2026): reabierto por instruccion explicita del coordinador/usuario tras
                         documentarlo como LIMITE-por-riesgo-historico (no tecnico real) - el propio
                         zoom/pan/hit-test del mapa (AR-MRK) y esta columna lateral (calibrada en MinHeight
                         590->652->800, AR-11a/AR-11f/AR-15/AR-EX1/FALLO-3) tienen su propio historial real,
                         pero "flotar el panel lateral sobre el mapa" NO exige tocar ninguno de los dos
                         mecanismos: es un cambio ADITIVO (una capa visual mas encima), no una reescritura
                         del zoom/pan ni del calculo de alto de la columna.
                         Estrategia de riesgo minimo, verificada antes de escribir el resto del comentario:
                         un Grid NO recorta a sus hijos por defecto (mismo hecho real que ya documentan
                         SlotRowHost/ClipToBounds en otras zonas de este fichero) y el orden de declaracion
                         en XAML decide el z-order (lo declarado DESPUES se pinta ENCIMA) - dandole a este
                         Border del mapa un ColumnSpan que cubra las 3 columnas, se PINTA de borde a borde
                         (el mapa real usa TODO el ancho, "pantalla completa" de verdad), mientras que el
                         GridSplitter y el panel lateral (declarados mas abajo en este mismo Grid, SIN
                         tocarlos) siguen ocupando su columna real de siempre y por tanto se ven ENCIMA,
                         flotando - ni su ancho (Settings.ExplorationSidebarWidth), ni su plegado/GridSplitter,
                         ni el alto de su ScrollViewer interno (calibrado contra el viewport real de esa
                         MISMA columna, que no cambia) se tocan. -->
                    <!-- ADR-TERRAKEEP-016/030 (27-sep-2026): Mapa+minimapa+tooltip (submodo mas
                         grande y con mas code-behind real de EXPLORACION, ver el comentario real
                         completo en WorldMapView.xaml) movido a Terrakeep.App/Views/
                         WorldMapView.xaml. Grid.Column="0" Grid.ColumnSpan="3" se quedan AQUI, en
                         el host (antes vivian en el Border que se movio) - siguen pintando el mapa
                         de borde a borde por encima del splitter y de la barra lateral flotante
                         (mismo mecanismo T6 ya documentado, sin cambios). x:Name="WorldMapView" en
                         el host: window.FindName("WorldMapView") seguido de
                         worldMapView.FindName("WorldMapScroll"/"WorldMapImage") en
                         AuditoriaViewportScroll.cs/Program.cs. FitToWindow()/SaveCurrentViewState()/
                         RestoreViewOrFit()/PanBy()/NavigateToTile()/UpdateMinimapViewport() son los
                         ganchos publicos que MainWindow.xaml.cs invoca desde fuera de este bloque
                         (OnFitToWindowClick, OnWindowClosing, LoadWorldAndRestoreView,
                         OnWindowKeyDown, la suscripcion a Exploration.NavigateToTileRequested y el
                         PropertyChanged de Zoom/WorldImage del constructor). -->
                    <views:WorldMapView x:Name="WorldMapView" Grid.Column="0" Grid.ColumnSpan="3" />

                    <!-- F-10: 5px de agarre real pero 1px de linea visible en reposo, 3px de
                         acento al pasar el raton o arrastrar - mismo lenguaje real que TEdit
                         (MainWindow.xaml:451-477, "VS Code style: subtle until hovered/dragged"),
                         reimplementado con los pinceles del propio tema (nada nuevo). -->
                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                  Background="Transparent" ShowsPreview="False">
                        <GridSplitter.Style>
                            <Style TargetType="GridSplitter">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Settings.ExplorationSidebarWidth}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </GridSplitter.Style>
                        <GridSplitter.Template>
                            <ControlTemplate TargetType="GridSplitter">
                                <Border Background="Transparent">
                                    <Border x:Name="Linea" Width="1" HorizontalAlignment="Center" Background="{StaticResource BorderBrush0}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Linea" Property="Width" Value="3" />
                                        <Setter TargetName="Linea" Property="Background" Value="{StaticResource AccentBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </GridSplitter.Template>
                    </GridSplitter>

                    <!-- Bug real confirmado por el usuario (14-sep-2026): al plegar la barra
                         lateral a 0 (OnToggleExplorationSidebarClick) desaparecian A LA VEZ el
                         boton "›" que la pliega (vive DENTRO de la propia columna 2, que se
                         colapsa con ella - ScrollViewer Grid.Column="2" mas abajo) Y el
                         GridSplitter de arriba (su Style lo pone Collapsed en cuanto el ancho
                         llega a 0) - no quedaba ningun sitio real desde el que volver a abrirla
                         ("si lo quitas para poder ver mejor el mapa ya no hay nada de el por
                         ningun lado", palabras del usuario). Esta pestaña vive en la columna 1
                         (la del splitter): esa columna es "Auto" y solo se queda a 0px cuando
                         NINGUNO de sus hijos es visible, asi que con el GridSplitter y esta
                         pestaña en triggers EXACTAMENTE opuestos (uno u otro, nunca los dos a la
                         vez) la columna 1 nunca desaparece entera y siempre hay algo real que
                         pulsar. Reusa el MISMO manejador que el boton de plegar - ya es un
                         alternador real (mira ExplorationSidebarWidth y decide solo), no hace
                         falta logica nueva. -->
                    <Button x:Name="ExpandExplorationSidebarButton" Grid.Column="1" Content="&#8249;" Tag="Ghost" Padding="4,14" VerticalAlignment="Center"
                            Click="OnToggleExplorationSidebarClick"
                            AutomationProperties.Name="ExpandExplorationSidebarButton"
                            ToolTip="{Binding Loc[explore_expand_sidebar], Mode=OneWay}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Settings.ExplorationSidebarWidth}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- ExplorationSidebarPanel ya no fija Height/MinHeight aqui: el suelo de scroll para listas virtualizadas vive en ExplorationSidebarBrowseContent (unico de los 3 modos del sidebar con listas grandes), MinHeight=300 medido contra el peor caso real. Prohibido volver a subir un suelo aqui: este DockPanel es compartido por Browse/ChestInspector/WorldTools y penalizaba a los 2 que no lo necesitaban. Historial completo (590->652->800->1000 y la investigacion que llevo a moverlo): ADR-TERRAKEEP-001. -->
                    <!-- T6: tarjeta flotante real - Background solido (nunca transparente, para que se
                         lea sobre el mapa que ahora sigue pintandose por debajo, ver el comentario real
                         del Border del mapa mas arriba) + sombra + separacion real de los bordes de la
                         ventana (Margin), mismo lenguaje visual que cualquier otra tarjeta de esta app
                         (SidePanelCard/BgSecondaryBrush). El Grid interior (alto/ancho/plegado/GridSplitter/
                         scroll) sigue exactamente igual, solo gano un envoltorio visual. -->
                    <Border x:Name="ExplorationSidebarFloatingCard" Grid.Column="2" Background="{StaticResource BgSecondaryBrush}" CornerRadius="8" Margin="0,0,4,4" Padding="10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.45" Direction="270" />
                        </Border.Effect>
                    <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" x:Name="ExplorationSidebarScroll"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  ScrollChanged="OnExplorationSidebarScrollChanged">
                    <DockPanel x:Name="ExplorationSidebarPanel">
                        <!-- Punto 4 (advisor Opus, "una nueva barra lateral... que ya no solo salgan
                             los npc, eso se traslada dentro de una rama madre donde salgan varios
                             botones" - ver ESPEC-ui-exploracion.md#9). Rediseño completo: la lista de
                             NPCs deja de vivir suelta, pasa a ser una categoria mas (D3: fila de
                             pildoras en vez de TabControl/Expander - TEdit se permite 4 pestañas
                             porque diseña este panel a 400px, aqui son 260-380). -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Loc[explore_search_title], Mode=OneWay}" Style="{StaticResource SectionText}" />
