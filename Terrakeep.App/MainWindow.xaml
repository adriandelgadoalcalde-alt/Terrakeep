                        <views:WorldToolsView x:Name="WorldToolsView" />
                        </Grid>
                    </DockPanel>
                    </ScrollViewer>
                    <!-- Indicador de scroll pendiente (cierre del punto 1, ver el comentario largo
                         junto a MinHeight="800" mas arriba): fila PROPIA (Grid.Row="1", Auto) debajo
                         del ScrollViewer, nunca superpuesto encima de su contenido (ver el "PRIMER
                         INTENTO DESCARTADO" del mismo comentario - superponerlo tapaba filas reales
                         ya visibles a tamaño por defecto). Empieza oculto (Auto -> 0px reales,
                         ninguna franja robada de balde) - OnExplorationSidebarScrollChanged
                         (MainWindow.xaml.cs) lo muestra/oculta segun quede recorrido real por debajo
                         (ExtentHeight > ViewportHeight y no ya al fondo), nunca un adorno fijo. -->
                    <Border x:Name="ExplorationScrollHint" Grid.Row="1" HorizontalAlignment="Center"
                            Margin="0,6,0,2" Background="{StaticResource BgElevatedBrush}" CornerRadius="10"
