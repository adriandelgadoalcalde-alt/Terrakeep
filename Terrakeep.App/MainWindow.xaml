                                <TextBlock Foreground="White" TextWrapping="Wrap" FontSize="12"
                                           Text="{Binding Loc[research_not_journey_mode], Mode=OneWay}" />
                            </Border>
                            <!-- H5-02 (quinta auditoria de Opus): "Quitar toda la investigacion" -
                                 el equivalente real del "Remove All" del Terrasavr original
                                 (app.TabResearch), que hoy no existia en absoluto - junto al ya
                                 real "Investigar todo" ("Unlock All"), los 2 al mismo nivel, mismo
                                 criterio real de la app original. Barra de progreso real (R-f
                                 ya calculaba N/Total como frase, ahora tambien como barra). -->
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                    <Button Content="{Binding Loc[action_research_all], Mode=OneWay}" Tag="Accent" Command="{Binding ResearchAllCommand}" />
                                    <Button Content="{Binding Loc[action_remove_all_research], Mode=OneWay}" Tag="Ghost" Margin="8,0,0,0"
                                            Command="{Binding Research.ClearAllResearchCommand}"
                                            ToolTip="{Binding Loc[tt_remove_all_research], Mode=OneWay}" />
                                </StackPanel>
                                <ProgressBar DockPanel.Dock="Top" Margin="0,6,0,0" Height="6" Minimum="0" Maximum="1"
                                             Value="{Binding Research.ProgressFraction, Mode=OneWay}"
                                             Foreground="{StaticResource AccentBrush}"
                                             ToolTip="{Binding Research.GlobalProgressSummary}" />
                                <!-- Paneles de progreso/completitud (14-sep-2026, punto 6 de la
                                     lista confirmada del 13-sep-2026): limite honesto investigado
                                     a fondo, documentado aqui en vez de fingir un panel de logros
                                     que este editor no puede ofrecer de verdad - Terraria guarda
                                     los logros por CUENTA de Steam (un unico fichero compartido,
                                     fuera de las carpetas Players/Worlds que esta app toca), sin
                                     ningun personaje/mundo al que asociarlos. -->
                                <TextBlock DockPanel.Dock="Top" Text="{Binding Loc[research_achievements_not_available], Mode=OneWay}"
                                           Style="{StaticResource CaptionText}" Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                            </DockPanel>
                            <!-- H4-13 (cuarta auditoria de Opus, Fable): el mismo bloque real
                                 "arbol+resultados" va envuelto en BgSecondaryBrush en Libreria y
                                 Libreria de buffs, pero aqui iba desnudo sobre el fondo primario -
                                 mismo componente, dos tratamientos distintos sin motivo real. -->
                            <!-- FASE D del responsive global (28-sep-2026, s11): Investigacion entra en la MISMA familia
                                 "catalogo con categorias" que las dos Librerias. RETIRADOS la columna fija de 210px con el
                                 arbol y su ScrollViewer propio y el ScrollViewer propio de las tarjetas raiz. Arriba,
                                 NavegadorCategorias (categorias principales siempre visibles + ruta/subcategorias); debajo,
                                 buscador + acciones de carpeta + resumen; y UN solo scroll owner vertical
                                 (InvestigacionResultados) para las tarjetas raiz o los resultados (WrapPanel: las filas
                                 de investigacion ya se reparten solas por el ancho). -->
                            <Border x:Name="InvestigacionCatalogo" Background="{StaticResource BgSecondaryBrush}" CornerRadius="8" Padding="8">
                                <DockPanel>
                                    <!-- FASE D, correccion D-04 del revisor visual: MISMO orden que las dos Librerias - cabecera con el
