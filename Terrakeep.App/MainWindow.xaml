                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.35" />
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Loc[explore_scroll_hint], Mode=OneWay}" Style="{StaticResource CaptionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="&#8595;" FontSize="11" Margin="5,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    </Grid>
                    </Border>

                    <!-- ExploracionRediseno Fase G (25-sep-2026): vista amplia del comparador de
                         mundos. Mismo patron T6 de la Border del mapa de mas arriba (Grid.Column="0"
                         Grid.ColumnSpan="3", DECLARADA LA ULTIMA de este Grid de 3 columnas para
                         pintarse encima de TODO - mapa Y el panel lateral flotante, no solo del
                         mapa) condicionada por Exploration.IsShowingWorldCompare (deriva de
                         SelectedCategory==Compare, ver OnSelectedCategoryChanged en
                         ExplorationViewModel - la pildora "Comparar" del selector de categoria,
                         mas arriba en este mismo fichero, sigue siendo el UNICO disparador real,
                         sin cambios). Contenido movido tal cual desde la columna estrecha del
                         sidebar (antes vivia dentro de ExplorationCategoryContent, ver el
                         comentario que quedo en su lugar) - mismos bindings/handlers de
                         codigo-detras (OnLoadWorldCompareA/BClick, OnCloseWorldCompareClick,
                         OnExportWorldCompareCardHtml/PngClick en MainWindow.xaml.cs), sin tocar
                         WorldCompareViewModel. Unico cambio real de contenido: la columna de
                         etiqueta de cada fila pasa de Width="140" fija a proporcional con un
