        <!-- Catálogo de rediseño visual T7 (20-sep-2026, ver Theme.xaml ToastCardBase para el
             porque): pila unica abajo a la derecha, ultimo hijo del Grid raiz a proposito (mismo
             motivo real del comentario X1 de abajo: el orden de los hijos decide el orden de
             pintado en WPF). Contiene, de arriba a abajo, el ToastHost (avisos efimeros reales,
             pueden coexistir varios) y la tarjeta persistente de actualizacion - las dos pilas
             comparten el mismo StackPanel asi que NUNCA se solapan entre si, este visible la que
             este visible. -->
        <StackPanel Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,22,22" Panel.ZIndex="99">

            <!-- ToastHost: avisos efimeros reales. Exito (guardado, TealGradientBrush, se
                 autocierra solo - ver _saveConfirmationTimer en MainViewModel.cs, 6s reales tras
                 este cambio) y error (PinkGradientBrush - antes CalamityBrush, corregido a
                 proposito: CalamityBrush esta reservado para "esto es de Calamity" en toda la
                 paleta, ver el comentario de DebuffColor en Theme.xaml, y un error generico de
                 guardar/cargar no tiene nada que ver con Calamity - confundia las dos señales).
                 GlobalErrorMessage (cualquier accion real de cargar/guardar/deshacer, visible
                 desde cualquier pestaña, H-3) y Home.ActionErrorMessage (una accion fallida del
                 menu contextual de Inicio, INI-07) son dos avisos de error INDEPENDIENTES - se
                 apilan los dos a la vez si coinciden, nunca se pisan, mismo criterio real que ya
                 aplicaba el resto de la app antes de esta ronda (ej. "equipado" y "Calamity" en
                 el mismo slot, T-4/E-1). Ninguno de los dos se autocierra (regla real del propio
                 catalogo: "auto-cierre 6s SALVO error"). -->
            <Border Background="{StaticResource TealGradientBrush}"
                    IsHitTestVisible="False"
                    Visibility="{Binding SaveConfirmationVisible, Converter={StaticResource BoolToVis}}">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ToastCardBase}">
                        <Setter Property="Opacity" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SaveConfirmationVisible}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <!-- Grid, NO StackPanel Orientation=Horizontal a proposito (bug real encontrado y
                     arreglado en esta misma ronda, ver T7_SOLO/bitacora): un StackPanel mide sus
                     hijos con ancho INFINITO en el eje de apilado, asi que un TextBlock con
                     TextWrapping="Wrap" dentro nunca llega a envolver - se recorta contra el
                     MaxWidth del Border SIN reflujo, cortando el texto a la mitad. Con Grid la
                     columna de texto es "*" (el ancho real que sobra tras el icono/boton), asi
                     que SI puede envolver de verdad. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#10003;" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Loc[save_confirmation_title], Mode=OneWay}" FontSize="13.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Border Background="{StaticResource PinkGradientBrush}"
                    Visibility="{Binding GlobalErrorMessage, Converter={StaticResource EmptyToCollapsed}}">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ToastCardBase}">
                        <Setter Property="Opacity" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding GlobalErrorMessage, Converter={StaticResource EmptyToCollapsed}}" Value="Visible">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#9888;" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Text="{Binding GlobalErrorMessage}" FontSize="13.5" Foreground="White" VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="2" Content="✕" Style="{StaticResource CircleCloseButton}" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"
                            Command="{Binding DismissGlobalErrorCommand}" ToolTip="{Binding Loc[close_notice_tooltip], Mode=OneWay}" />
                </Grid>
            </Border>

            <Border Background="{StaticResource PinkGradientBrush}"
                    Visibility="{Binding Home.ActionErrorMessage, Converter={StaticResource NullToVis}}">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ToastCardBase}">
                        <Setter Property="Opacity" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Home.ActionErrorMessage, Converter={StaticResource NullToVis}}" Value="Visible">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#9888;" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Home.ActionErrorMessage}" FontSize="13.5" Foreground="White" VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

        <!-- X1 (I+D-PROXIMOS-PASOS-FAMILIA-KEEP.md, 16-sep-2026): aviso discreto de version
             nueva disponible en GitHub Releases - NUNCA un popup modal, una tarjeta pequeña en
             la esquina que se puede cerrar con un clic. Solo visible cuando la comprobacion real
             de fondo (MainViewModel.IniciarComprobacionDeActualizacion, disparada una vez desde
             MainWindow.xaml.cs) encuentra de verdad una version mas reciente publicada - nunca
             se muestra "por si acaso" ni mientras se esta comprobando. -->
        <Border Background="{StaticResource BgElevatedBrush}"
                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="8"
                Padding="14,10" MaxWidth="360"
                Effect="{StaticResource CardShadow}"
                Visibility="{Binding HayActualizacionDisponible, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{Binding MensajeActualizacion}" Style="{StaticResource CaptionText}"
                           TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" />
                <!-- Actualizacion en un clic (17-sep-2026): ActualizacionEstadoTexto es el ÚNICO
                     texto de estado real (progreso "Descargando... N%"/"Instalando..." mientras
                     ActualizandoEnCurso, o un error real como "sin instalador adjunto"/"no se
                     pudo completar" cuando NO llego a arrancar o fallo) - visible siempre que haya
                     contenido, independientemente de ActualizandoEnCurso, para que un error de
                     ActualizarAhora (ver MainViewModel.Actualizaciones.cs) que ocurre ANTES de
                     poner ActualizandoEnCurso=true (sin instalador adjunto, exe propio no
                     localizado) no se quede escrito pero invisible. -->
                <TextBlock Text="{Binding ActualizacionEstadoTexto}" Style="{StaticResource CaptionText}"
                           TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"
                           Visibility="{Binding ActualizacionEstadoTexto, Converter={StaticResource EmptyToCollapsed}}" />
                <!-- Dos estados excluyentes: los 3 botones normales mientras no hay nada en
                     marcha, o una barra de progreso real + Cancelar mientras ActualizandoEnCurso
                     es true. Ver MainViewModel.Actualizaciones.cs (ActualizarAhora) para el flujo
                     completo: descarga real con progreso real, verificacion de huella si GitHub
                     la publica, instalacion silenciosa y reinicio. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"
                            Visibility="{Binding ActualizandoEnCurso, Converter={StaticResource InverseBoolToVis}}">
                    <Button Content="{Binding Loc[update_dismiss], Mode=OneWay}"
                            Command="{Binding DescartarActualizacionCommand}"
                            Style="{StaticResource BarButton}" Padding="10,4" Margin="0,0,8,0" />
                    <Button Content="{Binding Loc[update_view_release], Mode=OneWay}"
                            Command="{Binding AbrirActualizacionCommand}"
                            Style="{StaticResource BarButton}" Padding="10,4" Margin="0,0,8,0" />
                    <Button Content="{Binding Loc[update_now], Mode=OneWay}"
                            Command="{Binding ActualizarAhoraCommand}"
                            Style="{StaticResource BarButton}" Padding="10,4"
                            Background="{StaticResource AccentBrush}" />
                </StackPanel>
                <Grid Margin="0,10,0,0"
                      Visibility="{Binding ActualizandoEnCurso, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Grid.Column="0" Height="6" Minimum="0" Maximum="1" VerticalAlignment="Center"
                                 Foreground="{StaticResource AccentBrush}"
                                 Value="{Binding ProgresoActualizacion, Mode=OneWay}" />
                    <Button Grid.Column="1" Content="{Binding Loc[action_cancel], Mode=OneWay}"
                            Command="{Binding CancelarActualizacionCommand}"
                            Style="{StaticResource BarButton}" Padding="10,4" Margin="8,0,0,0" />
                </Grid>
            </StackPanel>
        </Border>
        </StackPanel>
    </Grid>
</Window>
