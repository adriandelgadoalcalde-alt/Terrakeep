<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Terrakeep.App.Controls"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Paleta REAL de Terrasavr (2-sep-2026, segunda pasada estetica pedida explicitamente
         tras comprobar que la primera no captaba bien el espiritu del original) - no inventada
         ni sacada de tokens genericos de Fluent: extraida directamente de
         Terrasavr-Calamity-Beta\resources\app\local-site\overrides.css, la hoja de estilo real
         que reviste el Terrasavr autentico (violeta #6C63FF de acento, fondos azul-marino muy
         oscuros en vez de gris neutro, degradados en los botones fuertes, tarjetas con borde
         de color, sombras marcadas). Colores secundarios (teal/rosa/naranja) tomados de los
         botones flotantes reales de Terrasavr (cada accion con su propio color, no todo del
         mismo tono) - se usan aqui para dar variedad a las tarjetas de navegacion de Inicio,
         mismo espiritu. Rojo de Calamity sin tocar (ya establecido, concepto propio de este
         puerto que Terrasavr original no tiene). -->
    <Color x:Key="BgPrimaryColor">#10121c</Color>
    <Color x:Key="BgSecondaryColor">#171a26</Color>
    <Color x:Key="BgElevatedColor">#1e2233</Color>
    <Color x:Key="BgHoverColor">#262b40</Color>
    <Color x:Key="BgPressedColor">#2f3550</Color>
    <Color x:Key="BorderColor">#2a2f42</Color>
    <Color x:Key="BorderStrongColor">#3d4460</Color>
    <Color x:Key="TextPrimaryColor">#f0f1f8</Color>
    <Color x:Key="TextSecondaryColor">#8a8fa3</Color>
    <Color x:Key="AccentColor">#6C63FF</Color>
    <Color x:Key="AccentHoverColor">#8079ff</Color>
    <Color x:Key="AccentPressedColor">#5951e0</Color>
    <Color x:Key="AccentDeepColor">#4834d4</Color>
    <Color x:Key="AccentMutedColor">#2a2856</Color>
    <Color x:Key="CalamityColor">#C0392B</Color>
    <Color x:Key="TealColor">#00d2a6</Color>
    <Color x:Key="TealDeepColor">#00997a</Color>
    <Color x:Key="PinkColor">#ff5d8f</Color>
    <Color x:Key="PinkDeepColor">#c92a5e</Color>
    <Color x:Key="OrangeColor">#ffb84d</Color>
    <Color x:Key="OrangeDeepColor">#ff7a18</Color>
    <!-- Verde de "equipado" (pedido explicito 2-sep-2026) - deliberadamente distinto del Teal
         (ya reservado para "accion con exito", ej. el banner de guardado) para que ambos
         significados no se confundan. -->
    <Color x:Key="EquippedGreenColor">#3ddc6e</Color>
    <!-- Oro del Modo Maestro real (consulta a Opus, sexta pasada) - un punto real de la
         pulsación (255, masterColor*200, 0) que usa el propio juego en el HUD de Maestro
         (Main.cs:20109-20111, masterColor~=0.85), no inventado - se distingue de OrangeColor
         (solo aparece como contorno de panel, nunca dentro de un slot) para que ambas señales
         no se confundan. El 6º hueco (Experto) reutiliza PinkColor, ya existente. -->
    <Color x:Key="MasterGoldColor">#ffd24a</Color>
    <!-- H6-12 (sexta auditoria de Opus, "los buffs de Calamity no distinguen buff de debuff"):
         morado veneno/maldicion, deliberadamente distinto de CalamityColor (ya reservado para
         "esto es de Calamity", con o sin relacion a que sea bueno o malo) - un buff de Calamity
         puede llevar los dos puntos a la vez (mod + negativo), asi que tienen que ser colores
         que no se confundan entre si. -->
    <Color x:Key="DebuffColor">#9b59b6</Color>

    <SolidColorBrush x:Key="BgPrimaryBrush" Color="{StaticResource BgPrimaryColor}" />
    <SolidColorBrush x:Key="BgSecondaryBrush" Color="{StaticResource BgSecondaryColor}" />
    <SolidColorBrush x:Key="BgElevatedBrush" Color="{StaticResource BgElevatedColor}" />
    <SolidColorBrush x:Key="BgHoverBrush" Color="{StaticResource BgHoverColor}" />
    <SolidColorBrush x:Key="BgPressedBrush" Color="{StaticResource BgPressedColor}" />
    <SolidColorBrush x:Key="BorderBrush0" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentMutedBrush" Color="{StaticResource AccentMutedColor}" />
    <SolidColorBrush x:Key="CalamityBrush" Color="{StaticResource CalamityColor}" />
    <SolidColorBrush x:Key="DebuffBrush" Color="{StaticResource DebuffColor}" />
    <SolidColorBrush x:Key="TealBrush" Color="{StaticResource TealColor}" />
    <SolidColorBrush x:Key="PinkBrush" Color="{StaticResource PinkColor}" />
    <SolidColorBrush x:Key="OrangeBrush" Color="{StaticResource OrangeColor}" />
    <SolidColorBrush x:Key="EquippedGreenBrush" Color="{StaticResource EquippedGreenColor}" />
    <SolidColorBrush x:Key="MasterGoldBrush" Color="{StaticResource MasterGoldColor}" />

    <!-- Degradados reales (135deg en el CSS original -> equivalente en WPF con StartPoint/
         EndPoint en esquinas opuestas) - los botones fuertes de Terrasavr real nunca son de
         color plano, siempre en degradado. -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource AccentHoverColor}" Offset="0" />
        <GradientStop Color="{StaticResource AccentDeepColor}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="OrangeGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource OrangeColor}" Offset="0" />
        <GradientStop Color="{StaticResource OrangeDeepColor}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TealGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource TealColor}" Offset="0" />
        <GradientStop Color="{StaticResource TealDeepColor}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PinkGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource PinkColor}" Offset="0" />
        <GradientStop Color="{StaticResource PinkDeepColor}" Offset="1" />
    </LinearGradientBrush>
    <FontFamily x:Key="AppFont">Segoe UI Variable Display, Segoe UI</FontFamily>

    <!-- Dos niveles de sombra (real Terrasavr: 0 4px 14px en reposo -> 0 8px 20px al pasar el
         raton, mas marcada) - antes solo habia una sombra fija, sin la sensacion de que la
         tarjeta "sube" de verdad. -->
    <DropShadowEffect x:Key="CardShadow" Color="Black" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.28" />
    <DropShadowEffect x:Key="CardShadowHover" Color="Black" Direction="270" ShadowDepth="5" BlurRadius="18" Opacity="0.42" />
    <DropShadowEffect x:Key="AccentGlow" Color="{StaticResource AccentColor}" ShadowDepth="0" BlurRadius="16" Opacity="0.55" />

    <!-- T-H/F2 (segunda auditoria de Opus, Fable): "No hay FocusVisualStyle propio en un tema
         oscuro personalizado" - el rectangulo de foco de WPF por defecto es negro discontinuo,
         practicamente invisible sobre este tema (fondos ya oscuros de por si). Clave especial
         real de WPF (SystemParameters.FocusVisualStyleKey) - la recoge SOLA cualquier control
         que reciba el foco por teclado (Tab), sin tener que aplicarla control a control. -->
    <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" StrokeThickness="2" Stroke="{StaticResource AccentBrush}"
                               StrokeDashArray="1 2" SnapsToDevicePixels="True" RadiusX="3" RadiusY="3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- H5-14 (quinta auditoria de Opus): "ningun slot se puede alcanzar con tabulador ni
         flechas... las flechas deberian recorrer la rejilla como en el juego". Estilo implicito
         (sin x:Key, se aplica solo a TODO SlotGridPanel real de la app - Equipamiento/
         Inventario/Almacenes/Libreria/Libreria de buffs, sin tener que tocar cada sitio donde se
         usa) - Contained mantiene la navegacion por flechas DENTRO de esta rejilla concreta, no
         se escapa a la rejilla vecina ni al resto de la ventana. -->
    <Style TargetType="controls:SlotGridPanel">
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
    </Style>

    <!-- Catálogo de rediseño visual T5 (20-sep-2026): "escala de espaciado declarada" - a
         diferencia de tipografia/radios (comentario de abajo), Theme.xaml nunca tuvo una escala
         de margenes con nombre; Inicio por si sola mezcla 10, 12, 14, 16, 18, 20, 24 y 26 en la
         misma pestaña (comprobado real: MainWindow.xaml, Margin="0,10,0,24" l.2381, "0,0,0,26"
         y "0,0,0,12" varias veces l.2428-2570, "0,0,14,14" en las 7 tarjetas NavCardButton,
         "16,0,0,0" en cabeceras con doll). Sp1..Sp6 = 4/8/12/16/24/32 (progresion x2 real, no
         arbitraria) en dos sabores porque WPF no permite una clave compartida por dos tipos:
         Sp1..Sp6 como Thickness UNIFORME (uso directo en Margin/Padding="{StaticResource SpN}")
         y SpD1..SpD6 como Double (uso en Width/Height/CornerRadius/espaciados sueltos que no son
         Thickness). CUALQUIER margen/padding NUEVO debe partir de esta escala, igual que
         CUALQUIER FontSize nuevo parte de la de abajo - el barrido de los +100 sitios EXISTENTES
         que aun usan un numero suelto queda pendiente a proposito (coste M, "barrido guiado por
         KeepQA" segun el propio catalogo: retocar cada uno a mano sin verificar geometria real
         uno a uno seria el mismo barrido mecanico sin verificar que el comentario de tipografia
         de abajo ya rechaza). -->
    <Thickness x:Key="Sp1">4</Thickness>
    <Thickness x:Key="Sp2">8</Thickness>
    <Thickness x:Key="Sp3">12</Thickness>
    <Thickness x:Key="Sp4">16</Thickness>
    <Thickness x:Key="Sp5">24</Thickness>
    <Thickness x:Key="Sp6">32</Thickness>
    <sys:Double x:Key="SpD1">4</sys:Double>
    <sys:Double x:Key="SpD2">8</sys:Double>
    <sys:Double x:Key="SpD3">12</sys:Double>
    <sys:Double x:Key="SpD4">16</sys:Double>
    <sys:Double x:Key="SpD5">24</sys:Double>
    <sys:Double x:Key="SpD6">32</sys:Double>

    <!-- Tipografia. Auditoria de Opus, Bloque 5 (T-6/T-7/T-8): escala real, documentada aqui a
         proposito - los 4 pasos con nombre son la fuente de verdad (24/14/12.5/11), y deben
         preferirse siempre a un FontSize suelto nuevo en MainWindow.xaml. Las variantes locales
         que ya existen ahi (9-13.5, ~15 valores distintos) NO son descuido: son ajustes reales
         a huecos concretos mas pequeños que el paso estandar (una pildora, una fila de tabla
         densa, un boton superpuesto en una tarjeta) - se dejan tal cual en vez de forzar un
         barrido mecanico de +100 sitios sin verificar cada uno a mano, pero CUALQUIER FontSize
         nuevo que se añada debe partir de uno de estos 4 pasos (o de 9, el suelo real de
         legibilidad fijado en T-10) y solo bajar si el hueco real lo exige, nunca al azar.
         Misma logica para CornerRadius: 6 (controles normales: botones/campos) y 8 (tarjetas/
         paneles) son los dos pasos reales que ya predominan en Theme.xaml; 2-5 son variantes
         reales para acentos pequeños (barras de progreso, indicadores), 10 para paneles grandes
         destacados, 99 para pildoras/circulos - mismo criterio, no un barrido mecanico. -->
    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="SectionText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <!-- Catálogo de rediseño visual T10 (20-sep-2026): "tipografía que crece con el ancho" - el
         propio comentario de WindowSizeClass.Extra (arriba, R-10/H-09) ya reconocia que a 1920px+
         quedaba un 28-39% del ancho real sin usar; hasta hoy la escala de 4 pasos (linea 130) era
         fija a cualquier ancho. BodyText/CaptionText (los dos pasos mas usados, cientos de sitios)
         suben UN escalon real en WindowSizeClass.Extra via DataTrigger; TitleText/SectionText se
         dejan tal cual a proposito (24/14 ya leen bien a cualquier ancho, y son los que menos
         sitio ocupan). El binding sube por DataContext.SizeClass desde el Window ancestro (mismo
         patron real ya usado en MainWindow.xaml, ej. DataContext.Settings.IsCompactMode) en vez de
         asumir que el DataContext local expone SizeClass - funciona igual venga el TextBlock de
         donde venga en el arbol visual. Verificado con TIPO_SOLO=1 (Terrakeep.App.Tests/
         Program.cs): FontSize real medido a 1900px (Amplio, sin cambio) y 1920px/2500px (Extra,
         13.5/12) - ver bitacora.md. -->
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.SizeClass, RelativeSource={RelativeSource AncestorType=Window}}" Value="Extra">
                <Setter Property="FontSize" Value="13.5" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.SizeClass, RelativeSource={RelativeSource AncestorType=Window}}" Value="Extra">
                <Setter Property="FontSize" Value="12" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Ventana / controles base -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource BgPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource BgElevatedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"
                            Effect="{StaticResource CardShadow}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- T-D (segunda auditoria de Opus, Fable): "la barra de desplazamiento horizontal esta
         rota - Width="10" fijo y un Track sin Orientation (por defecto vertical) con
         IsDirectionReversed=True fijo, sin ningun trigger para el caso horizontal. El unico uso
         real (WorldMapScroll, el visor de mundo) sale como un muñon mal orientado - enmascarado
         porque el pan por arrastre funciona bien y nadie usa esa barra". Track en si YA se
         reorienta solo segun Orientation (mecanismo real de WPF, sin tocar nada aqui) - lo que
         faltaba de verdad era el tamaño (Width fijo tambien en horizontal, se quedaba en un
         hilo de 10px de ancho en vez de 10px de ALTO) y el sentido (IsDirectionReversed=True es
         correcto en vertical -arriba=0-, pero en horizontal invierte izquierda/derecha). -->
    <Style x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{StaticResource BorderStrongBrush}" CornerRadius="4" Margin="2" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="10" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Boton - ya no un cambio de color instantaneo: anima de verdad (Storyboard sobre un
         SolidColorBrush propio de cada instancia, no el recurso compartido - animar un
         StaticResource compartido "sangraria" a todos los botones que lo usan). Tag="Accent" =
         degradado violeta + LEVANTA 2px al pasar el raton (la firma visual mas caracteristica
         de los botones reales de Terrasavr, antes ausente del todo). Tambien hay Tag="Teal"/
         "Pink"/"Orange" para las mismas variantes con degradado de otro color (pedido
         implicito: que no todo sea del mismo tono, como hace el propio Terrasavr con sus
         botones flotantes). -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- CornerRadius="8" (corregido tras feedback directo del usuario, septima
                         pasada, segunda ronda: "era al reves... todos los botones como estaban
                         en la ventana de builds donde apretabas autoequipar" - un primer intento
                         puso esto a "999" para forzar pildora completa en TODOS los botones,
                         pero como este MISMO estilo base es el que ya usaba "Auto-equipar"
                         (Tag="Accent"), ese cambio tambien le cambio la forma AL PROPIO boton de
                         referencia que el usuario queria replicar - "Auto-equipar" dejo de
                         parecerse a si mismo. La forma real que le gustaba siempre fue esta
                         (esquinas redondeadas normales, NO pildora completa) - lo que hacia
                         "moderno" a Auto-equipar frente a los botones planos era el degradado/
                         elevacion/animacion (Tag), nunca la forma. -->
                    <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <Border.Background>
                            <SolidColorBrush x:Name="BdBrush" Color="{StaticResource BgElevatedColor}" />
                        </Border.Background>
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="BdLift" Y="0" />
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBrush" Storyboard.TargetProperty="Color"
                                                         To="{StaticResource BgHoverColor}" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBrush" Storyboard.TargetProperty="Color"
                                                         To="{StaticResource BgElevatedColor}" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBrush" Storyboard.TargetProperty="Color"
                                                         To="{StaticResource BgPressedColor}" Duration="0:0:0.05" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBrush" Storyboard.TargetProperty="Color"
                                                         To="{StaticResource BgHoverColor}" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                        <!-- Bug real arreglado 25-sep-2026 (handoff e5eaea9e-c261-4199-8e7d-060b6054f58d):
                             PersonajeMenuButton (MainWindow.xaml) abre su propio ContextMenu con clic
                             izquierdo pero no tenia NINGUN trigger que reaccionara a que ese menu
                             estuviera abierto (medido: BdBrush.Color identico en cerrado/abierto).
                             "Abierto" se lee visualmente como "pressed mantenido" - mismo lenguaje ya
                             establecido arriba (IsPressed). Tag="Open" via TrueToTagConverter
                             (IsPersonajeMenuOpen), mismo mecanismo real de Tag que ya usan las
                             variantes de color de abajo - ningun otro boton de la app usa este valor. -->
                        <Trigger Property="Tag" Value="Open">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBrush" Storyboard.TargetProperty="Color"
                                                         To="{StaticResource BgPressedColor}" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBrush" Storyboard.TargetProperty="Color"
                                                         To="{StaticResource BgElevatedColor}" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="Tag" Value="Accent">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentGradientBrush}" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Teal">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource TealGradientBrush}" />
                            <Setter Property="Foreground" Value="#06281f" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Pink">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PinkGradientBrush}" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Orange">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource OrangeGradientBrush}" />
                            <Setter Property="Foreground" Value="#1a1200" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <!-- AccentSoft/Ghost - pregunta a Opus sobre el diseño (2-sep-2026, quinta
                             pasada: "todo lo que sean botones... me gustaria que la estetica...
                             fuera la misma que la de aplicar build"). Jerarquia real en vez de
                             pintar los 5 botones señalados de Accent a secas (Minima/Media/Maxima
                             de Buffs, ★/Quitar de prefijo): Accent queda para LA accion principal
                             de cada panel (Maxima, ★) - AccentSoft para la alternativa de la MISMA
                             familia (Minima/Media: no son 3 acciones de peso distinto, son 3
                             valores del mismo control, un color por cada una leeria como un
                             semaforo con 3 significados que no existen) - Ghost para
                             destructiva/deshacer (Quitar prefijo, Vaciar slot: el degradado rosa
                             a pantalla completa convertiria "Quitar" en lo mas llamativo de un
                             panel de 300px). AccentSoft reusa AccentMutedBrush/AccentHoverBrush,
                             que ya significan "de la familia del acento pero secundario" en
                             PrefixGroupButton - Ghost es exactamente lo que el Background=
                             "Transparent" puesto a mano en varios sitios intentaba lograr y la
                             plantilla ignoraba (documentado ya en NavCardButton/ItemEditTemplate
                             - Background de un Button normal no hace nada, solo Tag). -->
                        <Trigger Property="Tag" Value="AccentSoft">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentMutedBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Ghost">
                            <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="Tag" Value="Ghost" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource PinkBrush}" />
                        </MultiTrigger>
                        <!-- El levantamiento (translateY(-2px) real de Terrasavr) solo se aplica a
                             las variantes de color solido al pasar el raton, no al boton gris
                             normal - asi se reserva el gesto mas llamativo para las acciones
                             importantes. TargetName solo es valido dentro de
                             ControlTemplate.Triggers (a diferencia de Style.Triggers, que dio
                             MC4011 al intentarlo ahi la primera vez). -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="Tag" Value="Accent" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BdLift" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BdLift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="Tag" Value="Teal" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BdLift" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BdLift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="Tag" Value="Pink" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BdLift" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BdLift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="Tag" Value="Orange" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BdLift" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BdLift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="Tag" Value="AccentSoft" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BdLift" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BdLift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- BarButton (consulta a Opus, septima pasada) - calco del Button base de arriba, pero con
         el ContentPresenter en HorizontalAlignment="Stretch" en vez de "Center". Hace falta para
         las cabeceras plegables "Librería"/"Librería de buffs": su contenido es un DockPanel con
         el texto a la izquierda y "▲ Plegar" anclado a la derecha (DockPanel.Dock="Right") - eso
         solo se ve bien si el DockPanel ocupa TODO el ancho real del boton. El Button base
         siempre centra su contenido (Center fijo en la plantilla, ignora el
         HorizontalContentAlignment="Stretch" que se le ponga en la instancia - el mismo tipo de
         gotcha ya documentado varias veces en este archivo: la plantilla manda, no la propiedad
         puesta a mano), asi que sin este estilo aparte el DockPanel se encogeria al ancho de su
         contenido y "▲ Plegar" dejaria de estar pegado al borde derecho real. NO se usa en
         "Colocar" ni en la fila de NPC del Explorador (ninguno de los dos necesita estirar su
         contenido). -->
    <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <Border.Background>
                            <SolidColorBrush x:Name="BdBrush" Color="{StaticResource BgElevatedColor}" />
                        </Border.Background>
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="BdLift" Y="0" />
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBrush" Storyboard.TargetProperty="Color"
                                                         To="{StaticResource BgHoverColor}" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBrush" Storyboard.TargetProperty="Color"
                                                         To="{StaticResource BgElevatedColor}" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="Tag" Value="Accent">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentGradientBrush}" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Ghost">
                            <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="Tag" Value="Ghost" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource PinkBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TextBox - estilo "filled": fondo solido, esquinas redondeadas solo arriba, raya
         inferior que se anima al color de acento y se engorda al enfocar. -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BgElevatedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentMutedBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6,6,0,0" />
                        <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" Background="{StaticResource BorderStrongBrush}" />
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Underline" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Underline" Property="Height" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox - mismo lenguaje "filled" que TextBox, lista desplegable oscura con la
         opcion activa marcada en acento. -->
    <Style x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Bd" Background="{StaticResource BgElevatedBrush}" CornerRadius="6,6,0,0" />
                        <Border Height="2" VerticalAlignment="Bottom" Background="{StaticResource BorderStrongBrush}" x:Name="Underline" />
                        <Path x:Name="Arrow" Data="M0,0 L4,4 L8,0" Stroke="{StaticResource TextSecondaryBrush}"
                              StrokeThickness="1.6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Underline" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Margin="3,1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentMutedBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource BgElevatedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleBtn" Style="{StaticResource ComboBoxToggleButton}"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Focusable="False" ClickMode="Press" />
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                          HorizontalAlignment="Left" />
                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                                    BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" Padding="0,4"
                                    MinWidth="{TemplateBinding ActualWidth}" Effect="{StaticResource CardShadow}"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer MaxHeight="280" SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ContextMenu/MenuItem - pregunta a Opus sobre el diseño (2-sep-2026, quinta pasada:
         "el menú este de clic derecho de todo terrakeep es horrendo no va nada acorde con la
         estética de terrakeep"). Antes NINGUN Style para estos dos - cada menu contextual de
         la app (Inventario/Almacenes/Equipamiento/Monturas/Monedas/Buffs) usaba el menu blanco
         por defecto de Windows, sin relacion con la paleta oscura real. Mismo lenguaje que ya
         usa la Popup del ComboBox de arriba (fondo BgSecondaryBrush, borde BorderStrongBrush,
         esquinas redondeadas, CardShadow) - Theme.xaml esta fusionado en Application.Resources
         (App.xaml), asi que estos dos estilos implicitos arreglan TODA la app de golpe, sin
         tocar cada ContextMenu uno a uno.
         Gotcha real de WPF: HasDropShadow="True" es obligatorio aunque se ponga un Effect
         propio - WPF deriva el AllowsTransparency del Popup interno de esa propiedad, y con
         False el CornerRadius queda recortado contra un rectangulo opaco (4 esquinas negras
         visibles). MinWidth real en el Border (no en el Style) es lo que arregla de raiz "el
         recuadro rectangular super pequeño que no sirve de nada" (un menu de 1 solo MenuItem
         media lo que media ese item solo, a veces casi nada). -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource BgSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="0,4"
                            Margin="4" MinWidth="170" Effect="{StaticResource CardShadow}" SnapsToDevicePixels="True">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Margin="3,1" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" ContentSource="Icon" VerticalAlignment="Center" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="12,0,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CheckBox - cuadrado pequeño redondeado, relleno de acento con marca de verificacion. -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="5"
                                Background="Transparent" BorderThickness="1.4" BorderBrush="{StaticResource BorderStrongBrush}"
                                VerticalAlignment="Center">
                            <Path x:Name="Check" Data="M1,5 L4.2,8.4 L10.5,1" Stroke="White"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentGradientBrush}" />
                            <!-- Bug real encontrado y arreglado al verificar D-d/D-e con el arnes UIA
                                 (segunda auditoria de Opus, Fable) - primera vez que este arnes marcaba
                                 un CheckBox real de verdad: "AccentColor" es un Color (#6C63FF), no un
                                 Brush - BorderBrush exige un Brush. WPF lo tolera como VALOR LITERAL en
                                 un atributo XAML (conversion implicita al analizar), pero NO dentro de
                                 un Setter de un Trigger en tiempo de ejecucion real - DispatcherUnhandledException
                                 real ("#FF6C63FF no es un valor valido para BorderBrush"), silenciada por
                                 el manejador global de la app (no tumbaba la ventana) asi que llevaba
                                 tiempo sin notarse: CADA CheckBox marcado de toda la app perdia su borde
                                 de color de acento en silencio. AccentBrush (ya definido, mismo patron
                                 que el Trigger de arriba) en vez de AccentColor. -->
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RadioButton - circulo con punto de acento cuando esta seleccionado. -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="18" Height="18" VerticalAlignment="Center">
                            <Ellipse x:Name="Ring" Stroke="{StaticResource BorderStrongBrush}" StrokeThickness="1.4" />
                            <Ellipse x:Name="Dot" Width="9" Height="9" Fill="{StaticResource AccentBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider - pista fina, tramo recorrido en acento, pomo circular que crece al pasar el
         raton. -->
    <Style x:Key="SliderThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse x:Name="Th" Width="14" Height="14" Fill="{StaticResource AccentBrush}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Th" Property="Width" Value="17" />
                            <Setter TargetName="Th" Property="Height" Value="17" />
                            <Setter TargetName="Th" Property="Fill" Value="{StaticResource AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Th" Property="Fill" Value="{StaticResource AccentPressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="Height" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="4" Background="{StaticResource BorderBrush0}" CornerRadius="2" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Background="Transparent" BorderThickness="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" Background="{StaticResource AccentBrush}" CornerRadius="2" VerticalAlignment="Center" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Background="Transparent" BorderThickness="0" Opacity="0" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nav rail izquierda - indicador de seleccion = barra vertical de acento, fondo elevado
         detras del item activo.
         Catalogo de rediseño visual T1 (20-sep-2026, "rail con iconos, agrupada y colapsable"):
           - GroupDivider: filete real (BorderBrush0) ANTES del item, mostrado solo cuando el
             propio TabItem lleva Tag="GroupStart" (mismo mecanismo real ya usado en la app para
             variantes de Button - Tag="Accent"/"Orange"/"Ghost" - aplicado aqui a agrupar la
             rail sin tocar el ORDEN real de las 8 pestañas ni AppTab.cs: reordenar de verdad
             (mover Novedades/Acerca de al pie) tocaria el enum AppTab, los atajos Ctrl+1..8 y
             docenas de pruebas reales que asumen SelectedTabIndex por posicion - LIMITE real de
             esta ronda, documentado en bitacora, no en silencio). Con el orden actual
             (Inicio/Personaje/Builds/Novedades/Exploracion/AcercaDe/Guia/Servidor) el filete real
             separa Novedades de Builds y Guia de AcercaDe - dos bloques reales en vez del unico
             bloque plano de antes, sin ningun riesgo de reordenar nada.
           - Label (el ContentPresenter de Header) se colapsa en WindowSizeClass.Compacto -
             binding por DataContext.SizeClass del Window ancestro (mismo patron real ya usado en
             T10/Theme.xaml), asi que el icono/texto que trae CADA TabItem.Header no necesita
             saber nada de SizeClass el mismo (ContentPresenter no admite DataTrigger propio
             sobre una propiedad ajena, asi que el colapso vive en el icono+texto de cada Header
             en MainWindow.xaml, ver el Style NavRailLabel de abajo, no aqui). -->
    <Style x:Key="NavTabItem" TargetType="TabItem">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Padding" Value="16,11" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <StackPanel>
                        <Border x:Name="GroupDivider" Height="1" Background="{StaticResource BorderBrush0}"
                                Margin="16,6,16,7" Visibility="Collapsed" />
                        <Grid Margin="8,2">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <DockPanel>
                                    <Border x:Name="Indicator" DockPanel.Dock="Left" Width="3" CornerRadius="2"
                                            Background="{StaticResource AccentBrush}" Margin="-16,-2,10,-2" Opacity="0" />
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="GroupStart">
                            <Setter TargetName="GroupDivider" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgElevatedBrush}" />
                            <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Etiqueta de texto de cada item de la rail - el icono (20px) que va SIEMPRE visible vive
         directo en el Header de cada TabItem en MainWindow.xaml (no hace falta un estilo propio,
         es un TextBlock suelto sin FontSize de la escala normal). Esta se colapsa en
         WindowSizeClass.Compacto (rail a 56px, MainViewModel.RailWidth) - queda solo el icono,
         mismo criterio real que hace independiente del idioma a la rail en ese modo. -->
    <Style x:Key="NavRailLabel" TargetType="TextBlock">
        <Setter Property="Margin" Value="10,0,0,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.SizeClass, RelativeSource={RelativeSource AncestorType=Window}}" Value="Compacto">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NavTabControl" TargetType="TabControl">
        <Setter Property="TabStripPlacement" Value="Left" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource NavTabItem}" />
        <Setter Property="Padding" Value="0" />
        <!-- T1: StackPanel en vez del TabPanel implicito por defecto - a TabStripPlacement=Left
             el TabPanel de WPF solo aporta logica de solape/prioridad de ancho que aqui no hace
             falta (la rail nunca compite por ancho horizontal entre pestañas, se apilan en
             vertical sin mas) y NO admite Width fijo real sin ese mismo comportamiento raro; un
             StackPanel vertical simple SI respeta Width="{Binding RailWidth}" de abajo tal cual. -->
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" Width="{Binding RailWidth}" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pestañas internas - pastilla real de Terrasavr (fondo alfa-tintado de acento + borde
         de acento cuando esta activa, ver .tsx-tab.active del CSS real: background:
         #6C63FF22; border-color: #6C63FF) en vez del subrayado plano anterior. -->
    <Style x:Key="InnerTabItem" TargetType="TabItem">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="12,7" />
        <!-- Auditoria de redimensionado, R-09/H-10: hallazgo real distinto al diagnostico
             original (que atribuia esto a "TemplateBinding duplica el Margin del Setter").
             Aislado con un experimento directo (Margin=0 en el Setter -> clip.Bounds=null,
             CUALQUIER Margin no nulo en el TabItem -> clip = exactamente ese Margin, sea o no
             doble): TabPanel.ArrangeOverride no reserva hueco para el Margin real de sus HIJOS
             directos (los TabItem) - le da a cada uno un rect que ya excluye lo que su margen
             va a restar despues, asi que el Arrange normal de WPF (finalRect - margin) siempre
             recorta exactamente el margen, sea uno o dos. La correccion real: SIN Margin en el
             TabItem (Setter de aqui, siempre en 0 - TabPanel no puede recortar lo que no
             tiene), el hueco visual entre pastillas se consigue con un Margin real DENTRO de la
             plantilla (en el Border de abajo) - ese SI se arregla con normalidad (lo mide/resta
             el propio ContentPresenter/Border, ajeno a la rareza de TabPanel). -->
        <Setter Property="Margin" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" Margin="0,0,6,4" Padding="{TemplateBinding Padding}"
                            CornerRadius="8" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentMutedBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="InnerTabControl" TargetType="TabControl">
        <Setter Property="TabStripPlacement" Value="Top" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource InnerTabItem}" />
    </Style>

    <!-- Fondo de "hueco vacio" (pregunta a Opus sobre el diseño, 2-sep-2026 - segunda consulta:
         "las cajas vacías... el fondo podria diferenciar-se un poco mas de las que tienen
         objetos"). Antes solo se atenuaba el slot vacio entero con Opacity 0.35 sobre el mismo
         BgElevatedBrush de siempre - compuesto sobre el fondo real del panel (BgSecondaryBrush
         #171a26) la diferencia lleno/vacio quedaba en ~5-8 por canal, invisible en un tema
         oscuro. En vez de atenuar, invierte la elevacion: lleno = BgElevatedBrush (mas claro que
         el panel, "sobresale"), vacio = BgPrimaryBrush (mas oscuro que el panel, "se hunde") -
         mismo idioma visual que un hueco real, con un token ya existente en la paleta, sin
         opacidad de por medio (por eso los DataTrigger de Opacity que hacian esto antes en
         MainWindow.xaml se han quitado). -->

    <!-- Catálogo de rediseño visual T7 (20-sep-2026): "sistema único de avisos (toasts)". Antes
         real: tres formas distintas para el mismo concepto (banner flotante degradado teal de
         guardado, banner flotante plano CalamityBrush de error, tarjeta inline con borde
         PinkBrush solo en Inicio) - la tarjeta de "hay actualización" quedaba ademas tapando la
         pestaña Exploración/Apariencia en algunas resoluciones porque no compartia ningun
         contenedor con las demas. Cambio real: un unico ToastHost (StackPanel abajo a la derecha,
         ver el final de MainWindow.xaml, DENTRO del mismo StackPanel que la tarjeta de
         actualizacion para que las dos pilas se apilen SIN solaparse nunca, se muestre la que se
         muestre) con solo dos variantes reales necesarias hoy (extremos error/rosa y exito/teal;
         "aviso/naranja" queda declarado aqui para el dia que haga falta un tercero, mismo
         criterio que la escala de espaciado de arriba: declarar antes de que exista el primer
         consumidor no es sobra, es la misma disciplina). Solo la parte VISUAL cambia - las
         propiedades reales que disparan cada aviso (SaveConfirmationVisible/GlobalErrorMessage/
         HomeViewModel.ActionErrorMessage) siguen siendo las mismas de siempre, sin tocar ninguna
         de las docenas de sitios reales que ya las escriben. -->
    <Style x:Key="ToastCardBase" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="Effect" Value="{StaticResource CardShadow}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="MaxWidth" Value="360" />
    </Style>

    <!-- Tarjeta compacta de slot - usada por los 9 contenedores reales de la app
         (Equipamiento/Inventario/Almacenes/Monturas/Monedas, tercera pasada de diseño tras
         feedback directo del usuario: "equipamiento no tiene el mismo formato que inventario y
         el resto de las 9 pestañas"). Sin Width/Height fijos - los da SlotGridPanel al hacer
         Arrange (celda cuadrada con suelo/techo real), este estilo solo pone el aspecto visual. -->
    <Style x:Key="ItemSlotCardCompact" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{StaticResource BgElevatedBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush0}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BgHoverBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                <Setter Property="Background" Value="{StaticResource BgPrimaryBrush}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsEmpty}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource BgElevatedBrush}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Panel lateral persistente (Editar/Librería) - equivalente real del sideCtr de
         app.TabInventory, pedido explicito 1-sep-2026 ("acompaña desde Equipamiento hasta
         Forja del Vacio"). -->
    <Style x:Key="SidePanelCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush0}" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!-- FASE D del responsive global, correcciones D-01/D-05/D-07 del revisor visual (28-sep-2026): UNA sola
         regla de composicion para el panel Editar de Objetos y el de Buffs (s10: "no mantener dos
         arquitecturas diferentes sin motivo"), dentro de su rejilla de 2 filas (contenido / Libreria) x 2
         columnas (* / 300). MainViewModel.IsEditarBarraCompleta (SizeClass != Compacto):
           - true: barra lateral de alto completo (RowSpan 2), alta SEGUN SU CONTENIDO (VerticalAlignment Top;
             D-07: sin seleccion a 2560x1440 era una caja de 300x1245 con solo la leyenda);
           - false (Compacto): solo la fila de contenido, a su mismo alto (Margin inferior 8 como la rejilla
             de al lado) y la Libreria a ancho completo debajo (LibreriaComposicion). -->
    <Style x:Key="EditarTarjetaComposicion" TargetType="Border" BasedOn="{StaticResource SidePanelCard}">
        <Setter Property="Grid.Column" Value="1" />
        <Setter Property="Grid.Row" Value="0" />
        <Setter Property="Grid.RowSpan" Value="1" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.IsEditarBarraCompleta, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter Property="Grid.RowSpan" Value="2" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Margin" Value="0" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="LibreriaComposicion" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Grid.Column" Value="0" />
        <Setter Property="Grid.ColumnSpan" Value="2" />
        <Setter Property="Margin" Value="0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.IsEditarBarraCompleta, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter Property="Grid.ColumnSpan" Value="1" />
                <Setter Property="Margin" Value="0,0,10,0" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- REAPERTURA (25-sep-2026, TASK CONTEXT e5eaea9e-c261-4199-8e7d-060b6054f58d): el "Style"
         unico "StatusPillCaption" (24-sep-2026, ver historial mas abajo en bitacora.md) resolvia
         la inconsistencia de GEOMETRIA (Padding/CornerRadius distintos sin criterio) pero el
         usuario reabrio el punto de verdad: forzar TODOS los badges a la misma capsula pastilla
         no es la intencion visual real, cada badge cumple un PAPEL distinto y debe LEERSE
         distinto de un vistazo, no fundirse en un unico lenguaje. Rediseno real aprobado por el
         arquitecto: 4 familias visuales separadas, cada una con su propia geometria e invariante,
         sustituyendo "StatusPillCaption" por completo (retirado, cero usos tras este cambio).
         - StateTagNeutral: estado INFORMATIVO puro (p.ej. "Solo lectura", "Solo valido para
           <Slot>") - borde fino sin relleno, sin competir con nada, CornerRadius=6 (nunca 99):
           es una ETIQUETA, no una capsula de metrica.
         - MetricAccentText: una METRICA/recuento real (p.ej. "N diferencia(s)") - SIN Border
           propio, el numero manda por si mismo (violeta de marca + SemiBold); el contorno lo da
           una barra de acento vertical al lado, no una capsula que lo encierre.
         - SemanticStateChip: estado SEMANTICO por color (zona del mapa, tipo de objeto) - fondo
           NEUTRO fijo (BgElevatedBrush) para cualquier variante, con el color real (dot/borde) en
           vez de en el fondo, para que el chip sea legible igual sin importar el matiz semantico.
         - HeroKpiPill: UNICA familia que conserva la capsula "pill" (CornerRadius=99) - vive
           ENCIMA de AccentGradientBrush en la tarjeta hero de Inicio, un contexto de contraste
           distinto (overlay translucido sobre fondo de acento propio) donde la capsula si aporta
           separacion visual real. -->
    <Style x:Key="StateTagNeutral" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush0}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="6,3" />
    </Style>

    <Style x:Key="MetricAccentText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SemanticStateChip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgElevatedBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <SolidColorBrush x:Key="HeroKpiOverlayBrush" Color="#26FFFFFF" />
    <Style x:Key="HeroKpiPill" TargetType="Border">
        <Setter Property="CornerRadius" Value="99" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Background" Value="{StaticResource HeroKpiOverlayBrush}" />
    </Style>

    <!-- Botones "meta" (Biblioteca/Positivos/Negativos) y "grupo" (Cuerpo a cuerpo +/...) del
         selector de prefijo real (app.TabEdit btMeta/btGroups) - pastilla pequeña, acento
         solido cuando esta seleccionado en vez del fondo gris por defecto. -->
    <!-- PrefixMetaButton/PrefixGroupButton (consulta a Opus, septima pasada - "estos botones...
         me parecen muy horrendos... me gustaria algo mas moderno"): YA eran una pildora
         perfecta (CornerRadius="99", plantilla propia) - lo que los hacia planos/aburridos
         frente al boton "Auto-equipar" no era la forma, era la ausencia de degradado/
         elevacion/animacion (fondo solido a secas, sin las Trigger/ColorAnimation/
         TranslateTransform que el Button base ya tiene escritas para Tag="Accent"/
         "AccentSoft"). En vez de duplicar esa plantilla aqui otra vez, BasedOn del Button base
         (que ya sale en pildora completa, ver su propio comentario) y IsSelected se traduce a
         Tag en vez de pintar Background/Foreground a mano (Tag es lo unico que la plantilla
         base entiende de verdad - Background puesto a mano no hace nada, ver la nota historica
         de ItemEditTemplate/NavCardButton). Cero duplicacion: cualquier mejora futura del boton
         base (sombra, nuevo Tag...) llega aqui gratis. -->
    <Style x:Key="PrefixMetaButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="Margin" Value="0,0,5,5" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Tag" Value="Accent" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- AccentSoft en vez de Accent al seleccionar (no Accent a secas): son varios botones del
         mismo grupo compitiendo por atencion (ej. "Vista: Armadura/Vanidad/Tintes") - mismo
         criterio ya establecido para Minima/Media de Buffs, "de la familia del acento pero
         secundario". -->
    <Style x:Key="PrefixGroupButton" TargetType="Button" BasedOn="{StaticResource PrefixMetaButton}">
        <Setter Property="FontSize" Value="10.5" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Tag" Value="AccentSoft" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Pastillas de filtro de la Libreria (Rareza/Tipo de daño/Ranura de equipo, 13-sep-2026) -
         mismo mecanismo real que PrefixGroupButton (BasedOn del Button base, IsSelected->Tag en
         vez de pintar Background/Foreground a mano) para heredar gratis el degradado/sombra/
         animacion ya escritos ahi - la unica diferencia real es que estas pastillas ademas
         pueden llevar un punto de color (el Ellipse de LibraryFilterChipTemplate en
         MainWindow.xaml, no parte de este Style). -->
    <Style x:Key="LibraryFilterChipButton" TargetType="Button" BasedOn="{StaticResource PrefixGroupButton}">
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- H4-11 (cuarta auditoria de Opus, Fable): "el selector de versión usa otro lenguaje
         visual que el resto de selectores" - los botones de VersionOption pintaban Background/
         FontWeight a mano en un Style inline en MainWindow.xaml (el mismo error historico que
         PrefixMetaButton ya documenta arriba: pintar a mano no anima ni tiene degradado/
         elevacion). Mismo mecanismo real que PrefixMetaButton - solo cambia el nombre de la
         propiedad de origen (IsCurrent en vez de IsSelected, VersionOption no comparte tipo con
         PrefixMetaButtonViewModel). -->
    <Style x:Key="VersionOptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="Margin" Value="0,0,5,5" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter Property="Tag" Value="Accent" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- FASE D del responsive global (28-sep-2026): pastillas de categoria de la familia "catalogo con
         categorias" (Views/NavegadorCategorias.xaml y Views/TarjetasCategoriasRaiz.xaml). Aqui y no en el
         UserControl porque las usan los dos controles. -->
        <Color x:Key="NavCatSeleccionColor">#4834d4</Color>
        <SolidColorBrush x:Key="NavCatSeleccionBrush" Color="{StaticResource NavCatSeleccionColor}" />

        <!-- Pastilla base: plantilla propia (no el Button por defecto de WPF, cuyo cromo Aero pintaba el
             azul claro de hover bajo texto claro - el hallazgo de contraste del revisor de la FASE C).
             Estados por Tag, cada uno con contraste medido (texto sobre su fondo real):
               normal  TextPrimary #f0f1f8 sobre BgElevated #1e2233  ~14:1
               Ruta    TextPrimary #f0f1f8 sobre AccentMuted #2a2856 + borde de acento  ~12:1
               Sel     blanco sobre #4834d4 (AccentDeep, misma familia del acento)  ~7,7:1
             (antes: AccentBrush #6C63FF sobre AccentMuted #2a2856 = 3,17:1). -->
        <!-- Correccion D-06 del revisor visual de la FASE D: alto UNICO de 24px para todas las pastillas de
             la familia (antes 20px con icono y 18,6px sin el - "Ver todo", subpastillas de las tarjetas,
             desplegable), objetivo de clic comodo y filas alineadas. MinHeight, no Height: un nombre largo
             que envuelva sigue creciendo (s34). -->
        <Style x:Key="PastillaCategoriaBase" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="Margin" Value="0,0,4,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource BgElevatedBrush}" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="12" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Ruta">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentMutedBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Sel">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavCatSeleccionBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource NavCatSeleccionBrush}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PastillaCategoria" TargetType="Button" BasedOn="{StaticResource PastillaCategoriaBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInSelectedPath}" Value="True">
                    <Setter Property="Tag" Value="Ruta" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Tag" Value="Sel" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PastillaVerTodo" TargetType="Button" BasedOn="{StaticResource PastillaCategoriaBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedCategory}" Value="{x:Null}">
                    <Setter Property="Tag" Value="Sel" />
                </DataTrigger>
            </Style.Triggers>
        </Style>


    <!-- Tarjeta de navegacion clicable (pagina de Inicio) - anima de verdad al pasar el raton
         (antes solo cambiaba el color al instante): sube 3px, la sombra crece, el borde se
         tiñe del color de acento QUE SE LE PASE (Tag) - permite reproducir la variedad de
         color real de los FABs de Terrasavr (cada tarjeta puede llevar Tag="Accent"/"Teal"/
         "Pink"/"Orange" y su borde/icono de hover cambia a ese color en vez de ser siempre
         violeta). -->
    <Style x:Key="NavCardButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BgSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12"
                            BorderThickness="1" Padding="18" Effect="{StaticResource CardShadow}">
                        <Border.BorderBrush>
                            <SolidColorBrush x:Name="BdBorderBrush" Color="{StaticResource BorderColor}" />
                        </Border.BorderBrush>
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="BdLift" Y="0" />
                        </Border.RenderTransform>
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHoverBrush}" />
                            <Setter TargetName="Bd" Property="Effect" Value="{StaticResource CardShadowHover}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BdLift" Storyboard.TargetProperty="Y" To="-3" Duration="0:0:0.15" />
                                        <ColorAnimation Storyboard.TargetName="BdBorderBrush" Storyboard.TargetProperty="Color"
                                                         To="{StaticResource AccentColor}" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BdLift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.15" />
                                        <ColorAnimation Storyboard.TargetName="BdBorderBrush" Storyboard.TargetProperty="Color"
                                                         To="{StaticResource BorderColor}" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgPressedBrush}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Teal">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBorderBrush" Storyboard.TargetProperty="Color"
                                                         To="{StaticResource TealColor}" Duration="0" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                        <Trigger Property="Tag" Value="Pink">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBorderBrush" Storyboard.TargetProperty="Color"
                                                         To="{StaticResource PinkColor}" Duration="0" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                        <Trigger Property="Tag" Value="Orange">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBorderBrush" Storyboard.TargetProperty="Color"
                                                         To="{StaticResource OrangeColor}" Duration="0" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bug real de UI (pedido explicito del usuario, no reproducido nunca por el arnes -
         "Border + MouseBinding LeftClick" no tiene precedente de raton simulado, solo se
         invocaba el Command a mano): una fila clicable dentro de un Popup StaysOpen="False"
         (el panel "¿Donde lo tengo?") usando MouseBinding en vez de un Button real dejaba la
         interfaz bloqueada tras el clic real - MouseBinding no captura/libera el raton como un
         Button real (OnMouseLeftButtonDown/Up), y si el propio clic hace que el Popup se
         cierre (nuestro caso: el Command ejecutado cierra IsWhereIsItOpen) mientras el Popup
         desmonta su arbol visual a mitad del enrutado del evento de raton, la captura/el foco
         se quedan colgados de un elemento que ya no existe - gotcha real y conocido de WPF con
         Popup+StaysOpen=False+contenido clicable sin un Button real de por medio. Un Button
         real SI hace ese ciclo de captura/liberacion correctamente. Misma apariencia visual que
         el Border de antes (fondo/CornerRadius/hover), solo cambia el mecanismo de clic. -->
    <Style x:Key="RowClickButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BgElevatedBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Boton circular pequeño (cerrar/quitar/vaciar) - gira 90 grados y se tiñe de rojo al
         pasar el raton, gesto real de Terrasavr (.tsx-close-btn:hover { background: #ff4d4d;
         transform: rotate(90deg) }) que antes no existia en absoluto (los botones "X" solo
         cambiaban de color, sin ningun movimiento). -->
    <Style x:Key="CircleCloseButton" TargetType="Button">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="99" Background="Transparent">
                        <Border.RenderTransform>
                            <RotateTransform x:Name="BdRotate" Angle="0" CenterX="11" CenterY="11" />
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource PinkBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BdRotate" Storyboard.TargetProperty="Angle" To="90" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BdRotate" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Encargo del usuario 4-sep-2026: "quiero que cambies todos los botones de exploracion
         esos ovalados por algo que realmente vaya con la estetica como el boton de cargar
         personaje o el de cargar mundo pero que se diferencien un poco de botones principales
         claro" - ver ESPEC-sprites-botones-badges.md#B.
         Antes eran CategoryPill/CategoryChip, dos plantillas con CornerRadius="99" (pildora
         completa) que no se parecian a NINGUN otro boton de la app. La forma correcta es la
         MISMA que el estilo base de Button (CornerRadius="8"): el propio Theme.xaml ya documenta
         (ver el comentario de la plantilla de Button) que el usuario corrigio a mano un intento
         anterior de convertir todos los botones en pildoras, porque eso le cambiaba la forma al
         propio "Auto-equipar", que era el boton de referencia que queria replicar.
         Lo que los DIFERENCIA de un boton de accion es que no van rellenos: contorno en reposo,
         relleno de acento suave (AccentMutedBrush, la misma pareja que Tag="AccentSoft" ya usa
         para "de la familia del acento pero secundario") solo cuando estan marcados. Y NUNCA
         llevan la elevacion de 2px, que este tema reserva a las acciones principales.
         El BorderThickness es 1 en los CUATRO estados y solo cambia de color: subirlo a 2 al
         marcar movería el texto y haria "saltar" la fila entera del WrapPanel. -->
    <Style x:Key="CategorySelector" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="11,5" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{StaticResource BorderStrongBrush}"
                            Padding="{TemplateBinding Padding}">
                        <!-- SolidColorBrush propio de la instancia, igual que la plantilla de
                             Button: animar un StaticResource compartido sangraria a todos. -->
                        <Border.Background>
                            <SolidColorBrush x:Name="BdBrush" Color="{StaticResource BgSecondaryColor}" />
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBrush" Storyboard.TargetProperty="Color"
                                                        To="{StaticResource BgHoverColor}" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBrush" Storyboard.TargetProperty="Color"
                                                        To="{StaticResource BgSecondaryColor}" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- IsChecked va DESPUES de IsMouseOver a proposito: al fijar
                             Bd.Background se sustituye el pincel entero (incluido el animado),
                             mismo mecanismo real que ya usa Tag="Accent" en la plantilla de
                             Button. Al desmarcar se recupera solo el pincel animado. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentMutedBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sub-nivel del anterior: MISMA paleta y MISMA plantilla, solo mas compacto (asi la
         jerarquia se lee por tamaño, sin meter un tercer color). TargetType="ToggleButton" a
         proposito, no RadioButton: se aplica igual a los ToggleButton de multiseleccion (los 3
         chips de NPCs) y a los RadioButton de vista (Cofres, Objetos), porque RadioButton deriva
         de ToggleButton y WPF acepta un Style cuyo TargetType sea una clase base - ya estaba asi
         en produccion con el CategoryChip anterior, no es un accidente. -->
    <Style x:Key="ViewSelector" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{StaticResource BorderStrongBrush}"
                            Padding="{TemplateBinding Padding}">
                        <Border.Background>
                            <SolidColorBrush x:Name="BdBrush" Color="{StaticResource BgSecondaryColor}" />
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBrush" Storyboard.TargetProperty="Color"
                                                        To="{StaticResource BgHoverColor}" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBrush" Storyboard.TargetProperty="Color"
                                                        To="{StaticResource BgSecondaryColor}" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentMutedBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
