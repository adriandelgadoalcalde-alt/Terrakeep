<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Terrakeep.Core\Terrakeep.Core.csproj" />
    <!-- Fase B (15-sep-2026): pestaña "Servidor" - hosting real de un servidor dedicado de
         Terraria/tModLoader desde dentro de Terrakeep, reutilizando ServidorKeep.Core TAL CUAL
         (Job Objects, generador de serverconfig.txt, Firewall automatico, catalogo de mods) en
         vez de reimplementar esa logica ya construida y verificada la noche del 15-sep-2026 -
         ver Downloads\ServidorKeep\bitacora.md. Referencia de proyecto cruzada entre los dos
         repos de la familia Keep (misma maquina, mismo TargetFramework net10.0-windows) - no es
         un paquete NuGet porque ServidorKeep no se publica como tal, es otro producto hermano. -->
    <ProjectReference Include="..\..\..\ServidorKeep\ServidorKeep.Core\ServidorKeep.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <ApplicationIcon>Assets\branding\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Nombre real del binario compilado (Terrakeep.exe/.dll) - independiente del nombre del
         proyecto/namespace C# (Terrakeep.App desde el 7-sep-2026, antes TerrasavrNative.App;
         cambiar el nombre del proyecto/namespace afecta a carpetas y referencias de proyecto en
         todo el solution, es un movimiento aparte de este AssemblyName). Antes el .exe se
         llamaba TerrasavrNative.App.exe pese a que Product/AssemblyTitle ya decian "Terrakeep" -
         visible si el usuario abria la carpeta de instalacion o el Administrador de tareas
         (pestaña Detalles, columna "Nombre de archivo"). Pedido explicito del usuario
         (5-sep-2026): "de cara al usuario no puede ver nada... del otro nombre". -->
    <AssemblyName>Terrakeep</AssemblyName>
    <!-- Metadatos visibles en Propiedades del .exe / Administrador de tareas de Windows -
         sin esto, .NET usa el nombre del ensamblado en crudo (Terrakeep.App). -->
    <AssemblyTitle>Terrakeep</AssemblyTitle>
    <Product>Terrakeep</Product>
    <Description>Editor de personajes de Terraria (vanilla + Calamity Mod)</Description>
    <!-- Auditoria final de Opus (5-sep-2026, antes de publicar): el comentario de
         AboutViewModel.AuthorName ya daba por hecho que el nombre del autor vivia tambien aqui
         (<Authors>), pero NO estaba puesto - Company iba vacio y no habia ni Authors ni
         Copyright, asi que las Propiedades del Terrakeep.exe en Windows (pestaña Detalles) no
         decian de quien es el programa. Es justo el sitio donde mirar cuando alguien
         redistribuye un binario, asi que importa de verdad de cara a publicarlo. El nombre va
         LITERAL: "IncrediBad", con I y B mayusculas (misma regla que en AboutViewModel). -->
    <Authors>IncrediBad</Authors>
    <Company>IncrediBad</Company>
    <Copyright>Copyright © 2026 IncrediBad</Copyright>
    <!-- Real, sincronizada a mano con la version mas reciente de Assets/changelog.json - antes
         no se fijaba y caia al 1.0.0.0 por defecto de .NET, sin significar nada real. -->
    <!-- Bug real confirmado en produccion (17/18-sep-2026): esta version se bumbeo a 3.2.1 en el
         commit 628f97f6 pero FileVersion/AssemblyVersion se quedaron en 3.2.0.0 por error humano
         (la sincronizacion "a mano" de la que habla el comentario de arriba fallo esta vez).
         Assembly.GetExecutingAssembly().GetName().Version (MainViewModel.Actualizaciones.cs,
         AboutViewModel.cs) lee AssemblyVersion, NUNCA Version - asi que la app instalada real de
         la 3.2.1 seguia reportandose a si misma como "3.2.0" en Acerca de Y en la comprobacion de
         actualizaciones, que por tanto detectaba SIEMPRE una actualizacion disponible (la propia
         3.2.1 contra si misma) sin fin, incluso justo despues de una actualizacion real ya
         instalada con exito. Confirmado real: FileVersion del TerrakeepSetup-3.2.1.exe YA
         PUBLICADO en GitHub Releases es 3.2.0.0 (comprobado con Get-Item ... .VersionInfo.FileVersion
         tras instalarlo de verdad) - ese instalador concreto seguira con el bug hasta que se
         publique una release nueva con esto ya corregido (ver bitacora.md). -->
    <!-- 3.2.3 (18-sep-2026): arreglo real del clic sobre marcadores del mapa de Exploracion - ver
         changelog.json y bitacora.md. Version/FileVersion/AssemblyVersion sincronizados a mano
         los TRES a la vez en el mismo cambio, para no repetir el error humano documentado arriba
         (3.2.1 solo actualizo Version y se quedo el bucle infinito de "hay actualizacion"). -->
    <!-- 3.2.4 (18-sep-2026): arreglo real de AR-LAY - el panel de Armadura/Accesorios perdia 18,9px
         de alto (recortados de verdad, sin scroll) en la vista Apariencia con la Libreria desplegada.
         Ver changelog.json y bitacora.md. -->
    <Version>3.2.4</Version>
    <FileVersion>3.2.4.0</FileVersion>
    <AssemblyVersion>3.2.4.0</AssemblyVersion>
  </PropertyGroup>

  <!-- Auditoria final de Opus (5-sep-2026): la build de Release generaba .pdb (simbolos de
       depuracion) y el instalador los copiaba tal cual al equipo del usuario final - se
       comprobo en la instalacion real de esta maquina: Terrakeep.pdb, TerrasavrNative.App.pdb
       y TerrasavrNative.Core.pdb (nombres de proyecto de entonces, renombrados a Terrakeep.App
       y Terrakeep.Core el 7-sep-2026), ~800 KB en total. No le sirven de nada a quien solo usa la
       app, y le dan a cualquiera que quiera descompilar el binario los nombres reales de
       metodos y los numeros de linea del fuente. Solo en Release: la build de Debug los sigue
       generando, que es lo que necesitan el depurador y el arnes de pruebas. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

</Project>
