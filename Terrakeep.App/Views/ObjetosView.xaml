                                       Visibility="{Binding DataContext.ItemEdit.Slot, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToCollapsed}}" />
                            <!-- C-11 (informe de pulido final, cierra L4): "arrastrar es el UNICO
