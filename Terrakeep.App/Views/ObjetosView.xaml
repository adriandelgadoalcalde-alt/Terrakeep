                    <!-- Auditoria de Opus, T-10: suelo real de legibilidad - 8px era mas pequeño
                         que cualquier otro texto real de la app (el resto usa 9px o mas para
                         palabras reales), aqui subido a 9. -->
                    <Button Content="{Binding Loc[action_place], Mode=OneWay}" Tag="Accent" FontSize="9" Padding="0,1" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                            Command="{Binding DataContext.Library.PlaceInTargetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Visibility="{Binding DataContext.Library.IsPicking, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ObjetosBoolToVis}}" />
                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>
                        <!-- Layout real de Terrasavr (pedido explicito 1-sep-2026): el inventario/equipo
                             arriba, la Libreria (arbol + buscador) siempre visible debajo, a la derecha
                             del arbol - nunca una pestaña aparte a la que hay que ir, para que arrastrar
                             una tarjeta de la Libreria hasta un slot visible sea posible de verdad. -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- Las 2 filas compiten de verdad por el alto ("*" ambas cuando la Libreria esta desplegada): Objetos con MinHeight=216 (suelo real, 5 filas de Inventario) y Libreria con Height/MinHeight ligados a IsLibraryVisible (colapsada = Auto/0, desplegada = 2*/200) para que plegarla devuelva espacio de verdad. Historial completo: ADR-TERRAKEEP-003. FASE C del responsive global (28-sep-2026): la "limitacion conocida" que aqui se documentaba (a 1080x700 con la Libreria desplegada la 5a fila de Inventario solo se alcanzaba con el ScrollViewer de seguridad) queda resuelta sin scroll local: AjusteAlViewport ajusta la rejilla al alto real de la pagina (las 50 casillas enteras, celda 40px en ese caso). -->
                                <RowDefinition Height="3*" MinHeight="216" />
                                <RowDefinition Height="{Binding IsLibraryVisible, Converter={StaticResource BoolToGridLength}, ConverterParameter=2}"
                                               MinHeight="{Binding IsLibraryVisible, Converter={StaticResource BoolToDouble}, ConverterParameter=200}"
                                               MaxHeight="{Binding LibraryRowMaxHeight}" />
                            </Grid.RowDefinitions>

                            <!-- Contenedores a la izquierda + panel "Editar" a la derecha (equivalente real
                                 de app.TabInventory.initSide: sideCtr con las pestañas Edit/Library reales -
                                 aqui Library ya vive fijo abajo, ver Grid.Row=1, y Editar sigue al slot
                                 SELECCIONADO sea cual sea el contenedor activo). -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="300" />
                                </Grid.ColumnDefinitions>

                                <!-- Antes: 21 pestañas planas en una sola fila (9 contenedores + 12 de
                                     loadout puesto/1/2/3 x armadura/vanidad/tintes) - se amontonaba
                                     al reducir la ventana (pedido explicito 2-sep-2026). Ahora: solo 2
                                     pestañas externas, "Equipamiento" consolida los 12 sub-contenedores
                                     con su propio selector (equivalente real de app.TabEquips/Sb, ver
                                     bitacora.md "Fase D"). -->
                                <!-- H4-02 (cuarta auditoria de Opus, Fable): "Almacenes seleccionada y luego
                                     oculta en Amplio deja un contenido huérfano sin pestaña activa" - esta
                                     pestaña interna (Equipamiento=0/Inventario=1/Almacenes=2) no tenia
                                     SelectedIndex enlazado - MainViewModel.OnSizeClassChanged mueve la
                                     seleccion a Inventario si Almacenes (ahora oculta) era la activa. -->
                                <!-- T3 (catalogo de rediseño visual, "Personaje: tablero con panel lateral" -
                                     bitacora.md 20-sep-2026): reabierto por instruccion explicita del
                                     coordinador/usuario tras documentarlo como LIMITE-por-riesgo-historico (no
                                     tecnico real) - "8 rondas de arreglo real en esta zona" seguia siendo un
                                     motivo generico de cautela, no evidencia de que fusionar las 3 pestañas sea
                                     imposible. PASO 1 (estructural, cambio pequeño y verificado antes de seguir,
                                     mismo ciclo real de la zona): TabControl (3 pestañas EXCLUYENTES, una
                                     medida/pintada a la vez con SelectedIndex) -> Grid+ScrollViewer con las 3
                                     secciones SEGUIDAS en un StackPanel - tablero de scroll continuo real, no
                                     una simulacion. Contenido INTERNO de cada seccion sin tocar ni un pixel (los
                                     Border/Grid/SlotRowHost ya calibrados en las 8 rondas siguen exactamente
                                     igual) - solo cambia el CONTENEDOR exterior que las alojaba. -->
                                <!-- NAV123 (25-sep-2026, aplicador-fix, TASK CONTEXT
                                     e5eaea9e-c261-4199-8e7d-060b6054f58d): T3 PASO 2 (barra pegajosa + scroll
                                     continuo, comentario historico de arriba) REABIERTO y sustituido - el
                                     usuario exigio PAGINAS REALES, no un offset que ScrollViewer puede clampar
                                     (bug real "toggle 3 desincronizado" con Almacenes con pocos objetos, ver
                                     bitacora.md). ObjetosPageHost es un Grid de una sola celda con 3
                                     ScrollViewer SUPERPUESTOS (uno por seccion, cada uno con su propio scroll
                                     interno - Inventario y Almacenes lo necesitan igual que Equipamiento, ver
                                     H3-18 mas arriba) cuya Visibility depende en EXCLUSIVA de
                                     MainViewModel.ObjetosSubTabIndex via EnumEqualsToVis (converter ya
                                     existente, mismo patron que ExplorationSidebarBrowseInspectorHost) -
                                     exactamente 1 de las 3 paginas Visible en todo momento, cero estados
                                     intermedios alcanzables (ni por scroll libre: cada pagina solo desplaza su
                                     propio contenido, nunca "empuja" a la siguiente seccion). -->
                                <!-- NAV123 centrado real (26-sep-2026, patron de 2 fases - investigador-bug
                                     confirmo con DiagnosticoPosicionNavToggle.cs que el centro del RadioButton
                                     "1" caia 7px por debajo del centro real del titulo "Equipamiento": el
                                     margen superior fijo de ObjetosNavToggle (era Margin="0,4,4,0") mas la
                                     diferencia de alto entre ViewSelector (Padding 10,4 -> ~24,6px) y
                                     SectionText (~18,6px) no se compensaban entre si. IsSharedSizeScope+
                                     SharedSizeGroup="ObjetosHeaderRow" (abajo, titulo de cada pagina y
                                     ObjetosNavToggle) sincroniza el alto real de ambas filas SIN ningun numero
                                     magico - si SectionText o ViewSelector cambian de tamaño en el futuro el
                                     centrado sigue siendo exacto, mismo principio ya aplicado hoy a la
                                     geometria de Chester (preferir centrado declarativo real sobre un offset
                                     ajustado a ojo). -->
                                <Grid Grid.Column="0" Margin="0,0,10,0" Grid.IsSharedSizeScope="True">
                                <Grid x:Name="ObjetosPageHost">
                                <ScrollViewer x:Name="ObjetosPaginaEquipamiento" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              Visibility="{Binding ObjetosSubTabIndex, Converter={StaticResource EnumEqualsToVis}, ConverterParameter=0}">
                                    <Border x:Name="ObjetosSeccionEquipamiento">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" SharedSizeGroup="ObjetosHeaderRow" />
                                            </Grid.RowDefinitions>
                                            <!-- FASE C: el titulo de pagina lo da ahora la navegacion etiquetada (ObjetosNavToggle, mas
                                                 abajo), que se superpone a esta fila; la fila (SharedSizeGroup) se conserva
                                                 como hueco para que el contenido empiece debajo de ella. -->
                                        </Grid>
                                        <!-- Fusion con Monturas/Monedas como laterales (pregunta a Opus
                                             sobre el diseño, quinta pasada: "yo juntaría la página de
                                             munición mascotas gancho... y dinero en equipamiento en una
                                             sola ventana pero a los lados... mascotas etc mejor en
                                             vertical"). UN solo marco naranja para todo el bloque (3
                                             marcos compitiendo en ~672px seria el mismo amontonamiento
                                             que ya se resolvio en la tercera pasada) - los laterales se
                                             distinguen "hundiendose" (BgPrimaryBrush, mismo idioma que
                                             el arbol de la Libreria y los huecos vacios de
                                             ItemSlotCardCompact) en vez de con su propio contorno.
                                             SlotRowHost (no un Grid a secas) para que ReferenceWidth de
                                             los 3 SlotGridPanel de esta fila se enlace de forma fiable
                                             (ver SlotGridPanel.cs) contra el ancho de TODA la fila
                                             fusionada, no el de cada columna estrecha por separado -
                                             sin esto los 3 colapsarian a MinCell=44, mas pequeños que
                                             Inventario, el problema inverso de la cuarta pasada. -->
                                        <!-- FASE B del responsive global (28-sep-2026, PDF "Arreglo familia keep",
                                             bloque 2, s4-s7/s13/s14/s34 - changeMode REPLACE). MODELO VIEJO retirado
                                             entero, no parcheado: hasta hoy esta fila fusionada sobrevivia a las
                                             ventanas pequeñas a base de safety-scrolls locales ANIDADOS dentro del
                                             scroll owner de la pagina (medido con EQUIP_RESPONSIVE_SOLO: 9-10
                                             ScrollViewer verticales dentro de ObjetosPaginaEquipamiento) - uno
                                             alrededor de toda la fila (ADR-TERRAKEEP-011), otro en el lateral
                                             Mascotas/Tintes, otro con MaxHeight=112 en la cabecera Loadout/Vista/
                                             Defensa/bono (AR-14d), otro en la rejilla central (ADR-TERRAKEEP-015) y uno
                                             mas por cada contenedor (ContainerCompactTemplate) - mas la fila "*"
                                             MinHeight=84 que compensaba la cabecera, y ademas un modelo visual que
                                             cambiaba de arquitectura con el tamaño (IsEquipmentExpanded: desde
                                             Amplio desaparecia el selector Armadura/Vanidad/Tintes y salian las 3
                                             rejillas a la vez, a 40-44px de celda).
                                             MODELO NUEVO: la pagina ObjetosPaginaEquipamiento es el UNICO scroll owner
                                             vertical de este contexto. Todo lo de dentro es STRUCTURAL_FINITE (cabecera,
                                             selectores) o FINITE_PAGEABLE (Armadura/Vanidad/Tintes, una subvista a la vez
                                             con su selector SIEMPRE visible, en todos los tamaños) y crece en alto con
                                             naturalidad (ContainerFlowTemplate, filas Auto, TextWrapping en el bono de
                                             set) - si al final la pagina entera no cabe, la desplaza su owner, nunca una
                                             caja local. Las 3 columnas (Mascotas | Equipamiento | Monedas) se conservan
                                             porque la geometria real lo pide asi: el eje escaso en el minimo es el ALTO
                                             (medido: 140/259/208px de columnas caben de sobra a 1080px), apilarlas
                                             costaria alto justo donde falta. -->
                                        <Border BorderBrush="{StaticResource OrangeBrush}" BorderThickness="2" CornerRadius="10"
                                                Background="{StaticResource BgSecondaryBrush}" Padding="10,6" Margin="0,2,0,0">
                                            <!-- Columna central "*" con MinWidth=216 (5 slots MinCell=40 + gaps, el minimo real de SlotGridPanel cuando no le cabe mas): red de seguridad para que WPF recorte antes las columnas Auto de los laterales que el MinWidth de esta estrella, nunca al reves. Laterales van a Auto+MinWidth propio (su contenido ya se autolimita). Historial completo (por que "2*/5*/4*" no bastaba, el bug real de solape AR-14): ADR-TERRAKEEP-007. -->
                                              <controls:SlotRowHost x:Name="EquipamientoFila" ClipToBounds="True">
                                                  <Grid.ColumnDefinitions>
                                                      <ColumnDefinition Width="Auto" MinWidth="140" />
                                                      <ColumnDefinition Width="*" MinWidth="216" />
                                                      <ColumnDefinition Width="Auto" MinWidth="140" />
                                                  </Grid.ColumnDefinitions>
                                                  <!-- UNA sola fila (FASE B): retirado el "*" MinHeight=84 de AR-14d, que solo
                                                       existia para defender la rejilla de una cabecera encerrada en su propia
                                                       caja de scroll. Cabecera y subvista viven apiladas en la columna central
                                                       (EquipamientoCentro) y los laterales ocupan la misma fila - asi el alto
                                                       de un lateral nunca se reparte entre filas Auto empujando la rejilla
                                                       hacia abajo (medido en la primera version de esta fase con 2 filas Auto:
                                                       la rejilla bajaba ~70px separada de su cabecera). -->

                                                  <!-- Lateral izquierdo: Mascota/Montura/Gancho + Tinte, UNO AL LADO DEL
                                                       OTRO (consulta a Opus, septima pasada: apilados serian 10 filas en la
                                                       misma columna, hay mas ancho que alto de sobra aqui). FASE B: sin ScrollViewer
                                                       de seguridad propio - el owner de la pagina absorbe el alto. -->
                                                  <Border x:Name="CajaMascotasTintes" Grid.Column="0" Background="{StaticResource BgPrimaryBrush}"
                                                          CornerRadius="8" Padding="6" Margin="0,0,8,0" VerticalAlignment="Top">
                                                      <StackPanel Orientation="Horizontal">
                                                          <StackPanel Margin="0,0,10,0">
                                                              <!-- TextWrapping="Wrap" + MaxWidth (consulta a Opus, septima
                                                                   pasada): columna "Auto" medida con ancho infinito - sin
                                                                   este tope el texto sin envolver fijaria el ancho real de
                                                                   la columna entera. -->
                                                              <TextBlock Text="{Binding Loc[char_pet_mount_label], Mode=OneWay}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="70" Margin="0,0,0,3" />
                                                              <ContentControl Content="{Binding MountsContainer}" ContentTemplate="{StaticResource ContainerFlowTemplate}" />
                                                          </StackPanel>
                                                          <StackPanel>
                                                              <TextBlock Text="{Binding Loc[char_dye_label], Mode=OneWay}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="70" Margin="0,0,0,3" />
                                                              <ContentControl Content="{Binding DyesContainer}" ContentTemplate="{StaticResource ContainerFlowTemplate}" />
                                                          </StackPanel>
                                                      </StackPanel>
                                                  </Border>

                                                  <!-- Cabecera STRUCTURAL_FINITE (s6/s34): Loadout + selector de subvista
                                                       Armadura/Vanidad/Tintes + Defensa total + bono de set. Sin
                                                       ScrollViewer ni MaxHeight: el bono largo envuelve (TextWrapping) y la
                                                       fila Auto crece, empujando la subvista hacia abajo. DataContext local
                                                       a EquipmentGroup (los laterales necesitan el MainViewModel). -->
                                                  <StackPanel x:Name="EquipamientoCentro" Grid.Column="1" VerticalAlignment="Top">
                                                  <StackPanel x:Name="EquipamientoCabecera" Margin="0,0,0,6"
                                                              DataContext="{Binding EquipmentGroup}">
                                                      <!-- FASE C, remate N-03 de la FASE B: la rejilla se centra en su columna
                                                           (SlotGridPanel.ArrangeOverride, pedido explicito del usuario) y en Extra
                                                           las 3 subvistas tambien van centradas; la cabecera iba a la izquierda y a
                                                           1520px quedaba ~170px desalineada de la rejilla. Criterio: UN solo eje, el
                                                           central, en todos los tamaños - filas de pildoras centradas y textos con
                                                           TextAlignment=Center (el bono largo sigue envolviendo, s34). -->
                                                      <WrapPanel Margin="0,0,0,3" HorizontalAlignment="Center">
                                                          <TextBlock Text="{Binding Loc[char_loadout_label], Mode=OneWay}" Style="{StaticResource CaptionText}"
                                                                     VerticalAlignment="Center" Margin="0,0,8,5" />
                                                          <ItemsControl ItemsSource="{Binding LoadoutOptions}">
                                                              <ItemsControl.ItemsPanel>
                                                                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                              </ItemsControl.ItemsPanel>
                                                              <ItemsControl.ItemTemplate>
                                                                  <DataTemplate DataType="{x:Type vm:EquipmentOptionViewModel}">
                                                                      <!-- DisplayLabel (no Label): marca con un punto el conjunto
                                                                           que el personaje llevaba PUESTO al guardar - ver
                                                                           EquipmentGroupViewModel. -->
                                                                      <Button Content="{Binding DisplayLabel}" Style="{StaticResource PrefixMetaButton}"
                                                                              ToolTip="{Binding ToolTipText}"
                                                                              Command="{Binding DataContext.EquipmentGroup.SelectLoadoutCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                              CommandParameter="{Binding}" />
                                                                  </DataTemplate>
                                                              </ItemsControl.ItemTemplate>
                                                          </ItemsControl>
                                                      </WrapPanel>
                                                      <!-- Selector de subvista (s4): SIEMPRE visible, en todos los tamaños -
                                                           "Vanidad solo parece existir cuando hago la ventana mas grande" no
                                                           puede volver a pasar (ni al reves: antes, desde Amplio, era el
                                                           selector el que desaparecia). x:Name para el canario
                                                           EQUIP_RESPONSIVE_SOLO. -->
                                                      <WrapPanel x:Name="EquipamientoSelectorVista" HorizontalAlignment="Center">
                                                          <TextBlock Text="{Binding Loc[char_view_label], Mode=OneWay}" Style="{StaticResource CaptionText}"
                                                                     VerticalAlignment="Center" Margin="0,0,8,5" />
                                                          <ItemsControl ItemsSource="{Binding KindOptions}">
                                                              <ItemsControl.ItemsPanel>
                                                                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                              </ItemsControl.ItemsPanel>
                                                              <ItemsControl.ItemTemplate>
                                                                  <DataTemplate DataType="{x:Type vm:EquipmentOptionViewModel}">
                                                                      <Button Content="{Binding Label}" Style="{StaticResource PrefixGroupButton}"
                                                                              Command="{Binding DataContext.EquipmentGroup.SelectKindCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                              CommandParameter="{Binding}" Click="OnEquipmentKindClick" />
                                                                  </DataTemplate>
                                                              </ItemsControl.ItemTemplate>
                                                          </ItemsControl>
                                                      </WrapPanel>
                                                      <!-- Auditoria de Opus, E-4: defensa real sumada de este loadout y el
                                                           bono de set REALMENTE activo (VanillaArmorSetCatalog.BonusForEquipped). -->
                                                      <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center">
                                                          <Run Text="{Binding Loc[char_total_defense], Mode=OneWay}" />
                                                          <Run Text="{Binding TotalDefense, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                      </TextBlock>
                                                      <TextBlock Text="{Binding ActiveSetBonusText}" Style="{StaticResource CaptionText}"
                                                                 Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,2,0,0"
                                                                 Visibility="{Binding ActiveSetBonusText, Converter={StaticResource NullToVis}}" />
                                                  </StackPanel>

                                                  <!-- Subvista(s) FINITE_PAGEABLE (s4/s16/s17, correccion V-01 del revisor visual):
                                                       - Compacto/Normal: UNA subvista, la que diga el selector de arriba.
                                                       - Extra (IsEquipmentSideBySide, >= 1920 - umbral medido, ver MainViewModel): las 3 a la vez en columnas iguales,
                                                         en el orden del propio juego (Tinte | Vanidad | Armadura), alineadas por
                                                         fila de slot (mismo ancho de columna -> misma celda en las 3; cada columna se ciñe a su
                                                         rejilla y se centra, asi etiqueta y resaltado quedan pegados a sus slots). El
                                                         selector NO desaparece: marca la subvista enfocada con el borde de acento,
                                                         pulsarlo lleva el foco de teclado a esa columna (OnEquipmentKindClick) y
                                                         seleccionar un slot de otra columna mueve el selector ahi
                                                         (EquipmentGroupViewModel.SyncKindWithSlot). -->
                                                  <ContentControl x:Name="EquipamientoSubvistaActual"
                                                                  Content="{Binding EquipmentGroup.Current}"
                                                                  ContentTemplate="{StaticResource ContainerFlowTemplate}"
                                                                  Visibility="{Binding IsEquipmentSideBySide, Converter={StaticResource InverseBoolToVis}}" />
                                                  <!-- H-02 (segunda revision visual): UniformGrid 1x3 centrado en vez de 3
                                                       columnas "*" con cada rejilla centrada en la suya - aquello dejaba
                                                       140-210px de hueco entre rejillas a 1920/maximizado. UniformGrid mide
                                                       cada celda con 1/3 del ancho disponible (la celda del slot se limita por
                                                       ancho igual que antes), pero con HorizontalAlignment=Center el grupo
                                                       ocupa solo 3 x el ancho real de la rejilla mas ancha y se centra: la
                                                       separacion entre rejillas es fija (Margin 8,0 = 16px), no el sobrante. -->
                                                  <UniformGrid x:Name="EquipamientoSubvistasLadoALado" Rows="1" Columns="3" HorizontalAlignment="Center"
                                                               Visibility="{Binding IsEquipmentSideBySide, Converter={StaticResource ObjetosBoolToVis}}">
                                                      <Border x:Name="EquipamientoColumnaTintes" Margin="8,0" Padding="4" CornerRadius="8" BorderThickness="2" Tag="Dyes">
                                                          <Border.Style>
                                                              <Style TargetType="Border">
                                                                  <Setter Property="BorderBrush" Value="Transparent" />
                                                                  <Style.Triggers>
                                                                      <DataTrigger Binding="{Binding EquipmentGroup.SelectedKind}" Value="Dyes">
                                                                          <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                                      </DataTrigger>
                                                                  </Style.Triggers>
                                                              </Style>
                                                          </Border.Style>
                                                          <StackPanel>
                                                              <TextBlock Text="{Binding EquipmentGroup.KindOptions[2].Label}" Style="{StaticResource CaptionText}" Margin="2,0,0,4" />
                                                              <ContentControl Content="{Binding EquipmentGroup.CurrentDyes}" ContentTemplate="{StaticResource ContainerFlowTemplate}" />
                                                          </StackPanel>
                                                      </Border>
                                                      <Border x:Name="EquipamientoColumnaVanidad" Margin="8,0" Padding="4" CornerRadius="8" BorderThickness="2" Tag="Social">
                                                          <Border.Style>
                                                              <Style TargetType="Border">
                                                                  <Setter Property="BorderBrush" Value="Transparent" />
                                                                  <Style.Triggers>
                                                                      <DataTrigger Binding="{Binding EquipmentGroup.SelectedKind}" Value="Social">
                                                                          <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                                      </DataTrigger>
                                                                  </Style.Triggers>
                                                              </Style>
                                                          </Border.Style>
                                                          <StackPanel>
                                                              <TextBlock Text="{Binding EquipmentGroup.KindOptions[1].Label}" Style="{StaticResource CaptionText}" Margin="2,0,0,4" />
                                                              <ContentControl Content="{Binding EquipmentGroup.CurrentSocial}" ContentTemplate="{StaticResource ContainerFlowTemplate}" />
                                                          </StackPanel>
                                                      </Border>
                                                      <Border x:Name="EquipamientoColumnaArmadura" Margin="8,0" Padding="4" CornerRadius="8" BorderThickness="2" Tag="Items">
                                                          <Border.Style>
                                                              <Style TargetType="Border">
                                                                  <Setter Property="BorderBrush" Value="Transparent" />
                                                                  <Style.Triggers>
                                                                      <DataTrigger Binding="{Binding EquipmentGroup.SelectedKind}" Value="Items">
                                                                          <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                                      </DataTrigger>
                                                                  </Style.Triggers>
                                                              </Style>
                                                          </Border.Style>
                                                          <StackPanel>
                                                              <TextBlock Text="{Binding EquipmentGroup.KindOptions[0].Label}" Style="{StaticResource CaptionText}" Margin="2,0,0,4" />
                                                              <ContentControl Content="{Binding EquipmentGroup.CurrentItems}" ContentTemplate="{StaticResource ContainerFlowTemplate}" />
                                                          </StackPanel>
                                                      </Border>
                                                  </UniformGrid>
                                                  </StackPanel>

                                                  <!-- Lateral derecho Monedas/Municion. Historial completo: ADR-TERRAKEEP-005. -->
                                                  <Border x:Name="CajaMonedasMunicion" Grid.Column="2" Background="{StaticResource BgPrimaryBrush}"
                                                          CornerRadius="8" Padding="6" Margin="8,0,0,0" VerticalAlignment="Top">
                                                      <!-- FASE B: Monedas | Municion lado a lado, una columna de 4 cada una
                                                           (como el inventario del juego y como el lateral de Mascotas) - ver
                                                           el comentario de CoinsContainer en MainViewModel para la medida. -->
                                                      <StackPanel x:Name="PilaMonedasMunicion" Orientation="Horizontal" VerticalAlignment="Top">
                                                          <StackPanel Margin="0,0,10,0">
                                                              <TextBlock Text="{Binding CoinsContainer.DisplayName}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="70" Margin="0,0,0,3" />
                                                              <ContentControl Content="{Binding CoinsContainer}" ContentTemplate="{StaticResource ContainerFlowTemplate}" />
                                                          </StackPanel>
                                                          <StackPanel>
                                                              <TextBlock Text="{Binding AmmoContainer.DisplayName}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="70" Margin="0,0,0,3" />
                                                              <ContentControl Content="{Binding AmmoContainer}" ContentTemplate="{StaticResource ContainerFlowTemplate}" />
                                                          </StackPanel>
                                                      </StackPanel>
                                                  </Border>
                                              </controls:SlotRowHost>
                                        </Border>
                                    </StackPanel>
                                    </Border>
                                </ScrollViewer>
                                <!-- Antes: 9 pestañas planas aqui dentro, luego 5 (pregunta a Opus
                                     sobre el diseño, 2-sep-2026 y quinta pasada) - Monturas/Monedas
                                     se fusionaron dentro de Equipamiento (arriba) como laterales,
                                     asi que solo quedan Inventario/Almacenes aqui. Los 9
                                     ContainerViewModel siguen siendo los MISMOS de siempre
                                     (MainViewModel.Containers) - riesgo cero para guardar/cargar,
                                     ver StorageGroupViewModel.cs. -->
                                <!-- T3 PASO 1: seccion Inventario - se retira el bloque de dos columnas
                                     "Inventario + Almacen seleccionado" (IsStorageExpanded=True, vivia aqui
                                     duplicando la cabecera y los 3 botones de conjunto) porque Almacenes YA
                                     tiene su propia pagina propia (NAV123) - ya no hace falta fusionarlo aqui
                                     para verlo "a la vez". Border SIN Visibility condicionada propia (la
                                     Visibility real de la pagina completa vive en el ScrollViewer que la
                                     envuelve, ver arriba). -->
                                <ScrollViewer x:Name="ObjetosPaginaInventario" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              Visibility="{Binding ObjetosSubTabIndex, Converter={StaticResource EnumEqualsToVis}, ConverterParameter=1}">
                                    <!-- NAV123 centrado real (26-sep-2026): Margin="0,14,0,0" retirado - no
                                         tenia ninguna justificacion documentada y era distinto del Margin de
                                         ObjetosSeccionEquipamiento (sin margen), lo que desplazaba el titulo de
                                         esta pagina 14px por debajo del StackPanel flotante ObjetosNavToggle
                                         (fijo, no se mueve entre paginas). Unificado a sin margen, igual que
                                         Equipamiento/Almacenes - ver comentario completo en el Grid de mas
                                         arriba (SharedSizeGroup="ObjetosHeaderRow"). -->
                                    <!-- FASE C del responsive global: la pagina es el UNICO scroll owner vertical; su
                                         contenido se ajusta al viewport (AjusteAlViewport) - la rejilla 10x5 encoge o
                                         crece la celda hasta caber debajo de la cabecera (MinCell..MaxCell) y solo si ni
                                         a MinCell cabe, la pagina crece lo justo y la desplaza su owner (s14 paso 8).
                                         DockPanel (no StackPanel) para que la rejilla reciba el alto REAL restante. -->
                                    <controls:AjusteAlViewport AltoViewport="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                                    <Border x:Name="ObjetosSeccionInventario">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" SharedSizeGroup="ObjetosHeaderRow" />
                                            </Grid.RowDefinitions>
                                            <!-- FASE C: el titulo de pagina lo da ahora la navegacion etiquetada (ObjetosNavToggle, mas
                                                 abajo), que se superpone a esta fila; la fila (SharedSizeGroup) se conserva
                                                 como hueco para que el contenido empiece debajo de ella. -->
                                        </Grid>
                                        <!-- FASE C: VerticalAlignment=Top - el marco se ciñe a cabecera+rejilla (mide con el
                                             alto restante, pero no se estira hasta el fondo del viewport). Margin superior
                                             6->2, el mismo que el marco de Equipamiento, y relleno vertical 10->8 (s14 paso 7,
                                             compactar dentro de limites de legibilidad): medido, con 10 quedaban 4px de
                                             scroll de pagina a 1080x700 con la Libreria desplegada (rejilla ya en MinCell). -->
                                        <Border BorderBrush="{StaticResource OrangeBrush}" BorderThickness="2" CornerRadius="10"
                                                Background="{StaticResource BgSecondaryBrush}" Padding="10,8" Margin="0,2,0,0" VerticalAlignment="Top">
                                            <!-- A-c (segunda auditoria de Opus, Fable): "Inventario (47/50) seria
                                                 igual de util y no existe en ningun sitio" - la vista Amplia (mas
                                                 abajo) ya tenia esta cabecera, la normal/compacta no tenia
                                                 ninguna. -->
                                            <DockPanel>
                                                <!-- A-d (segunda auditoria de Opus, Fable): "operaciones en bloque -
                                                     ordenar, vaciar contenedor, mover todo al banco" - ver los 3
                                                     comandos reales en ContainerViewModel/MainViewModel. -->
                                                <!-- AR-LAY (6-sep-2026): Grid con MinWidth, no DockPanel. R-01/H-08 (abajo)
                                                     cambio el StackPanel de botones por un WrapPanel para que pudiera
                                                     partirse en dos filas, pero dejo el reparto en manos de un DockPanel
                                                     - y un DockPanel sirve a su hijo Dock PRIMERO y con su DesiredSize
                                                     ENTERO: el WrapPanel decide cuantas filas necesita ANTES de que el
                                                     titulo pida nada, y solo despues le deja el resto. Eso abre una
                                                     franja intermedia de anchos en la que los 6 botones caben JUSTO en
                                                     una fila y se llevan la anchura entera. Medido px a px entre 1500 y
                                                     1620: falla en 20 anchos, y a 1545x860 el titulo se queda en 0,3px
                                                     visibles de los 8,8 que pide, o sea desaparece del todo. Es el mismo
                                                     mecanismo (franja estrecha e invisible en el minimo y en maximizada)
                                                     que AR-14 con los accesorios, y se arregla igual: una columna con
                                                     MinWidth propio para el titulo y una Auto para los botones, que es
                                                     la unica forma de que sea el WRAPPANEL quien ceda y envuelva.
                                                     El reparto tiene que ser titulo=Auto y botones=*, NO al reves: una
                                                     columna Auto se queda con su DesiredSize entero aunque no quepa (el
                                                     Grid solo recorta a las estrella), asi que con los botones en Auto
                                                     el problema se movia, no se arreglaba - medido: el Grid pedia 607px
                                                     dentro de 581 y se cortaba "Vaciar contenedor". Con el titulo en
                                                     Auto (su ancho natural, ~90px, nunca se recorta) y el WrapPanel en
                                                     la estrella, el WrapPanel recibe el resto REAL y envuelve solo. -->
                                                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Auditoria de redimensionado, R-01/H-08: WrapPanel en vez de
                                                         StackPanel - a 1080px de ancho, 6 botones en una sola fila
                                                         recortaban el titulo "Inventario (N/M)" que viene detras
                                                         (DockPanel corta el ultimo hijo cuando no le queda sitio). Con
                                                         WrapPanel los botones pasan a 2 filas si hace falta, el titulo
                                                         nunca se pierde. -->
                                                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                                                        <!-- H5-03 (quinta auditoria de Opus): "guardar/cargar conjuntos de
                                                             objetos, funcion de primera clase en el Terrasavr original" -
                                                             el dialogo real de fichero vive en la View (MainViewModel es
                                                             headless), ver OnSaveInventorySetClick/OnLoadInventorySetClick/
                                                             OnAppendInventorySetClick. -->
                                                        <Button Content="{Binding Loc[action_save_set], Mode=OneWay}" Click="OnSaveInventorySetClick"
                                                                ToolTip="{Binding Loc[tt_save_inventory_json], Mode=OneWay}"
                                                                Tag="Ghost" Padding="6,3" FontSize="10.5" Margin="0,0,6,0" />
                                                        <Button Content="{Binding Loc[action_load_ellipsis], Mode=OneWay}" Click="OnLoadInventorySetClick"
                                                                ToolTip="{Binding Loc[tt_load_inventory_replace], Mode=OneWay}"
                                                                Tag="Ghost" Padding="6,3" FontSize="10.5" Margin="0,0,6,0" />
                                                        <Button Content="{Binding Loc[action_add_ellipsis], Mode=OneWay}" Click="OnAppendInventorySetClick"
                                                                ToolTip="{Binding Loc[tt_add_inventory_fill], Mode=OneWay}"
                                                                Tag="Ghost" Padding="6,3" FontSize="10.5" Margin="0,0,6,0" />
                                                        <Button Content="{Binding Loc[action_move_all_to_storage], Mode=OneWay}" Command="{Binding MoveInventoryToStorageCommand}"
                                                                ToolTip="{Binding Loc[tt_move_all_storage_tab], Mode=OneWay}"
                                                                Tag="Ghost" Padding="6,3" FontSize="10.5" Margin="0,0,6,0" />
                                                        <Button Content="{Binding Loc[action_sort], Mode=OneWay}" Command="{Binding InventoryContainer.SortCommand}"
                                                                ToolTip="{Binding Loc[tt_sort_by_id], Mode=OneWay}" Tag="Ghost" Padding="6,3" FontSize="10.5" Margin="0,0,6,0" />
                                                        <Button Content="{Binding Loc[action_empty_container], Mode=OneWay}" Command="{Binding InventoryContainer.ClearAllCommand}"
                                                                ToolTip="{Binding Loc[tt_empty_inventory], Mode=OneWay}" Tag="Ghost" Padding="6,3" FontSize="10.5" />
                                                    </WrapPanel>
                                                    <!-- Auditoria de redimensionado, AR-08/H-08: el WrapPanel de R-01 ya reduce
                                                         mucho el recorte (de ~660px de una fila sin envolver a un residual real
                                                         de 14px a 1080px, medido - el hueco restante entre los 6 botones ya en 2
                                                         filas y este titulo sigue siendo mas estrecho de lo que hace falta a ese
                                                         ancho concreto). TextTrimming honesto en vez de un corte seco silencioso -
                                                         parche previsto explicitamente en el propio informe para este residual. -->
                                                    <TextBlock Grid.Column="0" Text="{Binding InventoryContainer.DisplayName}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                                </Grid>
                                                <ContentControl Content="{Binding InventoryContainer}" ContentTemplate="{StaticResource ContainerFlowTemplate}" />
                                            </DockPanel>
                                        </Border>

                                        <!-- T3 PASO 1: el bloque real "Inventario + Almacen seleccionado lado a
                                             lado" (Auditoria de Opus, A-4, IsStorageExpanded) se retira aqui -
                                             Almacenes ya tiene su propia seccion permanente en este mismo scroll
                                             (justo debajo), asi que fusionarlo A LA FUERZA dentro de Inventario
                                             para "verlo a la vez" ya no aporta nada que el tablero no de gratis.
                                             CODIGO REAL RETIRADO (nunca comentado a medias - el bloque completo,
                                             ~117 lineas, vivia aqui: Grid de 2 columnas con una copia MANUAL de
                                             la cabecera+botones de Inventario a la izquierda y el selector de
                                             Almacen a la derecha, historial real: A-4 lo creo, R-01/H-01 tuvo que
                                             restaurarle 3 botones que se habian quedado fuera en la copia manual -
                                             ver el commit real de esta pieza para el texto integro si hiciera
                                             falta recuperarlo). -->
                                    </DockPanel>
                                    </Border>
                                    </controls:AjusteAlViewport>
                                </ScrollViewer>
                                <!-- T3 PASO 1: seccion Almacenes - antes vivia como pestaña propia SOLO en
                                     Compacto/Normal (se ocultaba entera en Amplio, donde el bloque de dos
                                     columnas ahora retirado la duplicaba dentro de Inventario). Con NAV123
                                     esta es su propia pagina permanente, siempre alcanzable con el selector
                                     3, a cualquier tamaño de ventana. -->
                                <ScrollViewer x:Name="ObjetosPaginaAlmacenes" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              Visibility="{Binding ObjetosSubTabIndex, Converter={StaticResource EnumEqualsToVis}, ConverterParameter=2}">
                                    <!-- NAV123 centrado real (26-sep-2026): mismo motivo que ObjetosSeccionInventario
                                         arriba - Margin="0,14,0,0" retirado, sin margen igual que las otras 2
                                         paginas. -->
                                    <!-- FASE C: mismo modelo que Inventario (UNICO scroll owner + AjusteAlViewport). -->
                                    <controls:AjusteAlViewport AltoViewport="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                                    <Border x:Name="ObjetosSeccionAlmacenes">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" SharedSizeGroup="ObjetosHeaderRow" />
                                            </Grid.RowDefinitions>
                                            <!-- FASE C: el titulo de pagina lo da ahora la navegacion etiquetada (ObjetosNavToggle, mas
                                                 abajo), que se superpone a esta fila; la fila (SharedSizeGroup) se conserva
                                                 como hueco para que el contenido empiece debajo de ella. -->
                                        </Grid>
                                        <Border BorderBrush="{StaticResource OrangeBrush}" BorderThickness="2" CornerRadius="10"
                                                Background="{StaticResource BgSecondaryBrush}" Padding="10,8" Margin="0,2,0,0" VerticalAlignment="Top">
                                            <DockPanel DataContext="{Binding StorageGroup}">
                                                <!-- FASE C (s14 pasos 1-2, reflow + wrap): selector de los 4 almacenes y botones en UN
                                                     WrapPanel - las 4 pildoras van SIEMPRE juntas (primer hijo, medido con el ancho
                                                     entero) y los botones siguen en la misma fila si caben o bajan a la siguiente.
                                                     Antes (DockPanel con los botones a la derecha, medidos primero) las pildoras se
                                                     quedaban con ~227px a 1080 y se partian en 3 filas: Forja y Camara del vacio caian
                                                     debajo, lejos de Banco/Caja fuerte, y la cabecera se comia ~25px mas de alto. -->
                                                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                                    <!-- Auditoria de Opus, A-1: "para saber si el Banco esta lleno hay
                                                         que pulsar su pildora y contar" - DisplayLabel ya trae el
                                                         recuento real en vivo ("Banco (38/40)"). -->
                                                    <ItemsControl x:Name="AlmacenesSelector" ItemsSource="{Binding Options}" Margin="0,0,12,0">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:EquipmentOptionViewModel}">
                                                                <Button Content="{Binding DisplayLabel}" Style="{StaticResource PrefixMetaButton}"
                                                                        Command="{Binding DataContext.StorageGroup.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <!-- Auditoria de redimensionado, R-01: WrapPanel por el mismo motivo que la
                                                         cabecera de Inventario (H-08). -->
                                                    <WrapPanel VerticalAlignment="Center">
                                                        <!-- H5-03: mismos 3 botones reales que Inventario, operando sobre
                                                             el almacen SELECCIONADO ahora mismo (Current) - igual que
                                                             Ordenar/Vaciar contenedor ya hacen aqui al lado. -->
                                                        <Button Content="{Binding Loc[action_save_set], Mode=OneWay}" Click="OnSaveStorageSetClick"
                                                                ToolTip="{Binding Loc[tt_save_storage_json], Mode=OneWay}"
                                                                Tag="Ghost" Padding="6,3" FontSize="10.5" Margin="0,0,6,0" />
                                                        <Button Content="{Binding Loc[action_load_ellipsis], Mode=OneWay}" Click="OnLoadStorageSetClick"
                                                                ToolTip="{Binding Loc[tt_load_storage_replace], Mode=OneWay}"
                                                                Tag="Ghost" Padding="6,3" FontSize="10.5" Margin="0,0,6,0" />
                                                        <Button Content="{Binding Loc[action_add_ellipsis], Mode=OneWay}" Click="OnAppendStorageSetClick"
                                                                ToolTip="{Binding Loc[tt_add_storage_fill], Mode=OneWay}"
                                                                Tag="Ghost" Padding="6,3" FontSize="10.5" Margin="0,0,6,0" />
                                                        <Button Content="{Binding Loc[action_sort], Mode=OneWay}" Command="{Binding Current.SortCommand}"
                                                                ToolTip="{Binding Loc[tt_sort_by_id], Mode=OneWay}" Tag="Ghost" Padding="6,3" FontSize="10.5" Margin="0,0,6,0" />
                                                        <Button Content="{Binding Loc[action_empty_container], Mode=OneWay}" Command="{Binding Current.ClearAllCommand}"
                                                                ToolTip="{Binding Loc[tt_empty_storage], Mode=OneWay}" Tag="Ghost" Padding="6,3" FontSize="10.5" />
                                                    </WrapPanel>
                                                </WrapPanel>
                                                <ContentControl Content="{Binding Current}" ContentTemplate="{StaticResource ContainerFlowTemplate}" />
                                            </DockPanel>
                                        </Border>
                                    </DockPanel>
                                    </Border>
                                    </controls:AjusteAlViewport>
                                </ScrollViewer>
                                </Grid>
                                <!-- NAV123: selector directo Equipamiento/Inventario/Almacenes - reemplaza el
                                     scroll libre + barra pegajosa (T3 PASO 2/3/4, retirados) que podia dejar el
                                     tablero a medio camino entre dos secciones o desincronizar el indicador
                                     cuando ScrollViewer clampaba el offset (bug real "toggle 3 desincronizado",
                                     Almacenes con pocos objetos - ver bitacora.md). 3 pastillas numeradas
                                     ("1"/"2"/"3", pedido explicito del usuario: "visualmente muy sencillo"),
                                     Style ViewSelector (Theme.xaml, TargetType=ToggleButton, MISMO mecanismo
                                     real ya usado por los selectores de "vista" de Cofres/Objetos en
                                     Exploracion). RadioButton (deriva de ToggleButton) con GroupName para mutua
                                     exclusion real sin logica manual. Flotante sobre ObjetosPageHost, ZIndex por
                                     encima de las 3 paginas, SIEMPRE visible sin necesidad de scroll. Click
                                     llama directo a MainViewModel.RequestObjetosSection (MainWindow.xaml.cs) -
                                     que solo escribe ObjetosSubTabIndex; la Visibility de cada pagina reacciona
                                     sola al binding, sin ningun calculo de offset/scroll de por medio. Ya no
                                     existe sincronizacion inversa por scroll (cada pagina tiene su scroll
                                     interno propio, nunca "avanza" a la seccion siguiente). -->
                                <!-- NAV123 centrado real (26-sep-2026): x:Name="ObjetosNavToggle" pasa del
                                     StackPanel al Grid que lo envuelve para conservar el mismo padre
                                     compartido con ObjetosPageHost (Grid sin nombre de mas arriba). Este Grid
                                     define la fila Auto con el mismo SharedSizeGroup="ObjetosHeaderRow" que el
                                     titulo de cada pagina - su alto queda sincronizado al maximo real entre
                                     ViewSelector y SectionText, y el StackPanel interior se centra en esa fila
                                     con VerticalAlignment="Center" (ya no hay Margin superior fijo). -->
                                <!-- FASE C del responsive global (hallazgo del revisor de la FASE B): los botones eran
                                     "1"/"2"/"3" sin etiqueta, a la derecha, junto a los 1/2/3 de Loadout (que significan otra
                                     cosa). Ahora llevan icono real del juego + nombre de la pagina (y su tooltip), van a la
                                     izquierda y hacen de encabezado de la pagina (el titulo suelto de cada pagina se retira:
                                     duplicaba el boton marcado). Mismos RadioButton, mismo GroupName/Tag/Click/IsChecked:
                                     la navegacion no cambia. Caben enteros en el minimo (~330px de ~630 en ES). -->
                                <Grid x:Name="ObjetosNavToggle" HorizontalAlignment="Left" VerticalAlignment="Top"
                                      Panel.ZIndex="5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" SharedSizeGroup="ObjetosHeaderRow" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- IsChecked ligado (TwoWay por defecto) a ObjetosSubTabIndex via EnumEquals
                                             (mismo converter/patron ya usado por Exploration.ChestViewMode arriba en
                                             este mismo fichero) - asi el selector refleja SIEMPRE la pagina real
                                             incluso cuando quien la cambia no es un clic aqui (WhereIsIt/busqueda
                                             global, via RequestObjetosSection). El Click sigue llamando a
                                             RequestObjetosSection para no depender solo de ConvertBack. -->
                                        <RadioButton x:Name="ObjetosNavToggle1" Style="{StaticResource ViewSelector}" GroupName="ObjetosSeccionNav"
                                                     Padding="10,4" FontSize="12" Tag="0" Click="OnObjetosNavToggleClick"
                                                     IsChecked="{Binding ObjetosSubTabIndex, Converter={StaticResource EnumEquals}, ConverterParameter=0}"
                                                     ToolTip="{Binding Loc[char_tab_equipment], Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="pack://siteoforigin:,,,/Assets/vanilla/icons/81.png" Width="16" Height="16" Margin="0,0,6,0"
                                                       Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Loc[char_tab_equipment], Mode=OneWay}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="ObjetosNavToggle2" Style="{StaticResource ViewSelector}" GroupName="ObjetosSeccionNav"
                                                     Padding="10,4" FontSize="12" Tag="1" Click="OnObjetosNavToggleClick"
                                                     IsChecked="{Binding ObjetosSubTabIndex, Converter={StaticResource EnumEquals}, ConverterParameter=1}"
                                                     ToolTip="{Binding Loc[char_tab_inventory], Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="pack://siteoforigin:,,,/Assets/vanilla/icons/48.png" Width="16" Height="16" Margin="0,0,6,0"
                                                       Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Loc[char_tab_inventory], Mode=OneWay}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="ObjetosNavToggle3" Style="{StaticResource ViewSelector}" GroupName="ObjetosSeccionNav"
                                                     Padding="10,4" FontSize="12" Tag="2" Click="OnObjetosNavToggleClick"
                                                     IsChecked="{Binding ObjetosSubTabIndex, Converter={StaticResource EnumEquals}, ConverterParameter=2}"
                                                     ToolTip="{Binding Loc[char_tab_storage], Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="pack://siteoforigin:,,,/Assets/vanilla/icons/87.png" Width="16" Height="16" Margin="0,0,6,0"
                                                       Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Loc[char_tab_storage], Mode=OneWay}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </RadioButton>
                                    </StackPanel>
                                </Grid>
                                </Grid>

                                <Border Grid.Column="1" Style="{StaticResource SidePanelCard}">
                                    <ContentControl Content="{Binding ItemEdit}" ContentTemplate="{StaticResource ItemEditTemplate}" />
                                </Border>
                            </Grid>

                            <!-- Libreria: arbol de carpetas real (vanilla + Calamity, ver
                                 LibraryViewModel.BuildCategoryTree) + buscador, SIEMPRE visible aqui abajo. -->
                            <Border Grid.Row="1" Background="{StaticResource BgSecondaryBrush}" CornerRadius="8" Padding="8">
                                <DockPanel>
                                    <!-- Cabecera SIEMPRE visible (pregunta a Opus sobre el diseño,
                                         2-sep-2026: plegar la Libreria es la mayor ganancia de
                                         espacio real de toda la pantalla, mas que optimizar las
                                         pestañas) - se puede plegar/desplegar a mano, y se
                                         auto-despliega sola al elegir "Elegir..."/"Cambiar" en
                                         cualquier slot (MainViewModel.RequestPickForSlot), para que
                                         nunca quede escondida justo cuando hace falta. -->
                                    <!-- T-H/F1: Ctrl+F ya salta aqui Y despliega esta Libreria (OnWindowKeyDown) -
                                         no se anunciaba en ningun sitio. -->
                                    <Button DockPanel.Dock="Top" Command="{Binding ToggleLibraryCollapsedCommand}"
                                            Style="{StaticResource BarButton}" ToolTip="{Binding Loc[tt_ctrlf_library], Mode=OneWay}"
                                            HorizontalContentAlignment="Stretch" Padding="8,5" Margin="0,0,0,4">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                                <TextBlock.Style>
                                                    <!-- Ronda de Libreria/Builds del 6-sep-2026: los dos rotulos eran
                                                         texto ESPAÑOL FIJO ("▲ Plegar"/"▼ Desplegar") desde que se
                                                         creo la cabecera plegable - con la app en ingles se quedaban
                                                         en español para siempre. No lo cazo A10-IDIOMA-BARRIDO
                                                         porque su heuristica busca palabras funcionales españolas
                                                         ("la", "de", "versión"...) y estos dos rotulos son una sola
                                                         palabra sin ninguna. Un Binding SI vale dentro de un
                                                         Setter.Value (se evalua contra el DataContext heredado, aqui
                                                         MainViewModel, que ya expone Loc). -->
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding Loc[library_collapse], Mode=OneWay}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLibraryCollapsed}" Value="True">
                                                                <Setter Property="Text" Value="{Binding Loc[library_expand], Mode=OneWay}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Loc[library_title], Mode=OneWay}" Style="{StaticResource SectionText}" FontSize="12.5" />
                                        </DockPanel>
                                    </Button>

                                    <Border DockPanel.Dock="Top" Background="{StaticResource AccentBrush}" CornerRadius="6" Padding="8,5" Margin="0,0,0,6"
                                            Visibility="{Binding Library.IsPicking, Converter={StaticResource ObjetosBoolToVis}}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="{Binding Loc[action_cancel], Mode=OneWay}" Command="{Binding Library.CancelPickCommand}"
                                                    Tag="Ghost" Foreground="{StaticResource BgPrimaryBrush}" Padding="6,2" ToolTip="{Binding Loc[shortcut_esc], Mode=OneWay}" />
                                            <TextBlock Text="{Binding Loc[library_pick_item_placeholder], Mode=OneWay}"
                                                       Foreground="{StaticResource BgPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="11.5" />
                                        </DockPanel>
                                    </Border>

                                    <Grid Visibility="{Binding IsLibraryVisible, Converter={StaticResource ObjetosBoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="210" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{StaticResource BgPrimaryBrush}" CornerRadius="6"
                                                Padding="5" Margin="0,0,8,0">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Top" Content="{Binding Loc[action_view_all], Mode=OneWay}" HorizontalAlignment="Left"
                                                        Padding="5,2" FontSize="10" Margin="0,0,0,4"
                                                        Command="{Binding Library.ClearCategoryCommand}" />
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding Library.RootCategories}"
                                                                  ItemTemplate="{StaticResource ObjetosCategoryNodeTemplate}" />
                                                </ScrollViewer>
                                            </DockPanel>
                                        </Border>

                                        <DockPanel Grid.Column="1">
                                            <!-- H4-01 (cuarta auditoria de Opus, Fable): MaxWidth CON
                                                 HorizontalAlignment="Left" mide al contenido (colapsaba a
                                                 ~30px vacio, crecia letra a letra al escribir) - quitado
                                                 Left, el DockPanel ya estira este hijo a lo ancho por
                                                 omision (igual que el TextBlock de resumen de debajo),
                                                 MaxWidth solo pone un techo en ventanas grandes. Marcador
                                                 de posicion real (Grid con TextBlock superpuesto,
                                                 IsHitTestVisible=False) para que se reconozca como
                                                 buscador de un vistazo, sin esperar a escribir. -->
                                            <!-- Fila de busqueda + boton "Filtros" (encargo del usuario, 13-sep-2026:
                                                 "amplia la busqueda con filtros combinables"). DockPanel en vez de
                                                 agrandar el Grid de abajo: el boton (ancho fijo, a la derecha) y el
                                                 buscador (el resto, MISMO MaxWidth=360 de siempre, ver H4-01) tienen
                                                 que repartirse el ancho, no superponerse - un Grid con columnas fijas
                                                 hubiera exigido medir el boton a mano. -->
                                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                                <Button x:Name="LibraryFiltersButton" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="9,5" FontSize="11"
                                                        Command="{Binding Library.ToggleFiltersOpenCommand}"
                                                        ToolTip="{Binding Loc[library_filter_title], Mode=OneWay}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Library.HasActiveFilters}" Value="True">
                                                                    <Setter Property="Tag" Value="AccentSoft" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding Loc[library_filter_button], Mode=OneWay}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Library.HasActiveFilters}" Value="True">
                                                                        <Setter Property="Text">
                                                                            <Setter.Value>
                                                                                <MultiBinding Converter="{StaticResource LocFormat}">
                                                                                    <Binding Path="Loc[library_filter_button_active]" Mode="OneWay" />
                                                                                    <Binding Path="Library.ActiveFilterCount" Mode="OneWay" />
                                                                                </MultiBinding>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button>
                                                <Grid MaxWidth="360">
                                                    <TextBox x:Name="LibrarySearchBox" Text="{Binding Library.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                             Padding="7,5" Background="{StaticResource BgElevatedBrush}"
                                                             Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0"
                                                             FontSize="12"
                                                             ToolTip="{Binding Loc[tt_search_grammar_full], Mode=OneWay}" />
                                                    <TextBlock Text="{Binding Loc[action_search_ellipsis], Mode=OneWay}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextSecondaryBrush}" IsHitTestVisible="False"
                                                               Visibility="{Binding Library.SearchText, Converter={StaticResource EmptyToVisible}}" />
                                                </Grid>
                                            </DockPanel>

                                            <!-- Popup real de filtros (mismo mecanismo que WhereIsItPopup: anclado
                                                 al boton, StaysOpen=False lo cierra con un clic fuera). Tres grupos
                                                 de pastillas (Rareza/Tipo de daño/Ranura de equipo) en WrapPanel -
                                                 ver LibraryFilterChipViewModel y LibraryViewModel.ApplyFilter. -->
                                            <Popup DockPanel.Dock="Top" x:Name="LibraryFiltersPopup" IsOpen="{Binding Library.IsFiltersOpen}"
                                                   PlacementTarget="{Binding ElementName=LibraryFiltersButton}"
                                                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                                <Border Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource AccentBrush}"
                                                        BorderThickness="1" CornerRadius="8" Padding="14" Width="420" Effect="{StaticResource CardShadow}">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,8">
                                                            <TextBlock Text="{Binding Loc[library_filter_title], Mode=OneWay}" Style="{StaticResource SectionText}" />
                                                            <Button DockPanel.Dock="Right" Content="{Binding Loc[library_filter_clear], Mode=OneWay}"
                                                                    Command="{Binding Library.ClearFiltersCommand}" Tag="Ghost" Padding="6,2" FontSize="10.5"
                                                                    Visibility="{Binding Library.HasActiveFilters, Converter={StaticResource ObjetosBoolToVis}}" />
                                                        </DockPanel>

                                                        <TextBlock Text="{Binding Loc[library_filter_rarity_group], Mode=OneWay}" Style="{StaticResource CaptionText}" Margin="0,4,0,4" />
                                                        <ItemsControl ItemsSource="{Binding Library.RarityChips}" Margin="0,0,0,4">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Style="{StaticResource LibraryFilterChipButton}"
                                                                            Command="{Binding DataContext.Library.ToggleRarityChipCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <Ellipse Width="8" Height="8" Margin="0,0,5,0" VerticalAlignment="Center"
                                                                                     Fill="{Binding SwatchBrush}"
                                                                                     Visibility="{Binding SwatchBrush, Converter={StaticResource NullToVis}}" />
                                                                            <TextBlock Text="{Binding Label}" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Text="{Binding Loc[library_filter_rarity_hint], Mode=OneWay}" Style="{StaticResource CaptionText}"
                                                                   FontSize="10" TextWrapping="Wrap" Margin="0,0,0,10" />

                                                        <TextBlock Text="{Binding Loc[library_filter_damage_group], Mode=OneWay}" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                                        <ItemsControl ItemsSource="{Binding Library.DamageKindChips}" Margin="0,0,0,10">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Content="{Binding Label}" Style="{StaticResource LibraryFilterChipButton}"
                                                                            Command="{Binding DataContext.Library.ToggleDamageKindChipCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <TextBlock Text="{Binding Loc[library_filter_equip_group], Mode=OneWay}" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                                        <ItemsControl ItemsSource="{Binding Library.EquipSlotChips}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Content="{Binding Label}" Style="{StaticResource LibraryFilterChipButton}"
                                                                            Command="{Binding DataContext.Library.ToggleEquipSlotChipCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </Popup>
                                            <!-- L-b (segunda auditoria de Opus, Fable): "el aviso de 'solo validos
                                                 para el slot seleccionado' es un texto mas, facil de pasar por
                                                 alto - y ni siquiera dice CUAL slot". Pildora real y separada, con
                                                 el rol real del slot (Cabeza/Accesorio 3/Tinte...). -->
                                            <!-- Familia "StateTagNeutral" (rediseno de badges, 25-sep-2026): el
                                                 violeta-acento queda reservado a la familia Metrica (recuento
                                                 real) - esto es una restriccion informativa, no una metrica. -->
                                            <Border DockPanel.Dock="Top" Style="{StaticResource StateTagNeutral}"
                                                    Margin="0,0,0,6" HorizontalAlignment="Left"
                                                    Visibility="{Binding Library.SlotRestrictionLabel, Converter={StaticResource NullToVis}}">
                                                <TextBlock Style="{StaticResource CaptionText}">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource LocFormat}">
                                                            <Binding Path="Loc[library_only_valid_for]" Mode="OneWay" />
                                                            <Binding Path="Library.SlotRestrictionLabel" Mode="OneWay" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Border>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding Library.ResultsSummary}" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                            <!-- Pregunta a Opus sobre el diseño (2-sep-2026, quinta pasada: "la libreria
                                                 sigue sin tener las rejillas como en inventario... no debe tener scroll a
                                                 menos que sea una categoria que logicamente tiene muchos ítems"). Misma
                                                 SlotGridPanel que el resto de la app - con estos parametros reales
                                                 (medidos contra la franja real de ~772x186px) no aparece scroll hasta
                                                 ~48 resultados (4 filas x 12 columnas a MinCell=40), y con pocos
                                                 resultados la celda crece hasta MaxCell=96 topada por ReferenceColumns=10
                                                 (~73px aqui) - ni vacio ni deforme. MinCell=40 en vez de 44 a proposito:
                                                 con 44 el scroll aparecia por solo 2px de diferencia real (4*44+12=188
                                                 contra 186 disponibles). Sin AvailableHeight el panel mediria con alto
                                                 infinito y SIEMPRE elegiria MaxCell + SIEMPRE scrollearia. -->
                                            <!-- H5-13 (quinta auditoria de Opus): "el estado vacio de la Libreria...
                                                 es un rectangulo en blanco - sin busqueda/carpeta/restriccion de
                                                 slot, la mitad derecha del panel es superficie muerta". Mismo
                                                 mecanismo real ya en produccion en Investigacion (H4-07 punto 3,
                                                 ShowRootCategoryCards - subido a la base compartida por H5-15) -
                                                 tarjetas grandes (NavCardButton) a las carpetas RAIZ reales, un
                                                 atajo mas grande al mismo arbol de la izquierda. -->
                                            <!-- imagen2/LIBCARD_CLIP_SOLO (24/25-sep-2026, revision-correccion-integral-
                                                 familia-Keep): sin clearance real la fila 1 quedaba pegada a Y=0 del
                                                 ScrollViewer, y el TranslateTransform "BdLift" de NavCardButton
                                                 (Theme.xaml, Trigger IsMouseOver, -3px) caia fuera del area que el
                                                 ScrollViewer recorta - 3,00px de recorte real medidos por el canario.
                                                 IMPORTANTE: el Padding va en el CONTENIDO (este ItemsControl), NUNCA en
                                                 el propio ScrollViewer - Padding ahi se traduce en Margin del
                                                 ScrollContentPresenter (plantilla por defecto de WPF), que desplaza a
                                                 la vez la CAJA que recorta Y el contenido que lleva dentro (medido:
                                                 mismo 3px de recorte, solo trasladado en bloque, cero mejora real).
                                                 Con el Margin en el ItemsControl la caja de recorte NO se mueve y el
                                                 contenido si queda mas abajo dentro de ella - clearance real. Arreglo
                                                 estructural (NO bajar el lift a 0 ni tapar con Clip/Effect). -->
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          Visibility="{Binding Library.ShowRootCategoryCards, Converter={StaticResource ObjetosBoolToVis}}">
                                                <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Library.RootCategories}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:CategoryNodeViewModel}">
                                                            <Button Style="{StaticResource NavCardButton}" Width="200" MinHeight="90" Margin="0,0,12,12"
                                                                    Command="{Binding SelectCommand}" CommandParameter="{Binding}">
                                                                <StackPanel>
                                                                    <!-- AR-LAY (6-sep-2026): DockPanel, NO StackPanel Horizontal - el
                                                                         MISMO bug que CategoryNodeTemplate ya documenta arriba
                                                                         (R-06/H-06), que se quedo sin arreglar en las tarjetas de
                                                                         carpeta raiz. Un StackPanel horizontal mide a sus hijos con
                                                                         ancho INFINITO, asi que el TextWrapping del nombre no se
                                                                         aplicaba NUNCA: el texto tomaba su ancho natural y se salia
                                                                         de la tarjeta (Width=200 fija), cortado en seco contra el
                                                                         borde del Button y sin ningun scroll horizontal con el que
                                                                         alcanzarlo. Medido a 1080x700: "Mascotas, Monturas,
                                                                         Herramientas" pedia 221px en una tarjeta de 200 y perdia
                                                                         89px. Un DockPanel SI da al ultimo hijo el ancho restante
                                                                         real, y el Wrap funciona solo a cualquier ancho. -->
                                                                    <DockPanel Margin="0,0,0,6">
                                                                        <Image DockPanel.Dock="Left" Source="{Binding IconPath}" Width="22" Height="22" Stretch="Uniform" Margin="0,0,8,0"
                                                                               Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource SectionText}" TextWrapping="Wrap"
                                                                                   VerticalAlignment="Center" />
                                                                    </DockPanel>
                                                                    <TextBlock Text="{Binding ItemCountLabel, Mode=OneWay}"
                                                                               Style="{StaticResource CaptionText}" />
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                            <!-- Auditoria de Opus, L-7: x:Name muerto, sin ningun uso real en el
                                                 codigo-behind - limpieza real, no cambio de comportamiento. -->
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                          Visibility="{Binding Library.ShowRootCategoryCards, Converter={StaticResource InverseBoolToVis}}">
                                                <ItemsControl ItemsSource="{Binding Library.Results}" ItemTemplate="{StaticResource LibraryCardTemplate}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <!-- Modo compacto (17-sep-2026): ver el comentario real del primer uso de
                                                                 SlotGridPanel (ContainerCompactTemplate) mas arriba en este mismo fichero. -->
                                                            <controls:SlotGridPanel Columns="12"
                                                                                     MinCell="{Binding DataContext.Settings.IsCompactMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static conv:CompactCellSizeConverter.Instance}, ConverterParameter=40}"
                                                                                     MaxCell="{Binding DataContext.Settings.IsCompactMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static conv:CompactCellSizeConverter.Instance}, ConverterParameter=90}"
                                                                                     Gap="{Binding DataContext.Settings.IsCompactMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static conv:CompactGapConverter.Instance}}"
                                                                                     ReferenceColumns="10"
                                                                                     AvailableHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </DockPanel>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </Grid>
</UserControl>
