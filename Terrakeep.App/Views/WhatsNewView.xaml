<!-- ADR-TERRAKEEP-016/017 (26-sep-2026): PRIMERA extraccion real de una seccion de
     MainWindow.xaml a un UserControl (sin precedente XAML en este repo hasta hoy - ver el
     comentario real de ADR-TERRAKEEP-016, punto 3). Seccion NOVEDADES elegida por el propio
     plan como la de menor riesgo: sin x:Name (ningun test FindName la toca), sin code-behind
     propio, y sus 3 recursos (CaptionText/AccentBrush/InnerTabControl) ya viven en
     Styles/Theme.xaml via App.xaml - NINGUNO es window-scoped, no hizo falta promover nada.
     Contenido byte a byte igual al que tenia el TabItem "NOVEDADES" en MainWindow.xaml, solo
     movido de sitio. El DataContext NO se fija aqui a proposito (regla 2d del ADR): este
     control hereda el MainViewModel real desde el Window que lo hospeda, los Binding relativos
     (WhatsNew.VanillaEntries, Loc[...], DetailContentMaxWidth/DetailCardColumns) siguen
     funcionando igual que antes de la extraccion. -->
<UserControl x:Class="Terrakeep.App.Views.WhatsNewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Terrakeep.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,10">
            <Run Text="{Binding Loc[whatsnew_intro_1], Mode=OneWay}" />
            <Run Text="{Binding Loc[whatsnew_intro_game], Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
            <Run Text="{Binding Loc[whatsnew_intro_2], Mode=OneWay}" />
            <Run Text="{Binding Loc[whatsnew_intro_link], Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
            <Run Text="." />
        </TextBlock>
        <TabControl Style="{StaticResource InnerTabControl}">
            <!-- H5-09: MaxWidth compartido (DetailContentMaxWidth) + las tarjetas de version
                 pasan de tira unica a UniformGrid de verdad (DetailCardColumns, 2 en Amplio)
                 en vez de "una tira unica" (texto literal del hallazgo). -->
            <TabItem Header="Terraria">
                <ScrollViewer x:Name="WhatsNewTerrariaScroll" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="{Binding DetailContentMaxWidth}" HorizontalAlignment="Left">
                        <ItemsControl ItemsSource="{Binding WhatsNew.VanillaEntries}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="{Binding DetailCardColumns}" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="tModLoader / Calamity Mod">
                <ScrollViewer x:Name="WhatsNewCalamityScroll" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="{Binding DetailContentMaxWidth}" HorizontalAlignment="Left">
                        <ItemsControl ItemsSource="{Binding WhatsNew.CalamityEntries}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="{Binding DetailCardColumns}" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
