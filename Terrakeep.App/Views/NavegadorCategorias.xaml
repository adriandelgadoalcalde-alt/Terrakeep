<!-- FASE D del responsive global (28-sep-2026, PDF "Arreglo familia keep" bloque 2, s9-s14/s16/s19/s26 C/s28).
     Navegacion de categorias COMPARTIDA por la familia "catalogo con categorias": Libreria de objetos
     (ObjetosView), Libreria de buffs e Investigacion (MainWindow). UN solo control, no tres arreglos
     (s11). DataContext = el CatalogBrowserViewModel de cada superficie (Library/BuffLibrary/Research).

     MODELO VIEJO (RETIRADO en las 3 superficies): columna fija de 210px con el arbol completo dentro de
     su PROPIO ScrollViewer, al lado del ScrollViewer de resultados (y de otro mas para las tarjetas de
     carpeta raiz). Medido con LIBRARY_RESPONSIVE_SOLO a 1080x700: solo 4/10 categorias principales de la
     Libreria y 5/8 de la Libreria de buffs se veian sin desplazar ese scroll lateral; 2 scroll owners
     verticales por superficie; la seleccion en 3,17:1 de contraste.

     MODELO NUEVO:
       1. Fila de categorias PRINCIPALES (STRUCTURAL_FINITE, s3 A): "Ver todo" + todas las raices como
          pastillas en un WrapPanel - envuelve a otra linea si no caben, nunca se esconden detras de
          un scroll.
       2. UNA linea de ruta (s12, drill-down + flyout): migas de la ruta por debajo de la raiz ("> Pre-
          Hardmode > Cobre y estaño", cada miga lleva a su nivel) y un desplegable "Subcategorias de X
          (N)" con los hijos del nivel mas profundo que los tiene. Asi un arbol de 4 niveles con hasta
          40 hijos por nodo (Placeables de Calamity) cuesta UNA linea de alto en cualquier tamaño, en vez
          de un scroll propio.
     Los resultados quedan como UNICO scroll owner vertical de la superficie (s13). -->
<UserControl x:Class="Terrakeep.App.Views.NavegadorCategorias"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Terrakeep.App.ViewModels"
             xmlns:services="clr-namespace:Terrakeep.App.Services">
    <UserControl.Resources>
        <DataTemplate x:Key="PastillaCategoriaTemplate" DataType="{x:Type vm:CategoryNodeViewModel}">
            <Button Style="{StaticResource PastillaCategoria}" Command="{Binding SelectCommand}" CommandParameter="{Binding}"
                    AutomationProperties.Name="{Binding Name}">
                <DockPanel>
                    <Image DockPanel.Dock="Left" Source="{Binding IconPath}" Width="16" Height="16" Margin="0,0,5,0" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" VerticalAlignment="Center"
                           Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <!-- 1. Categorias principales. "Ver todo" a la izquierda como cabeza de la fila; si las raices no
             caben en una linea, envuelven debajo (nunca scroll). -->
        <DockPanel x:Name="CategoriasPrincipales">
            <Button x:Name="BotonVerTodo" DockPanel.Dock="Left" Style="{StaticResource PastillaVerTodo}" VerticalAlignment="Top"
                    Command="{Binding ClearCategoryCommand}"
                    Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[action_view_all], Mode=OneWay}" />
            <ItemsControl x:Name="RaicesCategorias" ItemsSource="{Binding RootCategories}" ItemTemplate="{StaticResource PastillaCategoriaTemplate}"
                          Focusable="False" IsTabStop="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DockPanel>

        <!-- 2. Linea de estado de la superficie: ruta + subcategorias (solo si la carpeta elegida tiene nivel
             por debajo o esta por debajo de una raiz) y el resumen de resultados (ResultsSummary, comun a las
             3 superficies) en la MISMA linea - si no caben, el resumen baja solo (WrapPanel). Medido: a
             1080x700 con la Libreria desplegada, ruta y resumen en filas separadas dejaban 23px de resultados. -->
        <WrapPanel x:Name="RutaSubcategorias">
            <ItemsControl ItemsSource="{Binding MigasCategoria}" Focusable="False" IsTabStop="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CategoryNodeViewModel}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#8250;" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="2,0,5,4" VerticalAlignment="Center" />
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PastillaCategoriaTemplate}" Focusable="False" IsTabStop="False" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- "Subcategorias (N)": el nombre del nivel ya se ve en la miga/pastilla resaltada justo antes - repetirlo
                 aqui partia la linea en dos a 1080px (medido: 35px de resultados). El tooltip lo nombra igualmente. -->
            <Button x:Name="BotonSubcategorias" Style="{StaticResource PastillaCategoriaBase}" Click="OnAbrirSubcategorias"
                    ToolTip="{Binding NodoSubcategorias.Name}"
                    Visibility="{Binding NodoSubcategorias, Converter={StaticResource NullToVis}}">
                <TextBlock Foreground="{StaticResource AccentHoverBrush}">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource LocFormat}">
                            <Binding Source="{x:Static services:LocalizationService.Instance}" Path="[library_subcategories]" Mode="OneWay" />
                            <Binding Path="NodoSubcategorias.Children.Count" Mode="OneWay" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Button>
            <Popup x:Name="PopupSubcategorias" PlacementTarget="{Binding ElementName=BotonSubcategorias}" Placement="Bottom"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="10,10,6,6" MaxWidth="480" Effect="{StaticResource CardShadow}">
                    <ItemsControl x:Name="ListaSubcategorias" ItemsSource="{Binding NodoSubcategorias.Children}" Focusable="False" IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CategoryNodeViewModel}">
                                <Button Style="{StaticResource PastillaCategoria}" Command="{Binding SelectCommand}" CommandParameter="{Binding}"
                                        Click="OnSubcategoriaElegida" AutomationProperties.Name="{Binding Name}">
                                    <DockPanel>
                                        <Image DockPanel.Dock="Left" Source="{Binding IconPath}" Width="16" Height="16" Margin="0,0,5,0" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor" VerticalAlignment="Center"
                                               Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Popup>
            <TextBlock x:Name="ResumenResultados" Text="{Binding ResultsSummary}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="2,0,0,3" />
        </WrapPanel>
    </StackPanel>
</UserControl>
