<!-- ADR-TERRAKEEP-016/021 (26-sep-2026): QUINTA extraccion real de una seccion de
     MainWindow.xaml a un UserControl, siguiendo el orden de menor a mayor riesgo del plan
     (punto 4.4, tras NOVEDADES en ADR-017, BUILDS en ADR-018, SERVIDOR en ADR-019 y ACERCA DE en
     ADR-020). Seccion GUIA elegida por ser el siguiente paso recomendado: autocontenida
     (Guide.*), sin FindName conocidos en los 9 archivos citados por el grep original de
     ADR-016 - aunque una relectura real (mismo criterio ya establecido por ADR-018/020: no
     fiarse solo del grep de FindName sin repasar tambien el resto del arnes) encontro un x:Name
     real, GuideObjetivoBanner, usado por window.FindName(...) en
     Terrakeep.App.Tests/PruebasGuiaYServidor.cs (2 sitios, ver mas abajo).

     Esta seccion SI referencia un recurso window-scoped DIRECTAMENTE en su propio markup:
     {StaticResource BoolToVis} (BooleanToVisibilityConverter, x:Key SOLO en Window.Resources de
     MainWindow.xaml, 7 usos reales dentro de este bloque) - mismo caso ya resuelto por
     ADR-TERRAKEEP-019/HostingView: NUNCA promover a Application.Resources (rompe
     MainWindow.InitializeComponent() entero en runtime, tabla BAML OptimizedStaticResource
     compartida por ensamblado), en su lugar un <UserControl.Resources> LOCAL con clave propia
     (GuideBoolToVis) resuelto durante el propio InitializeComponent() de este UserControl. El
     resto de recursos que usa esta seccion (InverseBoolToVis/NullToVis/NullToCollapsed/
     EmptyToCollapsed y todos los brushes/estilos) ya viven en Styles/Theme.xaml o App.xaml -
     confirmado con grep exhaustivo, ninguno de esos vive SOLO en MainWindow.xaml.

     x:Name="GuideObjetivoBanner" (linea real mas abajo) SE MANTIENE en este UserControl - un
     UserControl compilado con su propia XAML es dueño de su propio NameScope (registrado durante
     su propio InitializeComponent()), asi que window.FindName("GuideObjetivoBanner") en el test
     original dejaria de encontrarlo tras la extraccion (paso 2b del plan ADR-016: el nombre pasa
     a vivir en el NameScope del UserControl, no en el del Window). Resuelto con el segundo camino
     que el propio ADR-016 dejaba por escrito (nunca tocar NameScope en tiempo de construccion,
     mas fragil por el orden real de instanciacion top-down de WPF): se anade x:Name="GuideView"
     al <views:GuideView /> que queda en MainWindow.xaml, y los 2 call-sites de
     PruebasGuiaYServidor.cs pasan a window.FindName("GuideView") seguido de
     guideView.FindName("GuideObjetivoBanner") - FrameworkElement.FindName ya busca en el
     NameScope mas cercano en la ascendencia O EN SI MISMO si el propio elemento es dueño de uno,
     asi que llamar FindName directamente sobre la instancia de GuideView encuentra el elemento
     sin ningun cambio en GuideView.xaml.cs.

     Contenido copiado BYTE A BYTE del TabItem "GUIA" en MainWindow.xaml (solo re-indentado al
     moverse de sitio, ningun caracter de contenido cambiado salvo BoolToVis->GuideBoolToVis) -
     el UserControl no fija su propio DataContext, hereda el MainViewModel real del Window. -->
<UserControl x:Class="Terrakeep.App.Views.GuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Terrakeep.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="GuideBoolToVis" />
    </UserControl.Resources>
    <!-- FASE G del responsive global (WARN-02, s17): a 1920/2560 el objetivo actual (columna
         izquierda, MaxWidth=680 de siempre) dejaba mas de la mitad del ancho disponible vacio -
         medido con RESTO_RESPONSIVE_SOLO (RESTO-GUIA-ANCHO: 40%/29% de uso a 1920/2560). El arbol
         de progresion completo (antes debajo de todo) pasa a columna derecha en Amplio/Extra
         (IsDetailSideBySide) - mismo contenido/bindings de siempre, solo reposicionado con un
         Style/DataTrigger sobre Grid.Row/Grid.Column (sin duplicar el ItemsControl). En
         Compacto/Normal sigue apilado debajo, igual que siempre (columna derecha colapsa a Auto/0
         via BoolToGridLength, ya usado en el resto del repo). -->
    <!-- Responsive global s33 condicion 15 (29-sep-2026): x:Name real anadido para que
         __perfiles-responsive__/Terrakeep.json (KeepQA) pueda declarar scrollOwnership sin
         inventar nombres - unico ScrollViewer de la vista, arbol de Guia real, potencialmente
         largo, scroll legitimo (s23). Cambio de solo nombre, sin tocar layout. -->
    <ScrollViewer x:Name="GuideContentScroll" Margin="14" VerticalScrollBarVisibility="Auto">
        <!-- FASE G (hallazgo propio, segunda vuelta): HorizontalAlignment="Left" en este Grid
             (copiado del StackPanel original que sustituye) es INCOMPATIBLE con una columna "*" -
             un Grid alineado a la izquierda se auto-dimensiona a su contenido NATURAL (measure con
             ancho infinito, como da cualquier ScrollViewer), nunca crece hasta MaxWidth, asi que la
             columna "*" nunca tiene "sobrante" real que repartir (medido: la tarjeta de la columna
             derecha se quedaba en su ancho natural, ~330-400px, ignorando por completo el MaxWidth=
             680 que se le habia quitado). Sin HorizontalAlignment (Stretch, el valor por defecto),
             MaxWidth actua como TOPE del ancho efectivo de Measure (WPF clampa el available size a
             MaxWidth antes de MeasureOverride, incluso con un ScrollViewer ancestro ofreciendo
             infinito) - la columna "*" pasa a calcularse sobre MaxWidth-AutoColumnWidth, un numero
             REAL, y en ventanas angostas (Compacto, MaxWidth=900) sigue sin desbordar porque Stretch
             tambien respeta el ancho real disponible cuando es MENOR que MaxWidth. -->
        <Grid MaxWidth="{Binding DetailContentMaxWidth}">
            <Grid.ColumnDefinitions>
                <!-- REGRESION REAL #2 (verificador QA final, 29-sep-2026, tras arreglar el bug de
                     precedencia local/Style): una ColumnDefinition Width="Auto" se MIDE con ancho
                     INFINITO (asi es como Grid averigua el tamaño "natural" de una columna Auto) -
                     cualquier TextWrapping="Wrap" dentro deja de envolver de verdad (nada que
                     envolver contra "infinito"), y el texto mas largo posible fija el ancho de TODA
                     la columna. En Compacto/Normal (apilado), la columna 0 aloja ADEMAS el bloque
                     secundario (Changelog de AcercaDe, arbol de Guia, instancias de Hosting) - el
                     Changelog (plantilla compartida de MainWindow.xaml, TextWrapping=Wrap sin
                     MaxWidth propio, siempre confio en el MaxWidth del StackPanel contenedor de
                     ANTES de esta fase) media miles de px de ancho natural sin envolver, arrastrando
                     tambien "Autoria"/"Ajustes" (misma columna) a un recorte horizontal real.
                     MaxWidth="680" en la propia ColumnDefinition SI limita el ancho efectivo de
                     Measure de una columna Auto (a diferencia de un StackPanel/Grid normal, una
                     ColumnDefinition SI respeta su propio Min/MaxWidth durante el Measure) -
                     restaura el mismo comportamiento de wrapping de antes de la FASE G, sin tocar la
                     plantilla compartida del Changelog ni ninguno de los MaxWidth=680 ya existentes
                     (que se quedan igual, esto es solo un cinturon de seguridad adicional). -->
                <ColumnDefinition Width="Auto" MaxWidth="680" />
                <ColumnDefinition Width="{Binding IsDetailSideBySide, Converter={StaticResource BoolToGridLength}, ConverterParameter=1}" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Grid.Column="0">
            <TextBlock Text="{Binding Loc[tab_guide], Mode=OneWay}" Style="{StaticResource TitleText}" FontSize="26" Margin="0,4,0,4" />
            <TextBlock Text="{Binding Loc[guide_subtitle], Mode=OneWay}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" MaxWidth="680" HorizontalAlignment="Left" Margin="0,0,0,4" />
            <TextBlock Text="{Binding Loc[guide_desktop_notice], Mode=OneWay}" Style="{StaticResource CaptionText}" FontStyle="Italic" TextWrapping="Wrap" MaxWidth="680" HorizontalAlignment="Left" Margin="0,0,0,18" />

            <!-- Aviso de Calamity detectado - mismo texto real que ya usa el mod. -->
            <Border Background="{StaticResource BgElevatedBrush}" BorderBrush="{StaticResource CalamityBrush}" BorderThickness="1" CornerRadius="8"
                    Padding="14,11" Margin="0,0,0,20" MaxWidth="680" HorizontalAlignment="Left"
                    Visibility="{Binding Guide.MostrarAvisoCalamity, Converter={StaticResource GuideBoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding Guide.TextoAvisoCalamityTitulo, Mode=OneWay}" Style="{StaticResource SectionText}" Foreground="{StaticResource CalamityBrush}" />
                    <TextBlock Text="{Binding Guide.TextoAvisoCalamity, Mode=OneWay}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Sin personaje ni mundo cargados: no hay nada que evaluar todavia. -->
            <Border Background="{StaticResource BgElevatedBrush}" CornerRadius="8" Padding="16,14" Margin="0,0,0,20" MaxWidth="680" HorizontalAlignment="Left"
                    Visibility="{Binding Guide.HasAnyData, Converter={StaticResource InverseBoolToVis}}">
                <TextBlock Text="{Binding Loc[guide_empty_state], Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
            </Border>

            <!-- Mundo cargado, SIN personaje: bug real reportado en directo (16-sep-2026)
                 - la mayoria de requisitos (Objeto/Gancho, necesitan el .plr) se ven "no
                 evaluable" y antes solo se explicaba letra pequeña, uno por uno, bajo cada
                 linea - facil de no leer entre docenas de requisitos identicos. Un aviso
                 unico y visible lo dice una sola vez, arriba de todo. -->
            <Border Background="{StaticResource BgElevatedBrush}" BorderBrush="{StaticResource OrangeBrush}" BorderThickness="1" CornerRadius="8"
                    Padding="14,11" Margin="0,0,0,20" MaxWidth="680" HorizontalAlignment="Left"
                    Visibility="{Binding Guide.MostrarAvisoSinPersonaje, Converter={StaticResource GuideBoolToVis}}">
                <TextBlock Text="{Binding Guide.TextoAvisoSinPersonaje, Mode=OneWay}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
            </Border>

            <!-- Guia Fase B (26-sep-2026): espejo exacto del aviso de arriba - personaje
                 cargado, SIN mundo (el .plr no guarda nada del mundo: NPCs del pueblo,
                 banderas de jefe derrotado, etc. se quedan NoEvaluable hasta cargar un
                 .wld). Mutuamente excluyente con el aviso de "sin personaje" por
                 construccion (GuideViewModel.Refresh: uno exige loaded==null, el otro
                 loaded!=null) - nunca se ven los dos a la vez, ya verificado en
                 GuiaFaseAReabiertaViewModelTests.MostrarAvisoSinMundoYSinPersonaje_
                 SonMutuamenteExcluyentes_NuncaLosDosTrueALaVez. -->
            <Border Background="{StaticResource BgElevatedBrush}" BorderBrush="{StaticResource OrangeBrush}" BorderThickness="1" CornerRadius="8"
                    Padding="14,11" Margin="0,0,0,20" MaxWidth="680" HorizontalAlignment="Left"
                    Visibility="{Binding Guide.MostrarAvisoSinMundo, Converter={StaticResource GuideBoolToVis}}">
                <TextBlock Text="{Binding Guide.TextoAvisoSinMundo, Mode=OneWay}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
            </Border>

            <!-- Objetivo actual - la tarjeta destacada, mismo tratamiento visual que el
                 "Continuar con..." de Inicio (degradado de acento + sombra). -->
            <!-- x:Name real (Encargo3, 25-sep-2026) solo para que el arnes pueda
                 BringIntoView() esta tarjeta antes de capturar evidencia - la pestaña Guia
                 entera vive en un ScrollViewer y el banner puede quedar fuera del viewport
                 tras expandir tramos mas abajo en la misma prueba. -->
            <StackPanel x:Name="GuideObjetivoBanner" Margin="0,0,0,10" Visibility="{Binding Guide.ObjetivoPaso, Converter={StaticResource NullToVis}}">
                <TextBlock Text="{Binding Guide.TextoObjetivoActual, Mode=OneWay}" Style="{StaticResource SectionText}" Margin="0,0,0,10" />
                <Border Background="{StaticResource AccentGradientBrush}" CornerRadius="10" Padding="18,14" Effect="{StaticResource CardShadow}"
                        MaxWidth="680" HorizontalAlignment="Left">
                    <DockPanel>
                        <!-- Encargo3 (24-sep-2026): sprite real del hito (jefe/objeto/NPC-vecino),
                             GuidePasoViewModel.IconPath - mismo tratamiento de pastilla
                             translucida ya usado en los KPI del hero de Inicio (#26FFFFFF,
                             MainWindow.xaml:2594/2600/2609). Visibilidad PROPIA: null es un
                             resultado real (paso sin objeto/NPC/jefe con sprite conocido, ver
                             ResolverIconoDelHito) - nunca un hueco roto. -->
                        <Border DockPanel.Dock="Left" Background="#26FFFFFF" CornerRadius="8" Width="48" Height="48"
                                Margin="0,0,14,0" VerticalAlignment="Top"
                                Visibility="{Binding Guide.ObjetivoPaso.IconPath, Converter={StaticResource NullToVis}}">
                            <Image Source="{Binding Guide.ObjetivoPaso.IconPath}" Width="40" Height="40" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        </Border>
                        <StackPanel>
                        <TextBlock Text="{Binding Guide.ObjetivoTramo.Nombre, Mode=OneWay}" Foreground="White" FontSize="12" Opacity="0.85" />
                        <TextBlock Text="{Binding Guide.ObjetivoPaso.Titulo, Mode=OneWay}" Foreground="White" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" Margin="0,2,0,8" />
                        <TextBlock Foreground="White" Opacity="0.85" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2">
                            <Run Text="{Binding Guide.TextoPorQue, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Guide.ObjetivoPaso.Porque, Mode=OneWay}" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock Foreground="White" Opacity="0.85" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2">
                            <Run Text="{Binding Guide.TextoComo, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Guide.ObjetivoPaso.Como, Mode=OneWay}" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <TextBlock Foreground="White" Opacity="0.85" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4">
                            <Run Text="{Binding Guide.TextoQueTeFalta, Mode=OneWay}" />
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Guide.ObjetivoPaso.Requisitos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2,0,4">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Guia Fase B (26-sep-2026): EsLimiteEstructural (ej. NpcActivo - jamas
                                                 evaluable desde un editor de ficheros estaticos, a diferencia de un
                                                 NoEvaluable "temporal" que SI se resuelve cargando datos) cambia el
                                                 glifo a "no disponible" en vez de "pendiente". Dos TextBlock
                                                 superpuestos + Visibility (no un Setter de Style/DataTrigger sobre
                                                 Text: Icono ya llega por Binding LOCAL, que en WPF pesa mas que
                                                 cualquier Setter de Style/Trigger - pisarlo asi no funcionaria). -->
                                            <Grid Width="18" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Icono}" Foreground="White" FontWeight="Bold"
                                                           Visibility="{Binding EsLimiteEstructural, Converter={StaticResource InverseBoolToVis}}" />
                                                <TextBlock Text="⊘" Foreground="White" FontWeight="Bold" Opacity="0.75"
                                                           Visibility="{Binding EsLimiteEstructural, Converter={StaticResource GuideBoolToVis}}" />
                                            </Grid>
                                            <TextBlock Text="{Binding Linea}" Foreground="White" TextWrapping="Wrap" MaxWidth="560">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Recomendado}" Value="True">
                                                                <Setter Property="Opacity" Value="0.7" />
                                                                <Setter Property="FontStyle" Value="Italic" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding EsLimiteEstructural}" Value="True">
                                                                <Setter Property="Opacity" Value="0.6" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Motivo}" Foreground="White" Opacity="0.65" FontSize="10" FontStyle="Italic" TextWrapping="Wrap"
                                                   MaxWidth="540" Margin="24,1,0,0" Visibility="{Binding Motivo, Converter={StaticResource EmptyToCollapsed}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
            <TextBlock Text="{Binding Guide.TextoSinObjetivo, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" MaxWidth="680" HorizontalAlignment="Left"
                       Margin="0,0,0,10" Visibility="{Binding Guide.ObjetivoPaso, Converter={StaticResource NullToCollapsed}}" />
        </StackPanel>

        <!-- Arbol completo, como hoja de ruta - un Expander por tramo (colapsado por
             defecto, mismo patron ya usado en Exploracion para no abrir la pantalla
             entera de golpe con 46 tramos reales). Columna derecha en Amplio/Extra (junto al
             objetivo actual), apilado debajo en Compacto/Normal - ver comentario FASE G arriba. -->
        <!-- REGRESION REAL (encontrada por el verificador QA final, 29-sep-2026): Grid.Row/
             Grid.Column/Margin puestos como ATRIBUTOS LOCALES aqui (ademas de en el Style de abajo)
             dejaban el Style entero MUERTO - en WPF un valor local SIEMPRE gana sobre cualquier
             Setter de Style, incluido uno dentro de un DataTrigger (orden real de precedencia de
             propiedades de dependencia). Este StackPanel se quedaba FIJO en Grid.Column=1 sin
             importar IsDetailSideBySide - a 1080x700 (Compacto, IsDetailSideBySide=False) la
             columna 1 pasa a Width=Auto (BoolToGridLength), pero el contenido seguia intentando
             vivir ahi, se media a su ancho natural (mayor que el hueco real) y quedaba CORTADO por
             el borde derecho del Grid, sin scroll para alcanzarlo (Guia: "Arbol de progresion
             completo" cortado; mismo bug en HostingView.xaml/AboutView.xaml). Sin ningun atributo
             local aqui, el Style (unico dueño real de Grid.Row/Grid.Column/Margin) SI reacciona al
             DataTrigger. -->
        <StackPanel>
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Grid.Row" Value="0" />
                    <Setter Property="Grid.Column" Value="1" />
                    <Setter Property="Margin" Value="24,0,0,0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDetailSideBySide}" Value="False">
                            <Setter Property="Grid.Row" Value="1" />
                            <Setter Property="Grid.Column" Value="0" />
                            <Setter Property="Margin" Value="0,16,0,0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="{Binding Loc[guide_all_tracks_title], Mode=OneWay}" Style="{StaticResource SectionText}" Margin="0,0,0,10" />
            <ItemsControl ItemsSource="{Binding Guide.Tramos}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- FASE G del responsive global (WARN-02, s17): SIN MaxWidth=680 a proposito
                             (a diferencia de los bloques de texto corrido de mas arriba) - esta
                             tarjeta vive en la columna derecha (arbol de progresion) en Amplio/Extra,
                             donde el ancho real de la columna crece con la ventana (1038px medidos a
                             1920, mas a 2560); un tope de legibilidad de parrafo no aplica a una fila
                             compacta de icono+titulo+badges. Medido: sin este cambio, Guia se quedaba
                             en 44% de uso a 2560x1440 (por debajo del 50% de s17) porque cada tarjeta
                             de tramo seguia topada a 680px pese a que la columna tenia mas sitio. -->
                        <Border Background="{StaticResource BgElevatedBrush}" BorderBrush="{StaticResource BorderBrush0}" BorderThickness="1"
                                CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                            <Expander Foreground="{StaticResource TextPrimaryBrush}" IsExpanded="False">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icono}" FontWeight="Bold" Width="18"
                                                   Foreground="{StaticResource EquippedGreenBrush}" />
                                        <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="380" />
                                        <Border Background="{StaticResource TealBrush}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                Visibility="{Binding EsOpcional, Converter={StaticResource GuideBoolToVis}}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DataContext.Loc[guide_optional_badge], RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" FontSize="9" Foreground="White" />
                                        </Border>
                                        <Border Background="{StaticResource CalamityBrush}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                Visibility="{Binding EsCalamity, Converter={StaticResource GuideBoolToVis}}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DataContext.Loc[guide_calamity_badge], RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" FontSize="9" Foreground="White" />
                                        </Border>
                                        <Border Background="{StaticResource BgHoverBrush}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                Visibility="{Binding Implementado, Converter={StaticResource InverseBoolToVis}}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DataContext.Loc[guide_not_implemented_badge], RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="26,8,0,4">
                                    <TextBlock Text="{Binding Resumen}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding Pasos}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,10">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Icono}" FontWeight="Bold" Width="16" Foreground="{StaticResource EquippedGreenBrush}" />
                                                        <!-- Encargo3 (24-sep-2026): sprite real del hito (jefe/objeto/NPC-vecino),
                                                             GuidePasoViewModel.IconPath, mismo resolver que el banner de arriba -
                                                             misma fila que ya usa este tamaño para icono+titulo en el resto de la app
                                                             (Width=20/Height=20, ver p.ej. linea 4146). -->
                                                        <Image Source="{Binding IconPath}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,6,0"
                                                               RenderOptions.BitmapScalingMode="NearestNeighbor" VerticalAlignment="Center"
                                                               Visibility="{Binding IconPath, Converter={StaticResource NullToVis}}" />
                                                        <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="500" VerticalAlignment="Center" />
                                                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <Run Text="{Binding PreparacionPct, Mode=OneWay}" /><Run Text="%" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <ItemsControl ItemsSource="{Binding Requisitos}" Margin="24,2,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <!-- Guia Fase B (26-sep-2026): antes solo el banner "Tu objetivo
                                                                     ahora mismo" mostraba Motivo bajo un requisito NoEvaluable -
                                                                     aqui, en el arbol completo (la vista real para explorar el
                                                                     resto de tramos, no solo el objetivo actual), se quedaba en
                                                                     blanco, sin ninguna pista de "por que no se puede comprobar".
                                                                     Mismo binding EXACTO que ya usa el banner
                                                                     (GuideRequisitoViewModel.Motivo, resuelto por idioma), sin
                                                                     duplicar logica ni inventar un converter nuevo - y mismo
                                                                     tratamiento de icono/opacidad EsLimiteEstructural que el
                                                                     banner (ver su comentario en el DataTemplate de
                                                                     ObjetivoPaso.Requisitos, mas arriba en este mismo fichero). -->
                                                                <StackPanel Margin="0,1,0,2">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Grid Width="16" VerticalAlignment="Top">
                                                                            <TextBlock Text="{Binding Icono}"
                                                                                       Visibility="{Binding EsLimiteEstructural, Converter={StaticResource InverseBoolToVis}}" />
                                                                            <TextBlock Text="⊘" Foreground="{StaticResource TextSecondaryBrush}"
                                                                                       Visibility="{Binding EsLimiteEstructural, Converter={StaticResource GuideBoolToVis}}" />
                                                                        </Grid>
                                                                        <TextBlock Text="{Binding Linea}" TextWrapping="Wrap" MaxWidth="480">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding EsLimiteEstructural}" Value="True">
                                                                                            <Setter Property="Opacity" Value="0.6" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding Motivo}" Style="{StaticResource CaptionText}" Opacity="0.65" FontSize="9" FontStyle="Italic" TextWrapping="Wrap"
                                                                               MaxWidth="460" Margin="20,1,0,0" Visibility="{Binding Motivo, Converter={StaticResource EmptyToCollapsed}}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
