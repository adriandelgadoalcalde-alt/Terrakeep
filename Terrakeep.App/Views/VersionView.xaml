<!-- ADR-TERRAKEEP-016/023 (26-sep-2026): SEPTIMA extraccion real de una seccion de
     MainWindow.xaml a un UserControl, segunda del grupo de sub-tabs de PERSONAJE (punto 4.5
     del plan, siguiente paso recomendado por ADR-TERRAKEEP-022 tras SPAWN POINTS). Sub-tab
     VERSION elegido sobre Unlocks (el otro candidato pendiente) tras grep exhaustivo real: a
     diferencia de Unlocks (que SI usa StaticResource BoolToVis, window-scoped, 5 veces en su
     propio markup), Version NO usa BoolToVis en ningun sitio - el unico converter de
     visibilidad que referencia es NullToVis (VersionEditor.DowngradeWarning) mas CountToVis
     (los 5 Expander de diagnostico), ambos definidos en App.xaml, no en Window.Resources. Sin
     ningun recurso window-scoped en su propio markup, esta extraccion no necesita el patron
     UserControl.Resources local que si hicieron falta en HostingView/ADR-019 y GuideView/
     ADR-021 - el caso mas simple desde SPAWN POINTS/ADR-022.

     Contenido copiado BYTE A BYTE del TabItem "VERSION" (el septimo sub-tab del TabControl
     interno de PERSONAJE, SelectedIndex=6 - PersonajeInnerTabIndex, confirmado por el canario
     real PB-07 de PruebasBuffsAparienciaVersion.cs y por IDEA9_SOLO de Program.cs) en
     MainWindow.xaml - solo re-indentado al moverse de sitio, ningun caracter de contenido
     cambiado. Grep exhaustivo confirmado: cero x:Name dentro del bloque original (nada que
     resolver con el patron de FindName doble de GUIA/ADR-021), y los 2 DataTemplate propios
     (VersionGroup/VersionOption) son ANIDADOS dentro de ItemsControl.ItemTemplate SIN x:Key -
     nunca dependen de Window.Resources, se compilan y resuelven junto con su propio
     ItemsControl igual en cualquier profundidad de anidamiento. Los demas StaticResource que
     usa este bloque (CalamityBrush/OrangeBrush/TextPrimaryBrush/CaptionText/SectionText/
     BgElevatedBrush/VersionOptionButton) confirmados en Styles/Theme.xaml, ninguno window-
     scoped.

     El UserControl no fija su propio DataContext, hereda el MainViewModel real del Window. Las
     2 referencias a RelativeSource AncestorType=Window (Loc[action_repair_fix] de los 5
     RepairIssueViewModel, VersionEditor.SetVersionCommand de VersionOption) siguen funcionando
     sin cambios: Window sigue siendo un ancestro real en el arbol visual aunque el contenido
     viva ahora dentro de un UserControl hijo (mismo mecanismo ya confirmado por las
     extracciones anteriores, p.ej. SpawnpointsView/ADR-022). Sin code-behind propio en
     MainWindow.xaml.cs para este sub-tab (todo Bindings/Commands). -->
<UserControl x:Class="Terrakeep.App.Views.VersionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Terrakeep.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer x:Name="VersionContentScroll" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
        <!-- D-a (segunda auditoria de Opus, Fable): mismo arreglo que Desbloqueos,
             arriba - HorizontalAlignment="Left" real, no centrado por omision.
             H5-09: mismo DetailContentMaxWidth compartido. -->
        <StackPanel MaxWidth="{Binding DetailContentMaxWidth}" HorizontalAlignment="Left">
            <Border Background="{StaticResource CalamityBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,14">
                <TextBlock Foreground="White" TextWrapping="Wrap" FontSize="12"
                           Text="{Binding Loc[version_warning_change], Mode=OneWay}" />
            </Border>
            <!-- V-c (segunda auditoria de Opus, Fable): "bajar de version no
                 advierte de lo que se pierde - el aviso generico no dice que
                 secciones dejaran de guardarse, los datos reales del personaje
                 ya estan a mano para decirlo con numeros". -->
            <Border Background="{StaticResource OrangeBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,14"
                    Visibility="{Binding VersionEditor.DowngradeWarning, Converter={StaticResource NullToVis}}">
                <TextBlock Foreground="White" TextWrapping="Wrap" FontSize="12" Text="{Binding VersionEditor.DowngradeWarning}" />
            </Border>
            <!-- Catalogo de ideas Keep, idea 9 ("modo reparar personaje", diagnostico +
                 arreglo en un clic - ver el comentario real de cabecera en
                 MainViewModel.RebuildIllegalPrefixDiagnostics para el alcance final de
                 los 4 diagnosticos y por que "version desfasada" no tiene panel propio
                 aqui, ya vive en VersionEditor.DowngradeWarning justo encima, con su
                 propio arreglo en un clic real - los botones de version de mas abajo).
                 Cada fila es un RepairIssueViewModel real (DisplayName + FixCommand),
                 nunca un string suelto - el boton "Arreglar" ejecuta la MISMA accion
                 real que el usuario haria a mano desde el slot/la pestaña Buffs/el
                 Explorador de archivos, solo que en un clic desde aqui. Objetos con un
                 prefijo que PrefixRulesCatalog.IsLegal dice que ese objeto concreto no
                 puede llevar - solo puede pasar en un .plr traido de fuera de Terrakeep
                 (esta misma app ya impide crear la combinacion desde dentro, bug real
                 cerrado el 1-sep-2026). -->
            <Expander Header="{Binding Loc[repair_illegal_prefixes], Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}"
                      Margin="0,0,0,14" IsExpanded="True"
                      Visibility="{Binding IllegalPrefixIssues.Count, Converter={StaticResource CountToVis}}">
                <StackPanel Margin="0,6,0,0">
                    <TextBlock Text="{Binding Loc[repair_illegal_prefixes_desc], Mode=OneWay}" Style="{StaticResource CaptionText}"
                               Foreground="{StaticResource OrangeBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding IllegalPrefixIssues}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RepairIssueViewModel}">
                                <DockPanel Margin="0,0,0,3">
                                    <Button DockPanel.Dock="Right" Content="{Binding DataContext.Loc[action_repair_fix], RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                                            Command="{Binding FixCommand}" Tag="Ghost" Padding="6,3" FontSize="10.5" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Expander>
            <!-- Idea 9: slots fantasma - id vanilla o Calamity que ningun catalogo
                 cargado reconoce. -->
            <Expander Header="{Binding Loc[repair_ghost_slots], Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}"
                      Margin="0,0,0,14" IsExpanded="True"
                      Visibility="{Binding GhostSlotIssues.Count, Converter={StaticResource CountToVis}}">
                <StackPanel Margin="0,6,0,0">
                    <TextBlock Text="{Binding Loc[repair_ghost_slots_desc], Mode=OneWay}" Style="{StaticResource CaptionText}"
                               Foreground="{StaticResource OrangeBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding GhostSlotIssues}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RepairIssueViewModel}">
                                <DockPanel Margin="0,0,0,3">
                                    <Button DockPanel.Dock="Right" Content="{Binding DataContext.Loc[action_repair_fix], RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                                            Command="{Binding FixCommand}" Tag="Ghost" Padding="6,3" FontSize="10.5" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Expander>
            <!-- Idea 9: duraciones de buff desbordadas (negativas o por encima del techo
                 real del juego para esta version, ver
                 BuffDurationPresets.MaxTicksForVersion). -->
            <Expander Header="{Binding Loc[repair_buff_overflow], Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}"
                      Margin="0,0,0,14" IsExpanded="True"
                      Visibility="{Binding OverflowingBuffIssues.Count, Converter={StaticResource CountToVis}}">
                <StackPanel Margin="0,6,0,0">
                    <TextBlock Text="{Binding Loc[repair_buff_overflow_desc], Mode=OneWay}" Style="{StaticResource CaptionText}"
                               Foreground="{StaticResource OrangeBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding OverflowingBuffIssues}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RepairIssueViewModel}">
                                <DockPanel Margin="0,0,0,3">
                                    <Button DockPanel.Dock="Right" Content="{Binding DataContext.Loc[action_repair_fix], RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                                            Command="{Binding FixCommand}" Tag="Ghost" Padding="6,3" FontSize="10.5" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Expander>
            <!-- Idea 9: .tplr huerfano (fichero .tplr sin .plr hermano en la misma
                 carpeta) y .tplr inconsistente (slots que se perderian en silencio al
                 guardar, ver CalamityCharacterSync.FindOutOfRangeTplrSlots/
                 PruneOutOfRangeTplrSlot). -->
            <Expander Header="{Binding Loc[repair_tplr_orphan], Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}"
                      Margin="0,0,0,14" IsExpanded="True"
                      Visibility="{Binding OrphanTplrIssues.Count, Converter={StaticResource CountToVis}}">
                <StackPanel Margin="0,6,0,0">
                    <TextBlock Text="{Binding Loc[repair_tplr_orphan_desc], Mode=OneWay}" Style="{StaticResource CaptionText}"
                               Foreground="{StaticResource OrangeBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding OrphanTplrIssues}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RepairIssueViewModel}">
                                <DockPanel Margin="0,0,0,3">
                                    <Button DockPanel.Dock="Right" Content="{Binding DataContext.Loc[action_repair_fix], RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                                            Command="{Binding FixCommand}" Tag="Ghost" Padding="6,3" FontSize="10.5" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Expander>
            <Expander Header="{Binding Loc[repair_tplr_inconsistent], Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}"
                      Margin="0,0,0,14" IsExpanded="True"
                      Visibility="{Binding InconsistentTplrIssues.Count, Converter={StaticResource CountToVis}}">
                <StackPanel Margin="0,6,0,0">
                    <TextBlock Text="{Binding Loc[repair_tplr_inconsistent_desc], Mode=OneWay}" Style="{StaticResource CaptionText}"
                               Foreground="{StaticResource OrangeBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding InconsistentTplrIssues}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RepairIssueViewModel}">
                                <DockPanel Margin="0,0,0,3">
                                    <Button DockPanel.Dock="Right" Content="{Binding DataContext.Loc[action_repair_fix], RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                                            Command="{Binding FixCommand}" Tag="Ghost" Padding="6,3" FontSize="10.5" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Expander>
            <TextBlock Text="{Binding Loc[version_raw_number], Mode=OneWay}" Style="{StaticResource SectionText}" Margin="0,0,0,4" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBox Text="{Binding VersionEditor.RawVersion, UpdateSourceTrigger=PropertyChanged}"
                         Width="90" Padding="6,4" HorizontalAlignment="Left"
                         Background="{StaticResource BgElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" />
                <!-- H3-14 (tercera auditoria de Opus, Fable): "279 se muestra crudo,
                     nunca '1.4.4.0+'" - resumen legible real (mismo calco de
                     TabVersion.getBestText que VersionEditorViewModel.BestMatchLabel). -->
                <TextBlock Text="{Binding VersionEditor.BestMatchLabel}" Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>

            <!-- H5-09: los 4 grupos reales (1.1.x/1.2.x/1.3.x/1.4.x) se repartian en
                 una columna unica pese a ser candidatos naturales a ir lado a lado -
                 mismo WrapPanel real que el resto de la app, con sitio real
                 (DetailContentMaxWidth) entran los 4 a la vez en Amplio. -->
            <ItemsControl ItemsSource="{Binding VersionEditor.Groups}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:VersionGroup}">
                        <StackPanel Margin="0,0,24,14" Width="200">
                            <TextBlock Text="{Binding Label}" Style="{StaticResource CaptionText}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding Options}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:VersionOption}">
                                        <!-- V-a (segunda auditoria de Opus, Fable): mismo patron real ya usado en la
                                             rejilla de prefijos (D-6, IsCurrent) - antes ningun boton de version
                                             indicaba cual era la YA puesta, habia que leer el numero en crudo de al
                                             lado y hacer la cuenta a mano.
                                             H4-11 (cuarta auditoria de Opus, Fable): "otro lenguaje visual que el
                                             resto de selectores" - pintaba Background/FontWeight a mano en vez de
                                             usar la misma pildora con Tag="Accent" que el resto de la app. -->
                                        <Button Content="{Binding Label}" Style="{StaticResource VersionOptionButton}"
                                                Command="{Binding DataContext.VersionEditor.SetVersionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Number}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
