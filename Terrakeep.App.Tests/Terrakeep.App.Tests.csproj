    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Terrakeep.App\Terrakeep.App.csproj" />
  </ItemGroup>

</Project>
