bin/
obj/
.vs/
*.user
*.suo

# Export/backup accidental de todo el repo en la raiz (visto de verdad: Terrasavr-Native.zip,
# 380 MB, 23-sep-2026 - duplicaba el repo entero incluido .codebase-memory, sin valor de
# recuperacion adicional sobre el propio git). Nunca se comitea un backup asi, solo se borra.
/*.zip

# BaseOutputPath aislados de sesiones concurrentes de KeepQA (21-sep-2026, mismo motivo que
# bin/obj de arriba: artefacto de build, nunca fuente). Convencion real: "bin_<algo>/" cuando una
# sesion necesita construir sin chocar con el bin/ compartido de otra sesion activa en paralelo
# (visto de verdad con `bin_diag/` y `bin_uia_record/` la noche del 20/21-sep-2026).
bin_*/
obj_*/
# Instalador generado por Inno Setup (installer/TerrakeepSetup.iss) - binario de build, no
# fuente. Se regenera con ISCC.exe, nunca se comitea (misma politica que bin/).
installer/output/

# Cache de bytecode de Python, generada al importar scripts/lang_vanilla.py desde otro
# script del mismo directorio. Artefacto de build, nunca fuente (misma politica que bin/obj).
scripts/__pycache__/

# KeepQA (17-sep-2026): snapshots visuales (Verify.ImageSharp, SnapshotVisual.cs). Convencion
# real de Verify: "*.received.png" es SIEMPRE efimero (el ultimo render, para comparar/aprobar a
# mano) - nunca fuente. "*.verified.png" SI se comitea (es la referencia real aprobada).
Terrakeep.App.Tests/snapshots-visuales/*.received.png
