bin/
obj/
.vs/
*.user
*.suo
# Instalador generado por Inno Setup (installer/TerrakeepSetup.iss) - binario de build, no
# fuente. Se regenera con ISCC.exe, nunca se comitea (misma politica que bin/).
installer/output/

# Cache de bytecode de Python, generada al importar scripts/lang_vanilla.py desde otro
# script del mismo directorio. Artefacto de build, nunca fuente (misma politica que bin/obj).
scripts/__pycache__/

# KeepQA (17-sep-2026): snapshots visuales (Verify.ImageSharp, SnapshotVisual.cs). Convencion
# real de Verify: "*.received.png" es SIEMPRE efimero (el ultimo render, para comparar/aprobar a
# mano) - nunca fuente. "*.verified.png" SI se comitea (es la referencia real aprobada).
Terrakeep.App.Tests/snapshots-visuales/*.received.png
